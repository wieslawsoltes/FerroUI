<StackPanel xmlns="https://github.com/ferroui"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:FerroBoard.Layouts;assembly=FerroBoard.Core"
 x:DataType="l:ComputedKeyboard">
 <TextBlock Text="{CompiledBinding Rows.Count}"/>
 <TextBlock Text="{CompiledBinding Rows[0].Count}"/>
 <TextBlock Text="{CompiledBinding Rows[0][0].Label}"/>
 <ContentControl Content="{CompiledBinding Keys}"/>
</StackPanel>

<ResourceDictionary xmlns="https://github.com/ferroui" xmlns:c="using:FerroRibbon.Controls" xmlns:i="using:FerroRibbon.Internal" xmlns:p="using:FerroRibbon.Controls.Primitives" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="ferres://FerroRibbon/Themes/Shared.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <ControlTheme TargetType="c:RibbonSlider" x:Key="{x:Type c:RibbonSlider}">
    <Setter Property="Foreground" Value="{DynamicResource RibbonForegroundBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Grid Height="{TemplateBinding InputHeight}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <p:RibbonIconPresenter Icon="{TemplateBinding Icon}" IconSize="16" Foreground="{DynamicResource RibbonIconBrush}" Margin="3,0,4,0" IsVisible="{TemplateBinding IconVisibility,Converter={x:Static i:RibbonInputTemplateValues.VisibilityToBoolean}}" />
            <TextBlock x:Name="PART_Label" Grid.Column="1" Text="{TemplateBinding Label}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{TemplateBinding Foreground}" IsVisible="{TemplateBinding LabelVisibility,Converter={x:Static i:RibbonInputTemplateValues.VisibilityToBoolean}}" />
            <i:RibbonInputSlider x:Name="PART_Slider" Grid.Column="2" Width="{TemplateBinding InputWidth}" VerticalAlignment="Center" MinHeight="0" Padding="0" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style Selector="^:input-disabled /template/ TextBlock#PART_Label">
      <Setter Property="Foreground" Value="{DynamicResource RibbonDisabledForegroundBrush}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>

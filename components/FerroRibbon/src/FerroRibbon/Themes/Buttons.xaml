<ResourceDictionary xmlns="https://github.com/ferroui" xmlns:c="using:FerroRibbon.Controls" xmlns:p="using:FerroRibbon.Controls.Primitives" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="ferres://FerroRibbon/Themes/Shared.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <ControlTheme x:Key="DefaultRibbonButtonStyle" TargetType="c:RibbonButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource RibbonForegroundBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="CornerRadius" Value="{DynamicResource RibbonControlCornerRadius}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border x:Name="RootGrid" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
            <p:RibbonItemContent x:Name="PART_Content" Icon="{TemplateBinding Icon}" LargeIcon="{TemplateBinding LargeIcon}" Label="{TemplateBinding Label}" ItemSize="{TemplateBinding CurrentSize}" ShowLabel="{TemplateBinding ActualShowLabel}" ShowChevron="{TemplateBinding ShowChevron}" IsSimplified="{TemplateBinding IsSimplified}" Metrics="{TemplateBinding Metrics}" Foreground="{TemplateBinding Foreground}" IconForeground="{DynamicResource RibbonIconBrush}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style Selector="^:pointerover:not(:pressed):not(:disabled) /template/ Border#RootGrid">
      <Setter Property="Background" Value="{DynamicResource RibbonItemHoverBrush}" />
    </Style>
    <Style Selector="^:pointerover:not(:pressed):not(:disabled) /template/ Border#RootGrid">
      <Setter Property="BorderBrush" Value="{DynamicResource RibbonItemBorderHoverBrush}" />
    </Style>
    <Style Selector="^:pressed:not(:disabled) /template/ Border#RootGrid">
      <Setter Property="Background" Value="{DynamicResource RibbonItemPressedBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ p|RibbonItemContent#PART_Content">
      <Setter Property="Foreground" Value="{DynamicResource RibbonDisabledForegroundBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ p|RibbonItemContent#PART_Content">
      <Setter Property="IconForeground" Value="{DynamicResource RibbonDisabledForegroundBrush}" />
    </Style>
  </ControlTheme>
  <ControlTheme TargetType="c:RibbonButton" BasedOn="{StaticResource DefaultRibbonButtonStyle}" x:Key="{x:Type c:RibbonButton}" />
  <ControlTheme TargetType="c:RibbonDropDownButton" BasedOn="{StaticResource DefaultRibbonButtonStyle}" x:Key="{x:Type c:RibbonDropDownButton}" />
</ResourceDictionary>

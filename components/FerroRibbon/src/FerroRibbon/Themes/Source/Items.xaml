  <ControlTheme x:Key="DefaultRibbonSplitButtonStyle" TargetType="c:RibbonSplitButton">
    <Setter Property="Foreground" Value="{DynamicResource RibbonForegroundBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border x:Name="PART_Chrome" CornerRadius="{DynamicResource RibbonControlCornerRadius}" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
            <Grid x:Name="PART_Root">
              <Button x:Name="PART_PrimaryButton" Foreground="{TemplateBinding Foreground}" Theme="{StaticResource RibbonSplitPartButtonStyle}">
                <p:RibbonItemContent x:Name="PART_PrimaryContent" IconForeground="{DynamicResource RibbonIconBrush}" Foreground="{TemplateBinding Foreground}" />
              </Button>
              <Button x:Name="PART_SecondaryButton" Foreground="{TemplateBinding Foreground}" Theme="{StaticResource RibbonSplitPartButtonStyle}">
                <p:RibbonItemContent x:Name="PART_SecondaryContent" IconForeground="{DynamicResource RibbonIconBrush}" Foreground="{TemplateBinding Foreground}" />
              </Button>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style Selector="^:checked /template/ Border#PART_Chrome">
      <Setter Property="Background" Value="{DynamicResource RibbonItemCheckedBrush}" />
    </Style>
    <Style Selector="^:checked /template/ Border#PART_Chrome">
      <Setter Property="BorderBrush" Value="{DynamicResource RibbonItemCheckedBorderBrush}" />
    </Style>
    <Style Selector="^:splitdisabled /template/ p|RibbonItemContent#PART_PrimaryContent">
      <Setter Property="Foreground" Value="{DynamicResource RibbonDisabledForegroundBrush}" />
    </Style>
    <Style Selector="^:splitdisabled /template/ p|RibbonItemContent#PART_PrimaryContent">
      <Setter Property="IconForeground" Value="{DynamicResource RibbonDisabledForegroundBrush}" />
    </Style>
    <Style Selector="^:splitdisabled /template/ p|RibbonItemContent#PART_SecondaryContent">
      <Setter Property="Foreground" Value="{DynamicResource RibbonDisabledForegroundBrush}" />
    </Style>
    <Style Selector="^:splitdisabled /template/ p|RibbonItemContent#PART_SecondaryContent">
      <Setter Property="IconForeground" Value="{DynamicResource RibbonDisabledForegroundBrush}" />
    </Style>
    <Style Selector="^:dropdownopen /template/ Button#PART_SecondaryButton">
      <Setter Property="Background" Value="{DynamicResource RibbonItemPressedBrush}" />
    </Style>
  </ControlTheme>
  <ControlTheme TargetType="c:RibbonSplitButton" BasedOn="{StaticResource DefaultRibbonSplitButtonStyle}" x:Key="{x:Type c:RibbonSplitButton}" />
<ControlTheme x:Key="{x:Type c:RibbonColorPicker}" TargetType="c:RibbonColorPicker" BasedOn="{StaticResource DefaultRibbonSplitButtonStyle}" />
<ControlTheme TargetType="c:RibbonCheckBox" x:Key="{x:Type c:RibbonCheckBox}">
    <Setter Property="Foreground" Value="{DynamicResource RibbonForegroundBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="4,0,6,0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="CornerRadius" Value="{DynamicResource RibbonControlCornerRadius}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border x:Name="PART_Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid Width="14" Height="14" VerticalAlignment="Center">
                <Border x:Name="PART_Box" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource RibbonInputHoverBorderBrush}" Background="{DynamicResource RibbonInputBackgroundBrush}" />
                <u:FontIcon x:Name="PART_Check" Glyph="" FontSize="10" Foreground="{DynamicResource RibbonAccentForegroundBrush}" IsVisible="False" />
                <Rectangle x:Name="PART_Indeterminate" Width="7" Height="2" Fill="{DynamicResource RibbonAccentForegroundBrush}" IsVisible="False" />
              </Grid>
              <TextBlock x:Name="PART_Label" Grid.Column="1" Margin="6,0,0,0" Text="{TemplateBinding Label}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" TextLineBounds="Full" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style Selector="^:ribbon-hover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource RibbonItemHoverBrush}" />
    </Style>
    <Style Selector="^:ribbon-disabled /template/ TextBlock#PART_Label">
      <Setter Property="Foreground" Value="{DynamicResource RibbonDisabledForegroundBrush}" />
    </Style>
  </ControlTheme>
<ControlTheme TargetType="c:RibbonSeparator" x:Key="{x:Type c:RibbonSeparator}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:RibbonSeparator">
          <Rectangle x:Name="PART_Line" Fill="{DynamicResource RibbonSeparatorBrush}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </ControlTheme>
  <ControlTheme TargetType="c:RibbonLabel" x:Key="{x:Type c:RibbonLabel}">
    <Setter Property="Foreground" Value="{DynamicResource RibbonForegroundBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:RibbonLabel">
          <Border Padding="4,0" Height="22">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <p:RibbonIconPresenter Icon="{TemplateBinding Icon}" IconSize="16" Foreground="{DynamicResource RibbonIconBrush}" />
              <TextBlock Text="{TemplateBinding Label}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </ControlTheme>
  <ControlTheme TargetType="c:RibbonButtonGroup" x:Key="{x:Type c:RibbonButtonGroup}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:RibbonButtonGroup">
          <StackPanel x:Name="PART_ItemsHost" Orientation="Horizontal" Spacing="0" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </ControlTheme>
  <ControlTheme TargetType="c:RibbonStackPanel" x:Key="{x:Type c:RibbonStackPanel}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:RibbonStackPanel">
          <StackPanel x:Name="PART_ItemsHost" Orientation="{TemplateBinding Orientation}" Spacing="{TemplateBinding Spacing}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </ControlTheme>
<ControlTheme TargetType="c:RibbonScreenTip" x:Key="{x:Type c:RibbonScreenTip}">
    <Setter Property="MaxWidth" Value="320" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:RibbonScreenTip">
          <Border Padding="2">
            <StackPanel Spacing="6">
              <TextBlock Text="{TemplateBinding TitleText}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <p:RibbonIconPresenter x:Name="PART_Image" Icon="{TemplateBinding Image}" IconSize="96" HorizontalAlignment="Left" Foreground="{DynamicResource RibbonIconBrush}" />
              <TextBlock x:Name="PART_Description" Text="{TemplateBinding Description}" TextWrapping="Wrap" Opacity="0.9" />
              <TextBlock x:Name="PART_DisabledReason" Text="{TemplateBinding DisabledReason}" TextWrapping="Wrap" FontStyle="Italic" Opacity="0.8" />
              <Border x:Name="PART_Extended" BorderThickness="0,1,0,0" Padding="0,6,0,0" BorderBrush="{DynamicResource RibbonSeparatorBrush}" IsVisible="False">
                <StackPanel Spacing="6">
                  <p:RibbonIconPresenter x:Name="PART_ExtendedImage" Icon="{TemplateBinding ExtendedImage}" IconSize="160" HorizontalAlignment="Left" Foreground="{DynamicResource RibbonIconBrush}" />
                  <TextBlock x:Name="PART_ExtendedDescription" Text="{TemplateBinding ExtendedDescription}" TextWrapping="Wrap" Opacity="0.9" />
                </StackPanel>
              </Border>
              <Border x:Name="PART_HelpText" BorderThickness="0,1,0,0" Padding="0,6,0,0" BorderBrush="{DynamicResource RibbonSeparatorBrush}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <u:FontIcon Glyph="" FontSize="12" />
                  <TextBlock Text="{TemplateBinding HelpText}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </ControlTheme>
</ResourceDictionary>

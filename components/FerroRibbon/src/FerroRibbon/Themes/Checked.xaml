<!-- RibbonSpace Items.xaml checked controls. Copyright Wiesław Šoltés, MIT. -->
<ResourceDictionary xmlns="https://github.com/ferroui" xmlns:c="using:FerroRibbon.Controls" xmlns:p="using:FerroRibbon.Controls.Primitives" xmlns:u="using:FerroRibbon.Compatibility" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="ferres://FerroRibbon/Themes/Shared.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <ControlTheme TargetType="c:RibbonToggleButton" x:Key="{x:Type c:RibbonToggleButton}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource RibbonForegroundBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="CornerRadius" Value="{DynamicResource RibbonControlCornerRadius}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border x:Name="RootGrid" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
            <p:RibbonItemContent x:Name="PART_Content" Icon="{TemplateBinding Icon}" LargeIcon="{TemplateBinding LargeIcon}" Label="{TemplateBinding Label}" ItemSize="{TemplateBinding CurrentSize}" ShowLabel="{TemplateBinding ActualShowLabel}" ShowChevron="{TemplateBinding ShowChevron}" IsSimplified="{TemplateBinding IsSimplified}" Metrics="{TemplateBinding Metrics}" Foreground="{TemplateBinding Foreground}" IconForeground="{DynamicResource RibbonIconBrush}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style Selector="^:unchecked:pointerover:not(:pressed):not(:disabled) /template/ Border#RootGrid">
      <Setter Property="Background" Value="{DynamicResource RibbonItemHoverBrush}" />
    </Style>
    <Style Selector="^:unchecked:pressed:not(:disabled) /template/ Border#RootGrid">
      <Setter Property="Background" Value="{DynamicResource RibbonItemPressedBrush}" />
    </Style>
    <Style Selector="^:unchecked:disabled /template/ p|RibbonItemContent#PART_Content">
      <Setter Property="Foreground" Value="{DynamicResource RibbonDisabledForegroundBrush}" />
    </Style>
    <Style Selector="^:unchecked:disabled /template/ p|RibbonItemContent#PART_Content">
      <Setter Property="IconForeground" Value="{DynamicResource RibbonDisabledForegroundBrush}" />
    </Style>
    <Style Selector="^:checked:not(:pointerover):not(:pressed):not(:disabled) /template/ Border#RootGrid">
      <Setter Property="Background" Value="{DynamicResource RibbonItemCheckedBrush}" />
    </Style>
    <Style Selector="^:checked:not(:pointerover):not(:pressed):not(:disabled) /template/ Border#RootGrid">
      <Setter Property="BorderBrush" Value="{DynamicResource RibbonItemCheckedBorderBrush}" />
    </Style>
    <Style Selector="^:checked:pointerover:not(:pressed):not(:disabled) /template/ Border#RootGrid">
      <Setter Property="Background" Value="{DynamicResource RibbonItemCheckedHoverBrush}" />
    </Style>
    <Style Selector="^:checked:pointerover:not(:pressed):not(:disabled) /template/ Border#RootGrid">
      <Setter Property="BorderBrush" Value="{DynamicResource RibbonItemCheckedBorderBrush}" />
    </Style>
    <Style Selector="^:checked:pressed:not(:disabled) /template/ Border#RootGrid">
      <Setter Property="Background" Value="{DynamicResource RibbonItemPressedBrush}" />
    </Style>
    <Style Selector="^:checked:pressed:not(:disabled) /template/ Border#RootGrid">
      <Setter Property="BorderBrush" Value="{DynamicResource RibbonItemCheckedBorderBrush}" />
    </Style>
    <Style Selector="^:checked:disabled /template/ Border#RootGrid">
      <Setter Property="Background" Value="{DynamicResource RibbonItemCheckedBrush}" />
    </Style>
    <Style Selector="^:checked:disabled /template/ p|RibbonItemContent#PART_Content">
      <Setter Property="Foreground" Value="{DynamicResource RibbonDisabledForegroundBrush}" />
    </Style>
    <Style Selector="^:checked:disabled /template/ p|RibbonItemContent#PART_Content">
      <Setter Property="IconForeground" Value="{DynamicResource RibbonDisabledForegroundBrush}" />
    </Style>
    <Style Selector="^:indeterminate:not(:pointerover):not(:pressed):not(:disabled) /template/ Border#RootGrid">
      <Setter Property="BorderBrush" Value="{DynamicResource RibbonItemCheckedBorderBrush}" />
    </Style>
    <Style Selector="^:indeterminate:pointerover:not(:pressed):not(:disabled) /template/ Border#RootGrid">
      <Setter Property="Background" Value="{DynamicResource RibbonItemHoverBrush}" />
    </Style>
    <Style Selector="^:indeterminate:pressed:not(:disabled) /template/ Border#RootGrid">
      <Setter Property="Background" Value="{DynamicResource RibbonItemPressedBrush}" />
    </Style>
    <Style Selector="^:indeterminate:disabled /template/ p|RibbonItemContent#PART_Content">
      <Setter Property="Foreground" Value="{DynamicResource RibbonDisabledForegroundBrush}" />
    </Style>
  </ControlTheme>
  <ControlTheme TargetType="c:RibbonCheckBox" x:Key="{x:Type c:RibbonCheckBox}">
    <Setter Property="Foreground" Value="{DynamicResource RibbonForegroundBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="4,0,6,0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="CornerRadius" Value="{DynamicResource RibbonControlCornerRadius}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border x:Name="PART_Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid Width="14" Height="14" VerticalAlignment="Center">
                <Border x:Name="PART_Box" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource RibbonInputHoverBorderBrush}" Background="{DynamicResource RibbonInputBackgroundBrush}" />
                <u:FontIcon x:Name="PART_Check" Glyph="" FontSize="10" Foreground="{DynamicResource RibbonAccentForegroundBrush}" IsVisible="False" />
                <Rectangle x:Name="PART_Indeterminate" Width="7" Height="2" Fill="{DynamicResource RibbonAccentForegroundBrush}" IsVisible="False" />
              </Grid>
              <TextBlock x:Name="PART_Label" Grid.Column="1" Margin="6,0,0,0" Text="{TemplateBinding Label}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" TextLineBounds="Full" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style Selector="^:ribbon-hover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource RibbonItemHoverBrush}" />
    </Style>
    <Style Selector="^:ribbon-disabled /template/ TextBlock#PART_Label">
      <Setter Property="Foreground" Value="{DynamicResource RibbonDisabledForegroundBrush}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>

<StackPanel xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:CompileBindings="True">
 <StackPanel.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceInclude Source="ferres://FerroRibbon/Themes/Ribbon.xaml" /><ResourceInclude Source="ferres://FerroRibbon/Themes/TextInput.xaml" /><ResourceInclude Source="ferres://FerroRibbon/Themes/Spinner.xaml" /><ResourceInclude Source="ferres://FerroRibbon/Themes/Slider.xaml" /></ResourceDictionary.MergedDictionaries>
  <RibbonSpinnerModel x:Key="Spinner" Minimum="-10" Maximum="30" Increment="0.25" Format="0.00" Unit="pt" InputWidth="85"><x:Arguments><x:String>spin</x:String><x:String>Spacing</x:String><x:Double>7.25</x:Double></x:Arguments></RibbonSpinnerModel>
  <RibbonTextBoxModel x:Key="Text" Id="text" Label="Find" Text="café 😀" Placeholder="Search" InputWidth="160" />
  <RibbonSliderModel x:Key="Slider" Id="slider" Label="Zoom" Minimum="-5" Maximum="50" StepFrequency="2.5" SliderWidth="155" Value="12.5" />
  <RibbonModel x:Key="Graph"><RibbonModel.Tabs><RibbonTabModel Id="home" Label="Home"><RibbonTabModel.Groups><RibbonGroupModel Id="inputs" Label="Inputs"><RibbonGroupModel.Items><StaticResource ResourceKey="Spinner" /><StaticResource ResourceKey="Text" /><StaticResource ResourceKey="Slider" /></RibbonGroupModel.Items></RibbonGroupModel></RibbonTabModel.Groups></RibbonTabModel></RibbonModel.Tabs></RibbonModel>
 </ResourceDictionary></StackPanel.Resources>
 <Ribbon Model="{StaticResource Graph}" IsDisplayOptionsButtonVisible="False" />
 <TextBox x:DataType="RibbonTextBoxModel" DataContext="{StaticResource Text}" Text="{Binding Text, Mode=TwoWay}" />
 <TextBlock x:DataType="RibbonSpinnerModel" DataContext="{StaticResource Spinner}" Text="{Binding Value}" />
 <TextBlock x:DataType="RibbonSliderModel" DataContext="{StaticResource Slider}" Text="{Binding Value}" />
</StackPanel>

<StackPanel xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:FerroRibbon.Consumer">
 <RibbonButton Label="Menu">
  <RibbonButton.Flyout>
   <MenuFlyout>
    <local:ConsumerMenu Text="_Literal-" RibbonMenu.Icon="&#xE700;" KeyboardAcceleratorTextOverride="Localized shortcut" />
    <ToggleMenuFlyoutItem x:Name="MenuSource" Text="Toggle" IsChecked="True" />
    <ToggleMenuFlyoutItem Text="Mirror" IsChecked="{Binding ElementName=MenuSource,Path=IsChecked,Mode=TwoWay}" />
    <MenuFlyoutSubItem Text="Nested" RadioMenuFlyoutItem.AreCheckStatesEnabled="True">
     <RadioMenuFlyoutItem Text="First" GroupName="consumer" IsChecked="True" />
     <RadioMenuFlyoutItem Text="Second" GroupName="consumer" />
     <MenuFlyoutSeparator />
    </MenuFlyoutSubItem>
   </MenuFlyout>
  </RibbonButton.Flyout>
 </RibbonButton>
</StackPanel>

<StackPanel xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:r="https://github.com/wieslawsoltes/RibbonSpace" xmlns:local="using:FerroRibbon.Consumer">
 <StackPanel.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="ferres://FerroRibbon/Themes/Ribbon.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></StackPanel.Resources>
 <local:ConsumerRibbon x:Name="RibbonRoot" x:DataType="local:CommandViewModel" CanFloatGroups="True" QuickAccessPosition="BelowRibbon" ShowQuickAccessLabels="True" IsApplicationButtonVisible="False" IsDisplayOptionsButtonVisible="False">
  <r:Ribbon.DataContext><local:CommandViewModel /></r:Ribbon.DataContext>
  <r:Ribbon.QuickAccessToolBar><local:ConsumerQuickAccessToolBar ShowCustomizeButton="False"><r:RibbonButton Id="save" Label="Save" Command="{Binding Command}" CommandParameter="{Binding Value}" /></local:ConsumerQuickAccessToolBar></r:Ribbon.QuickAccessToolBar>
  <r:Ribbon.QuickAccessCandidateIds><x:String>cut</x:String></r:Ribbon.QuickAccessCandidateIds>
  <r:RibbonTab Header="Home" KeyTip="H"><r:RibbonGroup Header="Tools" FloatingPosition="12,24"><r:RibbonButton Id="cut" Label="Cut" Command="{Binding Command}" CommandParameter="{Binding Value}" /></r:RibbonGroup></r:RibbonTab>
 </local:ConsumerRibbon>
 <TextBlock Text="{Binding ElementName=RibbonRoot,Path=QuickAccessToolBar.Items.Count}" />
</StackPanel>

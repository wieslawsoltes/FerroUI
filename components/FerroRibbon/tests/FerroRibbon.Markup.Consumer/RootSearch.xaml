<StackPanel xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="ferres://FerroRibbon/Themes/Ribbon.xaml" /></ResourceDictionary.MergedDictionaries>
  <RibbonSearchEntry x:Key="Help"><x:Arguments><x:String>help</x:String><x:String>Help</x:String></x:Arguments></RibbonSearchEntry>
  <RibbonSearchEntry x:Key="FullEntry"><x:Arguments><x:String>full</x:String><x:String>Hé𐐨</x:String><x:String>Path</x:String><x:String>Description</x:String><x:Null /><x:String>Ctrl+H</x:String><x:String>payload</x:String><x:Boolean>False</x:Boolean></x:Arguments></RibbonSearchEntry>
  <RibbonSearchResult x:Key="FullResult"><x:Arguments><StaticResource ResourceKey="FullEntry" /><x:Double>1.25</x:Double></x:Arguments></RibbonSearchResult>
  <RibbonSearchEngine x:Key="Engine" MaxRecent="3" />
 </ResourceDictionary></StackPanel.Resources>
 <Ribbon x:Name="SearchRoot" IsDisplayOptionsButtonVisible="False">
  <Ribbon.AdditionalSearchEntries><StaticResource ResourceKey="Help" /></Ribbon.AdditionalSearchEntries>
  <RibbonTab Id="home" Header="Home"><RibbonGroup Id="tools" Header="Tools"><RibbonButton x:Name="Alpha" Id="alpha" Label="Alpha" RibbonSearch.Keywords="first, start" /><RibbonButton Id="beta" Label="Beta" RibbonSearch.IsSearchable="False" /></RibbonGroup></RibbonTab>
 </Ribbon>
 <TextBlock x:Name="Count" x:DataType="Ribbon" DataContext="{Binding #SearchRoot}" Text="{Binding AdditionalSearchEntries.Count}" />
 <TextBlock x:Name="RecentLimit" x:DataType="RibbonSearchEngine" DataContext="{StaticResource Engine}" Text="{Binding MaxRecent}" />
</StackPanel>

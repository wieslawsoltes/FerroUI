<StackPanel xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:r="https://github.com/wieslawsoltes/RibbonSpace" xmlns:local="using:FerroRibbon.Consumer">
 <StackPanel.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceInclude Source="ferres://FerroRibbon/Themes/Ribbon.xaml" /><ResourceInclude Source="ferres://FerroRibbon/Themes/Backstage.xaml" /></ResourceDictionary.MergedDictionaries>
  <local:RootModelViewModel x:Key="ViewModel" />
  <local:ConsumerElementFactory x:Key="Factory" />
 </ResourceDictionary></StackPanel.Resources>
 <local:ConsumerRibbon x:DataType="local:RootModelViewModel" DataContext="{StaticResource ViewModel}" ItemFactory="{StaticResource Factory}" Model="{Binding Model}" IsDisplayOptionsButtonVisible="False">
  <r:RibbonTab Id="declared" Header="Declared" />
 </local:ConsumerRibbon>
</StackPanel>

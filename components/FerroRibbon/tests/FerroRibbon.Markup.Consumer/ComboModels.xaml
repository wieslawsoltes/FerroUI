<StackPanel xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="using:System.Collections.ObjectModel" x:CompileBindings="True">
 <StackPanel.Resources><ResourceDictionary>
  <c:ObservableCollection x:Key="Initial" x:TypeArguments="x:Object"><x:String>One</x:String><x:Null /><x:Int32>23</x:Int32></c:ObservableCollection>
  <RibbonComboBoxModel x:Key="Combo" IsEditable="True" Placeholder="Pick"><x:Arguments><x:String>choice</x:String><x:String>Choice</x:String><StaticResource ResourceKey="Initial" /></x:Arguments></RibbonComboBoxModel>
  <RibbonComboBoxModel x:Key="Inline" Id="inline" Label="Inline"><RibbonComboBoxModel.Items><x:String>Nested</x:String><RibbonButtonModel Id="node" Label="Node label" /></RibbonComboBoxModel.Items></RibbonComboBoxModel>
  <RibbonComboBoxModel x:Key="Empty"><x:Arguments><x:Null /><x:Null /><x:Null /></x:Arguments></RibbonComboBoxModel>
  <RibbonModel x:Key="Graph"><RibbonModel.Tabs><RibbonTabModel Id="home" Label="Home"><RibbonTabModel.Groups><RibbonGroupModel Id="inputs" Label="Inputs"><RibbonGroupModel.Items><StaticResource ResourceKey="Combo" /><StaticResource ResourceKey="Inline" /></RibbonGroupModel.Items></RibbonGroupModel></RibbonTabModel.Groups></RibbonTabModel></RibbonModel.Tabs></RibbonModel>
 </ResourceDictionary></StackPanel.Resources>
 <Ribbon Model="{StaticResource Graph}" IsDisplayOptionsButtonVisible="False" />
 <TextBlock x:DataType="RibbonComboBoxModel" DataContext="{StaticResource Combo}" Text="{Binding Items.Count}" />
 <TextBlock x:DataType="RibbonComboBoxModel" DataContext="{StaticResource Combo}" Text="{Binding Items[0]}" />
 <TextBox x:DataType="RibbonComboBoxModel" DataContext="{StaticResource Combo}" Text="{Binding Text, Mode=TwoWay}" />
</StackPanel>

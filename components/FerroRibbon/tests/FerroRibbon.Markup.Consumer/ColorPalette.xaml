<local:PaletteView xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:r="https://github.com/wieslawsoltes/RibbonSpace" xmlns:local="using:FerroRibbon.Consumer">
 <local:PaletteView.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="ferres://FerroRibbon/Themes/ColorPalette.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></local:PaletteView.Resources>
 <local:ConsumerPalette x:Name="Palette" SelectedColor="#80010203" ColorSelected="Selected" ColorPreview="Preview" MoreColorsRequested="More" ShowNoColor="True">
  <local:ConsumerPalette.ThemeColors><Color>#80010203</Color><Color>#FF112233</Color></local:ConsumerPalette.ThemeColors>
  <local:ConsumerPalette.StandardColors><Color>#FF050607</Color></local:ConsumerPalette.StandardColors>
 </local:ConsumerPalette>
 <TextBlock Text="{Binding ElementName=Palette,Path=RecentColors.Count}" />
 <TextBlock Text="{Binding ElementName=Palette,Path=ColorNames.Count}" />
 <TextBlock DataContext="{Binding ElementName=Palette}" x:DataType="r:RibbonColorPalette" Text="{CompiledBinding ColorNames.Count}" />
</local:PaletteView>

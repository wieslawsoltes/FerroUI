<local:ApplicationMenuView xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:FerroRibbon.Consumer" x:Class="FerroRibbon.Consumer.ApplicationMenuView" x:Name="Root">
  <Ribbon x:Name="RibbonOwner" IsVisible="False" />
  <local:ConsumerApplicationMenu x:Name="Menu" Ribbon="{Binding #RibbonOwner}" RecentHeader="Documents" ItemInvoked="ItemClick" RecentItemInvoked="RecentInvoked">
    <RibbonApplicationMenuItem Id="save-as" Label="{Binding #Root.Header}" >
      <RibbonApplicationMenuItem Id="drawing" Label="Drawing" Command="{Binding #Root.Command}" CommandParameter="{Binding #Root.Parameter}" Click="ItemClick" />
    </RibbonApplicationMenuItem>
    <RibbonApplicationMenu.RecentItems><RibbonApplicationMenuRecentItem Title="Drawing" IsPinned="True" Click="RecentClick" /></RibbonApplicationMenu.RecentItems>
    <RibbonApplicationMenu.FooterItems><Button Content="Options" /></RibbonApplicationMenu.FooterItems>
  </local:ConsumerApplicationMenu>
  <TextBlock Text="{Binding #Menu.FooterItems.Count}" />
</local:ApplicationMenuView>

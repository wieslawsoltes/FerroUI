<local:ClickDeliveryConsumer xmlns="https://github.com/ferroui"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:r="https://github.com/wieslawsoltes/RibbonSpace" xmlns:local="using:FerroRibbon.Consumer"
 x:Class="FerroRibbon.Consumer.ClickDeliveryConsumer" x:DataType="local:CommandViewModel" x:CompileBindings="True">
 <local:ClickDeliveryConsumer.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceInclude Source="ferres://FerroRibbon/Themes/Generic.xaml" />
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></local:ClickDeliveryConsumer.Resources>
 <local:ClickDeliveryConsumer.DataContext><local:CommandViewModel /></local:ClickDeliveryConsumer.DataContext>
 <r:RibbonButton Label="Push" Click="MarkHandled" Command="{Binding Command}" CommandParameter="{Binding Value}" />
 <r:RibbonDropDownButton Label="Drop down" Click="MarkHandled" Command="{Binding Command}" CommandParameter="{Binding Value}" />
 <r:RibbonToggleButton Label="Toggle" Click="MarkHandled" Command="{Binding Command}" CommandParameter="{Binding Value}" />
 <r:RibbonCheckBox Label="Check" Click="MarkHandled" Command="{Binding Command}" CommandParameter="{Binding Value}" />
 <local:ConsumerRibbonButton Label="Derived" Click="MarkHandled" Command="{Binding Command}" CommandParameter="{Binding Value}" />
</local:ClickDeliveryConsumer>

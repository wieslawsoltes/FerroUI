<!-- Public consumer: no individual ribbon template dictionaries are included. -->
<StackPanel xmlns="https://github.com/ferroui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:r="https://github.com/wieslawsoltes/RibbonSpace"
            xmlns:m="using:FerroRibbon.Model">
  <StackPanel.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="ferres://FerroRibbon/Themes/Generic.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <m:RibbonButtonModel x:Key="Model" Id="generated" Label="Generated" />
      <ControlTheme x:Key="ConsumerButton" TargetType="r:RibbonButton"
                    BasedOn="{StaticResource DefaultRibbonButtonStyle}">
        <Setter Property="Padding" Value="23" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border><TextBlock Text="Consumer template" /></Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
      <ControlTheme x:Key="ImplicitConsumerButton" TargetType="r:RibbonButton"
                    BasedOn="{StaticResource DefaultRibbonButtonStyle}">
        <Setter Property="Padding" Value="91" />
      </ControlTheme>
    </ResourceDictionary>
  </StackPanel.Resources>
  <r:Ribbon SelectedTabId="home" IsApplicationButtonVisible="False"
            IsDisplayOptionsButtonVisible="False">
    <r:RibbonTab Id="home" Header="Home">
      <r:RibbonGroup Header="Commands">
        <r:RibbonButton Label="Declared" />
      </r:RibbonGroup>
    </r:RibbonTab>
  </r:Ribbon>
  <r:RibbonSpinner Value="12" />
  <r:RibbonStatusBar />
  <r:RibbonZoomControl Value="100" />
</StackPanel>

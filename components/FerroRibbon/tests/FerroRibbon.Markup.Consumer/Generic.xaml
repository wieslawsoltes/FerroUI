<!-- Public consumer: no individual ribbon template dictionaries are included. -->
<StackPanel xmlns="https://github.com/ferroui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="ferres://FerroRibbon/Themes/Generic.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <RibbonButtonModel x:Key="Model" Id="generated" Label="Generated" />
      <ControlTheme x:Key="ConsumerButton" TargetType="RibbonButton"
                    BasedOn="{StaticResource DefaultRibbonButtonStyle}">
        <Setter Property="Padding" Value="23" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border><TextBlock Text="Consumer template" /></Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
      <ControlTheme x:Key="ImplicitConsumerButton" TargetType="RibbonButton"
                    BasedOn="{StaticResource DefaultRibbonButtonStyle}">
        <Setter Property="Padding" Value="91" />
      </ControlTheme>
    </ResourceDictionary>
  </StackPanel.Resources>
  <Ribbon SelectedTabId="home" IsApplicationButtonVisible="False"
            IsDisplayOptionsButtonVisible="False">
    <RibbonTab Id="home" Header="Home">
      <RibbonGroup Header="Commands">
        <RibbonButton Label="Declared" />
      </RibbonGroup>
    </RibbonTab>
  </Ribbon>
  <RibbonSpinner Value="12" />
  <RibbonStatusBar />
  <RibbonZoomControl Value="100" />
</StackPanel>

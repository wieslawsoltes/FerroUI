<StackPanel xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:FerroRibbon.Consumer">
 <StackPanel.Resources><ResourceDictionary>
  <RibbonElementFactory x:Key="NativeFactory" />
  <local:ConsumerElementFactory x:Key="CustomFactory" />
  <ResourceDictionary.MergedDictionaries><ResourceInclude Source="ferres://FerroRibbon/Themes/Ribbon.xaml" /><ResourceInclude Source="ferres://FerroRibbon/Themes/Slider.xaml" /><ResourceInclude Source="ferres://FerroRibbon/Themes/SimpleItems.xaml" /></ResourceDictionary.MergedDictionaries>
 </ResourceDictionary></StackPanel.Resources>
 <RibbonButton Label="Declared" Tag="{StaticResource NativeFactory}" RibbonSearch.Keywords="copy,paste" RibbonSearch.IsSearchable="False" />
 <RibbonGroup Header="Generated" Tag="{StaticResource CustomFactory}"><RibbonButton Id="declared" Label="Existing" /></RibbonGroup>
 <local:ConsumerRibbon IsApplicationButtonVisible="False" IsDisplayOptionsButtonVisible="False"><RibbonTab Header="Declared" Id="declared-tab" /></local:ConsumerRibbon>
</StackPanel>

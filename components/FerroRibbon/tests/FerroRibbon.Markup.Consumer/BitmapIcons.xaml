<StackPanel xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel.Resources><ResourceDictionary><BitmapIconSource x:Key="Source" UriSource="ferres://bitmap_icon_consumer/missing.png" ShowAsMonochrome="False" Foreground="Blue" /></ResourceDictionary></StackPanel.Resources>
 <BitmapIcon x:Name="Original" UriSource="ferres://bitmap_icon_consumer/missing.png" ShowAsMonochrome="False" Foreground="Blue" />
 <RibbonIconPresenter Icon="{Binding ElementName=Original}" IconSize="24" Foreground="Red" />
 <RibbonIconPresenter Icon="{StaticResource Source}" IconSize="23.5" Foreground="Red" />
 <MenuFlyoutItem Text="Bitmap" RibbonMenu.Icon="{StaticResource Source}" />
</StackPanel>

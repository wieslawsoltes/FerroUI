<StackPanel xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:r="https://github.com/wieslawsoltes/RibbonSpace" xmlns:m="using:FerroRibbon.Model" x:CompileBindings="True">
 <StackPanel.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries>
   <ResourceInclude Source="ferres://FerroRibbon/Themes/ColorPalette.xaml" />
   <ResourceInclude Source="ferres://FerroRibbon/Themes/GridPicker.xaml" />
   <ResourceInclude Source="ferres://FerroRibbon/Themes/SimpleItems.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <m:RibbonColorPickerModel x:Key="Colors" Id="colors" Label="Colors" ShowNoColor="True" SelectedColor="#80010203" />
  <m:RibbonGridPickerModel x:Key="Grid" Id="table" Label="Table" Rows="4" Columns="6" />
  <m:RibbonDropDownButtonModel x:Key="Drop" Id="insert" Label="Insert">
   <m:RibbonDropDownButtonModel.MenuItems>
    <StaticResource ResourceKey="Colors" />
    <StaticResource ResourceKey="Grid" />
   </m:RibbonDropDownButtonModel.MenuItems>
  </m:RibbonDropDownButtonModel>
 </ResourceDictionary></StackPanel.Resources>
 <TextBlock x:DataType="m:RibbonDropDownButtonModel" DataContext="{StaticResource Drop}" Text="{Binding MenuItems.Count}" />
 <r:RibbonColorPalette SelectedColor="#80010203" ShowNoColor="True" />
 <r:RibbonGridPicker Rows="4" Columns="6" />
</StackPanel>

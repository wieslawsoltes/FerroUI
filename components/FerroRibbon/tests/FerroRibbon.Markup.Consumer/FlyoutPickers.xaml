<StackPanel xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:CompileBindings="True">
 <StackPanel.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries>
   <ResourceInclude Source="ferres://FerroRibbon/Themes/ColorPalette.xaml" />
   <ResourceInclude Source="ferres://FerroRibbon/Themes/GridPicker.xaml" />
   <ResourceInclude Source="ferres://FerroRibbon/Themes/SimpleItems.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <RibbonColorPickerModel x:Key="Colors" Id="colors" Label="Colors" ShowNoColor="True" SelectedColor="#80010203" />
  <RibbonGridPickerModel x:Key="Grid" Id="table" Label="Table" Rows="4" Columns="6" />
  <RibbonDropDownButtonModel x:Key="Drop" Id="insert" Label="Insert">
   <RibbonDropDownButtonModel.MenuItems>
    <StaticResource ResourceKey="Colors" />
    <StaticResource ResourceKey="Grid" />
   </RibbonDropDownButtonModel.MenuItems>
  </RibbonDropDownButtonModel>
 </ResourceDictionary></StackPanel.Resources>
 <TextBlock x:DataType="RibbonDropDownButtonModel" DataContext="{StaticResource Drop}" Text="{Binding MenuItems.Count}" />
 <RibbonColorPalette SelectedColor="#80010203" ShowNoColor="True" />
 <RibbonGridPicker Rows="4" Columns="6" />
</StackPanel>

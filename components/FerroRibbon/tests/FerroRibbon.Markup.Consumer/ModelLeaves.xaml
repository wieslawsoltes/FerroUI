<StackPanel xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceInclude Source="ferres://FerroRibbon/Themes/Ribbon.xaml" /></ResourceDictionary.MergedDictionaries>
  <RibbonIcon x:Key="Illustration"><x:Arguments><RibbonIconKind>Text</RibbonIconKind><x:String>📐</x:String><x:Null /><x:String>#112233</x:String><x:Double>32</x:Double></x:Arguments></RibbonIcon>
  <RibbonScreenTipModel x:Key="Tip" Title="Measure é 📐" Description="Draw geometry" Shortcut="Ctrl+M" HelpText="Press F1" DisabledReason="No document" Image="{StaticResource Illustration}" ExtendedDescription="Extended help" ExtendedImage="{StaticResource Illustration}" />
  <RibbonButtonModel x:Key="Command" Id="measure" Label="Measure" Icon="{StaticResource Illustration}" ScreenTip="{StaticResource Tip}" />
  <RibbonModel x:Key="Graph"><RibbonModel.Tabs><RibbonTabModel Id="home" Label="Home"><RibbonTabModel.Groups><RibbonGroupModel Id="geometry" Label="Geometry"><RibbonGroupModel.Items><StaticResource ResourceKey="Command" /></RibbonGroupModel.Items></RibbonGroupModel></RibbonTabModel.Groups></RibbonTabModel></RibbonModel.Tabs></RibbonModel>
 </ResourceDictionary></StackPanel.Resources>
 <Ribbon Model="{StaticResource Graph}" IsDisplayOptionsButtonVisible="False" />
 <TextBlock DataContext="{StaticResource Tip}" x:DataType="RibbonScreenTipModel" Text="{Binding Title}" />
 <TextBlock DataContext="{StaticResource Tip}" x:DataType="RibbonScreenTipModel" Text="{Binding Image.Value}" />
 <TextBox DataContext="{StaticResource Tip}" x:DataType="RibbonScreenTipModel" Text="{Binding Title, Mode=TwoWay}" />
</StackPanel>

<StackPanel xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:m="using:FerroRibbon.Model" xmlns:r="https://github.com/wieslawsoltes/RibbonSpace">
 <StackPanel.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceInclude Source="ferres://FerroRibbon/Themes/Ribbon.xaml" /></ResourceDictionary.MergedDictionaries>
  <m:RibbonIcon x:Key="Illustration"><x:Arguments><m:RibbonIconKind>Text</m:RibbonIconKind><x:String>📐</x:String><x:Null /><x:String>#112233</x:String><x:Double>32</x:Double></x:Arguments></m:RibbonIcon>
  <m:RibbonScreenTip x:Key="Tip" Title="Measure é 📐" Description="Draw geometry" Shortcut="Ctrl+M" HelpText="Press F1" DisabledReason="No document" Image="{StaticResource Illustration}" ExtendedDescription="Extended help" ExtendedImage="{StaticResource Illustration}" />
  <m:RibbonButtonModel x:Key="Command" Id="measure" Label="Measure" Icon="{StaticResource Illustration}" ScreenTip="{StaticResource Tip}" />
  <m:RibbonModel x:Key="Graph"><m:RibbonModel.Tabs><m:RibbonTabModel Id="home" Label="Home"><m:RibbonTabModel.Groups><m:RibbonGroupModel Id="geometry" Label="Geometry"><m:RibbonGroupModel.Items><StaticResource ResourceKey="Command" /></m:RibbonGroupModel.Items></m:RibbonGroupModel></m:RibbonTabModel.Groups></m:RibbonTabModel></m:RibbonModel.Tabs></m:RibbonModel>
 </ResourceDictionary></StackPanel.Resources>
 <r:Ribbon Model="{StaticResource Graph}" IsDisplayOptionsButtonVisible="False" />
 <TextBlock DataContext="{StaticResource Tip}" x:DataType="m:RibbonScreenTip" Text="{Binding Title}" />
 <TextBlock DataContext="{StaticResource Tip}" x:DataType="m:RibbonScreenTip" Text="{Binding Image.Value}" />
 <TextBox DataContext="{StaticResource Tip}" x:DataType="m:RibbonScreenTip" Text="{Binding Title, Mode=TwoWay}" />
</StackPanel>

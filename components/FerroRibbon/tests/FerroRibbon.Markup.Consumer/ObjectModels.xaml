<StackPanel xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:m="using:FerroRibbon.Model" xmlns:r="https://github.com/wieslawsoltes/RibbonSpace">
 <StackPanel.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceInclude Source="ferres://FerroRibbon/Themes/Ribbon.xaml" /><ResourceInclude Source="ferres://FerroRibbon/Themes/Backstage.xaml" /></ResourceDictionary.MergedDictionaries>
  <Border x:Key="Body" Width="120" Height="60" Background="Blue"><TextBlock Text="Original native child" /></Border>
  <m:RibbonButtonModel x:Key="Command" Id="run" Label="Run" Tag="{StaticResource Body}" CommandParameter="{StaticResource Body}" />
  <m:RibbonBackstageItemModel x:Key="Information" Id="info" Label="Information" Tag="{StaticResource Command}" Content="{StaticResource Body}" CommandParameter="{StaticResource Body}" />
  <m:RibbonModel x:Key="Graph"><m:RibbonModel.Tabs>
   <m:RibbonTabModel Id="home" Label="Home"><m:RibbonTabModel.Groups>
    <m:RibbonGroupModel Id="tools" Label="Tools"><m:RibbonGroupModel.Items><StaticResource ResourceKey="Command" /></m:RibbonGroupModel.Items></m:RibbonGroupModel>
   </m:RibbonTabModel.Groups></m:RibbonTabModel>
  </m:RibbonModel.Tabs></m:RibbonModel>
 </ResourceDictionary></StackPanel.Resources>
 <r:Ribbon Model="{StaticResource Graph}" IsDisplayOptionsButtonVisible="False" />
</StackPanel>

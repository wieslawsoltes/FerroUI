<StackPanel xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceInclude Source="ferres://FerroRibbon/Themes/Ribbon.xaml" /><ResourceInclude Source="ferres://FerroRibbon/Themes/Backstage.xaml" /></ResourceDictionary.MergedDictionaries>
  <Border x:Key="Body" Width="120" Height="60" Background="Blue"><TextBlock Text="Original native child" /></Border>
  <RibbonButtonModel x:Key="Command" Id="run" Label="Run" Tag="{StaticResource Body}" CommandParameter="{StaticResource Body}" />
  <RibbonBackstageItemModel x:Key="Information" Id="info" Label="Information" Tag="{StaticResource Command}" Content="{StaticResource Body}" CommandParameter="{StaticResource Body}" />
  <RibbonModel x:Key="Graph"><RibbonModel.Tabs>
   <RibbonTabModel Id="home" Label="Home"><RibbonTabModel.Groups>
    <RibbonGroupModel Id="tools" Label="Tools"><RibbonGroupModel.Items><StaticResource ResourceKey="Command" /></RibbonGroupModel.Items></RibbonGroupModel>
   </RibbonTabModel.Groups></RibbonTabModel>
  </RibbonModel.Tabs></RibbonModel>
 </ResourceDictionary></StackPanel.Resources>
 <Ribbon Model="{StaticResource Graph}" IsDisplayOptionsButtonVisible="False" />
</StackPanel>

<StackPanel xmlns="https://github.com/ferroui"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel.Styles>
  <Style Selector="TextBlock">
   <Setter Property="TextTrimming" Value="WordEllipsis" />
   <Setter Property="ClipToBounds" Value="False" />
  </Style>
 </StackPanel.Styles>
 <StackPanel.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="ferres://FerroRibbon/Themes/Gallery.xaml" />
   </ResourceDictionary.MergedDictionaries>
  <RibbonGalleryModel x:Key="PreviewModel" Id="modelPreview" Label="Model previews"
   MinColumns="1" MaxColumns="1" ItemWidth="48" ItemHeight="52" ShowLabels="True">
   <RibbonGalleryModel.Items>
    <RibbonGalleryItemModel Label="Model label" Content="Model preview Á😀 العربية אבג is deliberately long" />
   </RibbonGalleryModel.Items>
  </RibbonGalleryModel>
  </ResourceDictionary>
 </StackPanel.Resources>
 <TextBlock x:Name="Ordinary" Text="Ordinary application text" />
 <RibbonGallery x:Name="DirectPreview" Label="Direct previews" MinColumns="1" MaxColumns="1"
  ItemWidth="48" ItemHeight="52" ShowItemLabels="True">
  <RibbonGalleryItem Label="Direct label" PreviewText="Direct preview Á😀 العربية אבג is deliberately long" />
 </RibbonGallery>
 <RibbonGallery MinColumns="1" MaxColumns="1" ItemWidth="48" ItemHeight="52" ShowItemLabels="False">
  <RibbonGallery.ItemTemplate>
   <DataTemplate><TextBlock Text="Template-owned preview" /></DataTemplate>
  </RibbonGallery.ItemTemplate>
  <RibbonGalleryItem Label="Custom label" />
 </RibbonGallery>
</StackPanel>

<StackPanel xmlns="https://github.com/ferroui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="ferres://FerroRibbon/Themes/ScreenTips.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </StackPanel.Resources>
  <RibbonScreenTip Title="Library" Description="External dictionary"
      ExtendedDescription="More" Theme="{DynamicResource {x:Type RibbonScreenTip}}" />
</StackPanel>

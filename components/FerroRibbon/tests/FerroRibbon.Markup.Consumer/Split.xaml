<StackPanel xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:r="https://github.com/wieslawsoltes/RibbonSpace" xmlns:local="using:FerroRibbon.Consumer">
 <StackPanel.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="ferres://FerroRibbon/Themes/Split.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></StackPanel.Resources>
 <local:ConsumerSplit x:Name="Source" Label="Paste" IsCheckable="True" FollowLastChoice="True"><MenuFlyout><MenuFlyoutItem Text="Text Only" /></MenuFlyout></local:ConsumerSplit>
 <r:RibbonSplitButton Label="Mirror" IsChecked="{Binding ElementName=Source,Path=IsChecked,Mode=TwoWay}" />
</StackPanel>

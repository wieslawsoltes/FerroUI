<local:RootBackstageConsumer xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:FerroRibbon.Consumer" x:Class="FerroRibbon.Consumer.RootBackstageConsumer" x:CompileBindings="True">
 <local:RootBackstageConsumer.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceInclude Source="ferres://FerroRibbon/Themes/Ribbon.xaml" /><ResourceInclude Source="ferres://FerroRibbon/Themes/Backstage.xaml" /></ResourceDictionary.MergedDictionaries>
  <RibbonHandledEventArgs x:Key="Arguments" Handled="True" />
 </ResourceDictionary></local:RootBackstageConsumer.Resources>
 <Ribbon ApplicationButtonClick="OnFile" BackstageOpened="OnOpened" BackstageClosed="OnClosed" IsDisplayOptionsButtonVisible="False">
  <Ribbon.Backstage><RibbonBackstage Title="File" NavigationPaneWidth="242.5"><RibbonBackstageItem Header="Information" Id="info" KeyTip="I"><TextBlock Text="Same native page" /></RibbonBackstageItem><RibbonBackstageItem Header="Close" KeyTip="C" Placement="Bottom" /></RibbonBackstage></Ribbon.Backstage>
  <RibbonTab Header="Home" KeyTip="H" />
 </Ribbon>
 <TextBlock x:DataType="RibbonHandledEventArgs" Text="{Binding Handled,Source={StaticResource Arguments}}" />
</local:RootBackstageConsumer>

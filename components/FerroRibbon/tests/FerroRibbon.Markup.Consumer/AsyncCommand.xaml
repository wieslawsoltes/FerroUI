<rs:RibbonButton xmlns="https://github.com/ferroui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:rs="https://github.com/wieslawsoltes/RibbonSpace" xmlns:local="using:FerroRibbon.Consumer"
    x:DataType="local:AsyncCommandViewModel" x:CompileBindings="True"
    Id="async.run" Label="Run" Command="{Binding Command}"
    CommandParameter="{Binding Value}">
  <rs:RibbonButton.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries>
      <ResourceInclude Source="ferres://FerroRibbon/Themes/Buttons.xaml" />
    </ResourceDictionary.MergedDictionaries></ResourceDictionary>
  </rs:RibbonButton.Resources>
</rs:RibbonButton>

<StackPanel xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:r="https://github.com/wieslawsoltes/RibbonSpace" xmlns:local="using:FerroRibbon.Consumer" x:DataType="local:NumberViewModel">
 <StackPanel.DataContext><local:NumberViewModel /></StackPanel.DataContext>
 <StackPanel.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="ferres://FerroRibbon/Themes/Spinner.xaml" /></ResourceDictionary.MergedDictionaries><r:RibbonValueChangedEventArgs x:Key="Change"><x:Arguments><x:Double>1.5</x:Double><x:Double>2.5</x:Double></x:Arguments></r:RibbonValueChangedEventArgs></ResourceDictionary></StackPanel.Resources>
 <local:ConsumerSpinner x:Name="Size" Minimum="0" Maximum="10" Increment="0.5" Format="0.0" Unit="cm" Value="{Binding Value,Mode=TwoWay}" Command="{Binding Command}" />
 <r:RibbonSpinner Format="0.000" Value="1.25" />
 <TextBlock Text="{Binding ElementName=Size,Path=Value}" />
 <TextBlock DataContext="{StaticResource Change}" x:DataType="r:RibbonValueChangedEventArgs" Text="{Binding OldValue}" />
</StackPanel>

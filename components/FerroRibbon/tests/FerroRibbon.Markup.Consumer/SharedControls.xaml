<StackPanel xmlns="https://github.com/ferroui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:rs="https://github.com/wieslawsoltes/RibbonSpace"
            xmlns:local="using:FerroRibbon.Consumer">
  <StackPanel.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><rs:RibbonThemeResources /></ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </StackPanel.Resources>
  <rs:RibbonKeyTip Text="{Binding IconText,Mode=TwoWay}" x:DataType="local:IconViewModel">
    <rs:RibbonKeyTip.DataContext><local:IconViewModel /></rs:RibbonKeyTip.DataContext>
  </rs:RibbonKeyTip>
  <Button Content="Run" Theme="{DynamicResource RibbonChromeButtonStyle}" rs:RibbonKeyTip.KeyTip="R" />
  <Button Content="Option" Theme="{DynamicResource RibbonGalleryItemStyle}" />
  <Button Width="20" Height="20" Theme="{DynamicResource RibbonSwatchButtonStyle}" Background="#123456" />
</StackPanel>

<StackPanel xmlns="https://github.com/ferroui"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:FerroRibbon.Consumer"
 x:DataType="local:ItemContractViewModel" x:CompileBindings="True">
 <StackPanel.DataContext><local:ItemContractViewModel /></StackPanel.DataContext>
 <ContentControl Content="{Binding Item}" />
 <TextBox Text="{Binding Item.Label, Mode=TwoWay}" />
 <TextBlock Text="{Binding Item.CurrentSize}" />
</StackPanel>

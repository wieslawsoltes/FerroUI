<StackPanel xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:r="https://github.com/wieslawsoltes/RibbonSpace" xmlns:local="using:FerroRibbon.Consumer" x:DataType="local:CommandViewModel">
 <StackPanel.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="ferres://FerroRibbon/Themes/Ribbon.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></StackPanel.Resources>
 <StackPanel.DataContext><local:CommandViewModel /></StackPanel.DataContext>
 <local:ConsumerRibbon x:Name="OwnerRoot" IsApplicationButtonVisible="False" IsDisplayOptionsButtonVisible="False">
  <local:ConsumerRibbon.TabStripItems><r:RibbonButton Label="Share" Command="{Binding Command}" CommandParameter="{Binding Value}" /></local:ConsumerRibbon.TabStripItems>
  <r:RibbonTab Id="home" Header="Home"><r:RibbonGroup Header="Tools">
   <r:RibbonGroup.SlideOutItems><r:RibbonButton Label="Advanced" Command="{Binding Command}" CommandParameter="{Binding Value}" r:RibbonItemHelper.Owner="{Binding ElementName=OwnerRoot}" /></r:RibbonGroup.SlideOutItems>
   <r:RibbonButton Label="Run" Command="{Binding Command}" CommandParameter="{Binding Value}" />
  </r:RibbonGroup></r:RibbonTab>
 </local:ConsumerRibbon>
 <r:RibbonButton Label="Detached" r:RibbonItemHelper.Owner="{Binding ElementName=OwnerRoot}" />
</StackPanel>

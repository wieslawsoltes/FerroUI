<StackPanel xmlns="https://github.com/ferroui"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:FerroRibbon.Consumer"
 x:DataType="local:IconViewModel" x:CompileBindings="True">
 <StackPanel.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceInclude Source="ferres://FerroRibbon/Themes/Generic.xaml" />
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></StackPanel.Resources>
 <StackPanel.DataContext><local:IconViewModel IconText="Owned" /></StackPanel.DataContext>
 <RibbonButton Label="Owned" AutomationProperties.Name="{Binding IconText}" />
 <RibbonDropDownButton Label="Owned" AutomationProperties.Name="{Binding IconText}" />
 <RibbonToggleButton Label="Owned" AutomationProperties.Name="{Binding IconText}" />
 <RibbonCheckBox Label="Owned" AutomationProperties.Name="{Binding IconText}" />
 <local:ConsumerRibbonButton Label="Owned" AutomationProperties.Name="{Binding IconText}" />
</StackPanel>

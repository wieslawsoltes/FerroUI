<local:GridPickView xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:FerroRibbon.Consumer">
 <local:GridPickView.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceInclude Source="ferres://FerroRibbon/Themes/GridPicker.xaml" /><ResourceInclude Source="ferres://FerroRibbon/Themes/Ribbon.xaml" /></ResourceDictionary.MergedDictionaries>
  <RibbonGridSize x:Key="Size"><x:Arguments><x:Int32>2</x:Int32><x:Int32>3</x:Int32></x:Arguments></RibbonGridSize>
  <RibbonGridPickerModel x:Key="Model" Id="table" Label="Table" Rows="3" Columns="4" />
  <RibbonModel x:Key="Graph"><RibbonModel.Tabs><RibbonTabModel Id="insert" Label="Insert"><RibbonTabModel.Groups><RibbonGroupModel Id="tables" Label="Tables"><RibbonGroupModel.Items><StaticResource ResourceKey="Model" /></RibbonGroupModel.Items></RibbonGroupModel></RibbonTabModel.Groups></RibbonTabModel></RibbonModel.Tabs></RibbonModel>
 </ResourceDictionary></local:GridPickView.Resources>
 <Ribbon Model="{StaticResource Graph}" IsDisplayOptionsButtonVisible="False" />
 <local:ConsumerGridPicker x:Name="Picker" Rows="2" Columns="3" SizePicked="Picked" />
 <TextBlock Text="{Binding ElementName=Picker, Path=HighlightedSize.Columns}" />
</local:GridPickView>

<local:ConsumerGallery xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:r="https://github.com/wieslawsoltes/RibbonSpace" xmlns:local="using:FerroRibbon.Consumer"
 x:Name="Gallery" Label="Styles" MinColumns="2" MaxColumns="5" IsFilterEnabled="True">

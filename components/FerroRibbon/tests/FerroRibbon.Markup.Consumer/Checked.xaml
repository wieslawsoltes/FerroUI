<StackPanel xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:r="https://github.com/wieslawsoltes/RibbonSpace" xmlns:local="using:FerroRibbon.Consumer">
 <StackPanel.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="ferres://FerroRibbon/Themes/Checked.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></StackPanel.Resources>
 <local:ConsumerToggle x:Name="SourceToggle" Label="Bold" GroupName="format" IsChecked="True" />
 <r:RibbonCheckBox Label="Mirror" IsChecked="{Binding ElementName=SourceToggle,Path=IsChecked,Mode=TwoWay}" />
</StackPanel>

<StackPanel xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:FerroRibbon.Consumer" x:CompileBindings="True">
 <StackPanel.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceInclude Source="ferres://FerroRibbon/Themes/Ribbon.xaml" /><ResourceInclude Source="ferres://FerroRibbon/Themes/Backstage.xaml" /></ResourceDictionary.MergedDictionaries>
  <RibbonModel x:Key="Graph" Title="Model graph">
   <RibbonModel.Tabs>
    <RibbonTabModel Id="home" Label="Home"><RibbonTabModel.Groups>
     <RibbonGroupModel Id="tools" Label="Tools" RowCount="2"><RibbonGroupModel.Items>
      <RibbonButtonModel Id="save" Label="Save" KeyTip="S" />
      <RibbonToggleButtonModel Id="bold" Label="Bold" KeyTip="B" />
     </RibbonGroupModel.Items></RibbonGroupModel>
    </RibbonTabModel.Groups></RibbonTabModel>
   </RibbonModel.Tabs>
  </RibbonModel>
 </ResourceDictionary></StackPanel.Resources>
 <local:ConsumerRibbon Model="{StaticResource Graph}" IsDisplayOptionsButtonVisible="False"><RibbonTab Id="declared" Header="Declared" /></local:ConsumerRibbon>
 <TextBlock x:DataType="RibbonModel" DataContext="{StaticResource Graph}" Text="{Binding Title}" />
 <TextBlock x:DataType="RibbonModel" DataContext="{StaticResource Graph}" Text="{Binding Tabs.Count}" />
 <TextBlock x:DataType="RibbonModel" DataContext="{StaticResource Graph}" Text="{Binding Tabs[0].Label}" />
 <TextBlock x:DataType="RibbonModel" DataContext="{StaticResource Graph}" Text="{Binding SelectedTab.Label}" />
</StackPanel>

<StackPanel xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel.Resources><ResourceDictionary><RibbonCustomization x:Key="State" /></ResourceDictionary></StackPanel.Resources>
 <TextBlock x:DataType="RibbonCustomization" DataContext="{StaticResource State}" Text="{CompiledBinding Labels.Count}" />
 <TextBlock x:DataType="RibbonCustomization" DataContext="{StaticResource State}" Text="{CompiledBinding GroupOrder.Count}" />
</StackPanel>

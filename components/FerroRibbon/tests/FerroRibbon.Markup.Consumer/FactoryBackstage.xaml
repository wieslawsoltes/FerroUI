<StackPanel xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:r="https://github.com/wieslawsoltes/RibbonSpace" xmlns:mv="using:FerroRibbon.Controls.Mvvm" xmlns:local="using:FerroRibbon.Consumer">
 <StackPanel.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceInclude Source="ferres://FerroRibbon/Themes/Backstage.xaml" /></ResourceDictionary.MergedDictionaries>
  <DataTemplate x:Key="Page" x:DataType="local:InputViewModel"><TextBlock Text="{Binding Text}" /></DataTemplate>
  <r:DataTemplateSelector x:Key="DefaultSelector" />
  <local:ConsumerTemplateSelector x:Key="Selector" Template="{StaticResource Page}" />
  <local:ConsumerBackstageFactory x:Key="Factory" ContentTemplateSelector="{StaticResource Selector}" />
 </ResourceDictionary></StackPanel.Resources>
 <r:RibbonBackstage Height="180" Title="Declared"><r:RibbonBackstageItem Id="declared" Header="Declared page"><TextBlock Text="Declared content" /></r:RibbonBackstageItem></r:RibbonBackstage>
 <Border x:Name="GeneratedHost" Height="400" />
</StackPanel>

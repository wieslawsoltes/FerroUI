<StackPanel xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:FerroRibbon.Consumer" xmlns:rs="https://github.com/wieslawsoltes/RibbonSpace"
 x:CompileBindings="True">
 <local:MetricsConsumer x:Name="MetricsSource" Density="Touch" CustomMetrics="{x:Static rs:RibbonMetrics.Touch}" Metrics="{x:Static rs:RibbonMetrics.Touch}" />
 <TextBlock Text="{Binding #MetricsSource.Metrics.RowHeight}" />
 <local:MetricsConsumer Density="{Binding #MetricsSource.Density, Mode=TwoWay}" CustomMetrics="{Binding #MetricsSource.CustomMetrics, Mode=TwoWay}" />
</StackPanel>

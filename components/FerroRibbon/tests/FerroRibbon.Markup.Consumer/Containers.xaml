<StackPanel xmlns="https://github.com/ferroui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:r="https://github.com/wieslawsoltes/RibbonSpace">
  <StackPanel.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="ferres://FerroRibbon/Themes/SimpleItems.xaml" />
        <ResourceInclude Source="ferres://FerroRibbon/Themes/Buttons.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </StackPanel.Resources>
  <r:RibbonButtonGroup x:Name="Buttons">
    <r:RibbonButton x:Name="First" Label="First" />
    <r:RibbonButton Label="Second" />
  </r:RibbonButtonGroup>
  <r:RibbonStackPanel Orientation="Vertical" Spacing="7.5">
    <r:RibbonButton Label="Stacked" />
    <r:RibbonLabel Label="Label" />
  </r:RibbonStackPanel>
  <TextBlock Text="{Binding #Buttons.Items.Count}" />
  <TextBlock Text="{Binding #Buttons.Items[0].Name}" />
</StackPanel>

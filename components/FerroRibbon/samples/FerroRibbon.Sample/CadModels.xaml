<StackPanel xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:cad="using:FerroRibbon.Sample.Cad" xmlns:r="https://github.com/wieslawsoltes/RibbonSpace" x:CompileBindings="True">
 <StackPanel.Resources>
    <!-- AutoCAD-style layer drop-down: on / off, freeze / thaw, lock / unlock, colour, name. -->
    <DataTemplate x:Key="LayerItemTemplate" x:DataType="cad:CadLayer">
      <StackPanel Orientation="Horizontal" Spacing="3" Height="20">
        <r:RibbonIconPresenter Icon="{Binding OnIcon}" IconSize="16" Foreground="{DynamicResource RibbonIconBrush}" />
        <r:RibbonIconPresenter Icon="{Binding FreezeIcon}" IconSize="16" Foreground="{DynamicResource RibbonIconBrush}" />
        <r:RibbonIconPresenter Icon="{Binding LockIcon}" IconSize="16" Foreground="{DynamicResource RibbonIconBrush}" />
        <Border Width="12" Height="12" Margin="3,0,5,0" VerticalAlignment="Center" Background="{Binding ColorBrush}" BorderBrush="{DynamicResource RibbonSwatchBorderBrush}" BorderThickness="1" />
        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="ColorItemTemplate" x:DataType="cad:CadColorOption">
      <StackPanel Orientation="Horizontal" Spacing="6" Height="20">
        <Grid Width="14" Height="14" VerticalAlignment="Center">
          <Border Background="{Binding Swatch}" BorderBrush="{DynamicResource RibbonSwatchBorderBrush}" BorderThickness="1" />
          <Polygon Points="0,14 14,0 14,14" Fill="{DynamicResource RibbonSecondaryForegroundBrush}" Opacity="{Binding SpecialOpacity}" />
        </Grid>
        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="LinetypeItemTemplate" x:DataType="cad:CadLinetype">
      <StackPanel Orientation="Horizontal" Spacing="8" Height="20">
        <Line StartPoint="0,10" EndPoint="40,10" Width="40" VerticalAlignment="Center" Stroke="{DynamicResource RibbonForegroundBrush}" StrokeThickness="1.4" StrokeDashArray="{Binding Dashes}" />
        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="LineweightItemTemplate" x:DataType="cad:CadLineweight">
      <StackPanel Orientation="Horizontal" Spacing="8" Height="20">
        <Rectangle Width="40" Height="{Binding Thickness}" VerticalAlignment="Center" Fill="{DynamicResource RibbonForegroundBrush}" />
        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" />
      </StackPanel>
    </DataTemplate>
 </StackPanel.Resources>
 <r:RibbonComboBox x:Name="Layers" ItemsSource="{x:Static cad:CadLayer.Samples}" ItemTemplate="{StaticResource LayerItemTemplate}" SelectionBoxTemplate="{StaticResource LayerItemTemplate}" />
 <r:RibbonComboBox x:Name="Colors" ItemsSource="{x:Static cad:CadColorOption.Samples}" ItemTemplate="{StaticResource ColorItemTemplate}" SelectionBoxTemplate="{StaticResource ColorItemTemplate}" />
 <r:RibbonComboBox x:Name="Linetypes" ItemsSource="{x:Static cad:CadLinetype.Samples}" ItemTemplate="{StaticResource LinetypeItemTemplate}" SelectionBoxTemplate="{StaticResource LinetypeItemTemplate}" />
 <r:RibbonComboBox x:Name="Weights" ItemsSource="{x:Static cad:CadLineweight.Samples}" ItemTemplate="{StaticResource LineweightItemTemplate}" SelectionBoxTemplate="{StaticResource LineweightItemTemplate}" />
</StackPanel>

<Window xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:cad="using:FerroRibbon.Sample.Cad" xmlns:local="using:FerroRibbon.Sample"
 x:DataType="local:SampleViewModel" x:CompileBindings="True"
 Title="FerroRibbon — native ribbon sample" Width="1140" Height="700" MinWidth="340" MinHeight="400">

 <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Background="#F0F2F5">
  <RibbonTitleBar x:Name="DocumentTitleBar" Ribbon="{Binding #Ribbon}" Title="FerroRibbon document" Subtitle="Working copy" AppIcon="&#xE8A5;" IsAppIconMenuEnabled="True" />
  <Ribbon Grid.Row="1" CanFloatGroups="True" IsShortcutRoutingEnabled="True" VisibilityMode="{Binding VisibilityMode,Mode=TwoWay}" IsMinimizeButtonVisible="True" DisplayMode="{Binding DisplayMode,Mode=TwoWay}" x:Name="Ribbon" IsApplicationButtonVisible="True" IsDisplayOptionsButtonVisible="False">
   <Ribbon.Backstage>
    <RibbonBackstage Title="FerroRibbon">
     <RibbonBackstageItem Id="information" Header="Information" KeyTip="I"><StackPanel Spacing="16"><TextBlock Text="Document information" FontSize="28" /><TextBlock Text="{Binding Document}" TextWrapping="Wrap" /></StackPanel></RibbonBackstageItem>
     <RibbonBackstageItem Id="file-save" Header="Save" KeyTip="S" Command="{Binding Action}" CommandParameter="Save" />
     <RibbonBackstageItem Id="file-reset" Header="Reset ribbon" KeyTip="R" Command="{Binding Action}" CommandParameter="Reset ribbon" />
     <RibbonBackstageItem Header="Return to document" KeyTip="C" Placement="Bottom" />
    </RibbonBackstage>
   </Ribbon.Backstage>
   <Ribbon.QuickAccessToolBar>
    <RibbonQuickAccessToolBar><RibbonButton Id="save" Label="Save" Icon="&#xE74E;" Command="{Binding Action}" CommandParameter="Save" /></RibbonQuickAccessToolBar>
   </Ribbon.QuickAccessToolBar>
   <RibbonTab Id="home" Header="Home" KeyTip="H">
    <RibbonGroup Id="clipboard" Header="Clipboard" ReductionOrder="0">
     <RibbonGroup.SlideOutItems>
      <RibbonButton Id="paste-special" Label="Paste Special" Icon="&#xE77F;" Command="{Binding Action}" CommandParameter="Paste special" />
      <RibbonButton Id="clipboard-history" Label="Clipboard History" Icon="&#xE8C8;" Command="{Binding Action}" CommandParameter="Clipboard history" />
     </RibbonGroup.SlideOutItems>
     <RibbonSplitButton Shortcut="Ctrl+V" Id="paste" Size="Large" Label="Paste" Icon="&#xE77F;" Command="{Binding Action}" CommandParameter="Paste" FollowLastChoice="True">
      <MenuFlyout><MenuFlyoutItem Text="Keep Source" Command="{Binding Action}" CommandParameter="Paste keeping source" /><MenuFlyoutItem Text="Text Only" Command="{Binding Action}" CommandParameter="Paste text only" /></MenuFlyout>
     </RibbonSplitButton>
     <RibbonButton Shortcut="Ctrl+X" Id="cut" KeyTip="X" Label="Cut" Icon="&#xE8C6;" Size="Medium" Command="{Binding Action}" CommandParameter="Cut" />
     <RibbonButton Shortcut="Ctrl+C" Id="copy" KeyTip="C" Label="Copy" Icon="&#xE8C8;" Size="Medium" Command="{Binding Action}" CommandParameter="Copy" />
     <RibbonButton Id="format" Label="Format Painter" Icon="&#xE771;" Size="Medium" Command="{Binding Action}" CommandParameter="Format painter" />
    </RibbonGroup>
    <RibbonGroup Id="font" Header="Font" ReductionOrder="1">
     <RibbonColorPicker Id="font-color" Label="Font Color" KeyTip="FC" ShowNoColor="True" SelectedColor="{Binding FontColor,Mode=TwoWay}" Command="{Binding FontColorAction}" />
     <RibbonFontComboBox Id="font-family" KeyTip="FF" Text="{Binding FontFamily,Mode=TwoWay}" Command="{Binding Font}" />
     <RibbonSpinner Id="font-size" KeyTip="FS" Label="Size" Minimum="8" Maximum="72" Format="0.#" Unit="pt" Value="{Binding FontSize,Mode=TwoWay}" Command="{Binding FontSizeAction}" />
     <RibbonToggleButton Shortcut="Ctrl+B" Id="bold" KeyTip="B" Label="Bold" Icon="B" IsChecked="{Binding Bold,Mode=TwoWay}" Command="{Binding Action}" CommandParameter="Bold" />
     <RibbonButton Label="Increase Font" Size="Large" Icon="A+" Command="{Binding Action}" CommandParameter="Increase font" />
     <RibbonButton Label="Decrease Font" Icon="A−" Command="{Binding Action}" CommandParameter="Decrease font" />
     <RibbonButton Label="Clear Formatting" Icon="&#xE894;" Command="{Binding Action}" CommandParameter="Clear formatting" />
    </RibbonGroup>
    <RibbonGroup Id="paragraph" Header="Paragraph" ReductionOrder="2">
     <RibbonButton Label="Bullets" Size="Large" Icon="&#xE8FD;" Command="{Binding Action}" CommandParameter="Bullets" />
     <RibbonButton Label="Numbering" Icon="&#xE8FE;" Command="{Binding Action}" CommandParameter="Numbering" />
     <RibbonButton Label="Indent" Icon="&#xE8D3;" Command="{Binding Action}" CommandParameter="Indent" />
    </RibbonGroup>
    <RibbonGroup Id="editing" Header="Editing" ReductionOrder="3">
     <RibbonTextBox Id="find-text" Label="Find" KeyTip="S" Shortcut="Ctrl+F" PlaceholderText="Find in document" Text="{Binding SearchText,Mode=TwoWay}" Command="{Binding Find}" />
     <RibbonButton Label="Find" Size="Large" Icon="&#xE721;" Command="{Binding Action}" CommandParameter="Find" />
     <RibbonButton Label="Select" Icon="&#xE8B0;" Command="{Binding Action}" CommandParameter="Select" />
     <RibbonDropDownButton Id="editing-menu" KeyTip="M" Label="Actions" Icon="&#xE712;">
      <RibbonDropDownButton.Flyout><MenuFlyout>
       <MenuFlyoutItem Text="Select All" RibbonKeyTip.KeyTip="A" RibbonMenu.Icon="&#xE8B0;" Command="{Binding Action}" CommandParameter="Select all" KeyboardAcceleratorTextOverride="Ctrl+A" />
       <MenuFlyoutSubItem Text="Document actions">
        <MenuFlyoutItem Text="Find Next" Command="{Binding Action}" CommandParameter="Find next" />
        <MenuFlyoutItem Text="Replace" Command="{Binding Action}" CommandParameter="Replace" />
       </MenuFlyoutSubItem>
      </MenuFlyout></RibbonDropDownButton.Flyout>
     </RibbonDropDownButton>
    </RibbonGroup>
   </RibbonTab>
   <RibbonTab Id="insert" Header="Insert" KeyTip="N">
    <RibbonGroup Id="styles" Header="Styles"><RibbonGallery Id="styles-gallery" Label="Styles" KeyTip="ST" MinColumns="2" MaxColumns="5" Command="{Binding Action}">
     <RibbonGalleryItem Label="Normal" Category="Paragraph" Value="Normal style" PreviewText="AaBb" />
     <RibbonGalleryItem Label="Heading 1" Category="Headings" Value="Heading 1 style" PreviewText="AaBb" PreviewFontSize="20" PreviewFontWeight="Bold" />
     <RibbonGalleryItem Label="Heading 2" Category="Headings" Value="Heading 2 style" PreviewText="AaBb" PreviewFontSize="17" PreviewFontWeight="Bold" />
     <RibbonGalleryItem Label="Title" Category="Headings" Value="Title style" PreviewText="Title" PreviewFontSize="24" />
     <RibbonGalleryItem Label="Subtitle" Category="Paragraph" Value="Subtitle style" PreviewText="Subtitle" PreviewFontStyle="Italic" />
     <RibbonGallery.FooterItems><RibbonButton Label="Apply Styles" Command="{Binding Action}" CommandParameter="Apply styles" /></RibbonGallery.FooterItems>
    </RibbonGallery></RibbonGroup>
    <RibbonGroup Id="tables" Header="Tables"><RibbonDropDownButton Id="insert-table" KeyTip="T" Label="Table" Icon="&#xE80A;"><RibbonDropDownButton.Flyout><Flyout><RibbonGridPicker Rows="8" Columns="10" Command="{Binding TableAction}" /></Flyout></RibbonDropDownButton.Flyout></RibbonDropDownButton></RibbonGroup>
    <RibbonGroup Header="Pages"><RibbonButton Label="Blank Page" Icon="&#xE8A5;" Command="{Binding Action}" CommandParameter="Blank page" /></RibbonGroup>
    <RibbonGroup Header="Illustrations"><RibbonButton Label="Picture" Icon="&#xE91B;" Command="{Binding Action}" CommandParameter="Picture" /><RibbonButton Label="Shape" Icon="&#xE7EF;" Command="{Binding Action}" CommandParameter="Shape" /></RibbonGroup>
    <RibbonGroup Header="Links"><RibbonButton Label="Hyperlink" Icon="&#xE71B;" Command="{Binding Action}" CommandParameter="Hyperlink" /></RibbonGroup>
   </RibbonTab>
   <RibbonTab Id="view" Header="View" KeyTip="W">
    <RibbonGroup Id="workspace" Header="Workspace"><RibbonSegmentedControl Id="workspace-mode" KeyTip="WS" Label="Workspace" Command="{Binding Action}"><RibbonSegment Label="Write" Value="Write workspace" /><RibbonSegment Label="Review" Value="Review workspace" /><RibbonSegment Label="Draw" Value="Draw workspace" /></RibbonSegmentedControl></RibbonGroup>
    <RibbonGroup Header="Document"><RibbonButton Label="Print Layout" Icon="&#xE8A5;" Command="{Binding Action}" CommandParameter="Print layout" /><RibbonButton Label="Reading View" Icon="&#xE736;" Command="{Binding Action}" CommandParameter="Reading view" /></RibbonGroup>
    <RibbonGroup Header="Options"><RibbonCheckBox Label="Simplified Ribbon" IsChecked="{Binding Simplified,Mode=TwoWay}" /><RibbonCheckBox Id="guides" Label="Show Guides" IsChecked="{Binding ShowGuides,Mode=TwoWay}" /></RibbonGroup>
    <RibbonGroup Header="Zoom"><RibbonButton Label="Zoom In" Icon="&#xE8A3;" Command="{Binding Action}" CommandParameter="Zoom in" /><RibbonButton Label="Zoom Out" Icon="&#xE71F;" Command="{Binding Action}" CommandParameter="Zoom out" /></RibbonGroup>
    <RibbonGroup Id="preview" Header="Preview"><RibbonSlider Id="opacity" KeyTip="O" Label="Opacity" Minimum="0" Maximum="100" StepFrequency="5" InputWidth="100" Value="{Binding OpacityPercent,Mode=TwoWay}" Command="{Binding OpacityAction}" /></RibbonGroup>
    <RibbonGroup Id="ribbon-state" Header="Ribbon state">
     <RibbonButton Id="customize-ribbon" Label="Customize Ribbon" Command="{Binding Action}" CommandParameter="Customize ribbon" />
     <RibbonButton Id="customize-qat" Label="Customize Quick Access" Command="{Binding Action}" CommandParameter="Customize quick access" />
     <RibbonButton Label="Save Ribbon" Command="{Binding Action}" CommandParameter="Save ribbon" />
     <RibbonButton Label="Restore Ribbon" Command="{Binding Action}" CommandParameter="Restore ribbon" />
     <RibbonButton Label="Reset Customization" Command="{Binding Action}" CommandParameter="Reset ribbon" />
     <RibbonButton Label="Reset Quick Access" Command="{Binding Action}" CommandParameter="Reset quick access" />
    </RibbonGroup>
   </RibbonTab>
  </Ribbon>
  <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*" Margin="6" ColumnSpacing="8">
   <RibbonMenuBar x:Name="CommandMenus" VerticalAlignment="Center">
    <RibbonMenuBarItem Header="Document"><MenuFlyoutItem Text="Save" Command="{Binding Action}" CommandParameter="Save" /></RibbonMenuBarItem>
    <RibbonMenuBarItem x:Name="ToolOptionsMenu" Header="Tools"><MenuFlyoutItem x:Name="TextToolsAction" Text="Text tools" Command="{Binding Action}" CommandParameter="Text tools" /><MenuFlyoutItem x:Name="DrawToolsAction" Text="Draw tools" Command="{Binding Action}" CommandParameter="Draw tools" /></RibbonMenuBarItem>
   </RibbonMenuBar>
   <RibbonToolBar x:Name="DocumentToolbar" Grid.Column="1" Width="220" ShowLabels="True">
    <RibbonButton Id="toolbar-save" Label="Save" Icon="&#xE74E;" SimplifiedLabel="Show" Command="{Binding Action}" CommandParameter="Save" />
    <RibbonButton Id="toolbar-copy" Label="Copy" Icon="&#xE8C8;" SimplifiedLabel="Show" Command="{Binding Action}" CommandParameter="Copy" />
    <RibbonButton Id="toolbar-paste" Label="Paste" Icon="&#xE77F;" SimplifiedLabel="Show" Command="{Binding Action}" CommandParameter="Paste" />
    <RibbonButton Id="toolbar-print" Label="Print" Icon="&#xE749;" SimplifiedLabel="Show" Command="{Binding Action}" CommandParameter="Print" />
   </RibbonToolBar>
   <RibbonContextualToolBar x:Name="ToolOptions" Grid.Column="2" ActiveContext="{Binding ActiveTool}">
    <RibbonToolBar x:Name="TextOptions" RibbonContextualToolBar.Context="text" ShowLabels="True"><RibbonButton Label="Text options" Icon="A" SimplifiedLabel="Show" Command="{Binding Action}" CommandParameter="Text options" /></RibbonToolBar>
    <RibbonToolBar x:Name="DrawOptions" RibbonContextualToolBar.Context="draw" ShowLabels="True"><RibbonButton Label="Pen" Icon="{cad:CadIcon Name=Line}" SimplifiedLabel="Show" Command="{Binding Action}" CommandParameter="Pen" /><RibbonButton Label="Brush" Icon="{cad:CadIcon Name=HatchSolid}" SimplifiedLabel="Show" Command="{Binding Action}" CommandParameter="Brush" /></RibbonToolBar>
   </RibbonContextualToolBar>
  </Grid>
  <LayoutTransformControl x:Name="DocumentZoom" Grid.Row="3" Margin="44,30">
   <LayoutTransformControl.LayoutTransform><ScaleTransform ScaleX="{Binding ZoomScale}" ScaleY="{Binding ZoomScale}" /></LayoutTransformControl.LayoutTransform>
  <Border x:Name="DocumentPage" Opacity="{Binding DocumentOpacity}" Padding="42" Background="White" BorderBrush="#D4D9E1" BorderThickness="1" CornerRadius="3">
   <TextBox x:Name="Document" FontFamily="{Binding FontFamily}" Text="{Binding Document,Mode=TwoWay}" Foreground="{Binding DocumentForeground}" CaretBrush="#202530" AcceptsReturn="True" TextWrapping="Wrap" FontSize="{Binding FontSize}" BorderThickness="0" Background="Transparent" />
  </Border>
  </LayoutTransformControl>
  <RibbonStatusBar x:Name="DocumentStatusBar" Grid.Row="4" Ribbon="{Binding #Ribbon}"><TextBlock Text="{Binding Status}" VerticalAlignment="Center" /><RibbonStatusBar.EndItems><RibbonZoomControl x:Name="DocumentZoomControl" Value="{Binding ZoomPercent,Mode=TwoWay}" Command="{Binding ZoomAction}" /></RibbonStatusBar.EndItems></RibbonStatusBar>
 </Grid>
</Window>

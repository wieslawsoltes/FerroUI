<ContentControl xmlns="https://github.com/ferroui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ContentControl.ContentTemplate>
    <DataTemplate x:DataType="Button">
      <StackPanel>
        <TextBlock Text="{x:Bind Content}" />
        <TextBox x:Name="editor" Text="{x:Bind Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="{x:Bind Content, Mode=OneWay}" />
        <TextBlock Text="{x:Bind editor.Text, Mode=OneWay}" />
      </StackPanel>
    </DataTemplate>
  </ContentControl.ContentTemplate>
</ContentControl>

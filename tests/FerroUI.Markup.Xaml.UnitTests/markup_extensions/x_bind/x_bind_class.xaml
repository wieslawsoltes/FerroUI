<Panel xmlns="https://github.com/ferroui"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       x:Class="FerroUI.Markup.Xaml.UnitTests.XBindPage">
  <TextBlock x:Name="title" Text="{x:Bind Title, Mode=OneWay}" />
  <TextBlock x:Name="model" Text="{x:Bind Model.Name, Mode=OneWay}" />
  <TextBlock x:Name="formatted" Text="{x:Bind Format(Title)}" />
  <Button x:Name="clicked" Click="{x:Bind OnClickNoArgs}" />
</Panel>

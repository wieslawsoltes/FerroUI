<Panel xmlns="https://github.com/ferroui"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:d="using:FerroDock.Ferro.Controls"
       x:DataType="d:DockControl" x:CompileBindings="True">
  <d:DockControl InitializeLayout="False" InitializeFactory="False"
                 EnableManagedWindowLayer="False" IsDockingEnabled="False" />
  <d:DocumentTabStrip Orientation="Vertical" CanCreateItem="True"
                      EnableWindowDrag="False" />
  <d:DocumentTabStripItem IsActive="True" Width="24" />
  <d:ToolTabStrip CanCreateItem="True" MouseWheelScrollOrientation="Vertical" />
  <d:ToolTabStripItem IsSelected="True" />
  <d:ToolChromeControl Title="Source chrome" IsPinned="True" IsMaximized="True" />
  <d:ToolPinItemControl Orientation="Vertical" />
  <d:ToolPinnedControl Orientation="Vertical" />
</Panel>

<StackPanel xmlns="https://github.com/ferroui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:FerroDock.Model.Core;assembly=FerroDock.Model"
    x:DataType="core:IFactory">
  <TextBlock Text="{Binding CurrentDockable.Title}" />
  <CheckBox IsChecked="{Binding HideDocumentsOnClose, Mode=TwoWay}" />
  <TextBlock Text="{Binding ContextLocator.Count}" />
</StackPanel>

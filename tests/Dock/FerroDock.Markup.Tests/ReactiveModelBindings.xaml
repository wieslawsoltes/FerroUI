<StackPanel xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:m="clr-namespace:FerroDock.Model.ReactiveUI.Controls;assembly=FerroDock.Model.ReactiveUI"
 x:CompileBindings="True" x:DataType="m:Document">
 <TextBlock Text="{Binding Title}" />
 <TextBox Text="{Binding Title, Mode=TwoWay}" />
 <CheckBox IsChecked="{Binding IsOpen, Mode=TwoWay}" />
</StackPanel>

<Panel xmlns="https://github.com/ferroui"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:d="using:FerroDock.Ferro.Controls"
       x:DataType="Panel" x:CompileBindings="True">
  <Panel.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="ferres://FerroDock.Ferro.Themes.Fluent/Accents/Fluent.xaml" />
        <ResourceInclude Source="ferres://FerroDock.Ferro.Themes.Fluent/Controls/DockTarget.xaml" />
        <ResourceInclude Source="ferres://FerroDock.Ferro.Themes.Fluent/Controls/GlobalDockTarget.xaml" />
        <ResourceInclude Source="ferres://FerroDock.Ferro.Themes.Fluent/Controls/DockAdornerWindow.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Panel.Resources>
  <d:DockTarget Name="LocalTarget" x:DataType="d:DockTarget" />
  <d:GlobalDockTarget Name="GlobalTarget" x:DataType="d:GlobalDockTarget" />
</Panel>

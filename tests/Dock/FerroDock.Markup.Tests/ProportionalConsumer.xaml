<p:ProportionalStackPanel xmlns="https://github.com/ferroui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:p="using:FerroDock.Controls.ProportionalStackPanel"
                          x:CompileBindings="True"
                          x:DataType="p:ProportionalStackPanel"
                          Width="604" Height="100" Orientation="Horizontal">
  <p:ProportionalStackPanel.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="ferres://FerroDock.Controls.ProportionalStackPanel/ProportionalStackPanelSplitter.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Border x:Key="FirstModel" p:ProportionalStackPanel.Proportion="0.25" />
      <Border x:Key="SecondModel" p:ProportionalStackPanel.Proportion="0.75" />
    </ResourceDictionary>
  </p:ProportionalStackPanel.Resources>
  <Border x:DataType="Border" DataContext="{StaticResource FirstModel}"
          p:ProportionalStackPanel.Proportion="{Binding (p:ProportionalStackPanel.Proportion)}" />
  <p:ProportionalStackPanelSplitter />
  <Border x:DataType="Border" DataContext="{StaticResource SecondModel}"
          p:ProportionalStackPanel.Proportion="{Binding (p:ProportionalStackPanel.Proportion)}" />
</p:ProportionalStackPanel>

<Panel xmlns="https://github.com/ferroui"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:d="using:FerroDock.Ferro.Controls"
       Name="SourceRoot" x:DataType="d:ManagedWindowDock" x:CompileBindings="True">
  <Panel.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="ferres://FerroDock.Ferro.Themes.Fluent/Controls/ManagedWindowLayer.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Panel.Resources>
  <d:ManagedWindowLayer Name="Layer" Dock="{Binding #SourceRoot.DataContext}" />
</Panel>

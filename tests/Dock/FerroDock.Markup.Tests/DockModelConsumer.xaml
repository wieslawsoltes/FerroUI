<StackPanel xmlns="https://github.com/ferroui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:core="using:FerroDock.Model.Core"
            xmlns:dmc="using:FerroDock.Model.Controls"
            x:CompileBindings="True" x:DataType="dmc:IDocumentDock">
  <StackPanel.Resources>
    <core:DockCapabilityPolicy x:Key="Policy" CanClose="False" CanDrop="True" />
    <core:DockCapabilityOverrides x:Key="Overrides" CanDrag="False" />
    <core:Alignment x:Key="UnsetAlignment">Unset</core:Alignment>
  </StackPanel.Resources>
  <TextBlock Name="Title" Text="{Binding Title}" />
  <TextBlock Name="Count" Text="{Binding VisibleDockables.Count}" />
  <TextBlock Name="First" Text="{Binding VisibleDockables[0].Title}" />
  <TextBlock Name="Active" Text="{Binding ActiveDockable.Title}" />
  <TextBox Name="Empty" Text="{Binding EmptyContent, Mode=TwoWay}" />
  <CheckBox Name="Create" IsChecked="{Binding CanCreateDocument, Mode=TwoWay}" />
  <TextBlock Name="LayoutMode" Text="{Binding LayoutMode}" />
  <Button Name="Cascade" Command="{Binding CascadeDocuments}" />
</StackPanel>

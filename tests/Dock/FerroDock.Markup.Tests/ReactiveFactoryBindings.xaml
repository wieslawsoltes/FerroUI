<StackPanel xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:m="clr-namespace:FerroDock.Model.ReactiveUI;assembly=FerroDock.Model.ReactiveUI"
 x:CompileBindings="True" x:DataType="m:Factory">
 <CheckBox IsChecked="{Binding HideToolsOnClose, Mode=TwoWay}" />
 <CheckBox IsChecked="{Binding HideDocumentsOnClose, Mode=TwoWay}" />
 <TextBlock Text="{Binding VisibleRootControls.Count}" />
 <TextBlock Text="{Binding DockControls.Count}" />
 <TextBlock Text="{Binding HostWindows.Count}" />
</StackPanel>

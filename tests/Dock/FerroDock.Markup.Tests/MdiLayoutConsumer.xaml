<Panel xmlns="https://github.com/ferroui"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:d="using:FerroDock.Ferro.Controls"
       xmlns:m="using:FerroDock.Ferro.Mdi"
       x:DataType="Panel" x:CompileBindings="True">
  <Panel.Resources>
    <m:MdiResizeDirection x:Key="CornerDirection">Left, Top</m:MdiResizeDirection>
  </Panel.Resources>
  <d:MdiLayoutPanel Name="DefaultManager" x:DataType="d:MdiLayoutPanel" />
  <d:MdiLayoutPanel Name="ConstructedManager" x:DataType="d:MdiLayoutPanel">
    <d:MdiLayoutPanel.LayoutManager>
      <m:ClassicMdiLayoutManager />
    </d:MdiLayoutPanel.LayoutManager>
  </d:MdiLayoutPanel>
  <d:MdiLayoutPanel Name="SharedManager" x:DataType="d:MdiLayoutPanel"
                    LayoutManager="{x:Static m:ClassicMdiLayoutManager.Instance}" />
  <d:MdiLayoutPanel Name="FallbackManager" x:DataType="d:MdiLayoutPanel"
                    LayoutManager="{x:Null}" />
</Panel>

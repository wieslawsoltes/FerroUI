<StackPanel xmlns="https://github.com/ferroui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="using:FerroDock.Ferro.Controls"
            xmlns:deferred="using:FerroDock.Controls.DeferredContentControl"
            xmlns:recycling="using:FerroUI.Controls.Recycling"
            x:DataType="d:ManagedDockWindowDocument" x:CompileBindings="True">
  <StackPanel.Resources>
    <DataTemplate x:Key="DeferredManagedBody" x:DataType="x:Object">
      <Button Content="Compiled managed body" />
    </DataTemplate>
  </StackPanel.Resources>
  <TextBlock Name="ManagedTitle" Text="{Binding Title}" />
  <TextBox Name="ManagedEditor" Text="{Binding Title, Mode=TwoWay}" />
  <TextBlock Name="ManagedZIndex" Text="{Binding MdiZIndex}" />
  <!-- Original MdiDocumentWindow content fragment, using its source recycling pipeline. -->
  <deferred:DeferredContentControl Name="ManagedBody" Content="{Binding}"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <deferred:DeferredContentControl.ContentTemplate>
      <recycling:ControlRecyclingDataTemplate Parent="{Binding #ManagedBody}" />
    </deferred:DeferredContentControl.ContentTemplate>
  </deferred:DeferredContentControl>
  <d:MdiDocumentWindow Name="ManagedFrame" MdiState="{Binding MdiState, Mode=TwoWay}"
                       IsActive="False" HeaderTemplate="{StaticResource DeferredManagedBody}" />
</StackPanel>

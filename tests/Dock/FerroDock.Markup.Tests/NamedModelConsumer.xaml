<StackPanel xmlns="https://github.com/ferroui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:t="using:FerroDock.Markup.Tests" x:CompileBindings="True">
  <ContentControl>
    <t:NamedDocument x:Name="Document" Title="Named engine document" />
  </ContentControl>
  <Border Tag="{Reference Document}" />
  <TextBlock Text="{Binding #Document.Title}" />
</StackPanel>

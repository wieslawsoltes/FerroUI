<StackPanel xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:m="clr-namespace:FerroDock.Model.Controls;assembly=FerroDock.Model" x:DataType="m:IDocumentDock">
<TextBox Text="{Binding Title, Mode=TwoWay}"/><ContentControl Content="{Binding EmptyContent}"/><CheckBox IsChecked="{Binding CanCreateDocument, Mode=TwoWay}"/><Button Command="{Binding AddDocument}" CommandParameter="{Binding DefaultDockable}"/>
</StackPanel>

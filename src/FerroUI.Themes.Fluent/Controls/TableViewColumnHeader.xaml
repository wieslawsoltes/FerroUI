<ResourceDictionary xmlns="https://github.com/ferroui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">

  <Design.PreviewWith>
    <Border Margin="20" BorderThickness="1" BorderBrush="LightGray">
      <TableViewColumnHeader Content="Header" />
    </Border>
  </Design.PreviewWith>

  <x:Double x:Key="TableViewColumnResizerWidth">12</x:Double>
  <Thickness x:Key="TableViewColumnResizerMargin">0,-9,-6,-12</Thickness>

  <ControlTemplate x:Key="TableViewColumnHeaderResizerTemplate" TargetType="Thumb">
    <Border Background="Transparent">
      <Rectangle Width="1"
                 Fill="{DynamicResource TableViewColumnHeaderSeparatorBackground}"
                 HorizontalAlignment="Center" />
    </Border>
  </ControlTemplate>

  <ControlTheme x:Key="{x:Type TableViewColumnHeader}" TargetType="TableViewColumnHeader">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="{DynamicResource TableViewCellPadding}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Content="{TemplateBinding Content}"
                            Padding="{TemplateBinding Padding}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
          <!-- The sort indicator (WinUI): shown while the rows are sorted by the column. -->
          <Path Name="PART_SortIndicator"
                Width="10"
                Height="5"
                Margin="0,0,12,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Stretch="None"
                Stroke="{TemplateBinding Foreground}"
                StrokeThickness="1"
                IsHitTestVisible="False"
                IsVisible="False" />
          <Thumb Name="PART_Resizer"
                 Template="{StaticResource TableViewColumnHeaderResizerTemplate}"
                 Width="{DynamicResource TableViewColumnResizerWidth}"
                 HorizontalAlignment="Right"
                 Cursor="SizeWestEast"
                 Margin="{DynamicResource TableViewColumnResizerMargin}"
                 IsEnabled="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Column?.CanUserEffectivelyResize, FallbackValue=False}">
          </Thumb>
        </Panel>
      </ControlTemplate>
    </Setter>
    <!-- Sorting (WinUI): the indicator of the direction. -->
    <Style Selector="^:sortascending /template/ Path#PART_SortIndicator">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Data" Value="M 0,5 L 5,0 L 10,5" />
    </Style>
    <Style Selector="^:sortdescending /template/ Path#PART_SortIndicator">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Data" Value="M 0,0 L 5,5 L 10,0" />
    </Style>
  </ControlTheme>

</ResourceDictionary>

// The amounts are `ScrollAmount` of the automation contracts of the controls (the values of the
// system: large decrement, small decrement, no amount, large increment, small increment).
[uuid(b38b8077-1fc3-42a5-8cae-d40c2215055a)]
interface IScrollProvider : IUnknown
{
    HRESULT Scroll([in] int horizontalAmount, [in] int verticalAmount);
    HRESULT SetScrollPercent([in] double horizontalPercent, [in] double verticalPercent);
    HRESULT GetHorizontalScrollPercent([out, retval] double* pRetVal);
    HRESULT GetVerticalScrollPercent([out, retval] double* pRetVal);
    HRESULT GetHorizontalViewSize([out, retval] double* pRetVal);
    HRESULT GetVerticalViewSize([out, retval] double* pRetVal);
    HRESULT GetHorizontallyScrollable([out, retval] BOOL* pRetVal);
    HRESULT GetVerticallyScrollable([out, retval] BOOL* pRetVal);
}

[uuid(2360c714-4bf1-4b26-ba65-9b21316127eb)]
interface IScrollItemProvider : IUnknown
{
    HRESULT ScrollIntoView();
}


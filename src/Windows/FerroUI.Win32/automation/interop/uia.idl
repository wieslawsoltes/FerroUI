}

enum SynchronizedInputType
{
    KeyUp = 0x01,
    KeyDown = 0x02,
    MouseLeftButtonUp = 0x04,
    MouseLeftButtonDown = 0x08,
    MouseRightButtonUp = 0x10,
    MouseRightButtonDown = 0x20
}

enum RowOrColumnMajor
{
    RowMajor,
    ColumnMajor,
    Indeterminate
}

enum SupportedTextSelection
{
    None,
    Single,
    Multiple
}

// SDK TextEdit causes; WinUI's exposed enum ends at CompositionFinalized.
enum TextEditChangeType
{
    None = 0,
    AutoCorrect = 1,
    Composition = 2,
    CompositionFinalized = 3,
    AutoComplete = 4
}

enum TextPatternRangeEndpoint
{
    Start = 0,
    End = 1
}

enum TextUnit
{
    Character = 0,
    Format = 1,
    Word = 2,
    Line = 3,
    Paragraph = 4,
    Page = 5,
    Document = 6
}

enum WindowVisualState
{
    Normal,
    Maximized,
    Minimized
}

enum WindowInteractionState
{
    Running,
    Closing,
    ReadyForUserInteraction,
    BlockedByModalWindow,
    NotResponding
}

// `UiaRect` of the system: the bounding rectangle of a fragment in screen coordinates.
struct UiaRect
{
    double left;
    double top;
    double width;
    double height;
}

// `UiaPoint` of the system.
struct UiaPoint
{
    double x;
    double y;
}

[uuid(d6dd68d1-86fd-4332-8666-9abedea2d24c)]
interface IRawElementProviderSimple : IUnknown
{
    HRESULT GetProviderOptions([out, retval] ProviderOptions* pRetVal);
    HRESULT GetPatternProvider([in] int patternId, [out, retval] IUnknown** pRetVal);
    HRESULT GetPropertyValue([in] int propertyId, [out, retval] VARIANT* pRetVal);
    HRESULT GetHostRawElementProvider([out, retval] IRawElementProviderSimple** pRetVal);
}

[uuid(a0a839a9-8da1-4a82-806a-8e0d44e79f56)]
interface IRawElementProviderSimple2 : IRawElementProviderSimple
{
    HRESULT ShowContextMenu();
}

[uuid(f7063da8-8359-439c-9297-bbc5299a7d87)]
interface IRawElementProviderFragment : IUnknown
{
    HRESULT Navigate([in] NavigateDirection direction, [out, retval] IRawElementProviderFragment** pRetVal);
    HRESULT GetRuntimeId([out, retval] SAFEARRAY_PTR* pRetVal);
    HRESULT GetBoundingRectangle([out, retval] UiaRect* pRetVal);
    HRESULT GetEmbeddedFragmentRoots([out, retval] SAFEARRAY_PTR* pRetVal);
    HRESULT SetFocus();
    HRESULT GetFragmentRoot([out, retval] IRawElementProviderFragmentRoot** pRetVal);
}

[uuid(620ce2a5-ab8f-40a9-86cb-de3c75599b58)]
interface IRawElementProviderFragmentRoot : IUnknown
{
    HRESULT ElementProviderFromPoint([in] double x, [in] double y, [out, retval] IRawElementProviderFragment** pRetVal);
    HRESULT GetFocus([out, retval] IRawElementProviderFragment** pRetVal);
}

[uuid(a407b27b-0f6d-4427-9292-473c7bf93258)]

    HRESULT GetMaximizable([out, retval] BOOL* pRetVal);
    HRESULT GetMinimizable([out, retval] BOOL* pRetVal);
    HRESULT GetIsModal([out, retval] BOOL* pRetVal);
    HRESULT GetVisualState([out, retval] WindowVisualState* pRetVal);
    HRESULT GetInteractionState([out, retval] WindowInteractionState* pRetVal);
    HRESULT GetIsTopmost([out, retval] BOOL* pRetVal);
}

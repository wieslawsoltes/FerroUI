<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  The application manifest of the example. It names the versions of Windows the example
  supports: without the entries for Windows 8 and later the system treats the process as one
  written for Windows 7, and then refuses, among other things, a child window with the layered
  style, which the native control host creates under a window without a redirection bitmap
  (a window of a composition mode). An application of the backend needs the same entries.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="FerroUI.Win32.Example" version="1.0.0.0"/>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 7 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
      <!-- Windows 8 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>

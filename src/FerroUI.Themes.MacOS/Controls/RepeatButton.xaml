<!--
  macOS 26 control theme, adapted from the FerroUI WinUI template foundation.
  Foundation: microsoft-ui-xaml 7e4b0c2096be402f51cc8f7d203ebf67cff183d0.
  Copyright (c) Microsoft Corporation. MIT License; see NOTICE.md.
  macOS geometry and states are theme calibrations against Apple's WWDC25
  AppKit design guidance; exact native rendering remains a comparison gate.
  FerroUI template parts, bindings and routed interaction are preserved.
-->
<ResourceDictionary xmlns="https://github.com/ferroui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Padding="20">
      <StackPanel Spacing="20">
        <RepeatButton Content="Repeat" />
        <RepeatButton IsEnabled="False" Content="Disabled" />
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <ControlTheme x:Key="DefaultRepeatButtonStyle" TargetType="RepeatButton">
    <Setter Property="MinHeight" Value="{DynamicResource MacOSControlHeight}" />
    <!-- The defaults of a WinUI 3 control, which its style leaves unset and its template binds
         (FerroUI's defaults are Stretch). Deviation (winui-theme/DEVIATIONS.md, G-27). -->
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource RepeatButtonBackground}" />
    <Setter Property="BackgroundSizing" Value="InnerBorderEdge" />
    <Setter Property="Foreground" Value="{DynamicResource RepeatButtonForeground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RepeatButtonBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource ButtonBorderThemeThickness}" />
    <Setter Property="Padding" Value="{DynamicResource MacOSControlPadding}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
    <Setter Property="CornerRadius" Value="{DynamicResource MacOSControlCornerRadius}" />
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border IsHitTestVisible="False" Margin="-3" BorderThickness="3"
                BorderBrush="{DynamicResource MacOSFocusBrush}"
                CornerRadius="{DynamicResource MacOSControlCornerRadius}" />
      </FocusAdornerTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter x:Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          Foreground="{TemplateBinding Foreground}"
                          BackgroundSizing="{TemplateBinding BackgroundSizing}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Padding="{TemplateBinding Padding}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                          RecognizesAccessKey="True">
          <ContentPresenter.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="{DynamicResource MacOSMotionFastDuration}" />
            </Transitions>
          </ContentPresenter.Transitions>
        </ContentPresenter>
      </ControlTemplate>
    </Setter>

    <!-- PointerOver -->
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RepeatButtonBackgroundPointerOver}" />
      <Setter Property="BorderBrush" Value="{DynamicResource RepeatButtonBorderBrushPointerOver}" />
      <Setter Property="Foreground" Value="{DynamicResource RepeatButtonForegroundPointerOver}" />
    </Style>
    <!-- Pressed -->
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RepeatButtonBackgroundPressed}" />
      <Setter Property="BorderBrush" Value="{DynamicResource RepeatButtonBorderBrushPressed}" />
      <Setter Property="Foreground" Value="{DynamicResource RepeatButtonForegroundPressed}" />
    </Style>
    <!-- Disabled -->
    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RepeatButtonBackgroundDisabled}" />
      <Setter Property="BorderBrush" Value="{DynamicResource RepeatButtonBorderBrushDisabled}" />
      <Setter Property="Foreground" Value="{DynamicResource RepeatButtonForegroundDisabled}" />
    </Style>

    <!-- macOS 26 mini/small/regular rectangles; large sizes use capsules. -->
    <Style Selector="^.mini">
      <Setter Property="MinHeight" Value="18" />
      <Setter Property="Padding" Value="7,1" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="FocusAdorner">
        <FocusAdornerTemplate>
          <Border IsHitTestVisible="False" Margin="-3" BorderThickness="3"
                  BorderBrush="{DynamicResource MacOSFocusBrush}" CornerRadius="4" />
        </FocusAdornerTemplate>
      </Setter>
    </Style>
    <Style Selector="^.small">
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="FocusAdorner">
        <FocusAdornerTemplate>
          <Border IsHitTestVisible="False" Margin="-3" BorderThickness="3"
                  BorderBrush="{DynamicResource MacOSFocusBrush}" CornerRadius="5" />
        </FocusAdornerTemplate>
      </Setter>
    </Style>
    <Style Selector="^.large">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="15,5" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="FocusAdorner">
        <FocusAdornerTemplate>
          <Border IsHitTestVisible="False" Margin="-3" BorderThickness="3"
                  BorderBrush="{DynamicResource MacOSFocusBrush}" CornerRadius="999" />
        </FocusAdornerTemplate>
      </Setter>
    </Style>
    <Style Selector="^.extra-large">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Padding" Value="19,7" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="FocusAdorner">
        <FocusAdornerTemplate>
          <Border IsHitTestVisible="False" Margin="-3" BorderThickness="3"
                  BorderBrush="{DynamicResource MacOSFocusBrush}" CornerRadius="999" />
        </FocusAdornerTemplate>
      </Setter>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type RepeatButton}" TargetType="RepeatButton" BasedOn="{StaticResource DefaultRepeatButtonStyle}" />
</ResourceDictionary>

  Copyright (c) Microsoft Corporation. Licensed under the MIT License (see NOTICE.md of the crate).

  Translation notes (docs/porting/winui-theme.md, section 4): ContentPresenter is
  PART_ContentPresenter and RefreshVisualizerPresenter PART_RefreshVisualizerPresenter, the parts
  of FerroUI's RefreshContainer (the control puts its visualizer into the presenter grid). The
  FerroUI contract: the content presenter also takes the ContentTemplate, the padding, the border
  and the content alignments of the control, as in the Fluent theme.
-->
<ResourceDictionary xmlns="https://github.com/ferroui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">
  <ControlTheme x:Key="DefaultRefreshContainerStyle" TargetType="RefreshContainer">
    <Setter Property="Foreground" Value="{DynamicResource RefreshContainerForegroundBrush}" />
    <Setter Property="Background" Value="{DynamicResource RefreshContainerBackgroundBrush}" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid x:Name="Root" Background="{TemplateBinding Background}">
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BackgroundSizing="InnerBorderEdge"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Background="Transparent" />
          <Grid x:Name="PART_RefreshVisualizerPresenter" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type RefreshContainer}" TargetType="RefreshContainer" BasedOn="{StaticResource DefaultRefreshContainerStyle}" />
</ResourceDictionary>

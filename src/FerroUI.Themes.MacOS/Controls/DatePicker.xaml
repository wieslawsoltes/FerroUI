  Geometry and timing are calibrated theme values, pending native capture.
  FerroUI template parts, keyboard handling, editing and popup contracts are preserved.
-->
<ResourceDictionary xmlns="https://github.com/ferroui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Padding="20" Height="500">
      <StackPanel Spacing="20" VerticalAlignment="Center">
        <DatePicker />
        <DatePicker IsEnabled="False" />
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <!-- DatePickerFlyoutButtonStyle of the template of DefaultDatePickerStyle. -->
  <ControlTheme x:Key="DatePickerFlyoutButtonStyle" TargetType="Button">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border Margin="-3" BorderThickness="3" IsHitTestVisible="False"
                BorderBrush="{DynamicResource MacOSFocusBrush}"
                CornerRadius="{DynamicResource MacOSControlCornerRadius}" />
      </FocusAdornerTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            Foreground="{TemplateBinding Foreground}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BackgroundSizing="InnerBorderEdge"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Content="{TemplateBinding Content}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            CornerRadius="{TemplateBinding CornerRadius}" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- PointerOver -->
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DatePickerButtonBackgroundPointerOver}" />
      <Setter Property="Foreground" Value="{DynamicResource DatePickerButtonForegroundPointerOver}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DatePickerButtonBorderBrushPointerOver}" />
    </Style>
    <!-- Pressed -->
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DatePickerButtonBackgroundPressed}" />
      <Setter Property="Foreground" Value="{DynamicResource DatePickerButtonForegroundPressed}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DatePickerButtonBorderBrushPressed}" />
    </Style>
    <!-- Disabled -->
    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DatePickerButtonBackgroundDisabled}" />
      <Setter Property="Foreground" Value="{DynamicResource DatePickerButtonForegroundDisabled}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DatePickerButtonBorderBrushDisabled}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="DefaultDatePickerStyle" TargetType="DatePicker">
    <!-- The defaults of a WinUI 3 control, which its style leaves unset and its template binds
         (FerroUI's defaults are Stretch). Deviation (winui-theme/DEVIATIONS.md, G-27). -->
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
    <Setter Property="Background" Value="{DynamicResource DatePickerButtonBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource DatePickerButtonForeground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DatePickerButtonBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource DatePickerBorderThemeThickness}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <!-- MinWidth and MaxWidth of the flyout button in the source, bound to it from the control. -->
    <Setter Property="MinWidth" Value="{DynamicResource DatePickerThemeMinWidth}" />
    <Setter Property="MinHeight" Value="{DynamicResource MacOSControlHeight}" />
    <Setter Property="MaxWidth" Value="{StaticResource DatePickerThemeMaxWidth}" />
    <!-- UseSystemFocusVisuals with FocusVisualMargin="-3", around the flyout button. -->
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border IsHitTestVisible="False" Margin="-3" BorderThickness="3"
                BorderBrush="{DynamicResource MacOSFocusBrush}"
                CornerRadius="{DynamicResource MacOSControlCornerRadius}" />
      </FocusAdornerTemplate>
    </Setter>
    <Setter Property="CornerRadius" Value="{DynamicResource MacOSControlCornerRadius}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The errors of FerroUI's data validation under the control (DataValidationErrors.xaml). -->
        <DataValidationErrors>
          <Grid x:Name="LayoutRoot" Margin="{TemplateBinding Padding}">
            <Button x:Name="PART_FlyoutButton"
                    Theme="{StaticResource DatePickerFlyoutButtonStyle}"
                    Background="{TemplateBinding Background}"
                    Foreground="{TemplateBinding Foreground}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    IsEnabled="{TemplateBinding IsEnabled}"
                    MinWidth="{TemplateBinding MinWidth}"
                    MinHeight="{TemplateBinding MinHeight}"
                    MaxWidth="{TemplateBinding MaxWidth}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Top"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    TemplatedControl.IsTemplateFocusTarget="True">
              <Grid x:Name="PART_ButtonContentGrid" ColumnDefinitions="78*,Auto,132*,Auto,78*">
                <TextBlock x:Name="PART_DayTextBlock"
                           Text="day"
                           TextAlignment="Center"
                           Padding="{DynamicResource DatePickerHostPadding}"
                           FontFamily="{TemplateBinding FontFamily}"
                           FontWeight="{TemplateBinding FontWeight}"
                           FontSize="{TemplateBinding FontSize}" />
                <TextBlock x:Name="PART_MonthTextBlock"
                           Text="month"
                           TextAlignment="Left"
                           Padding="{DynamicResource DatePickerHostMonthPadding}"
                           Margin="1,0,0,0"
                           FontFamily="{TemplateBinding FontFamily}"
                           FontWeight="{TemplateBinding FontWeight}"
                           FontSize="{TemplateBinding FontSize}" />
                <TextBlock x:Name="PART_YearTextBlock"
                           Text="year"
                           TextAlignment="Center"
                           Padding="{DynamicResource DatePickerHostPadding}"
                           FontFamily="{TemplateBinding FontFamily}"
                           FontWeight="{TemplateBinding FontWeight}"
                           FontSize="{TemplateBinding FontSize}" />
                <Rectangle x:Name="PART_FirstSpacer"
                           Fill="{DynamicResource DatePickerSpacerFill}"
                           HorizontalAlignment="Center"
                           Width="{DynamicResource DatePickerSpacerThemeWidth}"
                           Grid.Column="1" />
                <Rectangle x:Name="PART_SecondSpacer"
                           Fill="{DynamicResource DatePickerSpacerFill}"
                           HorizontalAlignment="Center"
                           Width="{DynamicResource DatePickerSpacerThemeWidth}"
                           Grid.Column="3" />
              </Grid>
            </Button>
            <Popup x:Name="PART_Popup"
                   WindowManagerAddShadowHint="False"
                   IsLightDismissEnabled="True"
                   PlacementTarget="{TemplateBinding}"
                   Placement="Bottom">
              <DatePickerPresenter x:Name="PART_PickerPresenter" Margin="{StaticResource ThemeShadowFlyoutMargin}" />
            </Popup>
          </Grid>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>

    <!-- The vertical alignment of the texts (FerroUI's VerticalContentAlignment of the control). -->
    <Style Selector="^ /template/ Button#PART_FlyoutButton TextBlock">
      <Setter Property="VerticalAlignment" Value="{TemplateBinding VerticalContentAlignment}" />
    </Style>
    <!-- Disabled -->
    <Style Selector="^:disabled">
      <Style Selector="^ /template/ Rectangle#PART_FirstSpacer">
        <Setter Property="Fill" Value="{DynamicResource DatePickerSpacerFillDisabled}" />
      </Style>
      <Style Selector="^ /template/ Rectangle#PART_SecondSpacer">
        <Setter Property="Fill" Value="{DynamicResource DatePickerSpacerFillDisabled}" />
      </Style>
    </Style>
    <!-- HasNoDate -->
    <Style Selector="^:hasnodate /template/ Button#PART_FlyoutButton">
      <Setter Property="Foreground" Value="{DynamicResource DatePickerButtonForegroundDefault}" />
    </Style>
    <!-- Not in WinUI: the :error of FerroUI's data validation (as the text box). -->
    <Style Selector="^:error /template/ Button#PART_FlyoutButton">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type DatePicker}" TargetType="DatePicker" BasedOn="{StaticResource DefaultDatePickerStyle}" />

  <ControlTheme x:Key="DefaultDatePickerFlyoutPresenterStyle" TargetType="DatePickerPresenter">
    <!-- The shadow is drawn outside the bounds of the control: a templated control clips to its
         bounds unless its theme says otherwise (G-24). -->
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Width" Value="296" />
    <Setter Property="MinWidth" Value="296" />
    <Setter Property="MaxHeight" Value="398" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
    <Setter Property="Background" Value="{DynamicResource DatePickerFlyoutPresenterBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DatePickerFlyoutPresenterBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource DateTimeFlyoutBorderThickness}" />
    <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="Background"
                BoxShadow="{DynamicResource ThemeShadowFlyoutBoxShadow}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{DynamicResource DateTimeFlyoutBorderPadding}"
                MaxHeight="292">
          <Grid x:Name="ContentPanel" RowDefinitions="*,Auto">
            <Grid x:Name="PART_PickerContainer">
              <Grid.Styles>
                <Style Selector="DateTimePickerPanel > ListBoxItem">
                  <Setter Property="Theme" Value="{StaticResource DateTimePickerLoopingSelectorItemStyle}" />
                </Style>
              </Grid.Styles>
              <!-- The columns are set by the presenter. -->
              <Border x:Name="HighlightRect"
                      ZIndex="-1"
                      Background="{DynamicResource DatePickerFlyoutPresenterHighlightFill}"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      Grid.Column="0"
                      Grid.ColumnSpan="5"
                      VerticalAlignment="Center"
                      Height="{DynamicResource DatePickerFlyoutPresenterHighlightHeight}"
                      Margin="4,2,4,2"
                      IsHitTestVisible="False" />
              <Grid x:Name="PART_MonthHost">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden"
                              Template="{StaticResource ScrollViewerScrollBarlessTemplate}">
                  <DateTimePickerPanel x:Name="PART_MonthSelector"
                                       PanelType="Month"
                                       ItemHeight="{DynamicResource DatePickerFlyoutPresenterItemHeight}"
                                       ShouldLoop="True" />
                </ScrollViewer>
                <RepeatButton x:Name="PART_MonthUpButton" Theme="{StaticResource DateTimePickerLoopingSelectorUpButtonStyle}" />
                <RepeatButton x:Name="PART_MonthDownButton" Theme="{StaticResource DateTimePickerLoopingSelectorDownButtonStyle}" />
              </Grid>
              <Grid x:Name="PART_DayHost">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden"
                              Template="{StaticResource ScrollViewerScrollBarlessTemplate}">
                  <DateTimePickerPanel x:Name="PART_DaySelector"
                                       PanelType="Day"
                                       ItemHeight="{DynamicResource DatePickerFlyoutPresenterItemHeight}"
                                       ShouldLoop="True" />
                </ScrollViewer>
                <RepeatButton x:Name="PART_DayUpButton" Theme="{StaticResource DateTimePickerLoopingSelectorUpButtonStyle}" />
                <RepeatButton x:Name="PART_DayDownButton" Theme="{StaticResource DateTimePickerLoopingSelectorDownButtonStyle}" />
              </Grid>
              <Grid x:Name="PART_YearHost">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden"
                              Template="{StaticResource ScrollViewerScrollBarlessTemplate}">
                  <DateTimePickerPanel x:Name="PART_YearSelector"
                                       PanelType="Year"
                                       ItemHeight="{DynamicResource DatePickerFlyoutPresenterItemHeight}"
                                       ShouldLoop="False" />
                </ScrollViewer>
                <RepeatButton x:Name="PART_YearUpButton" Theme="{StaticResource DateTimePickerLoopingSelectorUpButtonStyle}" />
                <RepeatButton x:Name="PART_YearDownButton" Theme="{StaticResource DateTimePickerLoopingSelectorDownButtonStyle}" />
              </Grid>
              <Rectangle x:Name="PART_FirstSpacer"
                         ZIndex="10000"
                         Fill="{DynamicResource DatePickerFlyoutPresenterSpacerFill}"
                         HorizontalAlignment="Center"
                         Width="{DynamicResource DatePickerSpacerThemeWidth}"
                         Grid.Column="1" />
              <Rectangle x:Name="PART_SecondSpacer"
                         ZIndex="10000"
                         Fill="{DynamicResource DatePickerFlyoutPresenterSpacerFill}"
                         HorizontalAlignment="Center"
                         Width="{DynamicResource DatePickerSpacerThemeWidth}"
                         Grid.Column="3" />
            </Grid>
            <Grid x:Name="AcceptDismissHostGrid"
                  Grid.Row="1"
                  Height="{DynamicResource DatePickerFlyoutPresenterAcceptDismissHostGridHeight}"
                  ColumnDefinitions="*,*">
              <Rectangle Height="{DynamicResource DatePickerSpacerThemeWidth}"
                         VerticalAlignment="Top"
                         Fill="{DynamicResource DatePickerFlyoutPresenterSpacerFill}"
                         Grid.ColumnSpan="2" />
              <Button x:Name="PART_AcceptButton"
                      Grid.Column="0"
                      Theme="{StaticResource DateTimePickerFlyoutButtonStyle}"
                      FontSize="16"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      Margin="{StaticResource DatePickerFlyoutPresenterAcceptMargin}"
                      Padding="4">
                <!-- E8FB at 16 px. -->
                <Path Data="{StaticResource GlyphGeometryE8FB}"
                      Fill="{Binding $parent[Button].Foreground}"
                      Stretch="Uniform"
                      Width="14" />
              </Button>
              <Button x:Name="PART_DismissButton"
                      Grid.Column="1"
                      Theme="{StaticResource DateTimePickerFlyoutButtonStyle}"
                      FontSize="16"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      Margin="{StaticResource DatePickerFlyoutPresenterDismissMargin}"
                      Padding="4">
                <!-- E711 at 16 px. -->
                <Path Data="{StaticResource GlyphGeometryE711}"
                      Fill="{Binding $parent[Button].Foreground}"
                      Stretch="Uniform"
                      Width="12" />
              </Button>
            </Grid>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- PointerOver of DefaultLoopingSelectorStyle: the up and down buttons of the host under the pointer. -->
    <Style Selector="^ /template/ Grid#PART_MonthHost:pointerover > RepeatButton">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^ /template/ Grid#PART_DayHost:pointerover > RepeatButton">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^ /template/ Grid#PART_YearHost:pointerover > RepeatButton">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type DatePickerPresenter}" TargetType="DatePickerPresenter" BasedOn="{StaticResource DefaultDatePickerFlyoutPresenterStyle}" />
</ResourceDictionary>

     Acrylic backing is the portable fallback for native Liquid Glass. -->
<ResourceDictionary xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Width="400" Height="300">
      <SplitView DisplayMode="Inline" IsPaneOpen="True" OpenPaneLength="160">
        <SplitView.Pane>
          <TextBlock Text="The pane" Margin="12"/>
        </SplitView.Pane>
        <TextBlock Text="The content" Margin="12"/>
      </SplitView>
    </Border>
  </Design.PreviewWith>
  <ControlTheme x:Key="DefaultSplitViewStyle" TargetType="SplitView">
    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundTransparentBrush}"/>
    <Setter Property="BorderThickness" Value="0.5"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="OpenPaneLength" Value="{DynamicResource SplitViewOpenPaneThemeLength}"/>
    <Setter Property="CompactPaneLength" Value="{DynamicResource SplitViewCompactPaneThemeLength}"/>
    <Setter Property="PaneBackground" Value="Transparent"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="{TemplateBinding Background}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.PaneColumnGridLength}"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Panel Name="PART_PaneRoot" ClipToBounds="True" HorizontalAlignment="Left" ZIndex="1">
            <Border x:Name="PaneRoot" Width="{TemplateBinding OpenPaneLength}" HorizontalAlignment="Left" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BackgroundSizing="InnerBorderEdge" BorderThickness="0" CornerRadius="{TemplateBinding CornerRadius}">
              <Border.Transitions>
                <Transitions>
                  <BrushTransition Property="Background" Duration="{DynamicResource MacOSMotionStandardDuration}"/>
                </Transitions>
              </Border.Transitions>
              <Border Margin="6" Background="{TemplateBinding PaneBackground}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" BoxShadow="0 1 4 0 #14000000">
                <Panel>
                  <ExperimentalAcrylicBorder Material="{DynamicResource MacOSSidebarGlassMaterial}" IsHitTestVisible="False" CornerRadius="{TemplateBinding CornerRadius}"/>
                  <Panel>
                    <ContentPresenter x:Name="PART_PanePresenter" Content="{TemplateBinding Pane}" ContentTemplate="{TemplateBinding PaneTemplate}"/>
                    <Rectangle x:Name="HCPaneBorder" IsVisible="False" Fill="{DynamicResource SystemControlForegroundTransparentBrush}" Width="1" HorizontalAlignment="Right"/>
                  </Panel>
                </Panel>
              </Border>
            </Border>
          </Panel>
          <Panel x:Name="ContentRoot" Grid.Column="1">
            <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
            <Rectangle x:Name="LightDismissLayer" Fill="Transparent" IsVisible="False"/>
          </Panel>
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:left">
      <Style Selector="^:overlay">
        <Style Selector="^ /template/ Panel#PART_PaneRoot">
          <Setter Property="Grid.Column" Value="0"/>
          <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <Style Selector="^ /template/ Panel#ContentRoot">
          <Setter Property="Grid.Column" Value="0"/>
          <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
      </Style>
      <Style Selector="^:compactoverlay">
        <Style Selector="^ /template/ Panel#PART_PaneRoot">
          <Setter Property="Grid.Column" Value="0"/>
          <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
      </Style>
    </Style>
    <Style Selector="^:right">
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Background="{TemplateBinding Background}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.PaneColumnGridLength}"/>
            </Grid.ColumnDefinitions>
            <Panel Name="PART_PaneRoot" Grid.Column="1" ClipToBounds="True" HorizontalAlignment="Right" ZIndex="1">
              <Border x:Name="PaneRoot" Width="{TemplateBinding OpenPaneLength}" HorizontalAlignment="Right" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BackgroundSizing="InnerBorderEdge" BorderThickness="0" CornerRadius="{TemplateBinding CornerRadius}">
                <Border.Transitions>
                  <Transitions>
                    <BrushTransition Property="Background" Duration="{DynamicResource MacOSMotionStandardDuration}"/>
                  </Transitions>
                </Border.Transitions>
                <Border Margin="6" Background="{TemplateBinding PaneBackground}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" BoxShadow="0 1 4 0 #14000000">
                  <Panel>
                    <ExperimentalAcrylicBorder Material="{DynamicResource MacOSSidebarGlassMaterial}" IsHitTestVisible="False" CornerRadius="{TemplateBinding CornerRadius}"/>
                    <Panel>
                      <ContentPresenter x:Name="PART_PanePresenter" Content="{TemplateBinding Pane}" ContentTemplate="{TemplateBinding PaneTemplate}"/>
                      <Rectangle x:Name="HCPaneBorder" IsVisible="False" Fill="{DynamicResource SystemControlForegroundTransparentBrush}" Width="1" HorizontalAlignment="Left"/>
                    </Panel>
                  </Panel>
                </Border>
              </Border>
            </Panel>
            <Panel x:Name="ContentRoot" Grid.Column="0">
              <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
              <Rectangle x:Name="LightDismissLayer" Fill="Transparent" IsVisible="False"/>
            </Panel>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:overlay">
        <Style Selector="^ /template/ Panel#PART_PaneRoot">
          <Setter Property="Grid.Column" Value="0"/>
          <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <Style Selector="^ /template/ Panel#ContentRoot">
          <Setter Property="Grid.Column" Value="0"/>
          <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
      </Style>
      <Style Selector="^:compactoverlay">
        <Style Selector="^ /template/ Panel#PART_PaneRoot">
          <Setter Property="Grid.Column" Value="0"/>
          <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
      </Style>
    </Style>
    <Style Selector="^:top">
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Background="{TemplateBinding Background}">
            <Grid.RowDefinitions>
              <RowDefinition Height="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.PaneRowGridLength}"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Panel Name="PART_PaneRoot" ClipToBounds="True" VerticalAlignment="Top" ZIndex="1">
              <Border x:Name="PaneRoot" Height="{TemplateBinding OpenPaneLength}" VerticalAlignment="Top" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BackgroundSizing="InnerBorderEdge" BorderThickness="0" CornerRadius="{TemplateBinding CornerRadius}">
                <Border.Transitions>
                  <Transitions>
                    <BrushTransition Property="Background" Duration="{DynamicResource MacOSMotionStandardDuration}"/>
                  </Transitions>
                </Border.Transitions>
                <Border Margin="6" Background="{TemplateBinding PaneBackground}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" BoxShadow="0 1 4 0 #14000000">
                  <Panel>
                    <ExperimentalAcrylicBorder Material="{DynamicResource MacOSSidebarGlassMaterial}" IsHitTestVisible="False" CornerRadius="{TemplateBinding CornerRadius}"/>
                    <Panel>
                      <ContentPresenter x:Name="PART_PanePresenter" Content="{TemplateBinding Pane}" ContentTemplate="{TemplateBinding PaneTemplate}"/>
                      <Rectangle x:Name="HCPaneBorder" IsVisible="False" Fill="{DynamicResource SystemControlForegroundTransparentBrush}" Height="1" VerticalAlignment="Bottom"/>
                    </Panel>
                  </Panel>
                </Border>
              </Border>
            </Panel>
            <Panel x:Name="ContentRoot" Grid.Row="1">
              <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
              <Rectangle x:Name="LightDismissLayer" Fill="Transparent" IsVisible="False"/>
            </Panel>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:overlay">
        <Style Selector="^ /template/ Panel#PART_PaneRoot">
          <Setter Property="Grid.Row" Value="0"/>
          <Setter Property="Grid.RowSpan" Value="2"/>
        </Style>
        <Style Selector="^ /template/ Panel#ContentRoot">
          <Setter Property="Grid.Row" Value="0"/>
          <Setter Property="Grid.RowSpan" Value="2"/>
        </Style>
      </Style>
      <Style Selector="^:compactoverlay">
        <Style Selector="^ /template/ Panel#PART_PaneRoot">
          <Setter Property="Grid.Row" Value="0"/>
          <Setter Property="Grid.RowSpan" Value="2"/>
        </Style>
      </Style>
    </Style>
    <Style Selector="^:bottom">
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Background="{TemplateBinding Background}">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.PaneRowGridLength}"/>
            </Grid.RowDefinitions>
            <Panel Name="PART_PaneRoot" Grid.Row="1" ClipToBounds="True" VerticalAlignment="Bottom" ZIndex="1">
              <Border x:Name="PaneRoot" Height="{TemplateBinding OpenPaneLength}" VerticalAlignment="Bottom" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BackgroundSizing="InnerBorderEdge" BorderThickness="0" CornerRadius="{TemplateBinding CornerRadius}">
                <Border.Transitions>
                  <Transitions>
                    <BrushTransition Property="Background" Duration="{DynamicResource MacOSMotionStandardDuration}"/>
                  </Transitions>
                </Border.Transitions>
                <Border Margin="6" Background="{TemplateBinding PaneBackground}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" BoxShadow="0 1 4 0 #14000000">
                  <Panel>
                    <ExperimentalAcrylicBorder Material="{DynamicResource MacOSSidebarGlassMaterial}" IsHitTestVisible="False" CornerRadius="{TemplateBinding CornerRadius}"/>
                    <Panel>
                      <ContentPresenter x:Name="PART_PanePresenter" Content="{TemplateBinding Pane}" ContentTemplate="{TemplateBinding PaneTemplate}"/>
                      <Rectangle x:Name="HCPaneBorder" IsVisible="False" Fill="{DynamicResource SystemControlForegroundTransparentBrush}" Height="1" VerticalAlignment="Top"/>
                    </Panel>
                  </Panel>
                </Border>
              </Border>
            </Panel>
            <Panel x:Name="ContentRoot" Grid.Row="0">
              <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
              <Rectangle x:Name="LightDismissLayer" Fill="Transparent" IsVisible="False"/>
            </Panel>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:overlay">
        <Style Selector="^ /template/ Panel#PART_PaneRoot">
          <Setter Property="Grid.Row" Value="0"/>
          <Setter Property="Grid.RowSpan" Value="2"/>
        </Style>
        <Style Selector="^ /template/ Panel#ContentRoot">
          <Setter Property="Grid.Row" Value="0"/>
          <Setter Property="Grid.RowSpan" Value="2"/>
        </Style>
      </Style>
      <Style Selector="^:compactoverlay">
        <Style Selector="^ /template/ Panel#PART_PaneRoot">
          <Setter Property="Grid.Row" Value="0"/>
          <Setter Property="Grid.RowSpan" Value="2"/>
        </Style>
      </Style>
    </Style>
    <Style Selector="^:left:open /template/ Panel#PART_PaneRoot, ^:right:open /template/ Panel#PART_PaneRoot">
      <Setter Property="Width" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=OpenPaneLength}"/>
    </Style>
    <Style Selector="^:left:closed /template/ Panel#PART_PaneRoot, ^:right:closed /template/ Panel#PART_PaneRoot">
      <Setter Property="Width" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.ClosedPaneWidth}"/>
    </Style>
    <Style Selector="^:top:open /template/ Panel#PART_PaneRoot, ^:bottom:open /template/ Panel#PART_PaneRoot">
      <Setter Property="Height" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=OpenPaneLength}"/>
    </Style>
    <Style Selector="^:top:closed /template/ Panel#PART_PaneRoot, ^:bottom:closed /template/ Panel#PART_PaneRoot">
      <Setter Property="Height" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.ClosedPaneHeight}"/>
    </Style>
    <Style Selector="^:inline:open /template/ Panel#PART_PaneRoot, ^:compactinline:open /template/ Panel#PART_PaneRoot">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="{DynamicResource MacOSMotionStandardDuration}" Easing="CubicEaseOut"/>
          <DoubleTransition Property="Height" Duration="{DynamicResource MacOSMotionStandardDuration}" Easing="CubicEaseOut"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^:inline:closed /template/ Panel#PART_PaneRoot, ^:compactinline:closed /template/ Panel#PART_PaneRoot">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="{DynamicResource MacOSMotionStandardDuration}" Easing="CubicEaseOut"/>
          <DoubleTransition Property="Height" Duration="{DynamicResource MacOSMotionStandardDuration}" Easing="CubicEaseOut"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^:overlay:open /template/ Panel#PART_PaneRoot, ^:compactoverlay:open /template/ Panel#PART_PaneRoot">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="{DynamicResource MacOSMotionStandardDuration}" Easing="CubicEaseOut"/>
          <DoubleTransition Property="Height" Duration="{DynamicResource MacOSMotionStandardDuration}" Easing="CubicEaseOut"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^:overlay:closed /template/ Panel#PART_PaneRoot, ^:compactoverlay:closed /template/ Panel#PART_PaneRoot">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="{DynamicResource MacOSMotionStandardDuration}" Easing="CubicEaseOut"/>
          <DoubleTransition Property="Height" Duration="{DynamicResource MacOSMotionStandardDuration}" Easing="CubicEaseOut"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^:overlay:open /template/ Rectangle#LightDismissLayer, ^:compactoverlay:open /template/ Rectangle#LightDismissLayer">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^:lightDismiss /template/ Rectangle#LightDismissLayer">
      <Setter Property="Fill" Value="{DynamicResource SplitViewLightDismissOverlayBackground}"/>
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type SplitView}" TargetType="SplitView" BasedOn="{StaticResource DefaultSplitViewStyle}"/>
</ResourceDictionary>

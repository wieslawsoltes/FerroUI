<!-- macOS 26 theme: the control theme of the WinUI theme (src/FerroUI.Themes.WinUI/Controls/AnnotatedScrollBar.xaml),
     as docs/porting/macos26-theme.md derives every control theme of the WinUI theme; the resources are this theme's. -->
<!--
  Ported from microsoft-ui-xaml (https://github.com/microsoft/microsoft-ui-xaml),
  commit 7e4b0c2096be402f51cc8f7d203ebf67cff183d0:
    controls/dev/AnnotatedScrollBar/AnnotatedScrollBar.xaml and the ScrollButtonStyle of
    AnnotatedScrollBar_themeresources.xaml (its other resources are
    Resources/AnnotatedScrollBar_themeresources.xaml)
  Copyright (c) Microsoft Corporation. Licensed under the MIT License (see NOTICE.md of the crate).

  Translation notes (docs/porting/winui-theme.md, section 4; docs/porting/winui-controls.md,
  section 10.13):
  - The parts are WinUI's: PART_RootGrid, PART_VerticalIncrementRepeatButton, PART_VerticalGrid,
    PART_LabelsGrid, PART_ToolTipRail, PART_DetailLabelToolTip, PART_TooltipContentPresenter,
    PART_VerticalThumbGhost, PART_VerticalThumb and PART_VerticalDecrementRepeatButton.
  - The detail label is the tip of PART_ToolTipRail (ToolTip.Tip); the bar opens it with
    ToolTip.IsOpen and places it with ToolTip.HorizontalOffset and ToolTip.VerticalOffset, so the
    service of the rail is off (WinUI's bar closes a tip it did not open the same way).
  - The glyphs of the buttons (EDDB, EDDC at ScrollButtonFontSize) are the paths of Glyphs.xaml,
    filled with the foreground of the button.
  - ScrollButtonStyle is a control theme here: the foreground of its states is the foreground of
    the button, which the glyph follows (WinUI animates the foreground of its ContentPresenter).
  - IsTapEnabled is left out (FerroUI's elements have no such switch); HorizontalTextAlignment is
    TextAlignment.
-->
<ResourceDictionary xmlns="https://github.com/ferroui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <AnnotatedScrollBar Height="300" />
  </Design.PreviewWith>

  <ControlTheme x:Key="ScrollButtonStyle" TargetType="RepeatButton" BasedOn="{StaticResource DefaultRepeatButtonStyle}">
    <Setter Property="MinWidth" Value="16" />
    <Setter Property="MinHeight" Value="16" />
    <Setter Property="Background" Value="{DynamicResource ScrollButtonBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource ScrollButtonForeground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ScrollButtonBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource ScrollButtonStyleBorderThickness}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
    <Setter Property="FontSize" Value="8" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter x:Name="ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BackgroundSizing="{TemplateBinding BackgroundSizing}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          Foreground="{TemplateBinding Foreground}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          Padding="{TemplateBinding Padding}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                          AutomationProperties.AccessibilityView="Raw" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource ScrollButtonForegroundPointerOver}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Foreground" Value="{DynamicResource ScrollButtonForegroundPressed}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource ScrollButtonForegroundDisabled}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="DefaultAnnotatedScrollBarStyle" TargetType="AnnotatedScrollBar">
    <Setter Property="MinWidth" Value="{StaticResource LabelsGridMinWidth}" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="LabelTemplate">
      <DataTemplate x:DataType="AnnotatedScrollBarLabel">
        <Border MinWidth="{StaticResource LabelsGridMinWidth}">
          <TextBlock Margin="0,-5,0,-2"
                     HorizontalAlignment="Right"
                     TextAlignment="Right"
                     Theme="{StaticResource BodyTextBlockStyle}"
                     AutomationProperties.AccessibilityView="Raw"
                     Text="{Binding Content}"
                     TextWrapping="NoWrap" />
        </Border>
      </DataTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid x:Name="PART_RootGrid" RowDefinitions="Auto,*,Auto">
          <RepeatButton x:Name="PART_VerticalIncrementRepeatButton"
                        Grid.Row="0"
                        Theme="{StaticResource ScrollButtonStyle}"
                        AutomationProperties.AccessibilityView="Raw"
                        HorizontalAlignment="Right"
                        IsTabStop="False">
            <Path x:Name="PART_VerticalIncrementRepeatIcon"
                  Data="{StaticResource GlyphGeometryEDDB}"
                  Fill="{Binding $parent[RepeatButton].Foreground}"
                  Stretch="Uniform"
                  Width="{StaticResource ScrollButtonFontSize}" />
          </RepeatButton>
          <Grid x:Name="PART_VerticalGrid" Grid.Row="1">
            <Grid x:Name="PART_LabelsGrid"
                  Background="Transparent"
                  HorizontalAlignment="Center"
                  MinWidth="{StaticResource LabelsGridMinWidth}" />
            <Border x:Name="PART_ToolTipRail"
                    HorizontalAlignment="Right"
                    Width="1"
                    ToolTip.ServiceEnabled="False"
                    ToolTip.Placement="Top">
              <ToolTip.Tip>
                <ToolTip x:Name="PART_DetailLabelToolTip"
                         MaxWidth="{StaticResource AnnotatedScrollBarTooltipMaxWidth}"
                         MinHeight="{StaticResource AnnotatedScrollBarTooltipMinHeight}"
                         VerticalContentAlignment="Center"
                         HorizontalAlignment="Right">
                  <ContentPresenter x:Name="PART_TooltipContentPresenter">
                    <ContentPresenter.ContentTemplate>
                      <DataTemplate>
                        <Border>
                          <TextBlock Margin="0,0,0,2"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Center"
                                     Theme="{StaticResource BaseTextBlockStyle}"
                                     AutomationProperties.AccessibilityView="Raw"
                                     Text="{Binding}"
                                     TextWrapping="WrapWithOverflow" />
                        </Border>
                      </DataTemplate>
                    </ContentPresenter.ContentTemplate>
                  </ContentPresenter>
                </ToolTip>
              </ToolTip.Tip>
            </Border>
            <Border x:Name="PART_VerticalThumbGhost"
                    IsVisible="False"
                    Width="{StaticResource ThumbWidth}"
                    Height="{StaticResource ThumbHeight}"
                    CornerRadius="{StaticResource ThumbCornerRadius}"
                    Background="{DynamicResource AccentFillColorDisabledBrush}"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right" />
            <Border x:Name="PART_VerticalThumb"
                    Width="{StaticResource ThumbWidth}"
                    Height="{StaticResource ThumbHeight}"
                    CornerRadius="{StaticResource ThumbCornerRadius}"
                    Background="{DynamicResource VerticalThumbBrush}"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right" />
          </Grid>
          <RepeatButton x:Name="PART_VerticalDecrementRepeatButton"
                        Grid.Row="2"
                        Theme="{StaticResource ScrollButtonStyle}"
                        AutomationProperties.AccessibilityView="Raw"
                        HorizontalAlignment="Right"
                        IsTabStop="False">
            <Path x:Name="PART_VerticalDecrementRepeatIcon"
                  Data="{StaticResource GlyphGeometryEDDC}"
                  Fill="{Binding $parent[RepeatButton].Foreground}"
                  Stretch="Uniform"
                  Width="{StaticResource ScrollButtonFontSize}" />
          </RepeatButton>
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type AnnotatedScrollBar}" TargetType="AnnotatedScrollBar" BasedOn="{StaticResource DefaultAnnotatedScrollBarStyle}" />
</ResourceDictionary>

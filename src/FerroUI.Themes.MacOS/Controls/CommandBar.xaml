            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="{DynamicResource MacOSMotionFastDuration}"/>
              </Transitions>
            </Border.Transitions>
          </Border>
          <Grid x:Name="ContentRoot" MinHeight="{DynamicResource AppBarThemeMinHeight}" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Background="{TemplateBinding Background}">
            <Viewbox x:Name="ContentViewbox" Height="{DynamicResource AppBarButtonContentHeight}" Margin="{DynamicResource AppBarButtonContentViewboxCollapsedMargin}" HorizontalAlignment="Stretch">
              <ContentPresenter x:Name="Content" Content="{TemplateBinding Icon}" Foreground="{TemplateBinding Foreground}">

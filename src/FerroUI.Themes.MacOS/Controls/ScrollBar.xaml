<ResourceDictionary xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="using:FerroUI.Controls.Converters" x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Padding="20">
      <StackPanel Orientation="Horizontal" Spacing="20">
        <ScrollBar Orientation="Horizontal" AllowAutoHide="False" VerticalAlignment="Center" Width="100"/>
        <ScrollBar Orientation="Vertical" AllowAutoHide="False" HorizontalAlignment="Center" Height="100"/>
      </StackPanel>
    </Border>
  </Design.PreviewWith>
  <converters:CornerRadiusFilterConverter x:Key="ScrollBarTrackCornerRadiusConverter" Filter="TopLeft, TopRight, BottomRight, BottomLeft" Scale="2"/>
  <ControlTheme x:Key="ScrollBarRepeatButtonTemplate" TargetType="RepeatButton">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid x:Name="Root" Background="Transparent"/>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
  <ControlTheme x:Key="ScrollBarHorizontalIncrementTemplate" TargetType="RepeatButton">
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="Root" Background="{DynamicResource ScrollBarButtonBackground}" BorderBrush="{DynamicResource ScrollBarButtonBorderBrush}" BackgroundSizing="InnerBorderEdge" Padding="{DynamicResource ScrollBarHorizontalIncreaseMargin}">
          <Path x:Name="Arrow" RenderTransformOrigin="50%,50%" Data="{StaticResource GlyphGeometryEDDA}" Fill="{DynamicResource ScrollBarButtonArrowForeground}" Stretch="Uniform" Height="{StaticResource ScrollBarButtonArrowIconFontSize}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Path#Arrow">
      <Setter Property="Fill" Value="{DynamicResource ScrollBarButtonArrowForegroundPointerOver}"/>
    </Style>
    <Style Selector="^:pressed /template/ Path#Arrow">
      <Setter Property="Fill" Value="{DynamicResource ScrollBarButtonArrowForegroundPressed}"/>
      <Setter Property="RenderTransform" Value="scale(0.875)"/>
    </Style>
    <Style Selector="^:disabled /template/ Path#Arrow">
      <Setter Property="Fill" Value="{DynamicResource ScrollBarButtonArrowForegroundDisabled}"/>
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="ScrollBarHorizontalDecrementTemplate" TargetType="RepeatButton">
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="Root" Background="{DynamicResource ScrollBarButtonBackground}" BorderBrush="{DynamicResource ScrollBarButtonBorderBrush}" BackgroundSizing="InnerBorderEdge" Padding="{DynamicResource ScrollBarHorizontalDecreaseMargin}">
          <Path x:Name="Arrow" RenderTransformOrigin="50%,50%" Data="{StaticResource GlyphGeometryEDD9}" Fill="{DynamicResource ScrollBarButtonArrowForeground}" Stretch="Uniform" Height="{StaticResource ScrollBarButtonArrowIconFontSize}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Path#Arrow">
      <Setter Property="Fill" Value="{DynamicResource ScrollBarButtonArrowForegroundPointerOver}"/>
    </Style>
    <Style Selector="^:pressed /template/ Path#Arrow">
      <Setter Property="Fill" Value="{DynamicResource ScrollBarButtonArrowForegroundPressed}"/>
      <Setter Property="RenderTransform" Value="scale(0.875)"/>
    </Style>
    <Style Selector="^:disabled /template/ Path#Arrow">
      <Setter Property="Fill" Value="{DynamicResource ScrollBarButtonArrowForegroundDisabled}"/>
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="ScrollBarVerticalIncrementTemplate" TargetType="RepeatButton">
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="Root" Background="{DynamicResource ScrollBarButtonBackground}" BorderBrush="{DynamicResource ScrollBarButtonBorderBrush}" BackgroundSizing="InnerBorderEdge" Padding="{DynamicResource ScrollBarVerticalIncreaseMargin}">
          <Path x:Name="Arrow" RenderTransformOrigin="50%,50%" Data="{StaticResource GlyphGeometryEDDC}" Fill="{DynamicResource ScrollBarButtonArrowForeground}" Stretch="Uniform" Width="{StaticResource ScrollBarButtonArrowIconFontSize}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Path#Arrow">
      <Setter Property="Fill" Value="{DynamicResource ScrollBarButtonArrowForegroundPointerOver}"/>
    </Style>
    <Style Selector="^:pressed /template/ Path#Arrow">
      <Setter Property="Fill" Value="{DynamicResource ScrollBarButtonArrowForegroundPressed}"/>
      <Setter Property="RenderTransform" Value="scale(0.875)"/>
    </Style>
    <Style Selector="^:disabled /template/ Path#Arrow">
      <Setter Property="Fill" Value="{DynamicResource ScrollBarButtonArrowForegroundDisabled}"/>
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="ScrollBarVerticalDecrementTemplate" TargetType="RepeatButton">
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="Root" Background="{DynamicResource ScrollBarButtonBackground}" BorderBrush="{DynamicResource ScrollBarButtonBorderBrush}" BackgroundSizing="InnerBorderEdge" Padding="{DynamicResource ScrollBarVerticalDecreaseMargin}">
          <Path x:Name="Arrow" RenderTransformOrigin="50%,50%" Data="{StaticResource GlyphGeometryEDDB}" Fill="{DynamicResource ScrollBarButtonArrowForeground}" Stretch="Uniform" Width="{StaticResource ScrollBarButtonArrowIconFontSize}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Path#Arrow">
      <Setter Property="Fill" Value="{DynamicResource ScrollBarButtonArrowForegroundPointerOver}"/>
    </Style>
    <Style Selector="^:pressed /template/ Path#Arrow">
      <Setter Property="Fill" Value="{DynamicResource ScrollBarButtonArrowForegroundPressed}"/>
      <Setter Property="RenderTransform" Value="scale(0.875)"/>
    </Style>
    <Style Selector="^:disabled /template/ Path#Arrow">
      <Setter Property="Fill" Value="{DynamicResource ScrollBarButtonArrowForegroundDisabled}"/>
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="ScrollBarVerticalThumbTemplate" TargetType="Thumb">
    <Setter Property="Template">
      <ControlTemplate>
        <Rectangle x:Name="ThumbVisual" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{DynamicResource ScrollBarThumbStrokeThickness}" RadiusX="4" RadiusY="4">
          <Rectangle.Transitions>
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="{DynamicResource MacOSMotionFastDuration}"/>
            </Transitions>
          </Rectangle.Transitions>
        </Rectangle>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:disabled /template/ Rectangle#ThumbVisual">
      <Setter Property="Fill" Value="{DynamicResource ScrollBarThumbFillDisabled}"/>
      <Setter Property="Opacity" Value="0"/>
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="ScrollBarHorizontalThumbTemplate" TargetType="Thumb">
    <Setter Property="Template">
      <ControlTemplate>
        <Rectangle x:Name="ThumbVisual" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{DynamicResource ScrollBarThumbStrokeThickness}" RadiusX="4" RadiusY="4">
          <Rectangle.Transitions>
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="{DynamicResource MacOSMotionFastDuration}"/>
            </Transitions>
          </Rectangle.Transitions>
        </Rectangle>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:disabled /template/ Rectangle#ThumbVisual">
      <Setter Property="Fill" Value="{DynamicResource ScrollBarThumbFillDisabled}"/>
      <Setter Property="Opacity" Value="0"/>
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="DefaultScrollBarStyle" TargetType="ScrollBar">
    <Setter Property="MinWidth" Value="12"/>
    <Setter Property="MinHeight" Value="12"/>
    <Setter Property="Background" Value="{DynamicResource ScrollBarBackground}"/>
    <Setter Property="Foreground" Value="{DynamicResource ScrollBarForeground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ScrollBarBorderBrush}"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="ShowDelay" Value="0:0:0"/>
    <Setter Property="HideDelay" Value="0:0:0.7"/>
    <Style Selector="^:vertical">
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="Root">
            <Border x:Name="VerticalRoot" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BackgroundSizing="InnerBorderEdge">
              <Grid RowDefinitions="Auto,*,Auto">
                <Border x:Name="VerticalTrackRect" Grid.RowSpan="3" Opacity="0" CornerRadius="{TemplateBinding CornerRadius, Converter={StaticResource ScrollBarTrackCornerRadiusConverter}}" BorderThickness="{DynamicResource ScrollBarTrackBorderThemeThickness}" Background="{DynamicResource ScrollBarTrackFill}" BorderBrush="{DynamicResource ScrollBarTrackStroke}" BackgroundSizing="InnerBorderEdge">
                  <Border.Transitions>
                    <Transitions>
                      <DoubleTransition Property="Opacity" Duration="{DynamicResource MacOSMotionFastDuration}"/>
                    </Transitions>
                  </Border.Transitions>
                </Border>
                <RepeatButton x:Name="PART_LineUpButton" Grid.Row="0" Opacity="0" Height="0" MinWidth="0" Focusable="False" Interval="50" Padding="{DynamicResource ScrollBarVerticalDecreaseMargin}" Theme="{StaticResource ScrollBarVerticalDecrementTemplate}" HorizontalAlignment="Center" IsVisible="False" IsHitTestVisible="False" Width="0" MinHeight="0">
                  <RepeatButton.Transitions>
                    <Transitions>
                      <DoubleTransition Property="Opacity" Duration="{DynamicResource MacOSMotionFastDuration}"/>
                    </Transitions>
                  </RepeatButton.Transitions>
                </RepeatButton>
                <Track Grid.Row="1" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value, Mode=TwoWay}" DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}" ViewportSize="{TemplateBinding ViewportSize}" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                  <Track.DecreaseButton>
                    <RepeatButton x:Name="PART_PageUpButton" Focusable="False" Interval="50" Theme="{StaticResource ScrollBarRepeatButtonTemplate}"/>
                  </Track.DecreaseButton>
                  <Track.IncreaseButton>
                    <RepeatButton x:Name="PART_PageDownButton" Focusable="False" Interval="50" Theme="{StaticResource ScrollBarRepeatButtonTemplate}"/>
                  </Track.IncreaseButton>
                  <Thumb x:Name="VerticalThumb" Background="{DynamicResource ScrollBarPanningThumbBackground}" BorderBrush="{DynamicResource ScrollBarThumbBorderBrush}" Theme="{StaticResource ScrollBarVerticalThumbTemplate}" Width="6" MinHeight="{StaticResource ScrollBarVerticalThumbMinHeight}" RenderTransformOrigin="100%,50%" RenderTransform="none" CornerRadius="{TemplateBinding CornerRadius}" HorizontalAlignment="Center">
                    <Thumb.Transitions>
                      <Transitions>
                        <DoubleTransition Property="Width" Duration="{DynamicResource MacOSMotionFastDuration}" Easing="CubicEaseOut"/>
                        <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource MacOSMotionFastDuration}" Easing="CubicEaseOut"/>
                      </Transitions>
                    </Thumb.Transitions>
                  </Thumb>
                </Track>
                <RepeatButton x:Name="PART_LineDownButton" Grid.Row="2" Opacity="0" Height="0" MinWidth="0" Focusable="False" Interval="50" Padding="{DynamicResource ScrollBarVerticalIncreaseMargin}" Theme="{StaticResource ScrollBarVerticalIncrementTemplate}" HorizontalAlignment="Center" IsVisible="False" IsHitTestVisible="False" Width="0" MinHeight="0">
                  <RepeatButton.Transitions>
                    <Transitions>
                      <DoubleTransition Property="Opacity" Duration="{DynamicResource MacOSMotionFastDuration}"/>
                    </Transitions>
                  </RepeatButton.Transitions>
                </RepeatButton>
              </Grid>
            </Border>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="^:horizontal">
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="Root">
            <Border x:Name="HorizontalRoot" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BackgroundSizing="InnerBorderEdge" CornerRadius="{TemplateBinding CornerRadius}">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border x:Name="HorizontalTrackRect" Grid.ColumnSpan="3" Opacity="0" CornerRadius="{TemplateBinding CornerRadius, Converter={StaticResource ScrollBarTrackCornerRadiusConverter}}" BorderThickness="{DynamicResource ScrollBarTrackBorderThemeThickness}" Background="{DynamicResource ScrollBarTrackFill}" BorderBrush="{DynamicResource ScrollBarTrackStroke}" BackgroundSizing="InnerBorderEdge">
                  <Border.Transitions>
                    <Transitions>
                      <DoubleTransition Property="Opacity" Duration="{DynamicResource MacOSMotionFastDuration}"/>
                    </Transitions>
                  </Border.Transitions>
                </Border>
                <RepeatButton x:Name="PART_LineUpButton" Grid.Column="0" Opacity="0" MinHeight="0" Width="0" Focusable="False" Interval="50" Padding="{DynamicResource ScrollBarHorizontalDecreaseMargin}" Theme="{StaticResource ScrollBarHorizontalDecrementTemplate}" VerticalAlignment="Center" IsVisible="False" IsHitTestVisible="False" Height="0" MinWidth="0">
                  <RepeatButton.Transitions>
                    <Transitions>
                      <DoubleTransition Property="Opacity" Duration="{DynamicResource MacOSMotionFastDuration}"/>
                    </Transitions>
                  </RepeatButton.Transitions>
                </RepeatButton>
                <Track Grid.Column="1" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value, Mode=TwoWay}" DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}" ViewportSize="{TemplateBinding ViewportSize}" Orientation="{TemplateBinding Orientation}">
                  <Track.DecreaseButton>
                    <RepeatButton x:Name="PART_PageUpButton" Focusable="False" Interval="50" Theme="{StaticResource ScrollBarRepeatButtonTemplate}"/>
                  </Track.DecreaseButton>
                  <Track.IncreaseButton>
                    <RepeatButton x:Name="PART_PageDownButton" Focusable="False" Interval="50" Theme="{StaticResource ScrollBarRepeatButtonTemplate}"/>
                  </Track.IncreaseButton>
                  <Thumb x:Name="HorizontalThumb" Background="{DynamicResource ScrollBarPanningThumbBackground}" BorderBrush="{DynamicResource ScrollBarThumbBorderBrush}" Theme="{StaticResource ScrollBarHorizontalThumbTemplate}" Height="6" MinWidth="{StaticResource ScrollBarHorizontalThumbMinWidth}" RenderTransformOrigin="50%,100%" RenderTransform="none" CornerRadius="{TemplateBinding CornerRadius}" VerticalAlignment="Center">
                    <Thumb.Transitions>
                      <Transitions>
                        <DoubleTransition Property="Height" Duration="{DynamicResource MacOSMotionFastDuration}" Easing="CubicEaseOut"/>
                        <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource MacOSMotionFastDuration}" Easing="CubicEaseOut"/>
                      </Transitions>
                    </Thumb.Transitions>
                  </Thumb>
                </Track>
                <RepeatButton x:Name="PART_LineDownButton" Grid.Column="2" Opacity="0" MinHeight="0" Width="0" Focusable="False" Interval="50" Padding="{DynamicResource ScrollBarHorizontalIncreaseMargin}" Theme="{StaticResource ScrollBarHorizontalIncrementTemplate}" VerticalAlignment="Center" IsVisible="False" IsHitTestVisible="False" Height="0" MinWidth="0">
                  <RepeatButton.Transitions>
                    <Transitions>
                      <DoubleTransition Property="Opacity" Duration="{DynamicResource MacOSMotionFastDuration}"/>
                    </Transitions>
                  </RepeatButton.Transitions>
                </RepeatButton>
              </Grid>
            </Border>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="^[IsExpanded=true]">
      <Style Selector="^ /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource ScrollBarBackgroundPointerOver}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ScrollBarBorderBrushPointerOver}"/>
      </Style>
      <Style Selector="^ /template/ Border#VerticalTrackRect, ^ /template/ Border#HorizontalTrackRect">
        <Setter Property="BorderBrush" Value="{DynamicResource ScrollBarTrackStrokePointerOver}"/>
        <Setter Property="Background" Value="{DynamicResource ScrollBarTrackFillPointerOver}"/>
        <Setter Property="Opacity" Value="1"/>
      </Style>
      <Style Selector="^ /template/ Thumb#VerticalThumb">
        <Setter Property="Background" Value="{DynamicResource ScrollBarThumbBackground}"/>
        <Setter Property="Width" Value="8"/>
        <Setter Property="RenderTransform" Value="none"/>
      </Style>
      <Style Selector="^ /template/ Thumb#HorizontalThumb">
        <Setter Property="Background" Value="{DynamicResource ScrollBarThumbBackground}"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="RenderTransform" Value="none"/>
      </Style>
    </Style>
    <Style Selector="^:disabled">
      <Style Selector="^ /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource ScrollBarBackgroundDisabled}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ScrollBarBorderBrushDisabled}"/>
        <Setter Property="Opacity" Value="0.5"/>
      </Style>
      <Style Selector="^ /template/ Border#VerticalTrackRect, ^ /template/ Border#HorizontalTrackRect">
        <Setter Property="BorderBrush" Value="{DynamicResource ScrollBarTrackStrokeDisabled}"/>
        <Setter Property="Background" Value="{DynamicResource ScrollBarTrackFillDisabled}"/>
      </Style>
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar" BasedOn="{StaticResource DefaultScrollBarStyle}"/>
</ResourceDictionary>

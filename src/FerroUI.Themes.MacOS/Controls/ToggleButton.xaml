<!--
  macOS 26 control theme, adapted from the FerroUI WinUI template foundation.
  Foundation: microsoft-ui-xaml 7e4b0c2096be402f51cc8f7d203ebf67cff183d0.
  Copyright (c) Microsoft Corporation. MIT License; see NOTICE.md.
  macOS geometry and states are theme calibrations against Apple's WWDC25
  AppKit design guidance; exact native rendering remains a comparison gate.
  FerroUI template parts, bindings and routed interaction are preserved.
-->
<ResourceDictionary xmlns="https://github.com/ferroui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Padding="20">
      <StackPanel Spacing="20">
        <ToggleButton Content="Unchecked" />
        <ToggleButton IsChecked="True" Content="Checked" />
        <ToggleButton IsThreeState="True" IsChecked="{x:Null}" Content="Indeterminate" />
        <ToggleButton IsChecked="True" IsEnabled="False" Content="Disabled" />
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <ControlTheme x:Key="DefaultToggleButtonStyle" TargetType="ToggleButton">
    <Setter Property="MinHeight" Value="{DynamicResource MacOSControlHeight}" />
    <!-- The defaults of a WinUI 3 control, which its style leaves unset and its template binds
         (FerroUI's defaults are Stretch). Deviation (winui-theme/DEVIATIONS.md, G-27). -->
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource ToggleButtonBackground}" />
    <Setter Property="BackgroundSizing" Value="InnerBorderEdge" />
    <Setter Property="Foreground" Value="{DynamicResource ToggleButtonForeground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ToggleButtonBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource ToggleButtonBorderThemeThickness}" />
    <Setter Property="Padding" Value="{DynamicResource MacOSControlPadding}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
    <Setter Property="CornerRadius" Value="{DynamicResource MacOSControlCornerRadius}" />
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border IsHitTestVisible="False" Margin="-3" BorderThickness="3"
                BorderBrush="{DynamicResource MacOSFocusBrush}"
                CornerRadius="{DynamicResource MacOSControlCornerRadius}" />
      </FocusAdornerTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter x:Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          Foreground="{TemplateBinding Foreground}"
                          BackgroundSizing="{TemplateBinding BackgroundSizing}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Padding="{TemplateBinding Padding}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                          RecognizesAccessKey="True">
          <ContentPresenter.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="{DynamicResource MacOSMotionFastDuration}" />
            </Transitions>
          </ContentPresenter.Transitions>
        </ContentPresenter>
      </ControlTemplate>
    </Setter>

    <!-- PointerOver -->
    <Style Selector="^:pointerover">
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ToggleButtonBackgroundPointerOver}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ToggleButtonBorderBrushPointerOver}" />
        <Setter Property="Foreground" Value="{DynamicResource ToggleButtonForegroundPointerOver}" />
      </Style>
    </Style>
    <!-- Pressed -->
    <Style Selector="^:pressed">
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ToggleButtonBackgroundPressed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ToggleButtonBorderBrushPressed}" />
        <Setter Property="Foreground" Value="{DynamicResource ToggleButtonForegroundPressed}" />
      </Style>
    </Style>
    <!-- Disabled -->
    <Style Selector="^:disabled">
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ToggleButtonBackgroundDisabled}" />
        <Setter Property="Foreground" Value="{DynamicResource ToggleButtonForegroundDisabled}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ToggleButtonBorderBrushDisabled}" />
      </Style>
    </Style>
    <!-- Checked -->
    <Style Selector="^:checked">
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ToggleButtonBackgroundChecked}" />
        <Setter Property="Foreground" Value="{DynamicResource ToggleButtonForegroundChecked}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ToggleButtonBorderBrushChecked}" />
        <Setter Property="BackgroundSizing" Value="{DynamicResource ToggleButtonCheckedStateBackgroundSizing}" />
      </Style>
    </Style>
    <!-- CheckedPointerOver -->
    <Style Selector="^:checked:pointerover">
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ToggleButtonBackgroundCheckedPointerOver}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ToggleButtonBorderBrushCheckedPointerOver}" />
        <Setter Property="Foreground" Value="{DynamicResource ToggleButtonForegroundCheckedPointerOver}" />
        <Setter Property="BackgroundSizing" Value="{DynamicResource ToggleButtonCheckedStateBackgroundSizing}" />
      </Style>
    </Style>
    <!-- CheckedPressed -->
    <Style Selector="^:checked:pressed">
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ToggleButtonBackgroundCheckedPressed}" />
        <Setter Property="Foreground" Value="{DynamicResource ToggleButtonForegroundCheckedPressed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ToggleButtonBorderBrushCheckedPressed}" />
        <Setter Property="BackgroundSizing" Value="{DynamicResource ToggleButtonCheckedStateBackgroundSizing}" />
      </Style>
    </Style>
    <!-- CheckedDisabled -->
    <Style Selector="^:checked:disabled">
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ToggleButtonBackgroundCheckedDisabled}" />
        <Setter Property="Foreground" Value="{DynamicResource ToggleButtonForegroundCheckedDisabled}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ToggleButtonBorderBrushCheckedDisabled}" />
        <!-- CheckedDisabled does not set BackgroundSizing: the value of the control, not the one of Checked. -->
        <Setter Property="BackgroundSizing" Value="{TemplateBinding BackgroundSizing}" />
      </Style>
    </Style>
    <!-- Indeterminate -->
    <Style Selector="^:indeterminate">
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ToggleButtonBackgroundIndeterminate}" />
        <Setter Property="Foreground" Value="{DynamicResource ToggleButtonForegroundIndeterminate}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ToggleButtonBorderBrushIndeterminate}" />
      </Style>
    </Style>
    <!-- IndeterminatePointerOver -->
    <Style Selector="^:indeterminate:pointerover">
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ToggleButtonBackgroundIndeterminatePointerOver}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ToggleButtonBorderBrushIndeterminatePointerOver}" />
        <Setter Property="Foreground" Value="{DynamicResource ToggleButtonForegroundIndeterminatePointerOver}" />
      </Style>
    </Style>
    <!-- IndeterminatePressed -->
    <Style Selector="^:indeterminate:pressed">
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ToggleButtonBackgroundIndeterminatePressed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ToggleButtonBorderBrushIndeterminatePressed}" />
        <Setter Property="Foreground" Value="{DynamicResource ToggleButtonForegroundIndeterminatePressed}" />
      </Style>
    </Style>
    <!-- IndeterminateDisabled -->
    <Style Selector="^:indeterminate:disabled">
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ToggleButtonBackgroundIndeterminateDisabled}" />
        <Setter Property="Foreground" Value="{DynamicResource ToggleButtonForegroundIndeterminateDisabled}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ToggleButtonBorderBrushIndeterminateDisabled}" />
      </Style>
    </Style>

    <!-- macOS 26 mini/small/regular rectangles; large sizes use capsules. -->
    <Style Selector="^.mini">
      <Setter Property="MinHeight" Value="18" />
      <Setter Property="Padding" Value="7,1" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="FocusAdorner">
        <FocusAdornerTemplate>
          <Border IsHitTestVisible="False" Margin="-3" BorderThickness="3"
                  BorderBrush="{DynamicResource MacOSFocusBrush}" CornerRadius="4" />
        </FocusAdornerTemplate>
      </Setter>
    </Style>
    <Style Selector="^.small">
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="FocusAdorner">
        <FocusAdornerTemplate>
          <Border IsHitTestVisible="False" Margin="-3" BorderThickness="3"
                  BorderBrush="{DynamicResource MacOSFocusBrush}" CornerRadius="5" />
        </FocusAdornerTemplate>
      </Setter>
    </Style>
    <Style Selector="^.large">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="15,5" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="FocusAdorner">
        <FocusAdornerTemplate>
          <Border IsHitTestVisible="False" Margin="-3" BorderThickness="3"
                  BorderBrush="{DynamicResource MacOSFocusBrush}" CornerRadius="999" />
        </FocusAdornerTemplate>
      </Setter>
    </Style>
    <Style Selector="^.extra-large">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Padding" Value="19,7" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="FocusAdorner">
        <FocusAdornerTemplate>
          <Border IsHitTestVisible="False" Margin="-3" BorderThickness="3"
                  BorderBrush="{DynamicResource MacOSFocusBrush}" CornerRadius="999" />
        </FocusAdornerTemplate>
      </Setter>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ToggleButton}" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}" />
</ResourceDictionary>

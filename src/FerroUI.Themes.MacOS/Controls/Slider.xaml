  macOS geometry and states are theme calibrations against Apple's WWDC25
  AppKit design guidance; exact native rendering remains a comparison gate.
  FerroUI template parts, bindings and routed interaction are preserved.
-->
<ResourceDictionary xmlns="https://github.com/ferroui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Padding="20" Width="400">
      <StackPanel Spacing="20">
        <Slider Value="30" />
        <Slider Value="60" TickPlacement="Outside" TickFrequency="10" />
        <Slider Value="30" IsEnabled="False" />
        <Slider Value="30" Orientation="Vertical" Height="120" />
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <!-- SliderThumbStyle of the Grid.Resources of the template. -->
  <ControlTheme x:Key="SliderThumbStyle" TargetType="Thumb">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource SliderThumbBackground}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Margin="0"
                Background="{DynamicResource SliderOuterThumbBackground}"
                BorderBrush="{DynamicResource SliderThumbBorderBrush}"
                BackgroundSizing="InnerBorderEdge"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{DynamicResource SliderThumbCornerRadius}">
          <Ellipse x:Name="SliderInnerThumb"
                   RenderTransformOrigin="50%,50%"
                   RenderTransform="scale(1)"
                   Fill="{TemplateBinding Background}"
                   Width="{DynamicResource SliderInnerThumbWidth}"
                   Height="{DynamicResource SliderInnerThumbHeight}">
            <Ellipse.Transitions>
              <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource MacOSMotionStandardDuration}" Easing="CubicEaseOut" />
              </Transitions>
            </Ellipse.Transitions>
          </Ellipse>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- Keep a stable round knob on hover. -->
    <Style Selector="^:pointerover /template/ Ellipse#SliderInnerThumb">
      <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>
    <!-- A small, interruptible compression provides press feedback. -->
    <Style Selector="^:pressed /template/ Ellipse#SliderInnerThumb">
      <Setter Property="RenderTransform" Value="scale(0.96)" />
    </Style>
    <!-- Disabled (1.167) -->
    <Style Selector="^:disabled /template/ Ellipse#SliderInnerThumb">
      <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>
  </ControlTheme>

  <!-- The decrease button of the horizontal track: HorizontalDecreaseRect. -->
  <ControlTheme x:Key="SliderHorizontalDecreaseButtonStyle" TargetType="RepeatButton">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="Transparent">
          <Rectangle x:Name="HorizontalDecreaseRect"
                     Fill="{TemplateBinding Background}"
                     Height="{DynamicResource SliderTrackThemeHeight}"
                     VerticalAlignment="Center"
                     RadiusX="{TemplateBinding CornerRadius, Converter={StaticResource TopLeftCornerRadiusDoubleValueConverter}}"
                     RadiusY="{TemplateBinding CornerRadius, Converter={StaticResource BottomRightCornerRadiusDoubleValueConverter}}" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- The decrease button of the vertical track: VerticalDecreaseRect. -->
  <ControlTheme x:Key="SliderVerticalDecreaseButtonStyle" TargetType="RepeatButton">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="Transparent">
          <Rectangle x:Name="VerticalDecreaseRect"
                     Fill="{TemplateBinding Background}"
                     Width="{DynamicResource SliderTrackThemeHeight}"
                     HorizontalAlignment="Center"
                     RadiusX="{TemplateBinding CornerRadius, Converter={StaticResource TopLeftCornerRadiusDoubleValueConverter}}"
                     RadiusY="{TemplateBinding CornerRadius, Converter={StaticResource BottomRightCornerRadiusDoubleValueConverter}}" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- The increase button of the track: the part of the track after the thumb, which shows the
       track rectangle behind it. -->
  <ControlTheme x:Key="SliderIncreaseButtonStyle" TargetType="RepeatButton">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="Transparent" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="DefaultSliderStyle" TargetType="Slider">
    <Setter Property="Background" Value="{DynamicResource SliderTrackFill}" />
    <Setter Property="BorderThickness" Value="{DynamicResource SliderBorderThemeThickness}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SliderThumbBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SliderTrackValueFill}" />
    <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border IsHitTestVisible="False" Margin="-3" BorderThickness="3"
                BorderBrush="{DynamicResource MacOSFocusBrush}"
                CornerRadius="{DynamicResource MacOSControlCornerRadius}" />
      </FocusAdornerTemplate>
    </Setter>
    <Setter Property="CornerRadius" Value="{DynamicResource SliderTrackCornerRadius}" />

    <!-- HorizontalTemplate -->
    <Style Selector="^:horizontal">
      <Setter Property="Template">
        <ControlTemplate>
          <!-- The errors of FerroUI's data validation under the slider (DataValidationErrors.xaml). -->
          <DataValidationErrors>
            <Grid Margin="{TemplateBinding Padding}">
              <Border x:Name="FocusBorder"
                      CornerRadius="{DynamicResource ControlCornerRadius}"
                      TemplatedControl.IsTemplateFocusTarget="True" />
              <Grid x:Name="SliderContainer" Background="{DynamicResource SliderContainerBackground}">
                <Grid.Styles>
                  <Style Selector="TickBar">
                    <Setter Property="ReservedSpace" Value="{Binding #PART_Track.Thumb.Bounds}" />
                  </Style>
                </Grid.Styles>
                <Grid x:Name="HorizontalTemplate"
                      MinHeight="{DynamicResource SliderHorizontalHeight}"
                      ColumnDefinitions="Auto,Auto,*">
                  <Grid.RowDefinitions>
                    <!-- SliderPreContentMargin, Auto, SliderPostContentMargin -->
                    <RowDefinition Height="7" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="7" />
                  </Grid.RowDefinitions>
                  <Rectangle x:Name="HorizontalTrackRect"
                             Fill="{TemplateBinding Background}"
                             Height="{DynamicResource SliderTrackThemeHeight}"
                             Grid.Row="1"
                             Grid.ColumnSpan="3"
                             RadiusX="{TemplateBinding CornerRadius, Converter={StaticResource TopLeftCornerRadiusDoubleValueConverter}}"
                             RadiusY="{TemplateBinding CornerRadius, Converter={StaticResource BottomRightCornerRadiusDoubleValueConverter}}" />
                  <TickBar x:Name="TopTickBar"
                           IsVisible="False"
                           Fill="{DynamicResource SliderTickBarFill}"
                           Height="{DynamicResource SliderOutsideTickBarThemeHeight}"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,4"
                           Grid.ColumnSpan="3"
                           Placement="Top"
                           Ticks="{TemplateBinding Ticks}"
                           TickFrequency="{TemplateBinding Slider.TickFrequency}"
                           Orientation="{TemplateBinding Slider.Orientation}"
                           Minimum="{TemplateBinding Slider.Minimum}"
                           Maximum="{TemplateBinding Slider.Maximum}"
                           IsDirectionReversed="{TemplateBinding IsDirectionReversed}" />
                  <TickBar x:Name="BottomTickBar"
                           IsVisible="False"
                           Fill="{DynamicResource SliderTickBarFill}"
                           Height="{DynamicResource SliderOutsideTickBarThemeHeight}"
                           VerticalAlignment="Top"
                           Margin="0,4,0,0"
                           Grid.Row="2"
                           Grid.ColumnSpan="3"
                           Placement="Bottom"
                           Ticks="{TemplateBinding Ticks}"
                           TickFrequency="{TemplateBinding Slider.TickFrequency}"
                           Orientation="{TemplateBinding Slider.Orientation}"
                           Minimum="{TemplateBinding Slider.Minimum}"
                           Maximum="{TemplateBinding Slider.Maximum}"
                           IsDirectionReversed="{TemplateBinding IsDirectionReversed}" />
                  <Track x:Name="PART_Track"
                         Grid.Row="0"
                         Grid.RowSpan="3"
                         Grid.ColumnSpan="3"
                         Minimum="{TemplateBinding Minimum}"
                         Maximum="{TemplateBinding Maximum}"
                         Value="{TemplateBinding Value, Mode=TwoWay}"
                         IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                         Orientation="Horizontal">
                    <Track.DecreaseButton>
                      <RepeatButton x:Name="PART_DecreaseButton"
                                    Theme="{StaticResource SliderHorizontalDecreaseButtonStyle}"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Focusable="False" />
                    </Track.DecreaseButton>
                    <Track.IncreaseButton>
                      <RepeatButton x:Name="PART_IncreaseButton"
                                    Theme="{StaticResource SliderIncreaseButtonStyle}"
                                    Focusable="False" />
                    </Track.IncreaseButton>
                    <Thumb x:Name="HorizontalThumb"
                           Theme="{StaticResource SliderThumbStyle}"
                           DataContext="{TemplateBinding Value}"
                           Height="{DynamicResource SliderHorizontalThumbHeight}"
                           Width="{DynamicResource SliderHorizontalThumbWidth}"
                           CornerRadius="999" />
                  </Track>
                </Grid>
              </Grid>
            </Grid>
          </DataValidationErrors>
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- VerticalTemplate -->
    <Style Selector="^:vertical">
      <Setter Property="Template">
        <ControlTemplate>
          <!-- The errors of FerroUI's data validation under the slider (DataValidationErrors.xaml). -->
          <DataValidationErrors>
            <Grid Margin="{TemplateBinding Padding}">
              <Border x:Name="FocusBorder"
                      CornerRadius="{DynamicResource ControlCornerRadius}"
                      TemplatedControl.IsTemplateFocusTarget="True" />
              <Grid x:Name="SliderContainer" Background="{DynamicResource SliderContainerBackground}">
                <Grid.Styles>
                  <Style Selector="TickBar">
                    <Setter Property="ReservedSpace" Value="{Binding #PART_Track.Thumb.Bounds}" />
                  </Style>
                </Grid.Styles>
                <Grid x:Name="VerticalTemplate"
                      MinWidth="{DynamicResource SliderVerticalWidth}"
                      RowDefinitions="*,Auto,Auto">
                  <Grid.ColumnDefinitions>
                    <!-- SliderPreContentMargin, Auto, SliderPostContentMargin -->
                    <ColumnDefinition Width="7" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="7" />
                  </Grid.ColumnDefinitions>
                  <Rectangle x:Name="VerticalTrackRect"
                             Fill="{TemplateBinding Background}"
                             Width="{DynamicResource SliderTrackThemeHeight}"
                             Grid.Column="1"
                             Grid.RowSpan="3"
                             RadiusX="{TemplateBinding CornerRadius, Converter={StaticResource TopLeftCornerRadiusDoubleValueConverter}}"
                             RadiusY="{TemplateBinding CornerRadius, Converter={StaticResource BottomRightCornerRadiusDoubleValueConverter}}" />
                  <TickBar x:Name="LeftTickBar"
                           IsVisible="False"
                           Fill="{DynamicResource SliderTickBarFill}"
                           Width="{DynamicResource SliderOutsideTickBarThemeHeight}"
                           HorizontalAlignment="Right"
                           Margin="0,0,4,0"
                           Grid.RowSpan="3"
                           Placement="Left"
                           Ticks="{TemplateBinding Ticks}"
                           TickFrequency="{TemplateBinding Slider.TickFrequency}"
                           Orientation="{TemplateBinding Slider.Orientation}"
                           Minimum="{TemplateBinding Slider.Minimum}"
                           Maximum="{TemplateBinding Slider.Maximum}"
                           IsDirectionReversed="{TemplateBinding IsDirectionReversed}" />
                  <TickBar x:Name="RightTickBar"
                           IsVisible="False"
                           Fill="{DynamicResource SliderTickBarFill}"
                           Width="{DynamicResource SliderOutsideTickBarThemeHeight}"
                           HorizontalAlignment="Left"
                           Margin="4,0,0,0"
                           Grid.Column="2"
                           Grid.RowSpan="3"
                           Placement="Right"
                           Ticks="{TemplateBinding Ticks}"
                           TickFrequency="{TemplateBinding Slider.TickFrequency}"
                           Orientation="{TemplateBinding Slider.Orientation}"
                           Minimum="{TemplateBinding Slider.Minimum}"
                           Maximum="{TemplateBinding Slider.Maximum}"
                           IsDirectionReversed="{TemplateBinding IsDirectionReversed}" />
                  <Track x:Name="PART_Track"
                         Grid.Column="0"
                         Grid.ColumnSpan="3"
                         Grid.RowSpan="3"
                         Minimum="{TemplateBinding Minimum}"
                         Maximum="{TemplateBinding Maximum}"
                         Value="{TemplateBinding Value, Mode=TwoWay}"
                         IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                         Orientation="Vertical">
                    <Track.DecreaseButton>
                      <RepeatButton x:Name="PART_DecreaseButton"
                                    Theme="{StaticResource SliderVerticalDecreaseButtonStyle}"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Focusable="False" />
                    </Track.DecreaseButton>
                    <Track.IncreaseButton>
                      <RepeatButton x:Name="PART_IncreaseButton"
                                    Theme="{StaticResource SliderIncreaseButtonStyle}"
                                    Focusable="False" />
                    </Track.IncreaseButton>
                    <Thumb x:Name="VerticalThumb"
                           Theme="{StaticResource SliderThumbStyle}"
                           DataContext="{TemplateBinding Value}"
                           Width="{DynamicResource SliderVerticalThumbWidth}"
                           Height="{DynamicResource SliderVerticalThumbHeight}"
                           CornerRadius="999" />
                  </Track>
                </Grid>
              </Grid>
            </Grid>
          </DataValidationErrors>
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- The tick bars the control shows for its TickPlacement. -->
    <Style Selector="^[TickPlacement=TopLeft] /template/ TickBar#TopTickBar, ^[TickPlacement=Outside] /template/ TickBar#TopTickBar">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^[TickPlacement=BottomRight] /template/ TickBar#BottomTickBar, ^[TickPlacement=Outside] /template/ TickBar#BottomTickBar">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^[TickPlacement=TopLeft] /template/ TickBar#LeftTickBar, ^[TickPlacement=Outside] /template/ TickBar#LeftTickBar">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^[TickPlacement=BottomRight] /template/ TickBar#RightTickBar, ^[TickPlacement=Outside] /template/ TickBar#RightTickBar">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- Normal sets the base values. -->
    <!-- PointerOver -->
    <Style Selector="^:pointerover">
      <Style Selector="^ /template/ Rectangle#HorizontalTrackRect, ^ /template/ Rectangle#VerticalTrackRect">
        <Setter Property="Fill" Value="{DynamicResource SliderTrackFillPointerOver}" />
      </Style>
      <Style Selector="^ /template/ Thumb#HorizontalThumb, ^ /template/ Thumb#VerticalThumb">
        <Setter Property="Background" Value="{DynamicResource SliderThumbBackgroundPointerOver}" />
      </Style>
      <Style Selector="^ /template/ Grid#SliderContainer">
        <Setter Property="Background" Value="{DynamicResource SliderContainerBackgroundPointerOver}" />
      </Style>
      <Style Selector="^ /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{DynamicResource SliderTrackValueFillPointerOver}" />
      </Style>
    </Style>
    <!-- Pressed -->
    <Style Selector="^:pressed">
      <Style Selector="^ /template/ Rectangle#HorizontalTrackRect, ^ /template/ Rectangle#VerticalTrackRect">
        <Setter Property="Fill" Value="{DynamicResource SliderTrackFillPressed}" />
      </Style>
      <Style Selector="^ /template/ Thumb#HorizontalThumb, ^ /template/ Thumb#VerticalThumb">
        <Setter Property="Background" Value="{DynamicResource SliderThumbBackgroundPressed}" />
      </Style>
      <Style Selector="^ /template/ Grid#SliderContainer">
        <Setter Property="Background" Value="{DynamicResource SliderContainerBackgroundPressed}" />
      </Style>
      <Style Selector="^ /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{DynamicResource SliderTrackValueFillPressed}" />
      </Style>
    </Style>
    <!-- Disabled -->
    <Style Selector="^:disabled">
      <Style Selector="^ /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{DynamicResource SliderTrackValueFillDisabled}" />
      </Style>
      <Style Selector="^ /template/ Rectangle#HorizontalTrackRect, ^ /template/ Rectangle#VerticalTrackRect">
        <Setter Property="Fill" Value="{DynamicResource SliderTrackFillDisabled}" />
      </Style>
      <Style Selector="^ /template/ Thumb#HorizontalThumb, ^ /template/ Thumb#VerticalThumb">
        <Setter Property="Background" Value="{DynamicResource SliderThumbBackgroundDisabled}" />
      </Style>
      <Style Selector="^ /template/ TickBar">
        <Setter Property="Fill" Value="{DynamicResource SliderTickBarFillDisabled}" />
      </Style>
      <Style Selector="^ /template/ Grid#SliderContainer">
        <Setter Property="Background" Value="{DynamicResource SliderContainerBackgroundDisabled}" />
      </Style>
    </Style>

    <!-- Not in WinUI (no input validation): the :error of FerroUI's data validation, as the
         Fluent theme shows it, with the error brush of the WinUI theme. -->
    <Style Selector="^:error">
      <Setter Property="Foreground" Value="{DynamicResource SystemControlErrorTextForegroundBrush}" />
      <Style Selector="^ /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource SystemControlErrorTextForegroundBrush}" />
      </Style>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type Slider}" TargetType="Slider" BasedOn="{StaticResource DefaultSliderStyle}" />
</ResourceDictionary>

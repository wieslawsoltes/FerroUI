<!-- macOS 26 theme: the control theme of the WinUI theme (src/FerroUI.Themes.WinUI/Controls/ListView.xaml),
     as docs/porting/macos26-theme.md derives every control theme of the WinUI theme; the resources are this theme's. -->
<!--
  Ported from microsoft-ui-xaml (https://github.com/microsoft/microsoft-ui-xaml),
  commit 7e4b0c2096be402f51cc8f7d203ebf67cff183d0:
    dxaml/xcp/dxaml/themes/generic.xaml (the implicit style of ListView)
    controls/dev/CommonStyles/ListViewItem_themeresources.xaml (the implicit style of
    ListViewItem, based on DefaultListViewItemStyle of Controls/ListBoxItem.xaml)
  Copyright (c) Microsoft Corporation. Licensed under the MIT License (see NOTICE.md of the crate).

  The templates of WinUI's ListView and ListViewItem, which FerroUI ports as controls
  (ferroui-controls, docs/porting/winui-calculator-gaps.md, LV-1); the Fluent theme has no document
  for them. Translation notes (docs/porting/winui-theme.md, section 4):
  - The template keeps WinUI's structure, Border > ScrollViewer (the part ScrollViewer) >
    ItemsPresenter. FerroUI's ItemsPresenter has no Header and Footer: the header and the footer
    are content presenters above and below it, in a vertical StackPanel, with the padding of the
    list around the three, as WinUI's presenter lays them out.
  - The scroll modes and rails of the scroll viewer (HorizontalScrollMode, VerticalScrollMode,
    IsHorizontalRailEnabled, IsVerticalRailEnabled) are not FerroUI properties: the scroll bar
    visibilities say the same (Disabled horizontally). ZoomMode stays Disabled, the default.
  - ItemContainerTransitions (AddDeleteThemeTransition, ContentThemeTransition,
    ReorderThemeTransition, EntranceThemeTransition) are theme transitions, which the theme does
    not port (G-22).
  - The items are ListViewItems drawn with DefaultListViewItemStyle (decision D6: the chrome of
    ListViewItemPresenter drawn with elements, LBI-6 to LBI-9).
-->
<ResourceDictionary xmlns="https://github.com/ferroui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Padding="20" Width="300" Height="200">
      <ListView>
        <ListViewItem Content="First" />
        <ListViewItem Content="Second" />
        <ListViewItem Content="Third" />
      </ListView>
    </Border>
  </Design.PreviewWith>

  <ControlTheme x:Key="DefaultListViewStyle" TargetType="ListView">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
    <Setter Property="IsSwipeEnabled" Value="True" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False" />
    <Setter Property="ScrollViewer.BringIntoViewOnFocusChange" Value="True" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <ItemsStackPanel Orientation="Vertical" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border BorderBrush="{TemplateBinding BorderBrush}"
                Background="{TemplateBinding Background}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <ScrollViewer x:Name="ScrollViewer"
                        HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                        VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                        IsDeferredScrollingEnabled="{TemplateBinding (ScrollViewer.IsDeferredScrollingEnabled)}"
                        BringIntoViewOnFocusChange="{TemplateBinding (ScrollViewer.BringIntoViewOnFocusChange)}"
                        IsScrollChainingEnabled="{TemplateBinding (ScrollViewer.IsScrollChainingEnabled)}"
                        AutomationProperties.AccessibilityView="Raw">
            <StackPanel Margin="{TemplateBinding Padding}">
              <ContentPresenter Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}" />
              <ItemsPresenter x:Name="PART_ItemsPresenter"
                              ItemsPanel="{TemplateBinding ItemsPanel}" />
              <ContentPresenter Content="{TemplateBinding Footer}"
                                ContentTemplate="{TemplateBinding FooterTemplate}" />
            </StackPanel>
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ListView}" TargetType="ListView" BasedOn="{StaticResource DefaultListViewStyle}" />

  <!-- ListViewItem: DefaultListViewItemStyle, and the chrome of the multiple selection mode. -->
  <ControlTheme x:Key="{x:Type ListViewItem}" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
    <!-- MultiSelectEnabled (the `:multiselect` pseudo-class the list sets in Multiple): the check
         box of the presenter (CheckMode Inline, the rounded chrome): a square of 20 px
         (s_multiSelectSquareSize) at 14 px from the left edge (s_multiSelectRoundedSquareInlineMargin)
         with the corner radius ListViewItemCheckBoxCornerRadius and a border of 1 px
         (s_multiSelectRoundedSquareThickness) while unselected, the check glyph E73E of 16 px
         (s_checkMarkGlyphFontSize), and the content moved by 28 px
         (s_multiSelectRoundedContentOffset). The selection indicator is not shown in Multiple
         (IsInSelectionIndicatorMode). Only lists in this mode use this template; as the WinUI
         theme, with this theme's resources. -->
    <Style Selector="^:multiselect">
      <Setter Property="Template">
        <ControlTemplate>
          <Panel x:Name="Root">
            <Border x:Name="Backplate"
                    Margin="4,2,4,2"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BackgroundSizing="InnerBorderEdge"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource ListViewItemCornerRadius}"
                    IsHitTestVisible="False"
                    TemplatedControl.IsTemplateFocusTarget="True" />
            <Border x:Name="MultiSelectSquare"
                    Margin="14,0,0,0"
                    MinWidth="20"
                    Height="20"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    ClipToBounds="True"
                    CornerRadius="{DynamicResource ListViewItemCheckBoxCornerRadius}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ListViewItemCheckBoxBorderBrush}"
                    Background="{DynamicResource ListViewItemCheckBoxBrush}"
                    IsHitTestVisible="False">
              <!-- E73E at 16 px: the ink of the glyph in the symbol font. -->
              <Path x:Name="MultiSelectCheck"
                    Data="{StaticResource GlyphGeometryE73E}"
                    Fill="{DynamicResource ListViewItemCheckBrush}"
                    Stretch="Uniform"
                    Width="13"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FlowDirection="LeftToRight"
                    Opacity="0" />
            </Border>
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Margin="28,0,0,0"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>
    <!-- The brushes of the check box (SetMultiSelectCheckBoxBackground, SetMultiSelectCheckBoxBorder,
         SetMultiSelectCheckBoxForeground), in the order of their precedence. -->
    <Style Selector="^:multiselect:selected">
      <Style Selector="^ /template/ Border#MultiSelectSquare">
        <Setter Property="Background" Value="{DynamicResource ListViewItemCheckBoxSelectedBrush}" />
        <Setter Property="BorderThickness" Value="0" />
      </Style>
      <Style Selector="^ /template/ Path#MultiSelectCheck">
        <Setter Property="Opacity" Value="1" />
      </Style>
    </Style>
    <Style Selector="^:multiselect:pointerover /template/ Border#MultiSelectSquare">
      <Setter Property="Background" Value="{DynamicResource ListViewItemCheckBoxPointerOverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ListViewItemCheckBoxPointerOverBorderBrush}" />
    </Style>
    <Style Selector="^:multiselect:selected:pointerover /template/ Border#MultiSelectSquare">
      <Setter Property="Background" Value="{DynamicResource ListViewItemCheckBoxSelectedPointerOverBrush}" />
    </Style>
    <Style Selector="^:multiselect:pressed /template/ Border#MultiSelectSquare">
      <Setter Property="Background" Value="{DynamicResource ListViewItemCheckBoxPressedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ListViewItemCheckBoxPressedBorderBrush}" />
    </Style>
    <Style Selector="^:multiselect:selected:pressed">
      <Style Selector="^ /template/ Border#MultiSelectSquare">
        <Setter Property="Background" Value="{DynamicResource ListViewItemCheckBoxSelectedPressedBrush}" />
      </Style>
      <Style Selector="^ /template/ Path#MultiSelectCheck">
        <Setter Property="Fill" Value="{DynamicResource ListViewItemCheckPressedBrush}" />
      </Style>
    </Style>
    <Style Selector="^:multiselect:disabled">
      <Style Selector="^ /template/ Border#MultiSelectSquare">
        <Setter Property="Background" Value="{DynamicResource ListViewItemCheckBoxDisabledBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ListViewItemCheckBoxDisabledBorderBrush}" />
      </Style>
      <Style Selector="^ /template/ Path#MultiSelectCheck">
        <Setter Property="Fill" Value="{DynamicResource ListViewItemCheckDisabledBrush}" />
      </Style>
    </Style>
    <Style Selector="^:multiselect:selected:disabled /template/ Border#MultiSelectSquare">
      <Setter Property="Background" Value="{DynamicResource ListViewItemCheckBoxSelectedDisabledBrush}" />
    </Style>
  </ControlTheme>

  <!-- The header of a group: the implicit style of ListViewHeaderItem of generic.xaml. -->
  <ControlTheme x:Key="{x:Type ListViewHeaderItem}" TargetType="ListViewHeaderItem">
    <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="Background" Value="{DynamicResource SystemControlTransparentBrush}" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="Padding" Value="12,8,12,0" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Background="{TemplateBinding Background}">
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Margin="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          <Rectangle Stroke="{DynamicResource SystemControlForegroundBaseLowBrush}"
                     StrokeThickness="0.5"
                     Height="1"
                     VerticalAlignment="Bottom"
                     HorizontalAlignment="Stretch"
                     Margin="12,8,12,0" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>

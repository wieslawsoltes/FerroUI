<!-- macOS 26 theme: the control theme of the WinUI theme (src/FerroUI.Themes.WinUI/Controls/TabView.xaml),
     as docs/porting/macos26-theme.md derives every control theme of the WinUI theme; the resources are this theme's. -->
<!--
  Ported from microsoft-ui-xaml (https://github.com/microsoft/microsoft-ui-xaml),
  commit 7e4b0c2096be402f51cc8f7d203ebf67cff183d0:
    controls/dev/TabView/TabView.xaml (DefaultTabViewStyle and the implicit styles of TabView,
    TabViewListView and TabViewItem, and TabScrollViewerStyle; the resources of
    controls/dev/TabView/TabView_themeresources.xaml are Resources/TabView_themeresources.xaml)
  Copyright (c) Microsoft Corporation. Licensed under the MIT License (see NOTICE.md of the crate).

  The templates of WinUI's TabView, TabViewListView and TabViewItem, which FerroUI ports as
  controls (ferroui-controls, src/FerroUI.Controls/tab_view). TabViewButtonStyle,
  TabViewCloseButtonStyle and TabViewScrollButtonStyle are the ones of Controls/TabControl.xaml,
  where the same source is ported for FerroUI's TabControl (whose control theme keeps the key
  DefaultTabViewStyle: the key of TabView here is its type only).
  Translation notes (docs/porting/winui-theme.md, section 4):
  - The control finds WinUI's parts by name, as TabView.cpp does, except the columns
    LeftContentColumn, TabColumn, AddButtonColumn and RightContentColumn, which are the four
    columns of TabContainerGrid in that order (a ColumnDefinition has no x:Name here): TabContainerGrid, TabListView, AddButton,
    RightContentPresenter and TabContentPresenter. It gives the list its items
    (TabItemsSource, or TabItems) and its ItemTemplate in code; CanReorderTabs, CanDragTabs and
    AllowDropTabs are not bound (dragging tabs is not ported) and ItemTemplateSelector has no
    counterpart of TabView.
  - The visual states the control sets are pseudo-classes: SingleBottomBorderLine of TabView is
    :single-bottom-border-line; LeftBottomBorderLineShort and RightBottomBorderLineShort of the
    list are :left-bottom-border-line-short and :right-bottom-border-line-short; the states of
    TabViewItem are :close-button-collapsed (CloseButtonVisible without it), :compact
    (StandardWidth without it), :icon (NoIcon without it), :foreground-set, and
    :no-bottom-border-line, :left-of-selected-tab and :right-of-selected-tab
    (NormalBottomBorderLine without them). NoBottomBorderLine of the list and of the scroll
    viewer, which only a dragged tab sets, is left out with dragging.
  - FerroUI's ItemsPresenter has no Header and Footer: the 4 px header and footer of the strip,
    with their bottom border lines, are the elements TabsItemsPresenterHeader and
    TabsItemsPresenterFooter beside the items presenter (the control reads their widths). The
    ItemsStackPanel of the list is horizontal.
  - TabScrollViewerStyle is TabViewScrollViewerStyle (the key TabScrollViewerStyle is the one of
    TabControl, whose buttons scroll by commands): the scroll buttons are shown by the
    MenuScrollingVisibilityConverter of the offset, extent and viewport (the source shows them by
    ComputedHorizontalScrollBarVisibility), and the control scrolls 50 px per click and enables
    them at the ends of the range in code, as TabView.cpp does.
  - The glyphs E710 (Add), E711 (Cancel), EDD9 and EDDA of the buttons are paths of the glyph
    geometries (section 4.7), as high as the font size of the source.
  - The Grids LayoutRoot and TabContainer of TabViewItem are Borders of the same names around
    Grids. SelectedBackgroundPath is a Path in a Canvas whose geometry is
    TabViewTemplateSettings.TabGeometry, which the tab computes from its size. The header
    presenter is the ContentPresenter named ContentPresenter, whose content the tab sets to its
    Header in code; the tab has no PART_ContentPresenter, so its Content is shown only by the
    TabContentPresenter of the tab view. The icon is the IconElement of the template settings.
  - The states PointerOverSelected and PressedSelected set what Selected sets: ^:selected,
    written after the pointer states, applies to them. The selected tab is drawn above its
    neighbours (Canvas.ZIndex 20 of the code). LayoutRoot.Background="Transparent" of the
    selected states is left out (the tab container's background makes the tab hit-testable).
  - The drag visual TabDragVisualContainer and the states of dragging and reordering
    (DragStates, ReorderHintStates, DragDropVisualStates, DataVirtualizationStates) are left out
    with dragging. ItemContainerTransitions are theme transitions, not ported (G-22).
    KeyboardAcceleratorPlacementMode, HighContrastAdjustment, IsTextScaleFactorEnabled and
    OpticalMarginAlignment have no counterpart.
-->
<ResourceDictionary xmlns="https://github.com/ferroui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="using:FerroUI.Controls.Converters"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Width="520" Padding="20">
      <TabView Height="180">
        <TabViewItem Header="Selected">
          <TextBlock Text="The content of the selected tab." Margin="12" />
        </TabViewItem>
        <TabViewItem Header="Normal" />
        <TabViewItem Header="Not closable" IsClosable="False" />
      </TabView>
    </Border>
  </Design.PreviewWith>

  <ControlTheme x:Key="TabViewScrollViewerStyle" TargetType="ScrollViewer">
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="Root"
                BackgroundSizing="InnerBorderEdge"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border x:Name="LeftBottomBorderLine"
                    MinWidth="2"
                    Background="{DynamicResource TabViewBorderBrush}"
                    Height="1"
                    VerticalAlignment="Bottom" />
            <Border x:Name="RightBottomBorderLine"
                    Grid.Column="2"
                    Background="{DynamicResource TabViewBorderBrush}"
                    Height="1"
                    VerticalAlignment="Bottom" />
            <Border x:Name="ScrollDecreaseButtonContainer"
                    Padding="{DynamicResource TabViewItemLeftScrollButtonContainerPadding}"
                    VerticalAlignment="Bottom">
              <Border.IsVisible>
                <MultiBinding Converter="{x:Static converters:MenuScrollingVisibilityConverter.Instance}"
                              ConverterParameter="-1">
                  <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="HorizontalScrollBarVisibility" />
                  <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Offset.X" />
                  <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Extent.Width" />
                  <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Viewport.Width" />
                </MultiBinding>
              </Border.IsVisible>
              <RepeatButton x:Name="ScrollDecreaseButton"
                            Theme="{StaticResource TabViewScrollButtonStyle}"
                            AutomationProperties.AccessibilityView="Raw"
                            IsTabStop="False"
                            Delay="50"
                            Interval="100">
                <Path Data="{StaticResource GlyphGeometryEDD9}"
                      Fill="{Binding $parent[RepeatButton].Foreground}"
                      Stretch="Uniform"
                      Height="{StaticResource TabViewItemScrollButonFontSize}" />
              </RepeatButton>
            </Border>
            <ScrollContentPresenter x:Name="PART_ContentPresenter"
                                    Grid.Column="1"
                                    Padding="1,0,0,0"
                                    ContentTemplate="{TemplateBinding ContentTemplate}">
              <ScrollContentPresenter.GestureRecognizers>
                <ScrollGestureRecognizer CanHorizontallyScroll="{Binding CanHorizontallyScroll, ElementName=PART_ContentPresenter}"
                                         CanVerticallyScroll="{Binding CanVerticallyScroll, ElementName=PART_ContentPresenter}"
                                         Offset="{Binding Offset, ElementName=PART_ContentPresenter}"
                                         Viewport="{Binding Viewport, ElementName=PART_ContentPresenter}"
                                         Extent="{Binding Extent, ElementName=PART_ContentPresenter}" />
              </ScrollContentPresenter.GestureRecognizers>
            </ScrollContentPresenter>
            <Border x:Name="ScrollIncreaseButtonContainer"
                    Grid.Column="2"
                    Padding="{DynamicResource TabViewItemRightScrollButtonContainerPadding}"
                    VerticalAlignment="Bottom">
              <Border.IsVisible>
                <MultiBinding Converter="{x:Static converters:MenuScrollingVisibilityConverter.Instance}"
                              ConverterParameter="-1">
                  <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="HorizontalScrollBarVisibility" />
                  <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Offset.X" />
                  <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Extent.Width" />
                  <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Viewport.Width" />
                </MultiBinding>
              </Border.IsVisible>
              <RepeatButton x:Name="ScrollIncreaseButton"
                            Theme="{StaticResource TabViewScrollButtonStyle}"
                            AutomationProperties.AccessibilityView="Raw"
                            IsTabStop="False"
                            Delay="50"
                            Interval="100">
                <Path Data="{StaticResource GlyphGeometryEDDA}"
                      Fill="{Binding $parent[RepeatButton].Foreground}"
                      Stretch="Uniform"
                      Height="{StaticResource TabViewItemScrollButonFontSize}" />
              </RepeatButton>
            </Border>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TabView}" TargetType="TabView">
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Padding" Value="{DynamicResource TabViewHeaderPadding}" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Background" Value="{DynamicResource TabViewBackground}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid RowDefinitions="Auto,*">
          <Grid x:Name="TabContainerGrid" Background="{TemplateBinding Background}">
            <Grid.ColumnDefinitions>
              <!-- LeftContentColumn, TabColumn, AddButtonColumn and RightContentColumn: the control
                   takes them in this order (a ColumnDefinition has no x:Name in FerroUI). -->
              <ColumnDefinition Width="Auto" MinWidth="2" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="LeftBottomBorderLine"
                    Background="{DynamicResource TabViewBorderBrush}"
                    Height="1"
                    VerticalAlignment="Bottom" />
            <Border x:Name="RightBottomBorderLine"
                    Grid.Column="2"
                    Grid.ColumnSpan="2"
                    Background="{DynamicResource TabViewBorderBrush}"
                    Height="1"
                    VerticalAlignment="Bottom" />
            <ContentPresenter x:Name="LeftContentPresenter"
                              Grid.Column="0"
                              Content="{TemplateBinding TabStripHeader}"
                              ContentTemplate="{TemplateBinding TabStripHeaderTemplate}" />
            <TabViewListView x:Name="TabListView"
                             Grid.Column="1"
                             HorizontalAlignment="Stretch"
                             Padding="{TemplateBinding Padding}" />
            <Border Grid.Column="2"
                    IsVisible="{TemplateBinding IsAddTabButtonVisible}"
                    Padding="{DynamicResource TabViewItemAddButtonContainerPadding}"
                    VerticalAlignment="Bottom">
              <Button x:Name="AddButton"
                      Theme="{StaticResource TabViewButtonStyle}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Command="{TemplateBinding AddTabButtonCommand}"
                      CommandParameter="{TemplateBinding AddTabButtonCommandParameter}">
                <!-- E710 at TabViewItemAddButtonFontSize. -->
                <Path Data="{StaticResource GlyphGeometryE710}"
                      Fill="{Binding $parent[Button].Foreground}"
                      Stretch="Uniform"
                      Height="{DynamicResource TabViewItemAddButtonFontSize}" />
              </Button>
            </Border>
            <ContentPresenter x:Name="RightContentPresenter"
                              Grid.Column="3"
                              HorizontalAlignment="Stretch"
                              Content="{TemplateBinding TabStripFooter}"
                              ContentTemplate="{TemplateBinding TabStripFooterTemplate}" />
          </Grid>
          <ContentPresenter x:Name="TabContentPresenter"
                            Grid.Row="1"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <!-- SingleBottomBorderLine -->
    <Style Selector="^:single-bottom-border-line /template/ Border#LeftBottomBorderLine">
      <Setter Property="Grid.ColumnSpan" Value="4" />
    </Style>
    <Style Selector="^:single-bottom-border-line /template/ Border#RightBottomBorderLine">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TabViewListView}" TargetType="TabViewListView">
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
    <Setter Property="IsSwipeEnabled" Value="False" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False" />
    <Setter Property="ScrollViewer.BringIntoViewOnFocusChange" Value="True" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <ItemsStackPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border BorderBrush="{TemplateBinding BorderBrush}"
                Background="{TemplateBinding Background}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <ScrollViewer x:Name="ScrollViewer"
                        Theme="{StaticResource TabViewScrollViewerStyle}"
                        AutomationProperties.AccessibilityView="Raw"
                        HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                        VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                        IsDeferredScrollingEnabled="{TemplateBinding (ScrollViewer.IsDeferredScrollingEnabled)}"
                        BringIntoViewOnFocusChange="{TemplateBinding (ScrollViewer.BringIntoViewOnFocusChange)}"
                        IsTabStop="False">
            <StackPanel x:Name="TabsItemsPresenter" Orientation="Horizontal" Margin="{TemplateBinding Padding}">
              <Panel x:Name="TabsItemsPresenterHeader" Width="4">
                <Border x:Name="LeftBottomBorderLine"
                        Background="{DynamicResource TabViewBorderBrush}"
                        Width="4"
                        Height="1"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Left" />
              </Panel>
              <ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
              <Panel x:Name="TabsItemsPresenterFooter" Width="4">
                <Border x:Name="RightBottomBorderLine"
                        Background="{DynamicResource TabViewBorderBrush}"
                        Width="4"
                        Height="1"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Right" />
              </Panel>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- LeftBottomBorderLineShort, RightBottomBorderLineShort -->
    <Style Selector="^:left-bottom-border-line-short /template/ Border#LeftBottomBorderLine">
      <Setter Property="Width" Value="2" />
    </Style>
    <Style Selector="^:right-bottom-border-line-short /template/ Border#RightBottomBorderLine">
      <Setter Property="Width" Value="2" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TabViewItem}" TargetType="TabViewItem">
    <Setter Property="Background" Value="{DynamicResource TabViewItemHeaderBackground}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <!-- The default of a WinUI control (FerroUI's default is Top). -->
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="{DynamicResource TabViewItemMinHeight}" />
    <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
    <Setter Property="BorderThickness" Value="{DynamicResource TabViewItemBorderThickness}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TabViewItemBorderBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="LayoutRoot"
                Padding="{TemplateBinding Padding}"
                UseLayoutRounding="False">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border x:Name="BottomBorderLine"
                    Grid.ColumnSpan="3"
                    Background="{DynamicResource TabViewBorderBrush}"
                    Height="1"
                    VerticalAlignment="Bottom" />
            <Path x:Name="LeftRadiusRenderArc"
                  IsVisible="False"
                  Fill="{DynamicResource TabViewBorderBrush}"
                  VerticalAlignment="Bottom"
                  Margin="-4,0,0,0"
                  Height="4"
                  Width="4"
                  Data="M4 0C4 1.19469 3.47624 2.26706 2.64582 3H0C1.65685 3 3 1.65685 3 0H4Z" />
            <Path x:Name="RightRadiusRenderArc"
                  Grid.Column="2"
                  IsVisible="False"
                  Fill="{DynamicResource TabViewBorderBrush}"
                  VerticalAlignment="Bottom"
                  Margin="0,0,-4,0"
                  Height="4"
                  Width="4"
                  Data="M0 0C0 1.19469 0.523755 2.26706 1.35418 3H4C2.34315 3 1 1.65685 1 0H0Z" />
            <!-- This Path wrapped in a Canvas to prevent an infinite loop in calculating its width. -->
            <Canvas Grid.ColumnSpan="3">
              <Path x:Name="SelectedBackgroundPath"
                    Fill="{DynamicResource TabViewItemHeaderBackgroundSelected}"
                    Margin="-4,0"
                    IsVisible="False"
                    Data="{Binding TabViewTemplateSettings.TabGeometry, RelativeSource={RelativeSource TemplatedParent}}" />
            </Canvas>
            <Border x:Name="TabSeparator"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Width="1"
                    Background="{DynamicResource TabViewItemSeparator}"
                    Margin="{DynamicResource TabViewItemSeparatorMargin}" />
            <!-- CloseIconStates: CloseButtonVisible (TabViewItemHeaderPaddingWithCloseButton). -->
            <Border x:Name="TabContainer"
                    BackgroundSizing="InnerBorderEdge"
                    Grid.Column="1"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{StaticResource TabViewItemHeaderPaddingWithCloseButton}"
                    CornerRadius="{TemplateBinding CornerRadius, Converter={StaticResource TopCornerRadiusFilterConverter}}">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border x:Name="IconColumn">
                  <Viewbox x:Name="IconBox"
                           MaxWidth="{DynamicResource TabViewItemHeaderIconSize}"
                           MaxHeight="{DynamicResource TabViewItemHeaderIconSize}"
                           Margin="{DynamicResource TabViewItemHeaderIconMargin}"
                           IsVisible="False">
                    <ContentPresenter x:Name="IconControl"
                                      Content="{Binding TabViewTemplateSettings.IconElement, RelativeSource={RelativeSource TemplatedParent}}"
                                      Foreground="{DynamicResource TabViewItemIconForeground}" />
                  </Viewbox>
                </Border>
                <!-- The tab sets the content of this presenter to its Header in code. -->
                <ContentPresenter x:Name="ContentPresenter"
                                  Grid.Column="1"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                  FontWeight="{TemplateBinding FontWeight}"
                                  FontSize="{DynamicResource TabViewItemHeaderFontSize}"
                                  Foreground="{DynamicResource TabViewItemHeaderForeground}" />
                <Button x:Name="CloseButton"
                        Grid.Column="2"
                        Theme="{StaticResource TabViewCloseButtonStyle}"
                        Margin="{DynamicResource TabViewItemHeaderCloseMargin}"
                        IsTabStop="False">
                  <!-- E711 at TabViewItemHeaderCloseFontSize. -->
                  <Path Data="{StaticResource GlyphGeometryE711}"
                        Fill="{Binding $parent[Button].Foreground}"
                        Stretch="Uniform"
                        Height="{DynamicResource TabViewItemHeaderCloseFontSize}" />
                </Button>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- CommonStates: PointerOver -->
    <Style Selector="^:pointerover">
      <Style Selector="^ /template/ Border#TabContainer">
        <Setter Property="Background" Value="{DynamicResource TabViewItemHeaderBackgroundPointerOver}" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource TabViewItemHeaderForegroundPointerOver}" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#IconControl">
        <Setter Property="Foreground" Value="{DynamicResource TabViewItemIconForegroundPointerOver}" />
      </Style>
      <Style Selector="^ /template/ Button#CloseButton">
        <Setter Property="Background" Value="{DynamicResource TabViewItemHeaderPointerOverCloseButtonBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource TabViewItemHeaderPointerOverCloseButtonForeground}" />
      </Style>
      <Style Selector="^ /template/ Border#TabSeparator">
        <Setter Property="Opacity" Value="0" />
      </Style>
    </Style>
    <!-- Pressed -->
    <Style Selector="^:pressed">
      <Style Selector="^ /template/ Border#TabContainer">
        <Setter Property="Background" Value="{DynamicResource TabViewItemHeaderBackgroundPressed}" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource TabViewItemHeaderForegroundPressed}" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#IconControl">
        <Setter Property="Foreground" Value="{DynamicResource TabViewItemIconForegroundPressed}" />
      </Style>
      <Style Selector="^ /template/ Button#CloseButton">
        <Setter Property="Background" Value="{DynamicResource TabViewItemHeaderPressedCloseButtonBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource TabViewItemHeaderPressedCloseButtonForeground}" />
      </Style>
      <Style Selector="^ /template/ Border#TabSeparator">
        <Setter Property="Opacity" Value="0" />
      </Style>
    </Style>
    <!-- Selected (also PointerOverSelected and PressedSelected, which set the same values) -->
    <Style Selector="^:selected">
      <!-- Canvas.ZIndex 20 of TabViewItem::OnIsSelectedPropertyChanged. -->
      <Setter Property="ZIndex" Value="20" />
      <Style Selector="^ /template/ Border#BottomBorderLine">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^ /template/ Path#RightRadiusRenderArc, ^ /template/ Path#LeftRadiusRenderArc, ^ /template/ Path#SelectedBackgroundPath">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^ /template/ Border#TabContainer">
        <Setter Property="Background" Value="{DynamicResource TabViewItemHeaderBackground}" />
        <Setter Property="Margin" Value="{DynamicResource TabViewSelectedItemHeaderMargin}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TabViewSelectedItemBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource TabViewSelectedItemBorderThickness}" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource TabViewItemHeaderForegroundSelected}" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#IconControl">
        <Setter Property="Foreground" Value="{DynamicResource TabViewItemIconForegroundSelected}" />
      </Style>
      <Style Selector="^ /template/ Button#CloseButton">
        <Setter Property="Background" Value="{DynamicResource TabViewItemHeaderSelectedCloseButtonBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource TabViewItemHeaderSelectedCloseButtonForeground}" />
      </Style>
    </Style>
    <!-- DisabledStates: Disabled (IconControl.Foreground is set twice in the source; the second
         value, TabViewButtonForegroundDisabled, is the one in effect) -->
    <Style Selector="^:disabled">
      <Style Selector="^ /template/ Border#TabContainer">
        <Setter Property="Background" Value="{DynamicResource TabViewItemHeaderBackgroundDisabled}" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#IconControl">
        <Setter Property="Foreground" Value="{DynamicResource TabViewButtonForegroundDisabled}" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource TabViewItemHeaderForegroundDisabled}" />
      </Style>
      <Style Selector="^ /template/ Button#CloseButton">
        <Setter Property="Background" Value="{DynamicResource TabViewItemHeaderDisabledCloseButtonBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource TabViewItemHeaderDisabledCloseButtonForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TabViewItemHeaderCloseButtonBorderBrushDisabled}" />
      </Style>
    </Style>

    <!-- IconStates: Icon -->
    <Style Selector="^:icon /template/ Viewbox#IconBox">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <!-- TabWidthModes: Compact -->
    <Style Selector="^:compact">
      <Style Selector="^ /template/ Viewbox#IconBox">
        <Setter Property="Margin" Value="0" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^ /template/ Border#IconColumn">
        <Setter Property="Width" Value="{DynamicResource TabViewItemHeaderIconSize}" />
      </Style>
    </Style>
    <!-- CloseIconStates: CloseButtonCollapsed -->
    <Style Selector="^:close-button-collapsed">
      <Style Selector="^ /template/ Border#TabContainer">
        <Setter Property="Padding" Value="{StaticResource TabViewItemHeaderPaddingWithoutCloseButton}" />
      </Style>
      <Style Selector="^ /template/ Button#CloseButton">
        <Setter Property="IsVisible" Value="False" />
      </Style>
    </Style>
    <!-- ForegroundSet: the Foreground of the tab replaces the brushes of the states. -->
    <Style Selector="^:foreground-set /template/ ContentPresenter#IconControl, ^:foreground-set /template/ ContentPresenter#ContentPresenter">
      <Setter Property="Foreground" Value="{Binding $parent[TabViewItem].Foreground}" />
    </Style>
    <!-- The bottom border line beside the selected tab: LeftOfSelectedTab, RightOfSelectedTab,
         NoBottomBorderLine. -->
    <Style Selector="^:left-of-selected-tab /template/ Border#BottomBorderLine">
      <Setter Property="Margin" Value="0,0,2,0" />
    </Style>
    <Style Selector="^:right-of-selected-tab /template/ Border#BottomBorderLine">
      <Setter Property="Margin" Value="2,0,0,0" />
    </Style>
    <Style Selector="^:no-bottom-border-line /template/ Border#BottomBorderLine">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </ControlTheme>
</ResourceDictionary>

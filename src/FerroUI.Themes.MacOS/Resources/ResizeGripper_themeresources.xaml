<ResourceDictionary xmlns="https://github.com/ferroui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:winui="using:FerroUI.Themes.MacOS"
                    x:ClassModifier="internal">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="ResizeGripperSeparatorBrush" Color="{DynamicResource SystemAccentColor}" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="ResizeGripperSeparatorBrush" Color="{DynamicResource SystemAccentColor}" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="{x:Static winui:MacOSTheme.HighContrast}">
      <SolidColorBrush x:Key="ResizeGripperSeparatorBrush" Color="{DynamicResource SystemAccentColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <Thickness x:Key="ResizeGripperSeparatorThickness">0,0,2,0</Thickness>
  <Thickness x:Key="ResizeGripperSeparatorThicknessVertical">0,0,0,2</Thickness>
</ResourceDictionary>

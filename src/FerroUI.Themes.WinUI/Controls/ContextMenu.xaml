<!--
  Ported from microsoft-ui-xaml (https://github.com/microsoft/microsoft-ui-xaml),
  commit 7e4b0c2096be402f51cc8f7d203ebf67cff183d0:
    controls/dev/CommonStyles/MenuFlyout_themeresources.xaml (the style
    DefaultMenuFlyoutPresenterStyle; the resources of the document are
    Resources/MenuFlyout_themeresources.xaml)
  Copyright (c) Microsoft Corporation. Licensed under the MIT License (see NOTICE.md of the crate).

  Translation notes (docs/porting/winui-theme.md, section 4):
  - WinUI has no context menu control: the context menu of an element (ContextFlyout) is a
    MenuFlyout, shown by a MenuFlyoutPresenter. FerroUI's ContextMenu is a menu in a popup of its
    own, so its theme is the theme of the menu presenter (Controls/MenuFlyoutPresenter.xaml): the
    same setters and template, with the items presenter as PART_ItemsPresenter and the scroll
    viewer MenuFlyoutPresenterScrollViewer.
  - Focusable is set, as the other themes of FerroUI do, so that the open menu takes the
    keyboard. WindowManagerAddShadowHint is off: the shadow a window manager adds to a popup
    window does not follow the rounded corners of the presenter; the shadow of the menu flyout
    (a ThemeShadow at a Translation.Z of 32) is the BoxShadow ThemeShadowFlyoutBoxShadow of the
    border ThemeShadowWrapper around the border of the menu (a border of its own: a border whose
    background is sized to the inner edge of its border draws no box shadow), with the margin
    ThemeShadowFlyoutMargin as the room for it in the popup (Resources/ThemeShadows.xaml;
    DEVIATIONS.md, G-24).
  - The SystemBackdrop setter is kept, as for MenuFlyoutPresenter (the property of the presenter,
    which ContextMenu shares). The MinWidth bound to TemplateSettings.FlyoutContentMinWidth, and
    the scroll, rail and zoom modes are left out, as for MenuFlyoutPresenter.
-->
<ResourceDictionary xmlns="https://github.com/ferroui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Padding="48" Width="400" Height="200">
      <Border.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Cut" InputGesture="Ctrl+X" />
          <MenuItem Header="Copy" InputGesture="Ctrl+C" />
          <MenuItem Header="Paste" InputGesture="Ctrl+V" IsEnabled="False" />
        </ContextMenu>
      </Border.ContextMenu>
      <TextBlock Text="Right-click here" />
    </Border>
  </Design.PreviewWith>

  <ControlTheme x:Key="{x:Type ContextMenu}" TargetType="ContextMenu">
    <!-- The shadow is drawn outside the bounds of the control: a templated control clips to its
         bounds unless its theme says otherwise (G-24). -->
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Background" Value="{DynamicResource MenuFlyoutPresenterBackground}" />
    <Setter Property="SystemBackdrop" Value="{StaticResource MenuFlyoutSystemBackdrop}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MenuFlyoutPresenterBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource MenuFlyoutPresenterBorderThemeThickness}" />
    <Setter Property="Padding" Value="{StaticResource MenuFlyoutPresenterThemePadding}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="MinWidth" Value="{DynamicResource FlyoutThemeMinWidth}" />
    <Setter Property="MinHeight" Value="{StaticResource MenuFlyoutThemeMinHeight}" />
    <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
    <!-- The room for the shadow in the popup (G-24). -->
    <Setter Property="Margin" Value="{StaticResource ThemeShadowFlyoutMargin}" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="WindowManagerAddShadowHint" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The shadow on a border of its own: a border whose background is sized to the inner
             edge of its border is drawn as geometries, without its box shadows (G-24). -->
        <Border x:Name="ThemeShadowWrapper"
                BoxShadow="{DynamicResource ThemeShadowFlyoutBoxShadow}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  BackgroundSizing="InnerBorderEdge">
            <ScrollViewer x:Name="MenuFlyoutPresenterScrollViewer"
                          Theme="{StaticResource MenuFlyoutPresenterScrollViewer}"
                          Margin="{TemplateBinding Padding}"
                          HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                          VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}">
              <ItemsPresenter x:Name="PART_ItemsPresenter"
                              ItemsPanel="{TemplateBinding ItemsPanel}"
                              KeyboardNavigation.TabNavigation="Continue"
                              Grid.IsSharedSizeScope="True" />
            </ScrollViewer>
          </Border>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>

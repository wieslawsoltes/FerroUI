  Translation notes (docs/porting/winui-theme.md, section 4):
  - The Grid RootGrid has a background, a border and a corner radius, which a FerroUI panel does
    not have: it is a Border of the same name around the Grid.
  - The check glyph is an AnimatedIcon (AnimatedAcceptVisualSource, a Lottie animation) with a
    FontIconSource fallback of the symbol font; FerroUI has neither, so it is a Path of the glyph
    geometries GlyphGeometryE73E (CheckBoxCheckedGlyph) and GlyphGeometryE9AE
    (CheckBoxIndeterminateGlyph) of Resources/Glyphs.xaml. The states of the animated icon
    (NormalOff, PointerOverOn, ...) become its opacity: hidden when unchecked, shown otherwise.
  - The visual states of CombinedStates are nested styles on the pseudo-classes of the check
    state and the pointer state, in the order of the source.
-->
<ResourceDictionary xmlns="https://github.com/ferroui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Padding="20">
      <StackPanel Spacing="20">
        <CheckBox>Unchecked</CheckBox>
        <CheckBox IsChecked="True">Checked</CheckBox>
        <CheckBox IsThreeState="True" IsChecked="{x:Null}">Indeterminate</CheckBox>
        <CheckBox IsChecked="True" IsEnabled="False">Disabled</CheckBox>
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <ControlTheme x:Key="DefaultCheckBoxStyle" TargetType="CheckBox">
    <Setter Property="Background" Value="{DynamicResource CheckBoxBackgroundUnchecked}" />
    <Setter Property="Foreground" Value="{DynamicResource CheckBoxForegroundUnchecked}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrushUnchecked}" />
    <Setter Property="Padding" Value="{StaticResource CheckBoxPadding}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
    <Setter Property="MinWidth" Value="{StaticResource CheckBoxMinWidth}" />
    <Setter Property="MinHeight" Value="{StaticResource CheckBoxHeight}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    <!-- UseSystemFocusVisuals with FocusVisualMargin="{StaticResource CheckBoxFocusVisualMargin}" (-7,-3,-7,-3). -->
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border Margin="-7,-3,-7,-3"
                BorderThickness="2"
                BorderBrush="{DynamicResource SystemControlFocusVisualPrimaryBrush}"
                CornerRadius="{DynamicResource ControlCornerRadius}">
          <Border BorderThickness="1"
                  BorderBrush="{DynamicResource SystemControlFocusVisualSecondaryBrush}"
                  CornerRadius="{DynamicResource ControlCornerRadius}" />
        </Border>
      </FocusAdornerTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="RootGrid"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BackgroundSizing="InnerBorderEdge"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <Grid ColumnDefinitions="Auto,*">
            <Grid Grid.Column="0"
                  VerticalAlignment="Center"
                  Height="{StaticResource CheckBoxSize}"
                  Width="{StaticResource CheckBoxSize}">
              <Rectangle x:Name="NormalRectangle"
                         Fill="{DynamicResource CheckBoxCheckBackgroundFillUnchecked}"
                         Stroke="{DynamicResource CheckBoxCheckBackgroundStrokeUnchecked}"
                         StrokeThickness="{StaticResource CheckBoxBorderThickness}"
                         UseLayoutRounding="False"
                         Height="{StaticResource CheckBoxSize}"
                         Width="{StaticResource CheckBoxSize}"
                         RadiusX="{TemplateBinding CornerRadius, Converter={StaticResource TopLeftCornerRadiusDoubleValueConverter}}"
                         RadiusY="{TemplateBinding CornerRadius, Converter={StaticResource BottomRightCornerRadiusDoubleValueConverter}}" />
              <!-- The glyph is drawn at the size of its ink in the symbol font at CheckBoxGlyphSize. -->
              <Path x:Name="CheckGlyph"
                    Fill="{DynamicResource CheckBoxCheckGlyphForegroundUnchecked}"
                    Data="{StaticResource GlyphGeometryE73E}"
                    Stretch="Uniform"
                    Width="10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FlowDirection="LeftToRight"
                    Margin="0,1,0,-1"
                    Opacity="0" />
            </Grid>
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Grid.Column="1"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}"
                              Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              TextWrapping="Wrap"
                              RecognizesAccessKey="True" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- The glyph of the check states (AnimatedIcon.State and DownLevelCheckGlyph.Glyph of the source). -->
    <Style Selector="^:checked /template/ Path#CheckGlyph">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:indeterminate /template/ Path#CheckGlyph">
      <Setter Property="Data" Value="{StaticResource GlyphGeometryE9AE}" />
      <Setter Property="Width" Value="8" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- UncheckedPointerOver -->
    <Style Selector="^:pointerover">
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource CheckBoxForegroundUncheckedPointerOver}" />
      </Style>
      <Style Selector="^ /template/ Border#RootGrid">
        <Setter Property="Background" Value="{DynamicResource CheckBoxBackgroundUncheckedPointerOver}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrushUncheckedPointerOver}" />
      </Style>
      <Style Selector="^ /template/ Rectangle#NormalRectangle">
        <Setter Property="Stroke" Value="{DynamicResource CheckBoxCheckBackgroundStrokeUncheckedPointerOver}" />
        <Setter Property="Fill" Value="{DynamicResource CheckBoxCheckBackgroundFillUncheckedPointerOver}" />
      </Style>
      <Style Selector="^ /template/ Path#CheckGlyph">
        <Setter Property="Fill" Value="{DynamicResource CheckBoxCheckGlyphForegroundUncheckedPointerOver}" />
      </Style>
    </Style>
    <!-- UncheckedPressed -->
    <Style Selector="^:pressed">
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource CheckBoxForegroundUncheckedPressed}" />
      </Style>
      <Style Selector="^ /template/ Border#RootGrid">
        <Setter Property="Background" Value="{DynamicResource CheckBoxBackgroundUncheckedPressed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrushUncheckedPressed}" />
      </Style>
      <Style Selector="^ /template/ Rectangle#NormalRectangle">
        <Setter Property="Stroke" Value="{DynamicResource CheckBoxCheckBackgroundStrokeUncheckedPressed}" />
        <Setter Property="Fill" Value="{DynamicResource CheckBoxCheckBackgroundFillUncheckedPressed}" />
      </Style>
      <Style Selector="^ /template/ Path#CheckGlyph">
        <Setter Property="Fill" Value="{DynamicResource CheckBoxCheckGlyphForegroundUncheckedPressed}" />
      </Style>
    </Style>
    <!-- UncheckedDisabled -->
    <Style Selector="^:disabled">
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource CheckBoxForegroundUncheckedDisabled}" />
      </Style>
      <Style Selector="^ /template/ Border#RootGrid">
        <Setter Property="Background" Value="{DynamicResource CheckBoxBackgroundUncheckedDisabled}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrushUncheckedDisabled}" />
      </Style>
      <Style Selector="^ /template/ Rectangle#NormalRectangle">
        <Setter Property="Stroke" Value="{DynamicResource CheckBoxCheckBackgroundStrokeUncheckedDisabled}" />
        <Setter Property="Fill" Value="{DynamicResource CheckBoxCheckBackgroundFillUncheckedDisabled}" />
      </Style>
      <Style Selector="^ /template/ Path#CheckGlyph">
        <Setter Property="Fill" Value="{DynamicResource CheckBoxCheckGlyphForegroundUncheckedDisabled}" />
      </Style>
    </Style>
    <!-- CheckedNormal -->
    <Style Selector="^:checked">
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource CheckBoxForegroundChecked}" />
      </Style>
      <Style Selector="^ /template/ Border#RootGrid">
        <Setter Property="Background" Value="{DynamicResource CheckBoxBackgroundChecked}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrushChecked}" />
      </Style>
      <Style Selector="^ /template/ Rectangle#NormalRectangle">
        <Setter Property="Stroke" Value="{DynamicResource CheckBoxCheckBackgroundStrokeChecked}" />
        <Setter Property="Fill" Value="{DynamicResource CheckBoxCheckBackgroundFillChecked}" />
      </Style>
      <Style Selector="^ /template/ Path#CheckGlyph">
        <Setter Property="Fill" Value="{DynamicResource CheckBoxCheckGlyphForegroundChecked}" />
      </Style>
    </Style>
    <!-- CheckedPointerOver -->
    <Style Selector="^:checked:pointerover">
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource CheckBoxForegroundCheckedPointerOver}" />
      </Style>
      <Style Selector="^ /template/ Border#RootGrid">
        <Setter Property="Background" Value="{DynamicResource CheckBoxBackgroundCheckedPointerOver}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrushCheckedPointerOver}" />
      </Style>
      <Style Selector="^ /template/ Rectangle#NormalRectangle">
        <Setter Property="Stroke" Value="{DynamicResource CheckBoxCheckBackgroundStrokeCheckedPointerOver}" />
        <Setter Property="Fill" Value="{DynamicResource CheckBoxCheckBackgroundFillCheckedPointerOver}" />
      </Style>
      <Style Selector="^ /template/ Path#CheckGlyph">
        <Setter Property="Fill" Value="{DynamicResource CheckBoxCheckGlyphForegroundCheckedPointerOver}" />
      </Style>
    </Style>
    <!-- CheckedPressed -->
    <Style Selector="^:checked:pressed">
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource CheckBoxForegroundCheckedPressed}" />
      </Style>
      <Style Selector="^ /template/ Border#RootGrid">
        <Setter Property="Background" Value="{DynamicResource CheckBoxBackgroundCheckedPressed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrushCheckedPressed}" />
      </Style>
      <Style Selector="^ /template/ Rectangle#NormalRectangle">
        <Setter Property="Stroke" Value="{DynamicResource CheckBoxCheckBackgroundStrokeCheckedPressed}" />
        <Setter Property="Fill" Value="{DynamicResource CheckBoxCheckBackgroundFillCheckedPressed}" />
      </Style>
      <Style Selector="^ /template/ Path#CheckGlyph">
        <Setter Property="Fill" Value="{DynamicResource CheckBoxCheckGlyphForegroundCheckedPressed}" />
      </Style>
    </Style>
    <!-- CheckedDisabled -->
    <Style Selector="^:checked:disabled">
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource CheckBoxForegroundCheckedDisabled}" />
      </Style>
      <Style Selector="^ /template/ Border#RootGrid">
        <Setter Property="Background" Value="{DynamicResource CheckBoxBackgroundCheckedDisabled}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrushCheckedDisabled}" />
      </Style>
      <Style Selector="^ /template/ Rectangle#NormalRectangle">
        <Setter Property="Stroke" Value="{DynamicResource CheckBoxCheckBackgroundStrokeCheckedDisabled}" />
        <Setter Property="Fill" Value="{DynamicResource CheckBoxCheckBackgroundFillCheckedDisabled}" />
      </Style>
      <Style Selector="^ /template/ Path#CheckGlyph">
        <Setter Property="Fill" Value="{DynamicResource CheckBoxCheckGlyphForegroundCheckedDisabled}" />
      </Style>
    </Style>
    <!-- IndeterminateNormal -->
    <Style Selector="^:indeterminate">
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource CheckBoxForegroundIndeterminate}" />
      </Style>
      <Style Selector="^ /template/ Border#RootGrid">
        <Setter Property="Background" Value="{DynamicResource CheckBoxBackgroundIndeterminate}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrushIndeterminate}" />
      </Style>
      <Style Selector="^ /template/ Rectangle#NormalRectangle">
        <Setter Property="Stroke" Value="{DynamicResource CheckBoxCheckBackgroundStrokeIndeterminate}" />
        <Setter Property="Fill" Value="{DynamicResource CheckBoxCheckBackgroundFillIndeterminate}" />
      </Style>
      <Style Selector="^ /template/ Path#CheckGlyph">
        <Setter Property="Fill" Value="{DynamicResource CheckBoxCheckGlyphForegroundIndeterminate}" />
        <Setter Property="Margin" Value="0" />
      </Style>
    </Style>
    <!-- IndeterminatePointerOver -->
    <Style Selector="^:indeterminate:pointerover">
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource CheckBoxForegroundIndeterminatePointerOver}" />
      </Style>
      <Style Selector="^ /template/ Border#RootGrid">
        <Setter Property="Background" Value="{DynamicResource CheckBoxBackgroundIndeterminatePointerOver}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrushIndeterminatePointerOver}" />
      </Style>
      <Style Selector="^ /template/ Rectangle#NormalRectangle">
        <Setter Property="Stroke" Value="{DynamicResource CheckBoxCheckBackgroundStrokeIndeterminatePointerOver}" />
        <Setter Property="Fill" Value="{DynamicResource CheckBoxCheckBackgroundFillIndeterminatePointerOver}" />
      </Style>
      <Style Selector="^ /template/ Path#CheckGlyph">
        <Setter Property="Fill" Value="{DynamicResource CheckBoxCheckGlyphForegroundIndeterminatePointerOver}" />
        <Setter Property="Margin" Value="0" />
      </Style>
    </Style>
    <!-- IndeterminatePressed -->
    <Style Selector="^:indeterminate:pressed">
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource CheckBoxForegroundIndeterminatePressed}" />
      </Style>
      <Style Selector="^ /template/ Border#RootGrid">
        <Setter Property="Background" Value="{DynamicResource CheckBoxBackgroundIndeterminatePressed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrushIndeterminatePressed}" />
      </Style>
      <Style Selector="^ /template/ Rectangle#NormalRectangle">
        <Setter Property="Stroke" Value="{DynamicResource CheckBoxCheckBackgroundStrokeIndeterminatePressed}" />
        <Setter Property="Fill" Value="{DynamicResource CheckBoxCheckBackgroundFillIndeterminatePressed}" />
      </Style>
      <Style Selector="^ /template/ Path#CheckGlyph">
        <Setter Property="Fill" Value="{DynamicResource CheckBoxCheckGlyphForegroundIndeterminatePressed}" />
        <Setter Property="Margin" Value="0" />
      </Style>
    </Style>
    <!-- IndeterminateDisabled -->
    <Style Selector="^:indeterminate:disabled">
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource CheckBoxForegroundIndeterminateDisabled}" />
      </Style>
      <Style Selector="^ /template/ Border#RootGrid">
        <Setter Property="Background" Value="{DynamicResource CheckBoxBackgroundIndeterminateDisabled}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrushIndeterminateDisabled}" />
      </Style>
      <Style Selector="^ /template/ Rectangle#NormalRectangle">
        <Setter Property="Stroke" Value="{DynamicResource CheckBoxCheckBackgroundStrokeIndeterminateDisabled}" />
        <Setter Property="Fill" Value="{DynamicResource CheckBoxCheckBackgroundFillIndeterminateDisabled}" />
      </Style>
      <Style Selector="^ /template/ Path#CheckGlyph">
        <Setter Property="Fill" Value="{DynamicResource CheckBoxCheckGlyphForegroundIndeterminateDisabled}" />
        <Setter Property="Margin" Value="0" />
      </Style>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}" />
</ResourceDictionary>

<!--
  Ported from microsoft-ui-xaml (https://github.com/microsoft/microsoft-ui-xaml),
  commit 7e4b0c2096be402f51cc8f7d203ebf67cff183d0:
    controls/dev/SplitView/SplitView_themeresources.xaml (DefaultSplitViewStyle and the implicit
    style of SplitView; the resources are Resources/SplitView_themeresources.xaml)
  Copyright (c) Microsoft Corporation. Licensed under the MIT License (see NOTICE.md of the crate).

  Translation notes (docs/porting/winui-theme.md, section 4):
  - The Grid PaneRoot (border, corner radius, pane background and its BackgroundTransition) is
    the Panel PART_PaneRoot that FerroUI's SplitView requires (it clips the pane and its bounds
    are the area of the light dismiss), holding a Border PaneRoot of the width of the open pane
    with the background, border and corner radius; the BrushTransition is a transition of the
    background of the border (150 ms, the default duration of a BrushTransition). WinUI's
    BrushTransition interpolates only solid colour brushes and changes any other brush at once: it
    is a SolidColorBrushTransition (FerroUI's BrushTransition switches a brush it cannot
    interpolate half-way, which left the acrylic background of an overlaying NavigationView pane
    out for the first 75 ms of the opening while the content of the pane was already shown). The
    transition is set by styles, so that an overlay pane keeps its background while it closes
    (DEVIATIONS.md, SPV-7).
  - The states of DisplayModeStates (Closed, ClosedCompactLeft, OpenOverlayLeft, OpenInlineLeft,
    OpenCompactOverlayLeft and the Right ones) are the pseudo-classes FerroUI's SplitView sets:
    the display mode (:inline, :compactinline, :overlay, :compactoverlay), the state of the pane
    (:open, :closed) and the placement (:left, :right, :top, :bottom). The width of the pane
    column and the closed width of the pane are the TemplateSettings of FerroUI's control
    (PaneColumnGridLength, ClosedPaneWidth).
  - The VisualTransitions of DisplayModeStates slide the pane in and out with a translation and
    a moving clip (opening an overlay pane in 350 ms with the key spline 0.1,0.9 0.2,1.0 and
    closing it in 120 ms; opening an inline pane in SplitViewPaneAnimationOpenDuration, 200 ms,
    and closing it in SplitViewPaneAnimationCloseDuration, 100 ms, with the key spline
    0.0,0.35 0.15,1.0): the port animates the width of PART_PaneRoot, which clips the pane, with
    transitions of those durations and easings; the pane keeps the width of the open pane, so
    its content is revealed, not laid out again. The fade of the light dismiss layer is not
    reproduced.
  - The pane placement Top and Bottom of FerroUI has no counterpart in WinUI: those templates are
    the left one turned by a quarter, with the height of the pane animated.
  - The base template is the one of the left placement; the nested styles of the other
    placements replace it.
-->
<ResourceDictionary xmlns="https://github.com/ferroui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Width="400" Height="300">
      <SplitView DisplayMode="Inline" IsPaneOpen="True" OpenPaneLength="160">
        <SplitView.Pane>
          <TextBlock Text="The pane" Margin="12" />
        </SplitView.Pane>
        <TextBlock Text="The content" Margin="12" />
      </SplitView>
    </Border>
  </Design.PreviewWith>

  <ControlTheme x:Key="DefaultSplitViewStyle" TargetType="SplitView">
    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundTransparentBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource SplitViewLeftBorderThemeThickness}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="OpenPaneLength" Value="{DynamicResource SplitViewOpenPaneThemeLength}" />
    <Setter Property="CompactPaneLength" Value="{DynamicResource SplitViewCompactPaneThemeLength}" />
    <Setter Property="PaneBackground" Value="{DynamicResource SystemControlPageBackgroundChromeLowBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource SplitViewPaneRootCornerRadius}" />
    <!-- The pane at the left (the only placement of WinUI). -->
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="{TemplateBinding Background}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.PaneColumnGridLength}" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- Pane Content Area -->
          <Panel Name="PART_PaneRoot"
                 ClipToBounds="True"
                 HorizontalAlignment="Left"
                 ZIndex="1">
            <Border x:Name="PaneRoot"
                    Width="{TemplateBinding OpenPaneLength}"
                    HorizontalAlignment="Left"
                    Background="{TemplateBinding PaneBackground}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BackgroundSizing="InnerBorderEdge"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
              <Panel>
                <ContentPresenter x:Name="PART_PanePresenter"
                                  Content="{TemplateBinding Pane}"
                                  ContentTemplate="{TemplateBinding PaneTemplate}" />
                <Rectangle x:Name="HCPaneBorder"
                           IsVisible="False"
                           Fill="{DynamicResource SystemControlForegroundTransparentBrush}"
                           Width="1"
                           HorizontalAlignment="Right" />
              </Panel>
            </Border>
          </Panel>

          <!-- Content Area -->
          <Panel x:Name="ContentRoot" Grid.Column="1">
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <Rectangle x:Name="LightDismissLayer" Fill="Transparent" IsVisible="False" />
          </Panel>
        </Grid>
      </ControlTemplate>
    </Setter>

    <!-- The pane over the content (Overlay, CompactOverlay) or beside it (Inline, CompactInline):
         the columns of ClosedCompactLeft, OpenInlineLeft and OpenCompactOverlayLeft. -->
    <Style Selector="^:left">
      <Style Selector="^:overlay">
        <Style Selector="^ /template/ Panel#PART_PaneRoot">
          <Setter Property="Grid.Column" Value="0" />
          <Setter Property="Grid.ColumnSpan" Value="2" />
        </Style>
        <Style Selector="^ /template/ Panel#ContentRoot">
          <Setter Property="Grid.Column" Value="0" />
          <Setter Property="Grid.ColumnSpan" Value="2" />
        </Style>
      </Style>
      <Style Selector="^:compactoverlay">
        <Style Selector="^ /template/ Panel#PART_PaneRoot">
          <Setter Property="Grid.Column" Value="0" />
          <Setter Property="Grid.ColumnSpan" Value="2" />
        </Style>
      </Style>
    </Style>

    <!-- The pane at the right: the states ClosedCompactRight, OpenOverlayRight, OpenInlineRight
         and OpenCompactOverlayRight. -->
    <Style Selector="^:right">
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Background="{TemplateBinding Background}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.PaneColumnGridLength}" />
            </Grid.ColumnDefinitions>

            <Panel Name="PART_PaneRoot"
                   Grid.Column="1"
                   ClipToBounds="True"
                   HorizontalAlignment="Right"
                   ZIndex="1">
              <Border x:Name="PaneRoot"
                      Width="{TemplateBinding OpenPaneLength}"
                      HorizontalAlignment="Right"
                      Background="{TemplateBinding PaneBackground}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BackgroundSizing="InnerBorderEdge"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{TemplateBinding CornerRadius}">
                <Panel>
                  <ContentPresenter x:Name="PART_PanePresenter"
                                    Content="{TemplateBinding Pane}"
                                    ContentTemplate="{TemplateBinding PaneTemplate}" />
                  <Rectangle x:Name="HCPaneBorder"
                             IsVisible="False"
                             Fill="{DynamicResource SystemControlForegroundTransparentBrush}"
                             Width="1"
                             HorizontalAlignment="Left" />
                </Panel>
              </Border>
            </Panel>

            <Panel x:Name="ContentRoot" Grid.Column="0">
              <ContentPresenter x:Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
              <Rectangle x:Name="LightDismissLayer" Fill="Transparent" IsVisible="False" />
            </Panel>
          </Grid>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:overlay">
        <Style Selector="^ /template/ Panel#PART_PaneRoot">
          <Setter Property="Grid.Column" Value="0" />
          <Setter Property="Grid.ColumnSpan" Value="2" />
        </Style>
        <Style Selector="^ /template/ Panel#ContentRoot">
          <Setter Property="Grid.Column" Value="0" />
          <Setter Property="Grid.ColumnSpan" Value="2" />
        </Style>
      </Style>
      <Style Selector="^:compactoverlay">
        <Style Selector="^ /template/ Panel#PART_PaneRoot">
          <Setter Property="Grid.Column" Value="0" />
          <Setter Property="Grid.ColumnSpan" Value="2" />
        </Style>
      </Style>
    </Style>

    <!-- The pane at the top (FerroUI only). -->
    <Style Selector="^:top">
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Background="{TemplateBinding Background}">
            <Grid.RowDefinitions>
              <RowDefinition Height="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.PaneRowGridLength}" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Panel Name="PART_PaneRoot"
                   ClipToBounds="True"
                   VerticalAlignment="Top"
                   ZIndex="1">
              <Border x:Name="PaneRoot"
                      Height="{TemplateBinding OpenPaneLength}"
                      VerticalAlignment="Top"
                      Background="{TemplateBinding PaneBackground}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BackgroundSizing="InnerBorderEdge"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{TemplateBinding CornerRadius}">
                <Panel>
                  <ContentPresenter x:Name="PART_PanePresenter"
                                    Content="{TemplateBinding Pane}"
                                    ContentTemplate="{TemplateBinding PaneTemplate}" />
                  <Rectangle x:Name="HCPaneBorder"
                             IsVisible="False"
                             Fill="{DynamicResource SystemControlForegroundTransparentBrush}"
                             Height="1"
                             VerticalAlignment="Bottom" />
                </Panel>
              </Border>
            </Panel>

            <Panel x:Name="ContentRoot" Grid.Row="1">
              <ContentPresenter x:Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
              <Rectangle x:Name="LightDismissLayer" Fill="Transparent" IsVisible="False" />
            </Panel>
          </Grid>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:overlay">
        <Style Selector="^ /template/ Panel#PART_PaneRoot">
          <Setter Property="Grid.Row" Value="0" />
          <Setter Property="Grid.RowSpan" Value="2" />
        </Style>
        <Style Selector="^ /template/ Panel#ContentRoot">
          <Setter Property="Grid.Row" Value="0" />
          <Setter Property="Grid.RowSpan" Value="2" />
        </Style>
      </Style>
      <Style Selector="^:compactoverlay">
        <Style Selector="^ /template/ Panel#PART_PaneRoot">
          <Setter Property="Grid.Row" Value="0" />
          <Setter Property="Grid.RowSpan" Value="2" />
        </Style>
      </Style>
    </Style>

    <!-- The pane at the bottom (FerroUI only). -->
    <Style Selector="^:bottom">
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Background="{TemplateBinding Background}">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.PaneRowGridLength}" />
            </Grid.RowDefinitions>

            <Panel Name="PART_PaneRoot"
                   Grid.Row="1"
                   ClipToBounds="True"
                   VerticalAlignment="Bottom"
                   ZIndex="1">
              <Border x:Name="PaneRoot"
                      Height="{TemplateBinding OpenPaneLength}"
                      VerticalAlignment="Bottom"
                      Background="{TemplateBinding PaneBackground}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BackgroundSizing="InnerBorderEdge"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{TemplateBinding CornerRadius}">
                <Panel>
                  <ContentPresenter x:Name="PART_PanePresenter"
                                    Content="{TemplateBinding Pane}"
                                    ContentTemplate="{TemplateBinding PaneTemplate}" />
                  <Rectangle x:Name="HCPaneBorder"
                             IsVisible="False"
                             Fill="{DynamicResource SystemControlForegroundTransparentBrush}"
                             Height="1"
                             VerticalAlignment="Top" />
                </Panel>
              </Border>
            </Panel>

            <Panel x:Name="ContentRoot" Grid.Row="0">
              <ContentPresenter x:Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
              <Rectangle x:Name="LightDismissLayer" Fill="Transparent" IsVisible="False" />
            </Panel>
          </Grid>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:overlay">
        <Style Selector="^ /template/ Panel#PART_PaneRoot">
          <Setter Property="Grid.Row" Value="0" />
          <Setter Property="Grid.RowSpan" Value="2" />
        </Style>
        <Style Selector="^ /template/ Panel#ContentRoot">
          <Setter Property="Grid.Row" Value="0" />
          <Setter Property="Grid.RowSpan" Value="2" />
        </Style>
      </Style>
      <Style Selector="^:compactoverlay">
        <Style Selector="^ /template/ Panel#PART_PaneRoot">
          <Setter Property="Grid.Row" Value="0" />
          <Setter Property="Grid.RowSpan" Value="2" />
        </Style>
      </Style>
    </Style>

    <!-- The size of the pane: the open length, or the closed one (0, or CompactPaneLength in the
         compact modes). -->
    <Style Selector="^:left:open /template/ Panel#PART_PaneRoot, ^:right:open /template/ Panel#PART_PaneRoot">
      <Setter Property="Width" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=OpenPaneLength}" />
    </Style>
    <Style Selector="^:left:closed /template/ Panel#PART_PaneRoot, ^:right:closed /template/ Panel#PART_PaneRoot">
      <Setter Property="Width" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.ClosedPaneWidth}" />
    </Style>
    <Style Selector="^:top:open /template/ Panel#PART_PaneRoot, ^:bottom:open /template/ Panel#PART_PaneRoot">
      <Setter Property="Height" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=OpenPaneLength}" />
    </Style>
    <Style Selector="^:top:closed /template/ Panel#PART_PaneRoot, ^:bottom:closed /template/ Panel#PART_PaneRoot">
      <Setter Property="Height" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.ClosedPaneHeight}" />
    </Style>

    <!-- The VisualTransitions of DisplayModeStates. Inline panes: Closed to OpenInline in
         SplitViewPaneAnimationOpenDuration and back in SplitViewPaneAnimationCloseDuration, key
         spline 0.0,0.35 0.15,1.0. -->
    <Style Selector="^:inline:open /template/ Panel#PART_PaneRoot, ^:compactinline:open /template/ Panel#PART_PaneRoot">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.2" Easing="0.0,0.35,0.15,1.0" />
          <DoubleTransition Property="Height" Duration="0:0:0.2" Easing="0.0,0.35,0.15,1.0" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^:inline:closed /template/ Panel#PART_PaneRoot, ^:compactinline:closed /template/ Panel#PART_PaneRoot">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.1" Easing="0.0,0.35,0.15,1.0" />
          <DoubleTransition Property="Height" Duration="0:0:0.1" Easing="0.0,0.35,0.15,1.0" />
        </Transitions>
      </Setter>
    </Style>
    <!-- Overlay panes: opened in 350 ms and closed in 120 ms, key spline 0.1,0.9 0.2,1.0. -->
    <Style Selector="^:overlay:open /template/ Panel#PART_PaneRoot, ^:compactoverlay:open /template/ Panel#PART_PaneRoot">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.35" Easing="0.1,0.9,0.2,1.0" />
          <DoubleTransition Property="Height" Duration="0:0:0.35" Easing="0.1,0.9,0.2,1.0" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^:overlay:closed /template/ Panel#PART_PaneRoot, ^:compactoverlay:closed /template/ Panel#PART_PaneRoot">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.12" Easing="0.1,0.9,0.2,1.0" />
          <DoubleTransition Property="Height" Duration="0:0:0.12" Easing="0.1,0.9,0.2,1.0" />
        </Transitions>
      </Setter>
    </Style>

    <!-- The BackgroundTransition of the Grid PaneRoot (a BrushTransition of 150 ms, the default
         duration): solid colour brushes are interpolated, any other change of the background (to or
         from the acrylic of an overlaying NavigationView pane) is immediate, as in WinUI. -->
    <Style Selector="^ /template/ Border#PaneRoot">
      <Setter Property="Transitions">
        <Transitions>
          <SolidColorBrushTransition Property="Background" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <!-- Not in WinUI (DEVIATIONS.md, SPV-7): an overlay pane keeps its background while it closes
         (120 ms, the closing transition), so the content of the pane is not drawn over the content
         without a background. WinUI changes the background at once (NavigationView's
         PaneNotOverlaying) and slides the pane out over the content. -->
    <Style Selector="^:overlay:closed /template/ Border#PaneRoot, ^:compactoverlay:closed /template/ Border#PaneRoot">
      <Setter Property="Transitions">
        <Transitions>
          <SolidColorBrushTransition Property="Background" Delay="0:0:0.12" Duration="0:0:0" />
        </Transitions>
      </Setter>
    </Style>

    <!-- The open states show the high contrast border of the pane. -->
    <Style Selector="^:open /template/ Rectangle#HCPaneBorder">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <!-- OpenOverlay and OpenCompactOverlay show the light dismiss layer; OverlayVisible
         (LightDismissOverlayMode) fills it. -->
    <Style Selector="^:overlay:open /template/ Rectangle#LightDismissLayer, ^:compactoverlay:open /template/ Rectangle#LightDismissLayer">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:lightDismiss /template/ Rectangle#LightDismissLayer">
      <Setter Property="Fill" Value="{DynamicResource SplitViewLightDismissOverlayBackground}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type SplitView}" TargetType="SplitView" BasedOn="{StaticResource DefaultSplitViewStyle}" />
</ResourceDictionary>

<!--
  Ported from microsoft-ui-xaml (https://github.com/microsoft/microsoft-ui-xaml),
  commit 7e4b0c2096be402f51cc8f7d203ebf67cff183d0:
    controls/dev/CommonStyles/TimePicker_themeresources.xaml (the implicit styles of TimePicker,
    with its template-local TimePickerFlyoutButtonStyle, and of TimePickerFlyoutPresenter; its
    resources are Resources/TimePicker_themeresources.xaml)
    controls/dev/CommonStyles/DateTimePickerFlyout_themeresources.xaml (the template of
    DefaultLoopingSelectorStyle, written into the hosts of the presenter; the themes of the buttons
    and the items are in Controls/DateTimePickerShared.xaml)
  Copyright (c) Microsoft Corporation. Licensed under the MIT License (see NOTICE.md of the crate).

  Translation notes (docs/porting/winui-theme.md, section 4):
  - Template parts of TimePicker: FlyoutButton, FlyoutButtonContentGrid, FirstPickerHost,
    SecondPickerHost, ThirdPickerHost, HourTextBlock, MinuteTextBlock, PeriodTextBlock,
    FirstColumnDivider and SecondColumnDivider are PART_FlyoutButton,
    PART_FlyoutButtonContentGrid, PART_FirstPickerHost, PART_SecondPickerHost, PART_ThirdPickerHost,
    PART_HourTextBlock, PART_MinuteTextBlock, PART_PeriodTextBlock, PART_FirstColumnDivider and
    PART_SecondColumnDivider. FerroUI's TimePicker can show seconds (UseSeconds): it has a fourth
    host and a third divider (PART_FourthPickerHost, PART_ThirdColumnDivider) and the text block
    PART_SecondTextBlock; the seconds are the third host, the period the fourth. The control sets the
    columns (* for a host, Auto for a divider) and the visibility of the hosts in code.
  - WinUI's TimePickerFlyout is a flyout the control creates in code; FerroUI's TimePicker has the
    Popup PART_Popup with the TimePickerPresenter PART_PickerPresenter in its template.
  - The texts of the placeholders are the localized strings of WinUI ("hour", "minute",
    TEXT_TIMEPICKER_*_PLACEHOLDER of dxaml/xcp/dxaml/dllsrv/winrt/Microsoft.UI.Xaml.Common.rc) in
    English, and "second" for the seconds of FerroUI; the period without a time is set by the control
    (the designator of the current time, where WinUI shows "AM").
  - The template-local TimePickerFlyoutButtonStyle is the keyed theme of the same name; its
    ContentPresenter is PART_ContentPresenter.
  - HasTimeStates: HasNoTime is FerroUI's :hasnotime.
  - The MinWidth and MaxWidth of the flyout button (TimePickerThemeMinWidth, TimePickerThemeMaxWidth) are
    setters of the control bound to the button, so that the sizes of FerroUI's control apply.
  - The focus visual, the header and the properties without a counterpart are as for DatePicker
    (Controls/DatePicker.xaml).
  - The FerroUI contract: the template is wrapped in DataValidationErrors, which shows the errors
    of FerroUI's data validation under the control, and :error gives the border the critical brush
    (SystemFillColorCriticalBrush), as the Fluent theme does and as Controls/TextBox.xaml does.
  - Template parts of TimePickerPresenter: the LoopingSelectors the WinUI presenter creates in code
    and puts into FirstPickerHost, SecondPickerHost and ThirdPickerHost are the host panels
    PART_HourHost, PART_MinuteHost, PART_SecondHost and PART_PeriodHost, each with the template of
    DefaultLoopingSelectorStyle (as DatePickerPresenter); PickerHostGrid is PART_PickerContainer;
    FirstPickerSpacing and SecondPickerSpacing are PART_FirstSpacer and PART_SecondSpacer, and
    PART_ThirdSpacer is the divider of the seconds.
  - HighlightRect (a Grid with a background and a corner radius) is a Border, under the items; the
    three MonochromaticOverlayPresenters (with the background of the highlight, 3 px inside each
    column) that draw the selected items again in TimePickerFlyoutPresenterHighlightForegroundColor
    are the selected state of the items (Controls/DateTimePickerShared.xaml).
  - The accept button has the margin DatePickerFlyoutPresenterDismissMargin, as in the source.
  - The ThemeShadow of the flyout (a Translation.Z of 32, as DatePickerFlyoutPresenter) is the
    ThemeShadow (the shared WinUIThemeShadow, Translation.Z 32) on the border Background of the presenter, and the margin
    ThemeShadowFlyoutMargin of PART_PickerPresenter is the room for it in the popup
    (Resources/ThemeShadows.xaml; DEVIATIONS.md, G-24).
-->
<ResourceDictionary xmlns="https://github.com/ferroui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Padding="20" Height="500">
      <StackPanel Spacing="20" VerticalAlignment="Center">
        <TimePicker />
        <TimePicker IsEnabled="False" />
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <!-- TimePickerFlyoutButtonStyle of the template of the implicit style of TimePicker. -->
  <ControlTheme x:Key="TimePickerFlyoutButtonStyle" TargetType="Button">
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            Foreground="{TemplateBinding Foreground}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BackgroundSizing="InnerBorderEdge"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Content="{TemplateBinding Content}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            CornerRadius="{TemplateBinding CornerRadius}" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- PointerOver -->
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TimePickerButtonBackgroundPointerOver}" />
      <Setter Property="Foreground" Value="{DynamicResource TimePickerButtonForegroundPointerOver}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TimePickerButtonBorderBrushPointerOver}" />
    </Style>
    <!-- Pressed -->
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TimePickerButtonBackgroundPressed}" />
      <Setter Property="Foreground" Value="{DynamicResource TimePickerButtonForegroundPressed}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TimePickerButtonBorderBrushPressed}" />
    </Style>
    <!-- Disabled -->
    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TimePickerButtonBackgroundDisabled}" />
      <Setter Property="Foreground" Value="{DynamicResource TimePickerButtonForegroundDisabled}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TimePickerButtonBorderBrushDisabled}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TimePicker}" TargetType="TimePicker">
    <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
    <Setter Property="Background" Value="{DynamicResource DatePickerButtonBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource TimePickerButtonForeground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DatePickerButtonBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource DatePickerBorderThemeThickness}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <!-- MinWidth and MaxWidth of the flyout button in the source, bound to it from the control. -->
    <Setter Property="MinWidth" Value="{StaticResource TimePickerThemeMinWidth}" />
    <Setter Property="MaxWidth" Value="{StaticResource TimePickerThemeMaxWidth}" />
    <!-- UseSystemFocusVisuals with FocusVisualMargin="-3", around the flyout button. -->
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border Margin="-3"
                BorderThickness="2"
                BorderBrush="{DynamicResource SystemControlFocusVisualPrimaryBrush}"
                CornerRadius="{DynamicResource ControlCornerRadius}">
          <Border BorderThickness="1"
                  BorderBrush="{DynamicResource SystemControlFocusVisualSecondaryBrush}"
                  CornerRadius="{DynamicResource ControlCornerRadius}" />
        </Border>
      </FocusAdornerTemplate>
    </Setter>
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The errors of FerroUI's data validation under the control (DataValidationErrors.xaml). -->
        <DataValidationErrors>
          <Grid x:Name="LayoutRoot" Margin="{TemplateBinding Padding}">
            <Button x:Name="PART_FlyoutButton"
                    Theme="{StaticResource TimePickerFlyoutButtonStyle}"
                    Background="{TemplateBinding Background}"
                    Foreground="{TemplateBinding Foreground}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    IsEnabled="{TemplateBinding IsEnabled}"
                    MinWidth="{TemplateBinding MinWidth}"
                    MaxWidth="{TemplateBinding MaxWidth}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Top"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    TemplatedControl.IsTemplateFocusTarget="True">
              <!-- The columns are set by the control. -->
              <Grid x:Name="PART_FlyoutButtonContentGrid">
                <Border x:Name="PART_FirstPickerHost" Grid.Column="0">
                  <TextBlock x:Name="PART_HourTextBlock"
                             Text="hour"
                             TextAlignment="Center"
                             Padding="{DynamicResource TimePickerHostPadding}"
                             FontFamily="{TemplateBinding FontFamily}"
                             FontWeight="{TemplateBinding FontWeight}"
                             FontSize="{TemplateBinding FontSize}" />
                </Border>
                <Rectangle x:Name="PART_FirstColumnDivider"
                           Fill="{DynamicResource TimePickerSpacerFill}"
                           HorizontalAlignment="Center"
                           Width="{DynamicResource TimePickerSpacerThemeWidth}"
                           Grid.Column="1" />
                <Border x:Name="PART_SecondPickerHost" Grid.Column="2">
                  <TextBlock x:Name="PART_MinuteTextBlock"
                             Text="minute"
                             TextAlignment="Center"
                             Padding="{DynamicResource TimePickerHostPadding}"
                             FontFamily="{TemplateBinding FontFamily}"
                             FontWeight="{TemplateBinding FontWeight}"
                             FontSize="{TemplateBinding FontSize}" />
                </Border>
                <Rectangle x:Name="PART_SecondColumnDivider"
                           Fill="{DynamicResource TimePickerSpacerFill}"
                           HorizontalAlignment="Center"
                           Width="{DynamicResource TimePickerSpacerThemeWidth}"
                           Grid.Column="3" />
                <Border x:Name="PART_ThirdPickerHost" Grid.Column="4">
                  <TextBlock x:Name="PART_SecondTextBlock"
                             Text="second"
                             TextAlignment="Center"
                             Padding="{DynamicResource TimePickerHostPadding}"
                             FontFamily="{TemplateBinding FontFamily}"
                             FontWeight="{TemplateBinding FontWeight}"
                             FontSize="{TemplateBinding FontSize}" />
                </Border>
                <Rectangle x:Name="PART_ThirdColumnDivider"
                           Fill="{DynamicResource TimePickerSpacerFill}"
                           HorizontalAlignment="Center"
                           Width="{DynamicResource TimePickerSpacerThemeWidth}"
                           Grid.Column="5" />
                <Border x:Name="PART_FourthPickerHost" Grid.Column="6">
                  <TextBlock x:Name="PART_PeriodTextBlock"
                             TextAlignment="Center"
                             Padding="{DynamicResource TimePickerHostPadding}"
                             FontFamily="{TemplateBinding FontFamily}"
                             FontWeight="{TemplateBinding FontWeight}"
                             FontSize="{TemplateBinding FontSize}" />
                </Border>
              </Grid>
            </Button>
            <Popup x:Name="PART_Popup"
                   WindowManagerAddShadowHint="False"
                   IsLightDismissEnabled="True"
                   PlacementTarget="{TemplateBinding}"
                   Placement="Bottom">
              <TimePickerPresenter x:Name="PART_PickerPresenter" Margin="{StaticResource ThemeShadowFlyoutMargin}" />
            </Popup>
          </Grid>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>

    <!-- The vertical alignment of the texts (FerroUI's VerticalContentAlignment of the control). -->
    <Style Selector="^ /template/ Button#PART_FlyoutButton TextBlock">
      <Setter Property="VerticalAlignment" Value="{TemplateBinding VerticalContentAlignment}" />
    </Style>
    <!-- Disabled -->
    <Style Selector="^:disabled">
      <Style Selector="^ /template/ Rectangle#PART_FirstColumnDivider">
        <Setter Property="Fill" Value="{DynamicResource TimePickerSpacerFillDisabled}" />
      </Style>
      <Style Selector="^ /template/ Rectangle#PART_SecondColumnDivider">
        <Setter Property="Fill" Value="{DynamicResource TimePickerSpacerFillDisabled}" />
      </Style>
      <Style Selector="^ /template/ Rectangle#PART_ThirdColumnDivider">
        <Setter Property="Fill" Value="{DynamicResource TimePickerSpacerFillDisabled}" />
      </Style>
    </Style>
    <!-- HasNoTime -->
    <Style Selector="^:hasnotime /template/ Button#PART_FlyoutButton">
      <Setter Property="Foreground" Value="{DynamicResource TimePickerButtonForegroundDefault}" />
    </Style>
    <!-- Not in WinUI: the :error of FerroUI's data validation (as the text box). -->
    <Style Selector="^:error /template/ Button#PART_FlyoutButton">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TimePickerPresenter}" TargetType="TimePickerPresenter">
    <!-- The shadow is drawn outside the bounds of the control: a templated control clips to its
         bounds unless its theme says otherwise (G-24). -->
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Width" Value="242" />
    <Setter Property="MinWidth" Value="242" />
    <Setter Property="MaxHeight" Value="398" />
    <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Background" Value="{DynamicResource TimePickerFlyoutPresenterBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TimePickerFlyoutPresenterBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource DateTimeFlyoutBorderThickness}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="Background"
                Translation="0,0,32" Shadow="{StaticResource WinUIThemeShadow}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{DynamicResource DateTimeFlyoutBorderPadding}"
                MaxHeight="398">
          <Grid x:Name="ContentPanel" RowDefinitions="*,Auto">
            <!-- The columns are set by the presenter. -->
            <Grid x:Name="PART_PickerContainer">
              <Grid.Styles>
                <Style Selector="DateTimePickerPanel > ListBoxItem">
                  <Setter Property="Theme" Value="{StaticResource DateTimePickerLoopingSelectorItemStyle}" />
                </Style>
              </Grid.Styles>
              <Border x:Name="HighlightRect"
                      ZIndex="-1"
                      Background="{DynamicResource TimePickerFlyoutPresenterHighlightFill}"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      Grid.Column="0"
                      Grid.ColumnSpan="7"
                      VerticalAlignment="Center"
                      Height="{DynamicResource TimePickerFlyoutPresenterHighlightHeight}"
                      Margin="4,2,4,2"
                      IsHitTestVisible="False" />
              <Grid x:Name="PART_HourHost" Grid.Column="0">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden"
                              Template="{StaticResource ScrollViewerScrollBarlessTemplate}">
                  <DateTimePickerPanel x:Name="PART_HourSelector"
                                       PanelType="Hour"
                                       ShouldLoop="True"
                                       ItemHeight="{DynamicResource TimePickerFlyoutPresenterItemHeight}" />
                </ScrollViewer>
                <RepeatButton x:Name="PART_HourUpButton" Theme="{StaticResource DateTimePickerLoopingSelectorUpButtonStyle}" />
                <RepeatButton x:Name="PART_HourDownButton" Theme="{StaticResource DateTimePickerLoopingSelectorDownButtonStyle}" />
              </Grid>
              <Rectangle x:Name="PART_FirstSpacer"
                         ZIndex="10000"
                         Fill="{DynamicResource TimePickerFlyoutPresenterSpacerFill}"
                         HorizontalAlignment="Center"
                         Width="{DynamicResource TimePickerSpacerThemeWidth}"
                         Grid.Column="1" />
              <Grid x:Name="PART_MinuteHost" Grid.Column="2">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden"
                              Template="{StaticResource ScrollViewerScrollBarlessTemplate}">
                  <DateTimePickerPanel x:Name="PART_MinuteSelector"
                                       PanelType="Minute"
                                       ShouldLoop="True"
                                       ItemHeight="{DynamicResource TimePickerFlyoutPresenterItemHeight}" />
                </ScrollViewer>
                <RepeatButton x:Name="PART_MinuteUpButton" Theme="{StaticResource DateTimePickerLoopingSelectorUpButtonStyle}" />
                <RepeatButton x:Name="PART_MinuteDownButton" Theme="{StaticResource DateTimePickerLoopingSelectorDownButtonStyle}" />
              </Grid>
              <Rectangle x:Name="PART_SecondSpacer"
                         ZIndex="10000"
                         Fill="{DynamicResource TimePickerFlyoutPresenterSpacerFill}"
                         HorizontalAlignment="Center"
                         Width="{DynamicResource TimePickerSpacerThemeWidth}"
                         Grid.Column="3" />
              <Grid x:Name="PART_SecondHost" Grid.Column="4">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden"
                              Template="{StaticResource ScrollViewerScrollBarlessTemplate}">
                  <DateTimePickerPanel x:Name="PART_SecondSelector"
                                       PanelType="Second"
                                       ShouldLoop="True"
                                       ItemHeight="{DynamicResource TimePickerFlyoutPresenterItemHeight}" />
                </ScrollViewer>
                <RepeatButton x:Name="PART_SecondUpButton" Theme="{StaticResource DateTimePickerLoopingSelectorUpButtonStyle}" />
                <RepeatButton x:Name="PART_SecondDownButton" Theme="{StaticResource DateTimePickerLoopingSelectorDownButtonStyle}" />
              </Grid>
              <Rectangle x:Name="PART_ThirdSpacer"
                         ZIndex="10000"
                         Fill="{DynamicResource TimePickerFlyoutPresenterSpacerFill}"
                         HorizontalAlignment="Center"
                         Width="{DynamicResource TimePickerSpacerThemeWidth}"
                         Grid.Column="5" />
              <Grid x:Name="PART_PeriodHost" Grid.Column="6">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden"
                              Template="{StaticResource ScrollViewerScrollBarlessTemplate}">
                  <DateTimePickerPanel x:Name="PART_PeriodSelector"
                                       PanelType="TimePeriod"
                                       ShouldLoop="False"
                                       ItemHeight="{DynamicResource TimePickerFlyoutPresenterItemHeight}" />
                </ScrollViewer>
                <RepeatButton x:Name="PART_PeriodUpButton" Theme="{StaticResource DateTimePickerLoopingSelectorUpButtonStyle}" />
                <RepeatButton x:Name="PART_PeriodDownButton" Theme="{StaticResource DateTimePickerLoopingSelectorDownButtonStyle}" />
              </Grid>
            </Grid>
            <Grid x:Name="AcceptDismissHostGrid"
                  Grid.Row="1"
                  Height="{DynamicResource TimePickerFlyoutPresenterAcceptDismissHostGridHeight}"
                  ColumnDefinitions="*,*">
              <Rectangle Height="{DynamicResource TimePickerSpacerThemeWidth}"
                         VerticalAlignment="Top"
                         Fill="{DynamicResource TimePickerFlyoutPresenterSpacerFill}"
                         Grid.ColumnSpan="2" />
              <Button x:Name="PART_AcceptButton"
                      Grid.Column="0"
                      Theme="{StaticResource DateTimePickerFlyoutButtonStyle}"
                      FontSize="16"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      Margin="{StaticResource DatePickerFlyoutPresenterDismissMargin}"
                      Padding="4">
                <!-- E8FB at 16 px. -->
                <Path Data="{StaticResource GlyphGeometryE8FB}"
                      Fill="{Binding $parent[Button].Foreground}"
                      Stretch="Uniform"
                      Width="14" />
              </Button>
              <Button x:Name="PART_DismissButton"
                      Grid.Column="1"
                      Theme="{StaticResource DateTimePickerFlyoutButtonStyle}"
                      FontSize="16"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      Margin="{StaticResource DatePickerFlyoutPresenterDismissMargin}"
                      Padding="4">
                <!-- E711 at 16 px. -->
                <Path Data="{StaticResource GlyphGeometryE711}"
                      Fill="{Binding $parent[Button].Foreground}"
                      Stretch="Uniform"
                      Width="12" />
              </Button>
            </Grid>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- PointerOver of DefaultLoopingSelectorStyle: the up and down buttons of the host under the pointer. -->
    <Style Selector="^ /template/ Grid#PART_HourHost:pointerover > RepeatButton">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^ /template/ Grid#PART_MinuteHost:pointerover > RepeatButton">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^ /template/ Grid#PART_SecondHost:pointerover > RepeatButton">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^ /template/ Grid#PART_PeriodHost:pointerover > RepeatButton">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>
</ResourceDictionary>

<!--
  Ported from microsoft-ui-xaml (https://github.com/microsoft/microsoft-ui-xaml),
  commit 7e4b0c2096be402f51cc8f7d203ebf67cff183d0:
    controls/dev/CommonStyles/MenuFlyout_themeresources.xaml (the styles DefaultMenuFlyoutItemStyle,
    DefaultToggleMenuFlyoutItemStyle, DefaultMenuFlyoutSubItemStyle and the template of
    MenuFlyoutSeparator; the resources of the document are Resources/MenuFlyout_themeresources.xaml)
    controls/dev/RadioMenuFlyoutItem/RadioMenuFlyoutItem_themeresources.xaml (the styles
    DefaultRadioMenuFlyoutItemStyle and RadioMenuFlyoutSubItemStyle)
  Copyright (c) Microsoft Corporation. Licensed under the MIT License (see NOTICE.md of the crate).

  Translation notes (docs/porting/winui-theme.md, section 4):
  - FerroUI has one class of menu item where WinUI has four: MenuFlyoutItem, ToggleMenuFlyoutItem,
    RadioMenuFlyoutItem and MenuFlyoutSubItem. A MenuItem is a toggle item when its ToggleType is
    CheckBox (:toggle), a radio item when it is Radio (:radio), and a sub item when it has items
    (:not(MenuItem:empty)). DefaultMenuFlyoutItemStyle holds one template with the parts of the four
    templates (the check glyph of the toggle items, the icon, the text, the keyboard accelerator
    text and the chevron of the sub items) and the states of each kind, the states of a toggle or
    radio item and of a sub item after those of a plain item. The keyed themes of the other kinds
    are based on it: DefaultToggleMenuFlyoutItemStyle and DefaultRadioMenuFlyoutItemStyle set the
    ToggleType of their kind, DefaultMenuFlyoutSubItemStyle the setters of a sub item.
    DefaultSplitMenuFlyoutItemStyle is waived: FerroUI's MenuItem has no split mode.
  - Template parts: TextBlock, the text of the item, is the content presenter PART_HeaderPresenter
    of the header (FerroUI's header is content, with access keys); the popup of a sub item is
    PART_Popup with the items presenter PART_ItemsPresenter. The popup content is the template of
    MenuFlyoutPresenter (WinUI opens a MenuFlyoutPresenter for a sub item); it opens at the right
    edge of the item, 4 px over it (CascadingMenuHelper::m_subMenuOverlapPixels). The shadow of
    the presenter of a sub item (ApplyElevationEffect at the depth 1 of a submenu: a ThemeShadow at
    a Translation.Z of 40) is the BoxShadow ThemeShadowSubMenuBoxShadow of the border
    ThemeShadowWrapper around the border of the popup (a border of its own: a border whose
    background is sized to the inner edge of its border draws no box shadow), with the margin
    ThemeShadowSubMenuMargin as the room for it in the popup; deeper submenus have the same
    shadow (Resources/ThemeShadows.xaml; DEVIATIONS.md, G-24).
  - CheckPlaceholderStates, which the presenter computes from all of its items (the text of every
    item moves by MenuFlyoutItemPlaceholderThemeThickness when one item is a toggle item or has an
    icon), are columns of shared size: the check glyph column (12 px glyph and 16 px margin) and
    the icon column (16 px icon and 12 px margin) take their width in every item of a presenter
    when one item shows them. The keyboard accelerator text column is shared the same way, as
    TemplateSettings.KeyboardAcceleratorTextMinWidth makes the accelerator texts one width; the
    text shows when the item has an InputGesture (KeyboardAcceleratorTextVisible).
  - PointerOver is the :selected state of FerroUI's menus (the item under the pointer or reached
    with the keyboard); Pressed is :pressed while the pointer is over the item's own layout root,
    so that pressing an item of an open submenu does not press its parent.
  - NarrowPadding (PaddingSizeStates) applies always: WinUI uses it when the menu was opened with
    the mouse, the pen or the keyboard and MenuFlyoutItemThemePadding for touch; FerroUI does not
    report the input device that opened a menu. The narrow padding is the Padding of the item
    (the template binds LayoutRoot's padding to it).
  - The glyphs E73E (check), E915 (radio bullet), E974 and E76C (sub item chevrons) are the
    geometries of Resources/Glyphs.xaml at the ink size of the 12 px glyphs.
  - MenuFlyoutItemTextTrimming (Clip) is TextTrimming="None" of the header presenter, which
    clips; FerroUI's TextTrimming has no Clip value to hold in a resource.
    WinUI: MenuFlyoutItemTextTrimming
  - A MenuItem whose Header is "-" (:separator) is drawn with the template of MenuFlyoutSeparator.
  - UseSystemFocusVisuals is the default focus adorner; KeyboardAcceleratorPlacementMode,
    IsTextScaleFactorEnabled and AccessibilityView have no counterpart.
-->
<ResourceDictionary xmlns="https://github.com/ferroui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="using:FerroUI.Controls.Converters"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Padding="20" Width="320">
      <MenuFlyoutPresenter>
        <MenuItem Header="_Standard" InputGesture="Ctrl+S" />
        <MenuItem Header="Selected" IsSelected="True" />
        <MenuItem Header="Toggle" ToggleType="CheckBox" IsChecked="True" />
        <MenuItem Header="Radio" ToggleType="Radio" IsChecked="True" />
        <MenuItem Header="-" />
        <MenuItem Header="Disabled" IsEnabled="False" />
        <MenuItem Header="Parent">
          <MenuItem Header="Child 1" />
          <MenuItem Header="Child 2" />
        </MenuItem>
      </MenuFlyoutPresenter>
    </Border>
  </Design.PreviewWith>

  <converters:PlatformKeyGestureConverter x:Key="MenuItemKeyGestureConverter" />

  <ControlTheme x:Key="DefaultMenuFlyoutItemStyle" TargetType="MenuItem">
    <Setter Property="Background" Value="{DynamicResource MenuFlyoutItemBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MenuFlyoutItemBackgroundBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource MenuFlyoutItemBorderThickness}" />
    <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemForeground}" />
    <!-- MenuFlyoutItemThemePadding, replaced by NarrowPadding of PaddingSizeStates
         (MenuFlyoutItemThemePaddingNarrow), which applies always: set on the item, as a style of
         the template's LayoutRoot would not override its template binding of the padding. -->
    <Setter Property="Padding" Value="{StaticResource MenuFlyoutItemThemePaddingNarrow}" />
    <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border x:Name="LayoutRoot"
                  Padding="{TemplateBinding Padding}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BackgroundSizing="InnerBorderEdge"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Margin="{StaticResource MenuFlyoutItemMargin}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuFlyoutItemCheckPlaceholder" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuFlyoutItemIconPlaceholder" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuFlyoutItemKeyboardAcceleratorText" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <!-- E73E at 12 px in a cell of 12 px, with the margin 0,0,16,0 of the source. -->
              <Path x:Name="CheckGlyph"
                    Grid.Column="0"
                    Data="{StaticResource GlyphGeometryE73E}"
                    Fill="{DynamicResource MenuFlyoutSubItemChevron}"
                    Stretch="Uniform"
                    Width="10"
                    Margin="1,0,17,0"
                    VerticalAlignment="Center"
                    Opacity="0"
                    IsVisible="False" />
              <Viewbox x:Name="IconRoot"
                       Grid.Column="1"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Width="16"
                       Height="16"
                       Margin="0,0,12,0"
                       IsVisible="False">
                <!-- A path icon is unscaled there, as WinUI's, so that the Viewbox scales its
                     geometry as WinUI's does: the icon is a logical child of the item, which a
                     style of this presenter does not reach, so a style of the theme does it for
                     the path icons of menu items (MenuItem > PathIcon, Controls/WinUIControls.xaml, PI-3). -->
                <ContentPresenter x:Name="IconContent"
                                  Content="{TemplateBinding Icon}"
                                  Foreground="{TemplateBinding Foreground}" />
              </Viewbox>
              <ContentPresenter x:Name="PART_HeaderPresenter"
                                Grid.Column="2"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                TextTrimming="None"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
              <TextBlock x:Name="KeyboardAcceleratorTextBlock"
                         Grid.Column="3"
                         Theme="{StaticResource CaptionTextBlockStyle}"
                         Text="{TemplateBinding InputGesture, Converter={StaticResource MenuItemKeyGestureConverter}}"
                         Margin="24,4,0,0"
                         Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"
                         TextAlignment="Right"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         IsVisible="{TemplateBinding InputGesture, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <!-- E974 at 12 px in a cell of 12 px, with the margin MenuFlyoutItemChevronMargin
                   (24,0,0,-1) of the source. -->
              <Path x:Name="SubItemChevron"
                    Grid.Column="4"
                    Data="{StaticResource GlyphGeometryE974}"
                    Fill="{DynamicResource MenuFlyoutSubItemChevron}"
                    Stretch="Uniform"
                    Width="5.5"
                    Margin="27.25,0,3.25,-1"
                    VerticalAlignment="Center"
                    IsVisible="False" />
            </Grid>
          </Border>
          <!-- The submenu: a MenuFlyoutPresenter (DefaultMenuFlyoutPresenterStyle). -->
          <Popup x:Name="PART_Popup"
                 WindowManagerAddShadowHint="False"
                 Placement="RightEdgeAlignedTop"
                 HorizontalOffset="-4"
                 IsLightDismissEnabled="False"
                 IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}">
            <!-- The shadow on a border of its own (G-24). -->
            <Border x:Name="ThemeShadowWrapper"
                    BoxShadow="{DynamicResource ThemeShadowSubMenuBoxShadow}"
                    Margin="{StaticResource ThemeShadowSubMenuMargin}"
                    CornerRadius="{DynamicResource OverlayCornerRadius}">
              <Border Background="{DynamicResource MenuFlyoutPresenterBackground}"
                      BorderBrush="{DynamicResource MenuFlyoutPresenterBorderBrush}"
                      BorderThickness="{DynamicResource MenuFlyoutPresenterBorderThemeThickness}"
                      CornerRadius="{DynamicResource OverlayCornerRadius}"
                      MinWidth="{DynamicResource FlyoutThemeMinWidth}"
                      MinHeight="{StaticResource MenuFlyoutThemeMinHeight}"
                      BackgroundSizing="InnerBorderEdge">
                <ScrollViewer x:Name="MenuFlyoutPresenterScrollViewer"
                              Theme="{StaticResource MenuFlyoutPresenterScrollViewer}"
                              Margin="{StaticResource MenuFlyoutPresenterThemePadding}">
                  <ItemsPresenter x:Name="PART_ItemsPresenter"
                                  ItemsPanel="{TemplateBinding ItemsPanel}"
                                  KeyboardNavigation.TabNavigation="Continue"
                                  Grid.IsSharedSizeScope="True" />
                </ScrollViewer>
              </Border>
            </Border>
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- MenuFlyoutItem: PointerOver -->
    <Style Selector="^:selected">
      <Style Selector="^ /template/ Border#LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource MenuFlyoutItemBackgroundPointerOver}" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemForegroundPointerOver}" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#IconContent">
        <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemForegroundPointerOver}" />
      </Style>
      <Style Selector="^ /template/ TextBlock#KeyboardAcceleratorTextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForegroundPointerOver}" />
      </Style>
    </Style>
    <!-- MenuFlyoutItem: Pressed -->
    <Style Selector="^:pressed /template/ Border#LayoutRoot:pointerover">
      <Setter Property="Background" Value="{DynamicResource MenuFlyoutItemBackgroundPressed}" />
      <Style Selector="^ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemForegroundPressed}" />
      </Style>
      <Style Selector="^ ContentPresenter#IconContent">
        <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemForegroundPressed}" />
      </Style>
      <Style Selector="^ TextBlock#KeyboardAcceleratorTextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForegroundPressed}" />
      </Style>
    </Style>
    <!-- MenuFlyoutItem: Disabled -->
    <Style Selector="^:disabled">
      <Style Selector="^ /template/ Border#LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource MenuFlyoutItemBackgroundDisabled}" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemForegroundDisabled}" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#IconContent">
        <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemForegroundDisabled}" />
      </Style>
      <Style Selector="^ /template/ TextBlock#KeyboardAcceleratorTextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForegroundDisabled}" />
      </Style>
    </Style>

    <!-- IconPlaceholder: the icon column of an item with an icon. -->
    <Style Selector="^:icon /template/ Viewbox#IconRoot">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- ToggleMenuFlyoutItem and RadioMenuFlyoutItem: the check glyph column (CheckPlaceholder),
         the radio bullet E915 of RadioMenuFlyoutItem, and the keyboard accelerator text. -->
    <Style Selector="^:toggle /template/ Path#CheckGlyph, ^:radio /template/ Path#CheckGlyph">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:radio /template/ Path#CheckGlyph">
      <Setter Property="Data" Value="{StaticResource GlyphGeometryE915}" />
      <Setter Property="Width" Value="6" />
      <Setter Property="Margin" Value="3,0,19,0" />
    </Style>
    <Style Selector="^:toggle /template/ TextBlock#KeyboardAcceleratorTextBlock, ^:radio /template/ TextBlock#KeyboardAcceleratorTextBlock">
      <Setter Property="Margin" Value="24,0,0,0" />
      <Setter Property="Foreground" Value="{DynamicResource ToggleMenuFlyoutItemKeyboardAcceleratorTextForeground}" />
    </Style>
    <!-- ToggleMenuFlyoutItem, RadioMenuFlyoutItem: Checked of CheckStates -->
    <Style Selector="^:checked /template/ Path#CheckGlyph">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- ToggleMenuFlyoutItem, RadioMenuFlyoutItem: PointerOver -->
    <Style Selector="^:toggle:selected /template/ Border#LayoutRoot, ^:radio:selected /template/ Border#LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource MenuFlyoutSubItemBackgroundPointerOver}" />
    </Style>
    <Style Selector="^:toggle:selected /template/ ContentPresenter#PART_HeaderPresenter, ^:radio:selected /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemForegroundPointerOver}" />
    </Style>
    <Style Selector="^:toggle:selected /template/ Path#CheckGlyph, ^:radio:selected /template/ Path#CheckGlyph">
      <Setter Property="Fill" Value="{DynamicResource MenuFlyoutItemForegroundPointerOver}" />
    </Style>
    <Style Selector="^:toggle:selected /template/ ContentPresenter#IconContent, ^:radio:selected /template/ ContentPresenter#IconContent">
      <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemForegroundPointerOver}" />
    </Style>
    <Style Selector="^:toggle:selected /template/ TextBlock#KeyboardAcceleratorTextBlock, ^:radio:selected /template/ TextBlock#KeyboardAcceleratorTextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ToggleMenuFlyoutItemKeyboardAcceleratorTextForegroundPointerOver}" />
    </Style>
    <!-- ToggleMenuFlyoutItem, RadioMenuFlyoutItem: Pressed -->
    <Style Selector="^:toggle:pressed /template/ Border#LayoutRoot:pointerover, ^:radio:pressed /template/ Border#LayoutRoot:pointerover">
      <Setter Property="Background" Value="{DynamicResource MenuFlyoutSubItemBackgroundPressed}" />
    </Style>
    <Style Selector="^:toggle:pressed /template/ Border#LayoutRoot:pointerover ContentPresenter#PART_HeaderPresenter, ^:radio:pressed /template/ Border#LayoutRoot:pointerover ContentPresenter#PART_HeaderPresenter">
      <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutSubItemForegroundPressed}" />
    </Style>
    <Style Selector="^:toggle:pressed /template/ Border#LayoutRoot:pointerover Path#CheckGlyph, ^:radio:pressed /template/ Border#LayoutRoot:pointerover Path#CheckGlyph">
      <Setter Property="Fill" Value="{DynamicResource MenuFlyoutSubItemForegroundPressed}" />
    </Style>
    <Style Selector="^:toggle:pressed /template/ Border#LayoutRoot:pointerover ContentPresenter#IconContent, ^:radio:pressed /template/ Border#LayoutRoot:pointerover ContentPresenter#IconContent">
      <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutSubItemForegroundPressed}" />
    </Style>
    <Style Selector="^:toggle:pressed /template/ Border#LayoutRoot:pointerover TextBlock#KeyboardAcceleratorTextBlock, ^:radio:pressed /template/ Border#LayoutRoot:pointerover TextBlock#KeyboardAcceleratorTextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ToggleMenuFlyoutItemKeyboardAcceleratorTextForegroundPressed}" />
    </Style>
    <!-- ToggleMenuFlyoutItem, RadioMenuFlyoutItem: Disabled (which does not set the background
         of the layout root) -->
    <Style Selector="^:toggle:disabled /template/ Border#LayoutRoot">
      <Setter Property="Background" Value="{TemplateBinding Background}" />
    </Style>
    <Style Selector="^:radio:disabled /template/ Border#LayoutRoot">
      <Setter Property="Background" Value="{TemplateBinding Background}" />
    </Style>
    <Style Selector="^:toggle:disabled /template/ ContentPresenter#PART_HeaderPresenter, ^:radio:disabled /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutSubItemForegroundDisabled}" />
    </Style>
    <Style Selector="^:toggle:disabled /template/ Path#CheckGlyph, ^:radio:disabled /template/ Path#CheckGlyph">
      <Setter Property="Fill" Value="{DynamicResource MenuFlyoutSubItemForegroundDisabled}" />
    </Style>
    <Style Selector="^:toggle:disabled /template/ ContentPresenter#IconContent, ^:radio:disabled /template/ ContentPresenter#IconContent">
      <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutSubItemForegroundDisabled}" />
    </Style>
    <Style Selector="^:toggle:disabled /template/ TextBlock#KeyboardAcceleratorTextBlock, ^:radio:disabled /template/ TextBlock#KeyboardAcceleratorTextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ToggleMenuFlyoutItemKeyboardAcceleratorTextForegroundDisabled}" />
    </Style>

    <!-- MenuFlyoutSubItem: the setters of DefaultMenuFlyoutSubItemStyle and the chevron. -->
    <Style Selector="^:not(MenuItem:empty)">
      <Setter Property="Background" Value="{DynamicResource MenuFlyoutSubItemBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MenuFlyoutSubItemBackgroundBrush}" />
      <Setter Property="BorderThickness" Value="{DynamicResource MenuFlyoutSubItemBorderThickness}" />
      <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutSubItemForeground}" />
      <Style Selector="^ /template/ Path#SubItemChevron">
        <Setter Property="IsVisible" Value="True" />
      </Style>
    </Style>
    <!-- MenuFlyoutSubItem: PointerOver -->
    <Style Selector="^:selected:not(MenuItem:empty)">
      <Style Selector="^ /template/ Border#LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource MenuFlyoutSubItemBackgroundPointerOver}" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutSubItemForegroundPointerOver}" />
      </Style>
      <Style Selector="^ /template/ Path#SubItemChevron">
        <Setter Property="Fill" Value="{DynamicResource MenuFlyoutSubItemChevronPointerOver}" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#IconContent">
        <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutSubItemForegroundPointerOver}" />
      </Style>
    </Style>
    <!-- MenuFlyoutSubItem: Pressed -->
    <Style Selector="^:pressed:not(MenuItem:empty) /template/ Border#LayoutRoot:pointerover">
      <Setter Property="Background" Value="{DynamicResource MenuFlyoutSubItemBackgroundPressed}" />
      <Style Selector="^ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutSubItemForegroundPressed}" />
      </Style>
      <Style Selector="^ Path#SubItemChevron">
        <Setter Property="Fill" Value="{DynamicResource MenuFlyoutSubItemChevronPressed}" />
      </Style>
      <Style Selector="^ ContentPresenter#IconContent">
        <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutSubItemForegroundPressed}" />
      </Style>
    </Style>
    <!-- MenuFlyoutSubItem: SubMenuOpened -->
    <Style Selector="^:open:not(MenuItem:empty)">
      <Style Selector="^ /template/ Border#LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource MenuFlyoutSubItemBackgroundSubMenuOpened}" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutSubItemForegroundSubMenuOpened}" />
      </Style>
      <Style Selector="^ /template/ Path#SubItemChevron">
        <Setter Property="Fill" Value="{DynamicResource MenuFlyoutSubItemChevronSubMenuOpened}" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#IconContent">
        <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutSubItemForegroundSubMenuOpened}" />
      </Style>
    </Style>
    <!-- MenuFlyoutSubItem: Disabled -->
    <Style Selector="^:disabled:not(MenuItem:empty)">
      <Style Selector="^ /template/ Border#LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource MenuFlyoutSubItemBackgroundDisabled}" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutSubItemForegroundDisabled}" />
      </Style>
      <Style Selector="^ /template/ Path#SubItemChevron">
        <Setter Property="Fill" Value="{DynamicResource MenuFlyoutSubItemChevronDisabled}" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#IconContent">
        <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutSubItemForegroundDisabled}" />
      </Style>
    </Style>

    <!-- MenuFlyoutSeparator: a menu item whose header is "-". -->
    <Style Selector="^:separator">
      <Setter Property="Template">
        <ControlTemplate>
          <Rectangle x:Name="SeparatorRectangle"
                     Fill="{DynamicResource MenuFlyoutSeparatorBackground}"
                     Margin="{StaticResource MenuFlyoutSeparatorThemePadding}"
                     Height="{StaticResource MenuFlyoutSeparatorHeight}" />
        </ControlTemplate>
      </Setter>
    </Style>
  </ControlTheme>

  <!-- WinUI applies the default style of a control beneath an explicit style, so the keyed
       themes are based on the default theme (docs/porting/winui-theme.md, section 4.2). -->
  <ControlTheme x:Key="DefaultToggleMenuFlyoutItemStyle" TargetType="MenuItem" BasedOn="{StaticResource DefaultMenuFlyoutItemStyle}">
    <Setter Property="ToggleType" Value="CheckBox" />
    <Setter Property="Background" Value="Transparent" />
  </ControlTheme>

  <ControlTheme x:Key="DefaultRadioMenuFlyoutItemStyle" TargetType="MenuItem" BasedOn="{StaticResource DefaultMenuFlyoutItemStyle}">
    <Setter Property="ToggleType" Value="Radio" />
  </ControlTheme>

  <ControlTheme x:Key="DefaultMenuFlyoutSubItemStyle" TargetType="MenuItem" BasedOn="{StaticResource DefaultMenuFlyoutItemStyle}">
    <Setter Property="Background" Value="{DynamicResource MenuFlyoutSubItemBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MenuFlyoutSubItemBackgroundBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource MenuFlyoutSubItemBorderThickness}" />
    <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutSubItemForeground}" />
  </ControlTheme>

  <!-- RadioMenuFlyoutSubItemStyle: a sub item with the radio bullet E915 of its checked state in
       the check column (15 px margin) and the chevron E76C. -->
  <ControlTheme x:Key="RadioMenuFlyoutSubItemStyle" TargetType="MenuItem" BasedOn="{StaticResource DefaultMenuFlyoutSubItemStyle}">
    <Setter Property="BorderThickness" Value="0" />
    <Style Selector="^ /template/ Path#CheckGlyph">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Data" Value="{StaticResource GlyphGeometryE915}" />
      <Setter Property="Width" Value="6" />
      <Setter Property="Margin" Value="3,0,18,0" />
    </Style>
    <Style Selector="^ /template/ Path#SubItemChevron">
      <Setter Property="Data" Value="{StaticResource GlyphGeometryE76C}" />
      <Setter Property="Width" Value="6.4" />
      <Setter Property="Margin" Value="26.8,0,2.8,-1" />
    </Style>
    <!-- PointerOver, Pressed, SubMenuOpened and Disabled of the check glyph. -->
    <Style Selector="^:selected /template/ Path#CheckGlyph">
      <Setter Property="Fill" Value="{DynamicResource MenuFlyoutSubItemForegroundPointerOver}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#LayoutRoot:pointerover Path#CheckGlyph">
      <Setter Property="Fill" Value="{DynamicResource MenuFlyoutSubItemForegroundPressed}" />
    </Style>
    <Style Selector="^:open /template/ Path#CheckGlyph">
      <Setter Property="Fill" Value="{DynamicResource MenuFlyoutSubItemForegroundSubMenuOpened}" />
    </Style>
    <Style Selector="^:disabled /template/ Path#CheckGlyph">
      <Setter Property="Fill" Value="{DynamicResource MenuFlyoutSubItemForegroundDisabled}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type MenuItem}" TargetType="MenuItem" BasedOn="{StaticResource DefaultMenuFlyoutItemStyle}" />
</ResourceDictionary>

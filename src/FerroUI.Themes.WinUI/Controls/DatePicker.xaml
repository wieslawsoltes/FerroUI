<!--
  Ported from microsoft-ui-xaml (https://github.com/microsoft/microsoft-ui-xaml),
  commit 7e4b0c2096be402f51cc8f7d203ebf67cff183d0:
    controls/dev/CommonStyles/DatePicker_themeresources.xaml (DefaultDatePickerStyle with its
    template-local DatePickerFlyoutButtonStyle, DefaultDatePickerFlyoutPresenterStyle and the
    implicit styles of DatePicker and DatePickerFlyoutPresenter; its resources are
    Resources/DatePicker_themeresources.xaml)
    controls/dev/CommonStyles/DateTimePickerFlyout_themeresources.xaml (the template of
    DefaultLoopingSelectorStyle, written into the hosts of the presenter; the themes of the buttons
    and the items are in Controls/DateTimePickerShared.xaml)
  Copyright (c) Microsoft Corporation. Licensed under the MIT License (see NOTICE.md of the crate).

  Translation notes (docs/porting/winui-theme.md, section 4):
  - Template parts of DatePicker: FlyoutButton, FlyoutButtonContentGrid, DayTextBlock,
    MonthTextBlock, YearTextBlock, FirstPickerSpacing and SecondPickerSpacing are PART_FlyoutButton,
    PART_ButtonContentGrid, PART_DayTextBlock, PART_MonthTextBlock, PART_YearTextBlock,
    PART_FirstSpacer and PART_SecondSpacer. FerroUI's control sets the columns of the grid and
    their order from the date pattern of the culture, as WinUI's does (78*, 132* for the month).
  - WinUI's DatePickerFlyout is a flyout the control creates in code; FerroUI's DatePicker has the
    Popup PART_Popup with the DatePickerPresenter PART_PickerPresenter in its template. The control
    places the popup so that the selected values are over the button, as WinUI places its flyout.
  - The texts of the placeholders are the localized strings of WinUI ("day", "month", "year",
    TEXT_DATEPICKER_*_PLACEHOLDER of dxaml/xcp/dxaml/dllsrv/winrt/Microsoft.UI.Xaml.Common.rc) in
    English; the control clears the text it sets when it has no date, which restores them.
  - The template-local DatePickerFlyoutButtonStyle is the keyed theme of the same name; its
    ContentPresenter is PART_ContentPresenter.
  - HasDateStates: HasNoDate is FerroUI's :hasnodate.
  - The MinWidth and MaxWidth of the flyout button (DatePickerThemeMinWidth, DatePickerThemeMaxWidth) are
    setters of the control bound to the button, so that the sizes of FerroUI's control apply.
  - The focus visual: IsTabStop False on the control and UseSystemFocusVisuals with
    FocusVisualMargin -3 on the flyout button. FerroUI's DatePicker takes the focus itself: the
    FocusAdorner of the control (margin -3) is drawn around the flyout button
    (TemplatedControl.IsTemplateFocusTarget), and IsTabStop is left out.
  - HeaderContentPresenter and its row are left out: FerroUI's DatePicker has no Header.
    Orientation (Horizontal) and ElementSoundMode have no counterpart.
  - The FerroUI contract: the template is wrapped in DataValidationErrors, which shows the errors
    of FerroUI's data validation under the control, and :error gives the border the critical brush
    (SystemFillColorCriticalBrush), as the Fluent theme does and as Controls/TextBox.xaml does.
  - Template parts of DatePickerPresenter: PickerHostGrid is PART_PickerContainer; the
    LoopingSelectors the WinUI presenter creates in code are the hosts PART_DayHost, PART_MonthHost
    and PART_YearHost, each with the template of DefaultLoopingSelectorStyle (a ScrollViewer with
    ScrollViewerScrollBarlessTemplate around the DateTimePickerPanel PART_DaySelector, ... and the
    up and down RepeatButtons PART_DayUpButton, PART_DayDownButton, ..., shown while the pointer is
    over the host); AcceptButton and DismissButton are PART_AcceptButton and PART_DismissButton;
    FirstPickerSpacing and SecondPickerSpacing are PART_FirstSpacer and PART_SecondSpacer. The
    presenter sets the columns in code (78*, 138* for the month), the month column is 138* in
    FerroUI where WinUI's is 132*.
  - HighlightRect (a Grid with a background and a corner radius) is a Border, under the items; the
    three MonochromaticOverlayPresenters that draw the selected items again in
    DatePickerFlyoutPresenterHighlightForegroundColor are the selected state of the items
    (Controls/DateTimePickerShared.xaml).
  - The glyphs of the buttons (E8FB Accept, E711 Cancel at 16 px) are GlyphGeometryE8FB (14 px
    wide) and GlyphGeometryE711 (12 px wide).
  - The ThemeShadow of the flyout (ApplyElevationEffect of DatePickerFlyoutPresenter at a
    Translation.Z of 32) is the BoxShadow ThemeShadowFlyoutBoxShadow of the border Background of
    the presenter, and the margin ThemeShadowFlyoutMargin of PART_PickerPresenter is the room for
    it in the popup (Resources/ThemeShadows.xaml; DEVIATIONS.md, G-24); WindowManagerAddShadowHint
    is off, as in the Fluent theme.
-->
<ResourceDictionary xmlns="https://github.com/ferroui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Padding="20" Height="500">
      <StackPanel Spacing="20" VerticalAlignment="Center">
        <DatePicker />
        <DatePicker IsEnabled="False" />
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <!-- DatePickerFlyoutButtonStyle of the template of DefaultDatePickerStyle. -->
  <ControlTheme x:Key="DatePickerFlyoutButtonStyle" TargetType="Button">
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            Foreground="{TemplateBinding Foreground}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BackgroundSizing="InnerBorderEdge"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Content="{TemplateBinding Content}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            CornerRadius="{TemplateBinding CornerRadius}" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- PointerOver -->
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DatePickerButtonBackgroundPointerOver}" />
      <Setter Property="Foreground" Value="{DynamicResource DatePickerButtonForegroundPointerOver}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DatePickerButtonBorderBrushPointerOver}" />
    </Style>
    <!-- Pressed -->
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DatePickerButtonBackgroundPressed}" />
      <Setter Property="Foreground" Value="{DynamicResource DatePickerButtonForegroundPressed}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DatePickerButtonBorderBrushPressed}" />
    </Style>
    <!-- Disabled -->
    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DatePickerButtonBackgroundDisabled}" />
      <Setter Property="Foreground" Value="{DynamicResource DatePickerButtonForegroundDisabled}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DatePickerButtonBorderBrushDisabled}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="DefaultDatePickerStyle" TargetType="DatePicker">
    <!-- The defaults of a WinUI 3 control, which its style leaves unset and its template binds
         (FerroUI's defaults are Stretch). Deviation (winui-theme/DEVIATIONS.md, G-27). -->
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
    <Setter Property="Background" Value="{DynamicResource DatePickerButtonBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource DatePickerButtonForeground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DatePickerButtonBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource DatePickerBorderThemeThickness}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <!-- MinWidth and MaxWidth of the flyout button in the source, bound to it from the control. -->
    <Setter Property="MinWidth" Value="{StaticResource DatePickerThemeMinWidth}" />
    <Setter Property="MaxWidth" Value="{StaticResource DatePickerThemeMaxWidth}" />
    <!-- UseSystemFocusVisuals with FocusVisualMargin="-3", around the flyout button. -->
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border Margin="-3"
                BorderThickness="2"
                BorderBrush="{DynamicResource SystemControlFocusVisualPrimaryBrush}"
                CornerRadius="{DynamicResource ControlCornerRadius}">
          <Border BorderThickness="1"
                  BorderBrush="{DynamicResource SystemControlFocusVisualSecondaryBrush}"
                  CornerRadius="{DynamicResource ControlCornerRadius}" />
        </Border>
      </FocusAdornerTemplate>
    </Setter>
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The errors of FerroUI's data validation under the control (DataValidationErrors.xaml). -->
        <DataValidationErrors>
          <Grid x:Name="LayoutRoot" Margin="{TemplateBinding Padding}">
            <Button x:Name="PART_FlyoutButton"
                    Theme="{StaticResource DatePickerFlyoutButtonStyle}"
                    Background="{TemplateBinding Background}"
                    Foreground="{TemplateBinding Foreground}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    IsEnabled="{TemplateBinding IsEnabled}"
                    MinWidth="{TemplateBinding MinWidth}"
                    MaxWidth="{TemplateBinding MaxWidth}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Top"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    TemplatedControl.IsTemplateFocusTarget="True">
              <Grid x:Name="PART_ButtonContentGrid" ColumnDefinitions="78*,Auto,132*,Auto,78*">
                <TextBlock x:Name="PART_DayTextBlock"
                           Text="day"
                           TextAlignment="Center"
                           Padding="{DynamicResource DatePickerHostPadding}"
                           FontFamily="{TemplateBinding FontFamily}"
                           FontWeight="{TemplateBinding FontWeight}"
                           FontSize="{TemplateBinding FontSize}" />
                <TextBlock x:Name="PART_MonthTextBlock"
                           Text="month"
                           TextAlignment="Left"
                           Padding="{DynamicResource DatePickerHostMonthPadding}"
                           Margin="1,0,0,0"
                           FontFamily="{TemplateBinding FontFamily}"
                           FontWeight="{TemplateBinding FontWeight}"
                           FontSize="{TemplateBinding FontSize}" />
                <TextBlock x:Name="PART_YearTextBlock"
                           Text="year"
                           TextAlignment="Center"
                           Padding="{DynamicResource DatePickerHostPadding}"
                           FontFamily="{TemplateBinding FontFamily}"
                           FontWeight="{TemplateBinding FontWeight}"
                           FontSize="{TemplateBinding FontSize}" />
                <Rectangle x:Name="PART_FirstSpacer"
                           Fill="{DynamicResource DatePickerSpacerFill}"
                           HorizontalAlignment="Center"
                           Width="{DynamicResource DatePickerSpacerThemeWidth}"
                           Grid.Column="1" />
                <Rectangle x:Name="PART_SecondSpacer"
                           Fill="{DynamicResource DatePickerSpacerFill}"
                           HorizontalAlignment="Center"
                           Width="{DynamicResource DatePickerSpacerThemeWidth}"
                           Grid.Column="3" />
              </Grid>
            </Button>
            <Popup x:Name="PART_Popup"
                   WindowManagerAddShadowHint="False"
                   IsLightDismissEnabled="True"
                   PlacementTarget="{TemplateBinding}"
                   Placement="Bottom">
              <DatePickerPresenter x:Name="PART_PickerPresenter" Margin="{StaticResource ThemeShadowFlyoutMargin}" />
            </Popup>
          </Grid>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>

    <!-- The vertical alignment of the texts (FerroUI's VerticalContentAlignment of the control). -->
    <Style Selector="^ /template/ Button#PART_FlyoutButton TextBlock">
      <Setter Property="VerticalAlignment" Value="{TemplateBinding VerticalContentAlignment}" />
    </Style>
    <!-- Disabled -->
    <Style Selector="^:disabled">
      <Style Selector="^ /template/ Rectangle#PART_FirstSpacer">
        <Setter Property="Fill" Value="{DynamicResource DatePickerSpacerFillDisabled}" />
      </Style>
      <Style Selector="^ /template/ Rectangle#PART_SecondSpacer">
        <Setter Property="Fill" Value="{DynamicResource DatePickerSpacerFillDisabled}" />
      </Style>
    </Style>
    <!-- HasNoDate -->
    <Style Selector="^:hasnodate /template/ Button#PART_FlyoutButton">
      <Setter Property="Foreground" Value="{DynamicResource DatePickerButtonForegroundDefault}" />
    </Style>
    <!-- Not in WinUI: the :error of FerroUI's data validation (as the text box). -->
    <Style Selector="^:error /template/ Button#PART_FlyoutButton">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type DatePicker}" TargetType="DatePicker" BasedOn="{StaticResource DefaultDatePickerStyle}" />

  <ControlTheme x:Key="DefaultDatePickerFlyoutPresenterStyle" TargetType="DatePickerPresenter">
    <!-- The shadow is drawn outside the bounds of the control: a templated control clips to its
         bounds unless its theme says otherwise (G-24). -->
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Width" Value="296" />
    <Setter Property="MinWidth" Value="296" />
    <Setter Property="MaxHeight" Value="398" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
    <Setter Property="Background" Value="{DynamicResource DatePickerFlyoutPresenterBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DatePickerFlyoutPresenterBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource DateTimeFlyoutBorderThickness}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="Background"
                BoxShadow="{DynamicResource ThemeShadowFlyoutBoxShadow}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{DynamicResource DateTimeFlyoutBorderPadding}"
                MaxHeight="398">
          <Grid x:Name="ContentPanel" RowDefinitions="*,Auto">
            <Grid x:Name="PART_PickerContainer">
              <Grid.Styles>
                <Style Selector="DateTimePickerPanel > ListBoxItem">
                  <Setter Property="Theme" Value="{StaticResource DateTimePickerLoopingSelectorItemStyle}" />
                </Style>
              </Grid.Styles>
              <!-- The columns are set by the presenter. -->
              <Border x:Name="HighlightRect"
                      ZIndex="-1"
                      Background="{DynamicResource DatePickerFlyoutPresenterHighlightFill}"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      Grid.Column="0"
                      Grid.ColumnSpan="5"
                      VerticalAlignment="Center"
                      Height="{DynamicResource DatePickerFlyoutPresenterHighlightHeight}"
                      Margin="4,2,4,2"
                      IsHitTestVisible="False" />
              <Grid x:Name="PART_MonthHost">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden"
                              Template="{StaticResource ScrollViewerScrollBarlessTemplate}">
                  <DateTimePickerPanel x:Name="PART_MonthSelector"
                                       PanelType="Month"
                                       ItemHeight="{DynamicResource DatePickerFlyoutPresenterItemHeight}"
                                       ShouldLoop="True" />
                </ScrollViewer>
                <RepeatButton x:Name="PART_MonthUpButton" Theme="{StaticResource DateTimePickerLoopingSelectorUpButtonStyle}" />
                <RepeatButton x:Name="PART_MonthDownButton" Theme="{StaticResource DateTimePickerLoopingSelectorDownButtonStyle}" />
              </Grid>
              <Grid x:Name="PART_DayHost">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden"
                              Template="{StaticResource ScrollViewerScrollBarlessTemplate}">
                  <DateTimePickerPanel x:Name="PART_DaySelector"
                                       PanelType="Day"
                                       ItemHeight="{DynamicResource DatePickerFlyoutPresenterItemHeight}"
                                       ShouldLoop="True" />
                </ScrollViewer>
                <RepeatButton x:Name="PART_DayUpButton" Theme="{StaticResource DateTimePickerLoopingSelectorUpButtonStyle}" />
                <RepeatButton x:Name="PART_DayDownButton" Theme="{StaticResource DateTimePickerLoopingSelectorDownButtonStyle}" />
              </Grid>
              <Grid x:Name="PART_YearHost">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden"
                              Template="{StaticResource ScrollViewerScrollBarlessTemplate}">
                  <DateTimePickerPanel x:Name="PART_YearSelector"
                                       PanelType="Year"
                                       ItemHeight="{DynamicResource DatePickerFlyoutPresenterItemHeight}"
                                       ShouldLoop="False" />
                </ScrollViewer>
                <RepeatButton x:Name="PART_YearUpButton" Theme="{StaticResource DateTimePickerLoopingSelectorUpButtonStyle}" />
                <RepeatButton x:Name="PART_YearDownButton" Theme="{StaticResource DateTimePickerLoopingSelectorDownButtonStyle}" />
              </Grid>
              <Rectangle x:Name="PART_FirstSpacer"
                         ZIndex="10000"
                         Fill="{DynamicResource DatePickerFlyoutPresenterSpacerFill}"
                         HorizontalAlignment="Center"
                         Width="{DynamicResource DatePickerSpacerThemeWidth}"
                         Grid.Column="1" />
              <Rectangle x:Name="PART_SecondSpacer"
                         ZIndex="10000"
                         Fill="{DynamicResource DatePickerFlyoutPresenterSpacerFill}"
                         HorizontalAlignment="Center"
                         Width="{DynamicResource DatePickerSpacerThemeWidth}"
                         Grid.Column="3" />
            </Grid>
            <Grid x:Name="AcceptDismissHostGrid"
                  Grid.Row="1"
                  Height="{DynamicResource DatePickerFlyoutPresenterAcceptDismissHostGridHeight}"
                  ColumnDefinitions="*,*">
              <Rectangle Height="{DynamicResource DatePickerSpacerThemeWidth}"
                         VerticalAlignment="Top"
                         Fill="{DynamicResource DatePickerFlyoutPresenterSpacerFill}"
                         Grid.ColumnSpan="2" />
              <Button x:Name="PART_AcceptButton"
                      Grid.Column="0"
                      Theme="{StaticResource DateTimePickerFlyoutButtonStyle}"
                      FontSize="16"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      Margin="{StaticResource DatePickerFlyoutPresenterAcceptMargin}"
                      Padding="4">
                <!-- E8FB at 16 px. -->
                <Path Data="{StaticResource GlyphGeometryE8FB}"
                      Fill="{Binding $parent[Button].Foreground}"
                      Stretch="Uniform"
                      Width="14" />
              </Button>
              <Button x:Name="PART_DismissButton"
                      Grid.Column="1"
                      Theme="{StaticResource DateTimePickerFlyoutButtonStyle}"
                      FontSize="16"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      Margin="{StaticResource DatePickerFlyoutPresenterDismissMargin}"
                      Padding="4">
                <!-- E711 at 16 px. -->
                <Path Data="{StaticResource GlyphGeometryE711}"
                      Fill="{Binding $parent[Button].Foreground}"
                      Stretch="Uniform"
                      Width="12" />
              </Button>
            </Grid>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- PointerOver of DefaultLoopingSelectorStyle: the up and down buttons of the host under the pointer. -->
    <Style Selector="^ /template/ Grid#PART_MonthHost:pointerover > RepeatButton">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^ /template/ Grid#PART_DayHost:pointerover > RepeatButton">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^ /template/ Grid#PART_YearHost:pointerover > RepeatButton">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type DatePickerPresenter}" TargetType="DatePickerPresenter" BasedOn="{StaticResource DefaultDatePickerFlyoutPresenterStyle}" />
</ResourceDictionary>

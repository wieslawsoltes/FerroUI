<Window xmlns="https://github.com/ferroui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:id="using:FerroUI.Xaml.Interactions.Draggable"
        Title="ItemDragBehaviorVertical">
  <!-- Ported from tests/Xaml.Behaviors.Interactions.UnitTests/Core/ItemDragBehaviorVertical of
       Xaml.Behaviors. Adapted: no x:Class and no data context (the test loads the window with the
       run-time loader and sets the items source of the list box). -->
  <Window.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="(Interaction.Behaviors)">
        <BehaviorCollectionTemplate>
          <BehaviorCollection>
            <id:ItemDragBehavior Orientation="Vertical" HorizontalDragThreshold="0" VerticalDragThreshold="0" />
          </BehaviorCollection>
        </BehaviorCollectionTemplate>
      </Setter>
    </Style>
  </Window.Styles>
  <ListBox Name="TargetListBox" />
</Window>

<Window xmlns="https://github.com/ferroui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Ported from tests/Xaml.Behaviors.Interactions.UnitTests/Custom/WindowClosedRoutedEventWindow of Xaml.Behaviors.
       Adapted: no x:Class (the test loads the window with the run-time loader); the data context is set by the test. -->

  <Interaction.Behaviors>
    <RoutedEventTriggerBehavior RoutedEvent="{x:Static Window.WindowClosedEvent}">
      <InvokeCommandAction Command="{Binding CloseCommand}" />
    </RoutedEventTriggerBehavior>
  </Interaction.Behaviors>
</Window>

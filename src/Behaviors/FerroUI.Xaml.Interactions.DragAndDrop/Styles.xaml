<Styles xmlns="https://github.com/ferroui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Ported from src/Xaml.Behaviors.Interactions.DragAndDrop/Styles of Xaml.Behaviors. -->
  <Style Selector="TreeViewItem.DraggingUp">
    <Setter Property="AdornerLayer.Adorner">
      <Template>
        <Border BorderThickness="0 2 0 0"
                BorderBrush="{DynamicResource SystemAccentColor}"
                IsHitTestVisible="False" />
      </Template>
    </Setter>
  </Style>

  <Style Selector="TreeViewItem.DraggingDown">
    <Setter Property="AdornerLayer.Adorner">
      <Template>
        <Border BorderThickness="0 0 0 2"
                BorderBrush="{DynamicResource SystemAccentColor}"
                IsHitTestVisible="False" />
      </Template>
    </Setter>
  </Style>

  <Style Selector="TreeViewItem.TargetHighlight">
    <Setter Property="Background"
            Value="{DynamicResource TreeViewItemBackgroundPointerOver}" />
  </Style>
</Styles>

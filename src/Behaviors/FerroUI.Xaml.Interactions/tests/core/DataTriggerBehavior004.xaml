<Window xmlns="https://github.com/ferroui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DataTriggerBehavior004">
  <!-- Ported from tests/Xaml.Behaviors.Interactions.UnitTests/Core/DataTriggerBehavior004 of Xaml.Behaviors.
       Adapted: no x:Class (the test loads the window with the run-time loader); the data context is set by the test. -->

  <StackPanel>
    <TextBlock Name="TargetTextBlock"
               Text="Red">
      <Interaction.Behaviors>
        <DataTriggerBehavior Binding="{Binding #TargetCheckBox.IsChecked}"
                             RevertOnFalse="True"
                             ComparisonCondition="Equal"
                             Value="True">
          <ChangePropertyAction PropertyName="Text"
                                Value="Blue" />
          <ChangePropertyAction PropertyName="Text"
                                Value="Green" />
        </DataTriggerBehavior>
      </Interaction.Behaviors>
    </TextBlock>
    <CheckBox Name="TargetCheckBox"
              Content="Check"
              IsChecked="False" />

    <TextBlock x:Name="NullTargetTextBlock" Text="Not empty">
      <Interaction.Behaviors>
        <DataTriggerBehavior Binding="{Binding TestProperty}"
                             ComparisonCondition="Equal"
                             Value="{x:Null}">
          <ChangePropertyAction PropertyName="Text" Value="Empty" />
        </DataTriggerBehavior>
      </Interaction.Behaviors>
    </TextBlock>

    <TextBlock x:Name="UnconfiguredTextBlock" Text="Unchanged">
      <Interaction.Behaviors>
        <DataTriggerBehavior ComparisonCondition="Equal" Value="{x:Null}">
          <ChangePropertyAction PropertyName="Text" Value="Incorrectly executed" />
        </DataTriggerBehavior>
      </Interaction.Behaviors>
    </TextBlock>

    <TextBlock x:Name="RelationalTextBlock" Text="Unchanged">
      <Interaction.Behaviors>
        <DataTriggerBehavior Binding="{Binding TestProperty}"
                             ComparisonCondition="GreaterThan"
                             Value="z">
          <ChangePropertyAction PropertyName="Text" Value="Incorrectly executed" />
        </DataTriggerBehavior>
      </Interaction.Behaviors>
    </TextBlock>
  </StackPanel>
</Window>

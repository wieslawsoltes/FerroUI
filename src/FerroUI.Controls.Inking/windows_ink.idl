// The COM interfaces of the Windows Runtime the ink services of Windows (`windows_ink_services.rs`)
// call, for the MicroCom generator (src/tools/MicroCom.CodeGenerator), as the WinUI integration
// declares its own in `src/Windows/FerroUI.WinUI/interop/winui.idl`. WinUI has no such file: its
// ink control calls the ink engine of the system in C++/WinRT.
//
// Every interface below is the one of the metadata (`Windows.Foundation.UniversalApiContract.winmd`
// and `Windows.Foundation.FoundationContract.winmd` of the Windows SDK 10.0.19041), with its
// identifier and its methods in the order of the vtable: the ink engine
// (`Windows.UI.Input.Inking`), the in-memory stream and its reader and writer
// (`Windows.Storage.Streams`), and the collections and asynchronous operations of
// `Windows.Foundation` the services use. The clipboard is the ink engine's own
// (`InkStrokeContainer.CopySelectedToClipboard` and `PasteFromClipboard`), so no interface of
// `Windows.ApplicationModel.DataTransfer` is needed.
//
// A property is a `[propget]` and a `[propput]` method; a runtime class is passed as its default
// interface; a method the services do not call keeps its slot with `void*` for an interface and
// `INT32` for an enumeration the file does not declare. A parameterized interface or delegate is
// declared for each instance the services use, under a name of its own, with the identifier the
// Windows Runtime derives from its signature (the comment above it; a test of the crate derives
// it again).
@rust-types-from super
@rust-map HSTRING isize
@rust-map GUID Guid
@rust-map boolean u8
@rust-map BYTE u8
@rust-map INT16 i16
@rust-map UINT16 u16
@rust-map INT32 i32
@rust-map UINT32 u32
@rust-map INT64 i64
@rust-map UINT64 u64
@rust-map FLOAT f32
@rust-map DOUBLE f64

enum TrustLevel
{
    BaseTrust,
    PartialTrust,
    FullTrust
}

// Enumerations

// Windows.Foundation.AsyncStatus (int32)
enum AsyncStatus
{
    Canceled = 2,
    Completed = 1,
    Error = 3,
    Started = 0,
}
// Windows.UI.Input.Inking.PenTipShape (int32)
enum PenTipShape
{
    Circle = 0,
    Rectangle = 1,
}
// Windows.UI.Input.Inking.InkDrawingAttributesKind (int32)
enum InkDrawingAttributesKind
{
    Default = 0,
    Pencil = 1,
}
// Windows.UI.Input.Inking.InkPersistenceFormat (int32)
enum InkPersistenceFormat
{
    GifWithEmbeddedIsf = 0,
    Isf = 1,
}
// Windows.UI.Input.Inking.InkRecognitionTarget (int32)
enum InkRecognitionTarget
{
    All = 0,
    Selected = 1,
    Recent = 2,
}

// Structures

// Windows.Foundation.Point
struct Point
{
    FLOAT X;
    FLOAT Y;
}
// Windows.Foundation.Size
struct Size
{
    FLOAT Width;
    FLOAT Height;
}
// Windows.Foundation.Rect
struct Rect
{
    FLOAT X;
    FLOAT Y;
    FLOAT Width;
    FLOAT Height;
}
// Windows.UI.Color
struct Color
{
    BYTE A;
    BYTE R;
    BYTE G;
    BYTE B;
}
// Windows.Foundation.Numerics.Matrix3x2
struct Matrix3x2
{
    FLOAT M11;
    FLOAT M12;
    FLOAT M21;
    FLOAT M22;
    FLOAT M31;
    FLOAT M32;
}

// Interfaces and delegates


  </ControlTheme>
  <ControlTheme x:Key="{x:Type InkToolbarRulerButton}" TargetType="InkToolbarRulerButton" BasedOn="{StaticResource InkToolbarCommonButtonStyle}">
    <Setter Property="AutomationProperties.AutomationId" Value="InkToolbarRulerButton" />
    <Setter Property="Template">
      <ControlTemplate TargetType="InkToolbarRulerButton">
        <Border x:Name="RootElement" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
          <ContentPresenter x:Name="PART_ContentPresenter"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
          <Grid>
            <Path x:Name="ContentGlyph" Width="16" Height="16" Stretch="Uniform"
                  Data="{StaticResource InkToolbarRulerOutline}" Fill="{Binding $parent[InkToolbarRulerButton].Foreground}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
          </Grid>
          </ContentPresenter>
        </Border>
      </ControlTemplate>
    </Setter>
    <!-- As WinUI (InkToolBar.xaml, the Checked states of the ruler): a checked ruler takes the
         subtle selected fills of InkToolbarCommonButtonStyle, not the accent fills of the custom
         toggle. -->
  </ControlTheme>
  <ControlTheme x:Key="{x:Type InkToolbarMenuButton}" TargetType="InkToolbarMenuButton" BasedOn="{StaticResource InkToolbarCommonButtonStyle}">
    <Setter Property="Template">
      <ControlTemplate TargetType="InkToolbarMenuButton">
        <Border x:Name="RootElement" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
          <Grid>
            <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
            <Path x:Name="ExtensionGlyph" Stretch="Uniform"
                  Fill="{DynamicResource InkToolbarAccentColorForegroundThemeBrush}"
                  IsVisible="{TemplateBinding IsExtensionGlyphShown}" IsHitTestVisible="False" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type InkToolbarStencilButton}" TargetType="InkToolbarStencilButton" BasedOn="{StaticResource InkToolbarCommonButtonStyle}">
    <Setter Property="AutomationProperties.AutomationId" Value="InkToolbarStencilButton" />
    <Setter Property="Template">
      <ControlTemplate TargetType="InkToolbarStencilButton">
        <Border x:Name="RootElement" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
          <ContentPresenter x:Name="PART_ContentPresenter"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
          <Grid>
            <Grid.Styles>
              <Style Selector=":is(ToggleButton) Path#ExtensionGlyph">
                <Setter Property="Data" Value="{DynamicResource InkToolbarArrowDown}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <Setter Property="Width" Value="8" />
                <Setter Property="Height" Value="5" />
                <Setter Property="Opacity" Value="0" />
              </Style>
              <Style Selector=":is(ToggleButton):checked Path#ExtensionGlyph">
                <Setter Property="Opacity" Value="1" />
              </Style>
              <Style Selector=":is(ToggleButton):flyout-open Path#ExtensionGlyph">
                <Setter Property="Opacity" Value="0" />
              </Style>
              <Style Selector=":is(ToggleButton):flyout-top Path#ExtensionGlyph">
                <Setter Property="Data" Value="{DynamicResource InkToolbarArrowUp}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Width" Value="8" />
                <Setter Property="Height" Value="5" />
              </Style>
              <Style Selector=":is(ToggleButton):flyout-bottom Path#ExtensionGlyph">
                <Setter Property="Data" Value="{DynamicResource InkToolbarArrowDown}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <Setter Property="Width" Value="8" />
                <Setter Property="Height" Value="5" />
              </Style>
              <Style Selector=":is(ToggleButton):flyout-left Path#ExtensionGlyph">
                <Setter Property="Data" Value="{DynamicResource InkToolbarArrowLeft}" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Width" Value="5" />
                <Setter Property="Height" Value="8" />
              </Style>
              <Style Selector=":is(ToggleButton):flyout-right Path#ExtensionGlyph">
                <Setter Property="Data" Value="{DynamicResource InkToolbarArrowRight}" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Width" Value="5" />
                <Setter Property="Height" Value="8" />
              </Style>
              <Style Selector="Path#ContentGlyph">
                <Setter Property="Data" Value="{DynamicResource InkToolbarRulerOutline}" />
              </Style>
              <Style Selector=":is(InkToolbarStencilButton)[SelectedStencil=Protractor] Path#ContentGlyph">
                <Setter Property="Data" Value="{DynamicResource InkToolbarProtractorOutline}" />
              </Style>
            </Grid.Styles>
            <Path x:Name="ContentGlyph" Width="16" Height="16" Stretch="Uniform"
                  Fill="{Binding $parent[InkToolbarStencilButton].Foreground}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
            <Path x:Name="ExtensionGlyph" Stretch="Uniform"
                  Fill="{DynamicResource InkToolbarAccentColorForegroundThemeBrush}"
                  IsVisible="{Binding $parent[InkToolbarStencilButton].IsExtensionGlyphShown}" IsHitTestVisible="False" />
          </Grid>
          </ContentPresenter>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type InkToolbarFlyoutItem}" TargetType="InkToolbarFlyoutItem">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Background" Value="{DynamicResource InkToolbarFlyoutItemBackgroundThemeBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkToolbarFlyoutItemForegroundThemeBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate TargetType="InkToolbarFlyoutItem">
        <Border x:Name="RootElement" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
          <Grid>
            <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource InkToolbarFlyoutItemHoverBackgroundThemeBrush}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource InkToolbarFlyoutItemPressedBackgroundThemeBrush}" />
    </Style>
    <Style Selector="^:checked">
      <Setter Property="Background" Value="{DynamicResource InkToolbarFlyoutItemSelectedBackgroundThemeBrush}" />
    </Style>
    <Style Selector="^:checked:pointerover">
      <Setter Property="Background" Value="{DynamicResource InkToolbarFlyoutItemHoverSelectedBackgroundThemeBrush}" />
    </Style>
    <Style Selector="^:checked:pressed">
      <Setter Property="Background" Value="{DynamicResource InkToolbarFlyoutItemPressedSelectedBackgroundThemeBrush}" />
    </Style>
    <Style Selector="^:checked">
      <Setter Property="BorderBrush" Value="{DynamicResource InkToolbarFlyoutItemBorderSelectedThemeBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource InkToolbarDisabledForegroundThemeBrush}" />
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="^.ink-palette-item">
      <Setter Property="Padding" Value="6" />
      <Setter Property="CornerRadius" Value="26" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type InkToolbarStrokeWidthSlider}" TargetType="InkToolbarStrokeWidthSlider"
                BasedOn="{StaticResource {x:Type Slider}}">
    <Setter Property="MinHeight" Value="44" />
  </ControlTheme>
  <ControlTheme x:Key="{x:Type InkToolbar}" TargetType="InkToolbar">
    <Setter Property="Spacing" Value="0" />
    <Setter Property="Margin" Value="2" />
  </ControlTheme>
  <ControlTheme x:Key="{x:Type InkToolbarPenConfigurationControl}" TargetType="InkToolbarPenConfigurationControl">
    <Setter Property="MinWidth" Value="320" />
    <Setter Property="Margin" Value="0,8,0,12" />
  </ControlTheme>
</ResourceDictionary>

<!-- The control theme of TeachingTip for an application with the WinUI theme. An application
     that uses the control includes this document; one that does not links none of it. -->
<Styles xmlns="https://github.com/ferroui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <MergeResourceInclude Source="ferres://FerroUI.Controls.TeachingTip/Themes/WinUI/TeachingTip_themeresources.xaml" />
        <MergeResourceInclude Source="ferres://FerroUI.Controls.TeachingTip/Themes/WinUI/TeachingTip.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
</Styles>

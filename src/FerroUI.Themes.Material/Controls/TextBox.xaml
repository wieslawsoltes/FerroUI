  source e4d933c98df7baa7ea2b83eea6e086915961e0ff.
  Component measurements and interaction states follow the Android Open Source Project
  token definitions (Apache-2.0; see NOTICE.md). FerroUI template contracts are adapted
  from the WinUI theme, Copyright (c) Microsoft Corporation, MIT license.
-->
<ResourceDictionary xmlns="https://github.com/ferroui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:material="using:FerroUI.Themes.Material"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Padding="20">
      <StackPanel Spacing="20">
        <TextBox>Text</TextBox>
        <TextBox PlaceholderText="Placeholder" />
        <TextBox IsEnabled="False">Disabled</TextBox>
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <!-- DeleteButtonStyle of the template of DefaultTextBoxStyle. -->
  <ControlTheme x:Key="TextBoxDeleteButtonStyle" TargetType="Button">
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="ButtonLayoutGrid"
                Margin="{DynamicResource TextBoxInnerButtonMargin}"
                BorderBrush="Transparent"
                BorderThickness="{TemplateBinding BorderThickness}"
                Background="Transparent"
                BackgroundSizing="{TemplateBinding BackgroundSizing}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <!-- E894 at TextBoxIconFontSize: the glyph is drawn at the size of its ink. -->
          <Path x:Name="GlyphElement"
                Fill="{DynamicResource MaterialOnSurfaceVariantBrush}"
                Data="M 5,3 L 12,10 L 19,3 L 21,5 L 14,12 L 21,19 L 19,21 L 12,14 L 5,21 L 3,19 L 10,12 L 3,5 Z"
                Stretch="Uniform"
                Width="18"
                Height="18"
                VerticalAlignment="Center"
                HorizontalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- PointerOver -->
    <Style Selector="^:pointerover">
      <Style Selector="^ /template/ Border#ButtonLayoutGrid">
        <Setter Property="Background" Value="{DynamicResource MaterialOnSurfaceHoverBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>
      <Style Selector="^ /template/ Path#GlyphElement">
        <Setter Property="Fill" Value="{DynamicResource MaterialOnSurfaceBrush}" />
      </Style>
    </Style>
    <!-- Pressed -->
    <Style Selector="^:pressed">
      <Style Selector="^ /template/ Border#ButtonLayoutGrid">
        <Setter Property="Background" Value="{DynamicResource MaterialOnSurfacePressedBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>
      <Style Selector="^ /template/ Path#GlyphElement">
        <Setter Property="Fill" Value="{DynamicResource MaterialOnSurfaceBrush}" />
      </Style>
    </Style>
    <!-- Disabled -->
    <Style Selector="^:disabled /template/ Border#ButtonLayoutGrid">
      <Setter Property="Opacity" Value="0" />
    </Style>
  </ControlTheme>

  <!-- RevealButtonStyle of the template of DefaultPasswordBoxStyle. -->
  <ControlTheme x:Key="PasswordBoxRevealButtonStyle" TargetType="ToggleButton">
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="ButtonLayoutGrid"
                Margin="{DynamicResource TextBoxInnerButtonMargin}"
                BorderBrush="Transparent"
                BackgroundSizing="InnerBorderEdge"
                BorderThickness="{TemplateBinding BorderThickness}"
                Background="Transparent"
                CornerRadius="{TemplateBinding CornerRadius}">
          <!-- F78D at PasswordBoxIconFontSize (12 px): the glyph is drawn at the size of its ink. -->
          <Path x:Name="GlyphElement"
                Fill="{DynamicResource MaterialOnSurfaceVariantBrush}"
                Data="M 12,4 C 6,4 2,8 0,12 C 2,16 6,20 12,20 C 18,20 22,16 24,12 C 22,8 18,4 12,4 Z M 12,7 A 5,5 0 1 1 12,17 A 5,5 0 1 1 12,7 Z"
                Stretch="Uniform"
                Width="24"
                VerticalAlignment="Center"
                HorizontalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- PointerOver -->
    <Style Selector="^:pointerover">
      <Style Selector="^ /template/ Border#ButtonLayoutGrid">
        <Setter Property="Background" Value="{DynamicResource MaterialOnSurfaceHoverBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>
      <Style Selector="^ /template/ Path#GlyphElement">
        <Setter Property="Fill" Value="{DynamicResource MaterialOnSurfaceBrush}" />
      </Style>
    </Style>
    <!-- Pressed, CheckedPressed, IndeterminatePressed -->
    <Style Selector="^:pressed">
      <Style Selector="^ /template/ Border#ButtonLayoutGrid">
        <Setter Property="Background" Value="{DynamicResource MaterialOnSurfacePressedBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>
      <Style Selector="^ /template/ Path#GlyphElement">
        <Setter Property="Fill" Value="{DynamicResource MaterialOnSurfaceBrush}" />
      </Style>
    </Style>
    <!-- Disabled -->
    <Style Selector="^:disabled /template/ Border#ButtonLayoutGrid">
      <Setter Property="Opacity" Value="0" />
    </Style>
  </ControlTheme>

  <!-- The context flyout of a text box: the commands TextCommandBarFlyout shows for a TextBox
       (TextCommandBarFlyout::GetTextBoxButtonsToAdd), each while the text box can do it. -->
  <MenuFlyout x:Key="TextBoxContextFlyout">
    <MenuItem Header="{DynamicResource StringTextFlyoutCutText}"
              Command="{Binding $parent[TextBox].Cut}"
              IsEnabled="{Binding $parent[TextBox].CanCut}"
              IsVisible="{Binding $parent[TextBox].CanCut}"
              InputGesture="{x:Static TextBox.CutGesture}">
      <MenuItem.Icon>
        <PathIcon Data="{StaticResource GlyphGeometryE8C6}" />
      </MenuItem.Icon>
    </MenuItem>
    <MenuItem Header="{DynamicResource StringTextFlyoutCopyText}"
              Command="{Binding $parent[TextBox].Copy}"
              IsEnabled="{Binding $parent[TextBox].CanCopy}"
              IsVisible="{Binding $parent[TextBox].CanCopy}"
              InputGesture="{x:Static TextBox.CopyGesture}">
      <MenuItem.Icon>
        <PathIcon Data="{StaticResource GlyphGeometryE8C8}" />
      </MenuItem.Icon>
    </MenuItem>
    <MenuItem Header="{DynamicResource StringTextFlyoutPasteText}"
              Command="{Binding $parent[TextBox].Paste}"
              IsEnabled="{Binding $parent[TextBox].CanPaste}"
              IsVisible="{Binding $parent[TextBox].CanPaste}"
              InputGesture="{x:Static TextBox.PasteGesture}">
      <MenuItem.Icon>
        <PathIcon Data="{StaticResource GlyphGeometryE77F}" />
      </MenuItem.Icon>
    </MenuItem>
    <MenuItem Header="{DynamicResource StringTextFlyoutUndoText}"
              Command="{Binding $parent[TextBox].Undo}"
              IsEnabled="{Binding $parent[TextBox].CanUndo}"
              IsVisible="{Binding $parent[TextBox].CanUndo}">
      <MenuItem.Icon>
        <PathIcon Data="{StaticResource GlyphGeometryE7A7}" />
      </MenuItem.Icon>
    </MenuItem>
    <MenuItem Header="{DynamicResource StringTextFlyoutRedoText}"
              Command="{Binding $parent[TextBox].Redo}"
              IsEnabled="{Binding $parent[TextBox].CanRedo}"
              IsVisible="{Binding $parent[TextBox].CanRedo}">
      <MenuItem.Icon>
        <PathIcon Data="{StaticResource GlyphGeometryE7A6}" />
      </MenuItem.Icon>
    </MenuItem>
    <MenuItem Header="{DynamicResource StringTextFlyoutSelectAllText}"
              Command="{Binding $parent[TextBox].SelectAll}"
              IsVisible="{Binding $parent[TextBox].Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </MenuFlyout>

  <!-- The context flyout of a password box (TextCommandBarFlyout::GetPasswordBoxButtonsToAdd). -->
  <MenuFlyout x:Key="PasswordBoxContextFlyout">
    <MenuItem Header="{DynamicResource StringTextFlyoutPasteText}"
              Command="{Binding $parent[TextBox].Paste}"
              IsEnabled="{Binding $parent[TextBox].CanPaste}"
              IsVisible="{Binding $parent[TextBox].CanPaste}"
              InputGesture="{x:Static TextBox.PasteGesture}">
      <MenuItem.Icon>
        <PathIcon Data="{StaticResource GlyphGeometryE77F}" />
      </MenuItem.Icon>
    </MenuItem>
    <MenuItem Header="{DynamicResource StringTextFlyoutSelectAllText}"
              Command="{Binding $parent[TextBox].SelectAll}"
              IsVisible="{Binding $parent[TextBox].Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </MenuFlyout>

  <!-- The ordinary TextBox remains the editor; decoration is supplied through
       MaterialTextField attached properties. The layout panel uses Android's
       icon/affix/supporting geometry and one spring-driven label progress. -->
  <ControlTheme x:Key="DefaultTextBoxStyle" TargetType="TextBox">
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    <Setter Property="Background" Value="{DynamicResource MaterialSurfaceContainerHighestBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource MaterialPrimaryContainerBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource MaterialPrimaryBrush}" />
    <Setter Property="PlaceholderForeground" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="LineHeight" Value="24" />
    <Setter Property="LetterSpacing" Value="0.5" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
    <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False" />
    <Setter Property="MinHeight" Value="56" />
    <!-- 120, not TextFieldDefaults.MinWidth (280): Compose clamps a minimum to the width the
         parent offers, while a FerroUI MinWidth overflows narrower parents (sidebars, grid cells).
         The nativeMinWidth class opts into 280. -->
    <Setter Property="MinWidth" Value="120" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="CornerRadius" Value="4,4,0,0" />
    <Setter Property="BackgroundSizing" Value="InnerBorderEdge" />
    <Setter Property="ContextFlyout" Value="{StaticResource TextBoxContextFlyout}" />
    <Setter Property="AutomationProperties.HelpText" Value="{Binding $self.(MaterialTextField.AutomationDescription)}" />
    <Setter Property="Template">
      <ControlTemplate>
        <DataValidationErrors x:Name="MaterialValidationRoot" ClipToBounds="False">
          <material:MaterialTextFieldLayout x:Name="MaterialFieldLayout"
                    ContentPadding="{TemplateBinding Padding}"
                    ContainerMinHeight="{TemplateBinding MinHeight}">
            <material:MaterialTextFieldLayout.Transitions>
              <Transitions>
                <material:MaterialDoubleTransition Property="LabelProgress"
                    Duration="{DynamicResource MaterialMotionFastSpatialDuration}"
                    Easing="{DynamicResource MaterialMotionFastSpatialEasing}" />
              </Transitions>
            </material:MaterialTextFieldLayout.Transitions>
            <material:MaterialTextFieldBorder x:Name="BorderElement"
                    material:MaterialTextFieldLayout.Slot="Container"
                    Background="{TemplateBinding Background}"
                    BackgroundSizing="{TemplateBinding BackgroundSizing}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    MinWidth="{TemplateBinding MinWidth}"
                    MinHeight="{TemplateBinding MinHeight}">
              <Border.Transitions>
                <Transitions>
                  <BrushTransition Property="Background" Duration="{DynamicResource MaterialMotionFastEffectsDuration}" Easing="{DynamicResource MaterialMotionFastEffectsEasing}" />
                  <BrushTransition Property="BorderBrush" Duration="{DynamicResource MaterialMotionFastEffectsDuration}" Easing="{DynamicResource MaterialMotionFastEffectsEasing}" />
                  <material:MaterialThicknessTransition Property="BorderThickness" Duration="{DynamicResource MaterialMotionFastSpatialDuration}" Easing="{DynamicResource MaterialMotionFastSpatialEasing}" />
                </Transitions>
              </Border.Transitions>
            </material:MaterialTextFieldBorder>
            <TextBlock x:Name="MaterialFloatingLabel"
                       material:MaterialTextFieldLayout.Slot="Label"
                       Text="{TemplateBinding PlaceholderText}" FontSize="16" LineHeight="24" LetterSpacing="0.5"
                       Foreground="{DynamicResource MaterialOnSurfaceVariantBrush}"
                       IsHitTestVisible="False" IsVisible="False"
                       AutomationProperties.AccessibilityView="Raw" />
            <ContentPresenter x:Name="InnerLeftContentPresenter"
                              material:MaterialTextFieldLayout.Slot="InnerLeading"
                              IsVisible="{TemplateBinding InnerLeftContent, Converter={x:Static ObjectConverters.IsNotNull}}"
                              Content="{TemplateBinding InnerLeftContent}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <ContentPresenter x:Name="MaterialLeadingIcon"
                              material:MaterialTextFieldLayout.Slot="Leading"
                              Content="{TemplateBinding (material:MaterialTextField.LeadingIcon)}"
                              IsVisible="{TemplateBinding (material:MaterialTextField.LeadingIcon), Converter={x:Static ObjectConverters.IsNotNull}}"
                              MinWidth="48" MinHeight="48"
                              Foreground="{DynamicResource MaterialOnSurfaceVariantBrush}"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
            <TextBlock x:Name="MaterialPrefix"
                       material:MaterialTextFieldLayout.Slot="Prefix"
                       Text="{TemplateBinding (material:MaterialTextField.Prefix)}"
                       IsVisible="{TemplateBinding (material:MaterialTextField.Prefix), Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="{DynamicResource MaterialOnSurfaceVariantBrush}"
                       FontSize="{TemplateBinding FontSize}" LineHeight="{TemplateBinding LineHeight}"
                       LetterSpacing="{TemplateBinding LetterSpacing}" IsHitTestVisible="False" />
            <ScrollViewer x:Name="PART_ScrollViewer"
                          material:MaterialTextFieldLayout.Slot="Editor"
                          HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                          VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                          IsDeferredScrollingEnabled="{TemplateBinding (ScrollViewer.IsDeferredScrollingEnabled)}"
                          Padding="0" Foreground="{TemplateBinding Foreground}" Focusable="False">
              <TextPresenter x:Name="PART_TextPresenter"
                             Text="{TemplateBinding Text, Mode=TwoWay}"
                             CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                             CaretIndex="{TemplateBinding CaretIndex}"
                             SelectionStart="{TemplateBinding SelectionStart}"
                             SelectionEnd="{TemplateBinding SelectionEnd}"
                             TextAlignment="{TemplateBinding TextAlignment}"
                             TextWrapping="{TemplateBinding TextWrapping}"
                             LineHeight="{TemplateBinding LineHeight}"
                             LetterSpacing="{TemplateBinding LetterSpacing}"
                             PasswordChar="{TemplateBinding PasswordChar}"
                             RevealPassword="{TemplateBinding RevealPassword}"
                             SelectionBrush="{TemplateBinding SelectionBrush}"
                             SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                             CaretBrush="{TemplateBinding CaretBrush}"
                             HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                             VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
              <ScrollViewer.Styles>
                <Style Selector="ScrollContentPresenter#PART_ContentPresenter">
                  <Setter Property="Cursor" Value="IBeam" />
                </Style>
              </ScrollViewer.Styles>
            </ScrollViewer>
            <TextBlock x:Name="PlaceholderTextContentPresenter"
                       material:MaterialTextFieldLayout.Slot="Placeholder"
                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                       Foreground="{TemplateBinding PlaceholderForeground}"
                       Text="{TemplateBinding PlaceholderText}"
                       TextAlignment="{TemplateBinding TextAlignment}"
                       TextWrapping="{TemplateBinding TextWrapping}"
                       IsVisible="False" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock x:Name="MaterialSuffix"
                       material:MaterialTextFieldLayout.Slot="Suffix"
                       Text="{TemplateBinding (material:MaterialTextField.Suffix)}"
                       IsVisible="{TemplateBinding (material:MaterialTextField.Suffix), Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="{DynamicResource MaterialOnSurfaceVariantBrush}"
                       FontSize="{TemplateBinding FontSize}" LineHeight="{TemplateBinding LineHeight}"
                       LetterSpacing="{TemplateBinding LetterSpacing}" IsHitTestVisible="False" />
            <Button x:Name="DeleteButton" material:MaterialTextFieldLayout.Slot="Clear"
                    Theme="{StaticResource TextBoxDeleteButtonStyle}"
                    Command="{Binding $parent[TextBox].Clear}"
                    CornerRadius="24" Padding="0" Focusable="False" IsVisible="False"
                    FontSize="{TemplateBinding FontSize}" Width="48" Height="48" />
            <ToggleButton x:Name="RevealButton" material:MaterialTextFieldLayout.Slot="Reveal"
                          Theme="{StaticResource PasswordBoxRevealButtonStyle}"
                          IsChecked="{TemplateBinding RevealPassword, Mode=TwoWay}"
                          CornerRadius="24" Padding="0" Focusable="False" IsVisible="False"
                          FontSize="{TemplateBinding FontSize}" Width="48" Height="48" />
            <ContentPresenter x:Name="MaterialTrailingIcon"
                              material:MaterialTextFieldLayout.Slot="Trailing"
                              Content="{TemplateBinding (material:MaterialTextField.TrailingIcon)}"
                              IsVisible="{TemplateBinding (material:MaterialTextField.TrailingIcon), Converter={x:Static ObjectConverters.IsNotNull}}"
                              MinWidth="48" MinHeight="48"
                              Foreground="{DynamicResource MaterialOnSurfaceVariantBrush}"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
            <ContentPresenter x:Name="InnerRightContentPresenter"
                              material:MaterialTextFieldLayout.Slot="InnerTrailing"
                              IsVisible="{TemplateBinding InnerRightContent, Converter={x:Static ObjectConverters.IsNotNull}}"
                              Content="{TemplateBinding InnerRightContent}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <Grid x:Name="MaterialSupportingRow" material:MaterialTextFieldLayout.Slot="Supporting"
                  ColumnDefinitions="*,Auto" ColumnSpacing="16" IsVisible="False">
              <TextBlock x:Name="MaterialSupportingText" Grid.Column="0"
                         Text="{TemplateBinding (material:MaterialTextField.AssistiveText)}"
                         IsVisible="{TemplateBinding (material:MaterialTextField.AssistiveText), Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         Foreground="{DynamicResource MaterialOnSurfaceVariantBrush}"
                         FontSize="12" LineHeight="16" LetterSpacing="0.4" MinHeight="16"
                         TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
              <TextBlock x:Name="MaterialCharacterCounter" Grid.Column="1"
                         Text="{TemplateBinding (material:MaterialTextField.CounterText)}"
                         IsVisible="{TemplateBinding (material:MaterialTextField.CounterText), Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         Foreground="{DynamicResource MaterialOnSurfaceVariantBrush}"
                         FontSize="12" LineHeight="16" LetterSpacing="0.4" MinHeight="16"
                         AutomationProperties.AccessibilityView="Raw" />
            </Grid>
          </material:MaterialTextFieldLayout>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>

    <!-- TextFieldDefaults.MinWidth where the layout has room for it; compactWidth is the default
         minimum, kept for existing markup. -->
    <Style Selector="^.nativeMinWidth"><Setter Property="MinWidth" Value="280" /></Style>
    <Style Selector="^.compactWidth"><Setter Property="MinWidth" Value="120" /></Style>
    <Style Selector="^[AcceptsReturn=True]">
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Style Selector="^ /template/ material|MaterialTextFieldLayout#MaterialFieldLayout">
        <Setter Property="SingleLine" Value="False" />
      </Style>
    </Style>
    <Style Selector="^:pointerover /template/ Border#BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    </Style>
    <Style Selector="^:focus /template/ Border#BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource MaterialPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>
    <Style Selector="^.clearButton[AcceptsReturn=False][IsReadOnly=False]:focus:not(TextBox:empty) /template/ Button#DeleteButton">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^.revealPasswordButton[AcceptsReturn=False][IsReadOnly=False]:not(TextBox:empty) /template/ ToggleButton#RevealButton">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="^:empty /template/ TextBlock#PlaceholderTextContentPresenter">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- The legacy floatingLabel class still promotes PlaceholderText. The
         attached Label instead allows both a floating label and a placeholder. -->
    <Style Selector="^.floatingLabel /template/ TextBlock#MaterialFloatingLabel, ^:material-label /template/ TextBlock#MaterialFloatingLabel">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:material-label">
      <Setter Property="AutomationProperties.Name" Value="{Binding $self.(MaterialTextField.Label)}" />
      <Style Selector="^ /template/ TextBlock#MaterialFloatingLabel">
        <Setter Property="Text" Value="{TemplateBinding (material:MaterialTextField.Label)}" />
      </Style>
    </Style>
    <Style Selector="^.floatingLabel /template/ TextBlock#PlaceholderTextContentPresenter">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:material-label:empty:not(TextBox:focus) /template/ TextBlock#PlaceholderTextContentPresenter">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:material-label:empty:focus /template/ TextBlock#PlaceholderTextContentPresenter">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^.floatingLabel:empty:not(TextBox:focus) /template/ TextBlock#MaterialPrefix, ^.floatingLabel:empty:not(TextBox:focus) /template/ TextBlock#MaterialSuffix, ^:material-label:empty:not(TextBox:focus) /template/ TextBlock#MaterialPrefix, ^:material-label:empty:not(TextBox:focus) /template/ TextBlock#MaterialSuffix">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:focus /template/ material|MaterialTextFieldLayout#MaterialFieldLayout, ^:not(TextBox:empty) /template/ material|MaterialTextFieldLayout#MaterialFieldLayout">
      <Setter Property="LabelProgress" Value="1" />
    </Style>
    <Style Selector="^:focus /template/ TextBlock#MaterialFloatingLabel">
      <Setter Property="Foreground" Value="{DynamicResource MaterialPrimaryBrush}" />
    </Style>
    <Style Selector="^:material-support /template/ Grid#MaterialSupportingRow, ^:material-counter /template/ Grid#MaterialSupportingRow">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^.outlined">
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource MaterialOutlineBrush}" /><Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="^.outlined /template/ material|MaterialTextFieldLayout#MaterialFieldLayout">
      <Setter Property="IsOutlined" Value="True" />
    </Style>
    <Style Selector="^.outlined:focus /template/ Border#BorderElement">
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- Error affects the outline/indicator, label, caret, trailing icon and
         assistance; the value and leading icon keep their normal content roles. -->
    <Style Selector="^:error, ^:material-error">
      <Setter Property="CaretBrush" Value="{DynamicResource MaterialErrorBrush}" />
    </Style>
    <Style Selector="^:error /template/ Border#BorderElement, ^:material-error /template/ Border#BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource MaterialErrorBrush}" />
    </Style>
    <Style Selector="^:error /template/ TextBlock#MaterialFloatingLabel, ^:material-error /template/ TextBlock#MaterialFloatingLabel, ^:error /template/ TextBlock#MaterialSupportingText, ^:material-error /template/ TextBlock#MaterialSupportingText, ^:material-overlimit /template/ TextBlock#MaterialCharacterCounter, ^:error /template/ ContentPresenter#MaterialTrailingIcon, ^:material-error /template/ ContentPresenter#MaterialTrailingIcon">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource MaterialErrorBrush}" />
    </Style>
    <!-- Disabled takes precedence over error/focus colors, as in the native defaults. -->
    <Style Selector="^:disabled">
      <Setter Property="PlaceholderForeground" Value="{DynamicResource MaterialDisabledOnSurfaceBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ Border#BorderElement">
      <Setter Property="Background" Value="{DynamicResource MaterialTextFieldDisabledContainerBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MaterialDisabledOnSurfaceBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="^.outlined:disabled /template/ Border#BorderElement">
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="^:disabled /template/ ScrollViewer#PART_ScrollViewer, ^:disabled /template/ TextBlock#MaterialFloatingLabel, ^:disabled /template/ TextBlock#MaterialPrefix, ^:disabled /template/ TextBlock#MaterialSuffix, ^:disabled /template/ TextBlock#MaterialSupportingText, ^:disabled /template/ TextBlock#MaterialCharacterCounter, ^:disabled /template/ ContentPresenter#MaterialLeadingIcon, ^:disabled /template/ ContentPresenter#MaterialTrailingIcon">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource MaterialDisabledOnSurfaceBrush}" />
    </Style>
  </ControlTheme>

  <!-- DefaultPasswordBoxStyle (PasswordBox_themeresources.xaml): a text box with the password
       character of WinUI's PasswordBox, the reveal button instead of the delete button and the
       context flyout of a password box. Its other setters and its states are those of
       DefaultTextBoxStyle, as the source repeats them. -->
  <ControlTheme x:Key="DefaultPasswordBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
    <Setter Property="PasswordChar" Value="&#x25CF;" />
    <Setter Property="ContextFlyout" Value="{StaticResource PasswordBoxContextFlyout}" />
    <!-- ButtonCollapsed: a password box has no delete button. -->
    <Style Selector="^[AcceptsReturn=False][IsReadOnly=False][TextWrapping=NoWrap]:focus:not(TextBox:empty) /template/ Button#DeleteButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- ButtonVisible (PasswordBox::CanInvokeRevealButton: focused, not empty). -->
    <Style Selector="^[AcceptsReturn=False][IsReadOnly=False]:focus:not(TextBox:empty) /template/ ToggleButton#RevealButton">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TextBox}" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}" />
  <ControlTheme x:Key="MaterialFilledTextField" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}" />
  <ControlTheme x:Key="MaterialOutlinedTextField" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource MaterialOutlineBrush}" /><Setter Property="CornerRadius" Value="4" />
    <Style Selector="^ /template/ material|MaterialTextFieldLayout#MaterialFieldLayout"><Setter Property="IsOutlined" Value="True" /></Style>
    <Style Selector="^:focus /template/ Border#BorderElement"><Setter Property="BorderThickness" Value="2" /></Style>
    <Style Selector="^:disabled /template/ Border#BorderElement"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="1" /></Style>
  </ControlTheme>
</ResourceDictionary>

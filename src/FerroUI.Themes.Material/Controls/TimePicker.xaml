<ResourceDictionary xmlns="https://github.com/ferroui" xmlns:material="using:FerroUI.Themes.Material" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Padding="20" Height="500">
      <StackPanel Spacing="20" VerticalAlignment="Center">
        <TimePicker />
        <TimePicker IsEnabled="False" />
      </StackPanel>
    </Border>
  </Design.PreviewWith>
  <ControlTheme x:Key="TimePickerFlyoutButtonStyle" TargetType="Button">
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="FieldContainer" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
          <Panel>
            <Border x:Name="StateLayer" CornerRadius="{TemplateBinding CornerRadius}" Background="Transparent" IsHitTestVisible="False" />
            <material:MaterialRipple Fill="{TemplateBinding Foreground}" CornerRadius="{TemplateBinding CornerRadius}" ReducedMotion="{DynamicResource MaterialReducedMotion}" />
            <ContentPresenter x:Name="PART_ContentPresenter" Foreground="{TemplateBinding Foreground}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#StateLayer">
      <Setter Property="Background" Value="{DynamicResource MaterialOnSurfaceHoverBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#FieldContainer">
      <Setter Property="BorderBrush" Value="{DynamicResource MaterialPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource MaterialDisabledOnSurfaceBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ Border#FieldContainer">
      <Setter Property="Background" Value="{DynamicResource MaterialDisabledFieldBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MaterialDisabledOnSurfaceBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ Border#StateLayer">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type TimePicker}" TargetType="TimePicker">
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Background" Value="{DynamicResource MaterialSurfaceContainerHighestBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="MinWidth" Value="{StaticResource TimePickerThemeMinWidth}" />
    <Setter Property="MaxWidth" Value="{StaticResource TimePickerThemeMaxWidth}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="CornerRadius" Value="4,4,0,0" />
    <Setter Property="Template">
      <ControlTemplate>
        <DataValidationErrors>
          <Grid x:Name="LayoutRoot" Margin="{TemplateBinding Padding}">
            <Button x:Name="PART_FlyoutButton" Theme="{StaticResource TimePickerFlyoutButtonStyle}" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" IsEnabled="{TemplateBinding IsEnabled}" MinWidth="{TemplateBinding MinWidth}" MaxWidth="{TemplateBinding MaxWidth}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="{TemplateBinding CornerRadius}" TemplatedControl.IsTemplateFocusTarget="True" MinHeight="56">
              <Grid x:Name="PART_FlyoutButtonContentGrid">
                <Border x:Name="PART_FirstPickerHost" Grid.Column="0">
                  <TextBlock x:Name="PART_HourTextBlock" Text="hour" TextAlignment="Center" Padding="{DynamicResource TimePickerHostPadding}" FontFamily="{TemplateBinding FontFamily}" FontWeight="{TemplateBinding FontWeight}" FontSize="{TemplateBinding FontSize}" />
                </Border>
                <Rectangle x:Name="PART_FirstColumnDivider" Fill="{DynamicResource TimePickerSpacerFill}" HorizontalAlignment="Center" Width="{DynamicResource TimePickerSpacerThemeWidth}" Grid.Column="1" />
                <Border x:Name="PART_SecondPickerHost" Grid.Column="2">
                  <TextBlock x:Name="PART_MinuteTextBlock" Text="minute" TextAlignment="Center" Padding="{DynamicResource TimePickerHostPadding}" FontFamily="{TemplateBinding FontFamily}" FontWeight="{TemplateBinding FontWeight}" FontSize="{TemplateBinding FontSize}" />
                </Border>
                <Rectangle x:Name="PART_SecondColumnDivider" Fill="{DynamicResource TimePickerSpacerFill}" HorizontalAlignment="Center" Width="{DynamicResource TimePickerSpacerThemeWidth}" Grid.Column="3" />
                <Border x:Name="PART_ThirdPickerHost" Grid.Column="4">
                  <TextBlock x:Name="PART_SecondTextBlock" Text="second" TextAlignment="Center" Padding="{DynamicResource TimePickerHostPadding}" FontFamily="{TemplateBinding FontFamily}" FontWeight="{TemplateBinding FontWeight}" FontSize="{TemplateBinding FontSize}" />
                </Border>
                <Rectangle x:Name="PART_ThirdColumnDivider" Fill="{DynamicResource TimePickerSpacerFill}" HorizontalAlignment="Center" Width="{DynamicResource TimePickerSpacerThemeWidth}" Grid.Column="5" />
                <Border x:Name="PART_FourthPickerHost" Grid.Column="6">
                  <TextBlock x:Name="PART_PeriodTextBlock" TextAlignment="Center" Padding="{DynamicResource TimePickerHostPadding}" FontFamily="{TemplateBinding FontFamily}" FontWeight="{TemplateBinding FontWeight}" FontSize="{TemplateBinding FontSize}" />
                </Border>
              </Grid>
            </Button>
            <Popup x:Name="PART_Popup" WindowManagerAddShadowHint="False" IsLightDismissEnabled="True" PlacementTarget="{TemplateBinding}" Placement="Bottom">
              <TimePickerPresenter x:Name="PART_PickerPresenter" Margin="{StaticResource ThemeShadowFlyoutMargin}" />
            </Popup>
          </Grid>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ Button#PART_FlyoutButton TextBlock">
      <Setter Property="VerticalAlignment" Value="{TemplateBinding VerticalContentAlignment}" />
    </Style>
    <Style Selector="^:disabled">
      <Style Selector="^ /template/ Rectangle#PART_FirstColumnDivider">
        <Setter Property="Fill" Value="{DynamicResource TimePickerSpacerFillDisabled}" />
      </Style>
      <Style Selector="^ /template/ Rectangle#PART_SecondColumnDivider">
        <Setter Property="Fill" Value="{DynamicResource TimePickerSpacerFillDisabled}" />
      </Style>
      <Style Selector="^ /template/ Rectangle#PART_ThirdColumnDivider">
        <Setter Property="Fill" Value="{DynamicResource TimePickerSpacerFillDisabled}" />
      </Style>
    </Style>
    <Style Selector="^:hasnotime /template/ Button#PART_FlyoutButton">
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
    </Style>
    <Style Selector="^:error /template/ Button#PART_FlyoutButton">
      <Setter Property="BorderBrush" Value="{DynamicResource MaterialErrorBrush}" />
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type TimePickerPresenter}" TargetType="TimePickerPresenter">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Width" Value="242" />
    <Setter Property="MinWidth" Value="242" />
    <Setter Property="MaxHeight" Value="398" />
    <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Background" Value="{DynamicResource MaterialSurfaceContainerHighBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TimePickerFlyoutPresenterBorderBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="28" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="Background" BoxShadow="{DynamicResource MaterialElevation2BoxShadow}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{DynamicResource DateTimeFlyoutBorderPadding}" MaxHeight="398">
          <Grid x:Name="ContentPanel" RowDefinitions="*,Auto">
            <Grid x:Name="PART_PickerContainer">
              <Grid.Styles>
                <Style Selector="DateTimePickerPanel &gt; ListBoxItem">
                  <Setter Property="Theme" Value="{StaticResource DateTimePickerLoopingSelectorItemStyle}" />
                </Style>
              </Grid.Styles>
              <Border x:Name="HighlightRect" ZIndex="-1" Background="{DynamicResource MaterialSecondaryContainerBrush}" CornerRadius="8" Grid.Column="0" Grid.ColumnSpan="7" VerticalAlignment="Center" Height="{DynamicResource TimePickerFlyoutPresenterHighlightHeight}" Margin="4,2,4,2" IsHitTestVisible="False" />
              <Grid x:Name="PART_HourHost" Grid.Column="0">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" Template="{StaticResource ScrollViewerScrollBarlessTemplate}">
                  <DateTimePickerPanel x:Name="PART_HourSelector" PanelType="Hour" ShouldLoop="True" ItemHeight="{DynamicResource TimePickerFlyoutPresenterItemHeight}" />
                </ScrollViewer>
                <RepeatButton x:Name="PART_HourUpButton" Theme="{StaticResource DateTimePickerLoopingSelectorUpButtonStyle}" />
                <RepeatButton x:Name="PART_HourDownButton" Theme="{StaticResource DateTimePickerLoopingSelectorDownButtonStyle}" />
              </Grid>
              <Rectangle x:Name="PART_FirstSpacer" ZIndex="10000" Fill="{DynamicResource TimePickerFlyoutPresenterSpacerFill}" HorizontalAlignment="Center" Width="{DynamicResource TimePickerSpacerThemeWidth}" Grid.Column="1" />
              <Grid x:Name="PART_MinuteHost" Grid.Column="2">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" Template="{StaticResource ScrollViewerScrollBarlessTemplate}">
                  <DateTimePickerPanel x:Name="PART_MinuteSelector" PanelType="Minute" ShouldLoop="True" ItemHeight="{DynamicResource TimePickerFlyoutPresenterItemHeight}" />
                </ScrollViewer>
                <RepeatButton x:Name="PART_MinuteUpButton" Theme="{StaticResource DateTimePickerLoopingSelectorUpButtonStyle}" />
                <RepeatButton x:Name="PART_MinuteDownButton" Theme="{StaticResource DateTimePickerLoopingSelectorDownButtonStyle}" />
              </Grid>
              <Rectangle x:Name="PART_SecondSpacer" ZIndex="10000" Fill="{DynamicResource TimePickerFlyoutPresenterSpacerFill}" HorizontalAlignment="Center" Width="{DynamicResource TimePickerSpacerThemeWidth}" Grid.Column="3" />
              <Grid x:Name="PART_SecondHost" Grid.Column="4">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" Template="{StaticResource ScrollViewerScrollBarlessTemplate}">
                  <DateTimePickerPanel x:Name="PART_SecondSelector" PanelType="Second" ShouldLoop="True" ItemHeight="{DynamicResource TimePickerFlyoutPresenterItemHeight}" />
                </ScrollViewer>
                <RepeatButton x:Name="PART_SecondUpButton" Theme="{StaticResource DateTimePickerLoopingSelectorUpButtonStyle}" />
                <RepeatButton x:Name="PART_SecondDownButton" Theme="{StaticResource DateTimePickerLoopingSelectorDownButtonStyle}" />
              </Grid>
              <Rectangle x:Name="PART_ThirdSpacer" ZIndex="10000" Fill="{DynamicResource TimePickerFlyoutPresenterSpacerFill}" HorizontalAlignment="Center" Width="{DynamicResource TimePickerSpacerThemeWidth}" Grid.Column="5" />
              <Grid x:Name="PART_PeriodHost" Grid.Column="6">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" Template="{StaticResource ScrollViewerScrollBarlessTemplate}">
                  <DateTimePickerPanel x:Name="PART_PeriodSelector" PanelType="TimePeriod" ShouldLoop="False" ItemHeight="{DynamicResource TimePickerFlyoutPresenterItemHeight}" />
                </ScrollViewer>
                <RepeatButton x:Name="PART_PeriodUpButton" Theme="{StaticResource DateTimePickerLoopingSelectorUpButtonStyle}" />
                <RepeatButton x:Name="PART_PeriodDownButton" Theme="{StaticResource DateTimePickerLoopingSelectorDownButtonStyle}" />
              </Grid>
            </Grid>
            <Grid x:Name="AcceptDismissHostGrid" Grid.Row="1" Height="{DynamicResource TimePickerFlyoutPresenterAcceptDismissHostGridHeight}" ColumnDefinitions="*,*">
              <Rectangle Height="{DynamicResource TimePickerSpacerThemeWidth}" VerticalAlignment="Top" Fill="{DynamicResource TimePickerFlyoutPresenterSpacerFill}" Grid.ColumnSpan="2" />
              <Button x:Name="PART_AcceptButton" Grid.Column="0" Theme="{StaticResource DateTimePickerFlyoutButtonStyle}" FontSize="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="{StaticResource DatePickerFlyoutPresenterDismissMargin}" Padding="4">
                <Path Data="{StaticResource GlyphGeometryE8FB}" Fill="{Binding $parent[Button].Foreground}" Stretch="Uniform" Width="14" />
              </Button>
              <Button x:Name="PART_DismissButton" Grid.Column="1" Theme="{StaticResource DateTimePickerFlyoutButtonStyle}" FontSize="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="{StaticResource DatePickerFlyoutPresenterDismissMargin}" Padding="4">
                <Path Data="{StaticResource GlyphGeometryE711}" Fill="{Binding $parent[Button].Foreground}" Stretch="Uniform" Width="12" />
              </Button>
            </Grid>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ Grid#PART_HourHost:pointerover &gt; RepeatButton">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^ /template/ Grid#PART_MinuteHost:pointerover &gt; RepeatButton">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^ /template/ Grid#PART_SecondHost:pointerover &gt; RepeatButton">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^ /template/ Grid#PART_PeriodHost:pointerover &gt; RepeatButton">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>
</ResourceDictionary>

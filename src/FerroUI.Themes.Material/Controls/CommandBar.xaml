  <ControlTheme x:Key="{x:Type CommandBarToggleButton}" TargetType="CommandBarToggleButton" BasedOn="{StaticResource DefaultAppBarToggleButtonStyle}" />
  <ControlTheme x:Key="DefaultAppBarSeparatorStyle" TargetType="CommandBarSeparator">
    <Setter Property="Foreground" Value="{DynamicResource MaterialOutlineVariantBrush}" />
    <Setter Property="Padding" Value="{DynamicResource AppBarSeparatorMargin}" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel x:Name="RootGrid">
          <Rectangle x:Name="SeparatorRectangle" RadiusX="{StaticResource AppBarSeparatorCornerRadius}" RadiusY="{StaticResource AppBarSeparatorCornerRadius}" Width="{StaticResource AppBarSeparatorWidth}" VerticalAlignment="Stretch" Fill="{TemplateBinding Foreground}" Margin="{TemplateBinding Padding}" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^[IsCompact=True] /template/ Panel#RootGrid">
      <Setter Property="Height" Value="{DynamicResource AppBarThemeCompactHeight}" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="^[IsInOverflow=True] /template/ Panel#RootGrid">
      <Setter Property="Height" Value="NaN" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="^[IsInOverflow=True] /template/ Rectangle#SeparatorRectangle">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Height" Value="{StaticResource AppBarOverflowSeparatorHeight}" />
      <Setter Property="Margin" Value="{StaticResource AppBarOverflowSeparatorMargin}" />
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type CommandBarSeparator}" TargetType="CommandBarSeparator" BasedOn="{StaticResource DefaultAppBarSeparatorStyle}" />
  <ControlTheme x:Key="EllipsisButton" TargetType="Button" BasedOn="{StaticResource NavigationBackButtonNormalStyle}">
    <Setter Property="Margin" Value="0" />
  </ControlTheme>
  <ControlTheme x:Key="DefaultCommandBarOverflowPresenterStyle" TargetType="ItemsControl">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="{DynamicResource MaterialSurfaceContainerBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CommandBarOverflowPresenterBorderBrush}" />
    <Setter Property="Padding" Value="0,8" />
    <Setter Property="MaxWidth" Value="280" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="LayoutRoot" Background="{TemplateBinding Background}" BackgroundSizing="InnerBorderEdge" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" CornerRadius="{TemplateBinding CornerRadius}">
          <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}" VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}">
            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" Margin="0" />
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
  <ControlTheme x:Key="DefaultCommandBarStyle" TargetType="CommandBar">
    <Setter Property="DefaultLabelPosition" Value="Collapsed" />
    <Setter Property="MinHeight" Value="64" />
    <Setter Property="Background" Value="{DynamicResource MaterialSurfaceContainerBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    <Setter Property="Padding" Value="4,8" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="ItemWidthBottom" Value="48" />
    <Setter Property="ItemWidthCollapsed" Value="48" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel x:Name="LayoutRoot">
          <Border x:Name="ContentRoot" VerticalAlignment="Stretch" MinHeight="64" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" MinWidth="{StaticResource AppBarMoreButtonColumnMinWidth}" />
              </Grid.ColumnDefinitions>
              <Grid ColumnDefinitions="*,Auto">
                <ContentPresenter x:Name="PART_ContentPresenter" Margin="0" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" />
                <ItemsControl x:Name="PrimaryItemsControl" Grid.Column="1" HorizontalAlignment="Right" MinHeight="{DynamicResource AppBarThemeCompactHeight}" IsTabStop="False" ItemsSource="{Binding VisiblePrimaryCommands, RelativeSource={RelativeSource TemplatedParent}}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </Grid>
              <Button x:Name="PART_OverflowButton" Grid.Column="1" Theme="{StaticResource EllipsisButton}" Foreground="{TemplateBinding Foreground}" MinHeight="48" VerticalAlignment="Center" IsVisible="{TemplateBinding IsOverflowButtonVisible}">
                <Path x:Name="EllipsisIcon" Data="M12 8A2 2 0 1 0 12 4A2 2 0 1 0 12 8ZM12 14A2 2 0 1 0 12 10A2 2 0 1 0 12 14ZM12 20A2 2 0 1 0 12 16A2 2 0 1 0 12 20Z" Fill="{Binding $parent[Button].Foreground}" Stretch="None" Width="24" Height="24" VerticalAlignment="Center" />
              </Button>
              <Rectangle x:Name="HighContrastBorder" Grid.ColumnSpan="2" IsVisible="False" VerticalAlignment="Stretch" Stroke="{DynamicResource CommandBarHighContrastBorder}" StrokeThickness="1" />
              <Border x:Name="OpenBorder" Grid.ColumnSpan="2" IsVisible="False" VerticalAlignment="Stretch" BorderThickness="0" BorderBrush="Transparent" CornerRadius="{TemplateBinding CornerRadius}" />
            </Grid>
          </Border>
          <Popup x:Name="PART_OverflowPopup" IsOpen="{TemplateBinding IsOpen, Mode=TwoWay}" PlacementTarget="{Binding #ContentRoot}" Placement="BottomEdgeAlignedRight" IsLightDismissEnabled="True" WindowManagerAddShadowHint="False">
            <Border x:Name="SecondaryItemsControlShadowWrapper" BoxShadow="{DynamicResource MaterialElevation2BoxShadow}" Margin="{StaticResource ThemeShadowFlyoutMargin}" CornerRadius="4">
              <ItemsControl x:Name="PART_OverflowPresenter" Theme="{StaticResource DefaultCommandBarOverflowPresenterStyle}" IsTabStop="False" ItemsSource="{Binding OverflowItems, RelativeSource={RelativeSource TemplatedParent}}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </Border>
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:disabled /template/ Path#EllipsisIcon">
      <Setter Property="Fill" Value="{DynamicResource MaterialDisabledOnSurfaceBrush}" />
    </Style>
    <Style Selector="^[IsOpen=True]">
      <Style Selector="^ /template/ Border#ContentRoot">
        <Setter Property="Background" Value="{DynamicResource MaterialSurfaceContainerBrush}" />
        <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}" />
      </Style>
      <Style Selector="^ /template/ Border#OpenBorder, ^ /template/ Rectangle#HighContrastBorder">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^ /template/ Button#PART_OverflowButton">
        <Setter Property="VerticalAlignment" Value="Stretch" />
      </Style>
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type CommandBar}" TargetType="CommandBar" BasedOn="{StaticResource DefaultCommandBarStyle}" />
</ResourceDictionary>

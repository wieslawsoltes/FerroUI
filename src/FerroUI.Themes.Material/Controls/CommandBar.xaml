    <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderBrush="{DynamicResource MaterialSecondaryBrush}" BorderThickness="3" CornerRadius="20" Margin="-3" />
      </FocusAdornerTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel x:Name="Root" Background="Transparent">
          <Border x:Name="MaterialContainer" Margin="4" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" TemplatedControl.IsTemplateFocusTarget="True">
            <Border.Transitions>
              <Transitions>
                <material:MaterialCornerRadiusTransition Property="CornerRadius" Duration="{DynamicResource MaterialMotionDefaultEffectsDuration}" Easing="{DynamicResource MaterialMotionDefaultEffectsEasing}" />
              </Transitions>
            </Border.Transitions>
            <Panel>
              <Border x:Name="StateLayer" Background="{TemplateBinding Foreground}" CornerRadius="{Binding #MaterialContainer.CornerRadius}" Opacity="0" IsHitTestVisible="False">
                <Border.Transitions>
                  <Transitions>
                    <material:MaterialDoubleTransition Property="Opacity" Duration="{DynamicResource MaterialMotionFastEffectsDuration}" Easing="{DynamicResource MaterialMotionFastEffectsEasing}" />
                  </Transitions>
                </Border.Transitions>
              </Border>
              <material:MaterialRipple Fill="{TemplateBinding Foreground}" CornerRadius="{Binding #MaterialContainer.CornerRadius}" ReducedMotion="{DynamicResource MaterialReducedMotion}" />
              <Grid x:Name="ContentRoot" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Viewbox x:Name="ContentViewbox" Width="24" Height="24" HorizontalAlignment="Center" IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" Grid.ColumnSpan="2">
                  <Panel Width="24" Height="24">
                    <ContentPresenter x:Name="Content" Content="{TemplateBinding Icon}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    <Path x:Name="OverflowCheckGlyph" FlowDirection="LeftToRight" Width="24" Height="24" Stretch="None" Data="M9 16.17 4.83 12 3.41 13.41 9 19 21 7 19.59 5.59Z" Fill="{TemplateBinding Foreground}" IsVisible="False" />
                  </Panel>
                </Viewbox>
                <TextBlock x:Name="TextLabel" Grid.Row="1" Text="{TemplateBinding Label}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Margin="0,4,0,0" TextAlignment="Center" VerticalAlignment="Center" Grid.ColumnSpan="2" />
              </Grid>
            </Panel>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^[LabelPosition=Bottom]">
      <Setter Property="MinHeight" Value="64" />
    </Style>
    <Style Selector="^[IsCompact=True], ^[LabelPosition=Collapsed]">
      <Setter Property="MinHeight" Value="48" />
    </Style>
    <Style Selector="^[IsCompact=True] /template/ TextBlock#TextLabel, ^[LabelPosition=Collapsed] /template/ TextBlock#TextLabel">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^[LabelPosition=Right]">
      <Setter Property="Width" Value="NaN" />
    </Style>
    <Style Selector="^[LabelPosition=Right] /template/ Grid#ContentRoot">
      <Setter Property="Margin" Value="12,0" />
    </Style>
    <Style Selector="^[LabelPosition=Right] /template/ Viewbox#ContentViewbox">
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Grid.ColumnSpan" Value="1" />
    </Style>
    <Style Selector="^[LabelPosition=Right] /template/ TextBlock#TextLabel">
      <Setter Property="Grid.Row" Value="0" />
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Grid.ColumnSpan" Value="1" />
    </Style>
    <Style Selector="^[IsInOverflow=True]">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="MinWidth" Value="112" />
      <Setter Property="MaxWidth" Value="280" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    </Style>
    <Style Selector="^[IsInOverflow=True] /template/ Border#MaterialContainer">
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="^[IsInOverflow=True] /template/ Grid#ContentRoot">

      <Setter Property="Margin" Value="12,8" />
    </Style>
    <Style Selector="^[IsInOverflow=True] /template/ Viewbox#ContentViewbox">
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="Grid.ColumnSpan" Value="1" />
    </Style>
    <Style Selector="^[IsInOverflow=True] /template/ TextBlock#TextLabel">
      <Setter Property="Grid.Row" Value="0" />
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="TextAlignment" Value="Left" />
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Grid.ColumnSpan" Value="1" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#StateLayer">
      <Setter Property="Opacity" Value="0.08" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#StateLayer">
      <Setter Property="Opacity" Value="0.10" />
    </Style>
    <Style Selector="^:pressed /template/ Border#MaterialContainer">
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="^[IsInOverflow=True]:pressed /template/ Border#MaterialContainer">
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource MaterialDisabledOnSurfaceBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ Border#StateLayer">
      <Setter Property="Opacity" Value="0" />
    </Style>
  </ControlTheme>

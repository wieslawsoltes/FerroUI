<ResourceDictionary xmlns="https://github.com/ferroui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:material="using:FerroUI.Themes.Material"
                    x:ClassModifier="internal">
  <ControlTheme x:Key="DefaultCheckBoxStyle" TargetType="CheckBox">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="MinWidth" Value="48" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="0,0,12,0" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderBrush="{DynamicResource MaterialSecondaryBrush}"
                BorderThickness="3" CornerRadius="24" Margin="-3" />
      </FocusAdornerTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="Transparent" ColumnDefinitions="48,*" MinHeight="48">
          <Grid Width="48" Height="48" VerticalAlignment="Center">
            <Border x:Name="MaterialStateLayer" Width="40" Height="40" CornerRadius="20"
                    Background="{DynamicResource MaterialOnSurfaceBrush}" Opacity="0"
                    IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Border.Transitions><Transitions><material:MaterialDoubleTransition Property="Opacity" Duration="{DynamicResource MaterialMotionFastEffectsDuration}" Easing="{DynamicResource MaterialMotionFastEffectsEasing}" /></Transitions></Border.Transitions>
            </Border>
            <material:MaterialRipple x:Name="MaterialRipple" Fill="{DynamicResource MaterialOnSurfaceBrush}"
                                     Width="40" Height="40" CornerRadius="20"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     ReducedMotion="{DynamicResource MaterialReducedMotion}" />
            <Border x:Name="SelectionOutline" Width="18" Height="18" BorderThickness="2"
                    BorderBrush="{DynamicResource MaterialOnSurfaceVariantBrush}"
                    CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Border.Transitions><Transitions><BrushTransition Property="Background" Duration="{DynamicResource MaterialMotionFastEffectsDuration}" Easing="{DynamicResource MaterialMotionFastEffectsEasing}" /></Transitions></Border.Transitions>
            </Border>
            <material:MaterialSelectionMark x:Name="SelectionMark"
                  IsChecked="{TemplateBinding IsChecked}" Fill="Transparent"
                  Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                  ReducedMotion="{DynamicResource MaterialReducedMotion}"
                  MotionScheme="{DynamicResource MaterialMotionScheme}">
              <material:MaterialSelectionMark.Transitions><Transitions>
                <BrushTransition Property="Fill" Duration="{DynamicResource MaterialMotionFastEffectsDuration}" Easing="{DynamicResource MaterialMotionFastEffectsEasing}" />
              </Transitions></material:MaterialSelectionMark.Transitions>
            </material:MaterialSelectionMark>
          </Grid>
          <ContentPresenter x:Name="PART_ContentPresenter" Grid.Column="1"
                            Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" Margin="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True" TextWrapping="Wrap" />
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#MaterialStateLayer">
    <Setter Property="Opacity" Value="0.08" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#MaterialStateLayer">
    <Setter Property="Opacity" Value="0.10" />
    </Style>
    <Style Selector="^:disabled /template/ Border#MaterialStateLayer">
    <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="^:checked /template/ Border#SelectionOutline, ^:indeterminate /template/ Border#SelectionOutline">
    <Setter Property="Background" Value="{DynamicResource MaterialPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="^:checked /template/ material|MaterialSelectionMark#SelectionMark, ^:indeterminate /template/ material|MaterialSelectionMark#SelectionMark">
      <Setter Property="Fill" Value="{DynamicResource MaterialOnPrimaryBrush}" />
    </Style>
    <Style Selector="^:error /template/ Border#SelectionOutline">
    <Setter Property="BorderBrush" Value="{DynamicResource MaterialErrorBrush}" />
    </Style>
    <Style Selector="^:checked:error /template/ Border#SelectionOutline, ^:indeterminate:error /template/ Border#SelectionOutline">
    <Setter Property="Background" Value="{DynamicResource MaterialErrorBrush}" />
    </Style>
    <Style Selector="^:error /template/ material|MaterialSelectionMark#SelectionMark">
    <Setter Property="Fill" Value="{DynamicResource MaterialOnErrorBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ Border#SelectionOutline">
    <Setter Property="BorderBrush" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    <Setter Property="Opacity" Value="0.38" />
    </Style>
    <Style Selector="^:checked:disabled /template/ Border#SelectionOutline, ^:indeterminate:disabled /template/ Border#SelectionOutline">
    <Setter Property="Background" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ material|MaterialSelectionMark#SelectionMark">
    <Setter Property="Fill" Value="{DynamicResource MaterialSurfaceBrush}" />
    </Style>
    <Style Selector="^:checked /template/ Border#MaterialStateLayer, ^:indeterminate /template/ Border#MaterialStateLayer">
    <Setter Property="Background" Value="{DynamicResource MaterialPrimaryBrush}" />
    </Style>
    <Style Selector="^:disabled">
    <Setter Property="Foreground" Value="{DynamicResource MaterialDisabledContentBrush}" />
    </Style>
    <Style Selector="^:checked /template/ material|MaterialRipple#MaterialRipple, ^:indeterminate /template/ material|MaterialRipple#MaterialRipple">
      <Setter Property="Fill" Value="{DynamicResource MaterialPrimaryBrush}" />
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}" />
</ResourceDictionary>

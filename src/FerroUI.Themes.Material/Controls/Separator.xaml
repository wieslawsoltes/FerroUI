<ResourceDictionary xmlns="https://github.com/ferroui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">
  <ControlTheme x:Key="{x:Type Separator}" TargetType="Separator">
    <Setter Property="Background" Value="{DynamicResource MaterialOutlineVariantBrush}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template"><ControlTemplate><Rectangle Fill="{TemplateBinding Background}" Margin="{TemplateBinding Padding}" Height="1" /></ControlTemplate></Setter>
    <Style Selector="^.inset"><Setter Property="Padding" Value="16,0" /></Style>
  </ControlTheme>

</ResourceDictionary>

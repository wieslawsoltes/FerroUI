<ResourceDictionary xmlns="https://github.com/ferroui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">
  <ControlTheme x:Key="{x:Type TextSelectionHandle}" TargetType="TextSelectionHandle">
    <Setter Property="Template"><ControlTemplate>
      <Grid Width="48" Height="48" Background="Transparent">
        <Border x:Name="PART_Indicator" Width="1" Height="1" HorizontalAlignment="Center" VerticalAlignment="Top" />
        <Path x:Name="MaterialSelectionHandle" Data="M 12,0 L 20.5,8.5 A 12,12 0 1 1 3.5,8.5 Z"
              Width="24" Height="28" Fill="{DynamicResource MaterialPrimaryBrush}"
              HorizontalAlignment="Center" VerticalAlignment="Top" Stretch="Fill" />
      </Grid>
    </ControlTemplate></Setter>
    <Style Selector="^:start /template/ Path#MaterialSelectionHandle">
      <Setter Property="Data" Value="M 24,0 L 24,12 A 12,12 0 1 1 12,0 Z" />
      <Setter Property="Margin" Value="-23,0,0,0" />
      <Setter Property="Height" Value="24" />
    </Style>
    <Style Selector="^:end /template/ Path#MaterialSelectionHandle">
      <Setter Property="Data" Value="M 0,0 L 12,0 A 12,12 0 1 1 0,12 Z" />
      <Setter Property="Margin" Value="23,0,0,0" />
      <Setter Property="Height" Value="24" />
    </Style>
  </ControlTheme>
</ResourceDictionary>

<!-- AndroidX Material3 SegmentedButton.kt, e4d933c98df7baa7ea2b83eea6e086915961e0ff.
     Native radio/toggle children; group geometry and label/check motion are shared. -->
<ResourceDictionary xmlns="https://github.com/ferroui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:material="using:FerroUI.Themes.Material"
                    x:ClassModifier="internal">
  <ControlTheme x:Key="MaterialSegmentedGroupItem" TargetType="ToggleButton" BasedOn="{StaticResource MaterialSegmentedButton}">
    <Setter Property="MinWidth" Value="58" />
    <Setter Property="TextBlock.LineHeight" Value="20" />
    <Setter Property="LetterSpacing" Value="0.1" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent" MinHeight="48">
          <Border x:Name="ChipContainer" Height="40" VerticalAlignment="Center"
                  Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding (material:MaterialSegmentedGroup.ItemCornerRadius)}">
            <Panel>
              <Border x:Name="StateLayer" Background="Transparent" IsHitTestVisible="False"
                      CornerRadius="{TemplateBinding (material:MaterialSegmentedGroup.ItemCornerRadius)}">
                <Border.Transitions><Transitions>
                  <BrushTransition Property="Background" Duration="{DynamicResource MaterialMotionFastEffectsDuration}" Easing="{DynamicResource MaterialMotionFastEffectsEasing}" />
                </Transitions></Border.Transitions>
              </Border>
              <material:MaterialRipple x:Name="Ripple" Fill="{TemplateBinding Foreground}"
                      CornerRadius="{TemplateBinding (material:MaterialSegmentedGroup.ItemCornerRadius)}"
                      ReducedMotion="{DynamicResource MaterialReducedMotion}" />
              <material:MaterialSegmentedContent x:Name="SegmentContent" Margin="{TemplateBinding Padding}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      MotionScheme="{DynamicResource MaterialMotionScheme}"
                      ReducedMotion="{DynamicResource MaterialReducedMotion}">
                <Viewbox x:Name="CheckIcon" Width="18" Height="18" IsHitTestVisible="False"
                         Opacity="{Binding #SegmentContent.IconOpacity}" RenderTransformOrigin="0%,100%"
                         AutomationProperties.AccessibilityView="Raw">
                  <Viewbox.RenderTransform>
                    <ScaleTransform ScaleX="{Binding #SegmentContent.IconScale}" ScaleY="{Binding #SegmentContent.IconScale}" />
                  </Viewbox.RenderTransform>
                  <Path FlowDirection="LeftToRight" Data="M9 16.17 4.83 12 3.41 13.41 9 19 21 7 19.59 5.59Z"
                        Width="24" Height="24" Stretch="None" Fill="{TemplateBinding Foreground}" />
                </Viewbox>
                <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center" RecognizesAccessKey="True" />
              </material:MaterialSegmentedContent>
              <Border x:Name="SegmentFocusRing" BorderBrush="{DynamicResource MaterialSecondaryBrush}"
                      BorderThickness="3" Margin="-3" IsVisible="False" IsHitTestVisible="False"
                      CornerRadius="{TemplateBinding (material:MaterialSegmentedGroup.ItemCornerRadius)}" />
            </Panel>
          </Border>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:not(RadioButton)">
      <Setter Property="AutomationProperties.ControlTypeOverride" Value="CheckBox" />
    </Style>
    <Style Selector="^:checked /template/ material|MaterialSegmentedContent#SegmentContent">
      <Setter Property="IsSelected" Value="True" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#SegmentFocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled /template/ Border#SegmentFocusRing">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type material:MaterialSegmentedGroup}" TargetType="material:MaterialSegmentedGroup">
    <Setter Property="ItemTheme" Value="{StaticResource MaterialSegmentedGroupItem}" />
    <Setter Property="MinHeight" Value="48" />
  </ControlTheme>
</ResourceDictionary>

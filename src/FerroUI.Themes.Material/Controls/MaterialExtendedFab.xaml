<!-- Expressive extended FABs. Native source: FloatingActionButton.kt at
     AndroidX e4d933c98df7baa7ea2b83eea6e086915961e0ff (Apache-2.0). -->
<ResourceDictionary xmlns="https://github.com/ferroui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:material="using:FerroUI.Themes.Material"
                    x:ClassModifier="internal">
  <ControlTheme x:Key="{x:Type material:MaterialExtendedFab}" TargetType="material:MaterialExtendedFab">
    <Setter Property="Background" Value="{DynamicResource MaterialPrimaryContainerBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnPrimaryContainerBrush}"/>
    <Setter Property="CornerRadius" Value="16"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinWidth" Value="56"/>
    <Setter Property="MinHeight" Value="56"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="TextBlock.LineHeight" Value="24"/>
    <Setter Property="LetterSpacing" Value="0.15"/>
    <Setter Property="MotionScheme" Value="{DynamicResource MaterialMotionScheme}"/>
    <Setter Property="ReducedMotion" Value="{DynamicResource MaterialReducedMotion}"/>
    <Setter Property="ClipToBounds" Value="False"/>
    <Setter Property="FocusAdorner" Value="{x:Null}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border x:Name="FocusRing" BorderBrush="{DynamicResource MaterialSecondaryBrush}" BorderThickness="3"
                  CornerRadius="{TemplateBinding CornerRadius}" Margin="-5" IsVisible="False" IsHitTestVisible="False"/>
        <Border x:Name="MaterialContainer" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}" BoxShadow="{DynamicResource MaterialElevationLevel3}">
          <Panel>
            <Border x:Name="StateLayer" Background="{TemplateBinding Foreground}" CornerRadius="{TemplateBinding CornerRadius}"
                    Opacity="0" IsHitTestVisible="False">
              <Border.Transitions>
                <Transitions>
                  <material:MaterialDoubleTransition Property="Opacity" Duration="{DynamicResource MaterialMotionFastEffectsDuration}"
                                                     Easing="{DynamicResource MaterialMotionFastEffectsEasing}"/>
                </Transitions>
              </Border.Transitions>
            </Border>
            <material:MaterialRipple Fill="{TemplateBinding Foreground}" CornerRadius="{TemplateBinding CornerRadius}"
                                     ReducedMotion="{TemplateBinding ReducedMotion}"/>
            <material:MaterialExtendedFabLayout x:Name="PART_FabLayout" IsExpanded="{TemplateBinding IsExpanded}"
                                                SizeVariant="{TemplateBinding SizeVariant}" MotionScheme="{TemplateBinding MotionScheme}"
                                                ReducedMotion="{TemplateBinding ReducedMotion}" ClipToBounds="True">
              <Viewbox x:Name="PART_Icon" Stretch="Uniform" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                <ContentPresenter x:Name="PART_IconPresenter" Content="{TemplateBinding Icon}" Foreground="{TemplateBinding Foreground}"
                                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
              </Viewbox>
              <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"
                                IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
            </material:MaterialExtendedFabLayout>
          </Panel>
        </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:medium">
      <Setter Property="CornerRadius" Value="20"/>
      <Setter Property="MinWidth" Value="80"/>
      <Setter Property="MinHeight" Value="80"/>
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="TextBlock.LineHeight" Value="28"/>
      <Setter Property="LetterSpacing" Value="0"/>
    </Style>
    <Style Selector="^:large">
      <Setter Property="CornerRadius" Value="28"/>
      <Setter Property="MinWidth" Value="96"/>
      <Setter Property="MinHeight" Value="96"/>
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="TextBlock.LineHeight" Value="32"/>
      <Setter Property="LetterSpacing" Value="0"/>
    </Style>
    <Style Selector="^:pointerover /template/ Border#StateLayer">
      <Setter Property="Opacity" Value="0.08"/>
    </Style>
    <Style Selector="^:focus-visible /template/ Border#StateLayer">
      <Setter Property="Opacity" Value="0.10"/>
    </Style>
    <Style Selector="^:focus-visible /template/ Border#FocusRing">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="^:pointerover /template/ Border#MaterialContainer">
      <Setter Property="BoxShadow" Value="{DynamicResource MaterialElevationLevel4}"/>
    </Style>
    <Style Selector="^:pressed /template/ Border#MaterialContainer, ^:focus-visible /template/ Border#MaterialContainer">
      <Setter Property="BoxShadow" Value="{DynamicResource MaterialElevationLevel3}"/>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Background" Value="{DynamicResource MaterialDisabledContainerBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource MaterialDisabledContentBrush}"/>
    </Style>
    <Style Selector="^:disabled /template/ Border#StateLayer">
      <Setter Property="Opacity" Value="0"/>
    </Style>
    <Style Selector="^:disabled /template/ Border#MaterialContainer">
      <Setter Property="BoxShadow" Value="none"/>
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="MaterialSmallExtendedFab" TargetType="material:MaterialExtendedFab" BasedOn="{StaticResource {x:Type material:MaterialExtendedFab}}">
    <Setter Property="SizeVariant" Value="Small"/>
  </ControlTheme>
  <ControlTheme x:Key="MaterialMediumExtendedFab" TargetType="material:MaterialExtendedFab" BasedOn="{StaticResource {x:Type material:MaterialExtendedFab}}">
    <Setter Property="SizeVariant" Value="Medium"/>
  </ControlTheme>
  <ControlTheme x:Key="MaterialLargeExtendedFab" TargetType="material:MaterialExtendedFab" BasedOn="{StaticResource {x:Type material:MaterialExtendedFab}}">
    <Setter Property="SizeVariant" Value="Large"/>
  </ControlTheme>
</ResourceDictionary>

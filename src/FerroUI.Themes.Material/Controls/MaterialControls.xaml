        <MergeResourceInclude Source="ferres://FerroUI.Themes.Material/Controls/OverlayPopupHost.xaml" />
        <MergeResourceInclude Source="ferres://FerroUI.Themes.Material/Controls/PopupRoot.xaml" />
        <MergeResourceInclude Source="ferres://FerroUI.Themes.Material/Controls/ThemeVariantScope.xaml" />
        <MergeResourceInclude Source="ferres://FerroUI.Themes.Material/Controls/Window.xaml" />

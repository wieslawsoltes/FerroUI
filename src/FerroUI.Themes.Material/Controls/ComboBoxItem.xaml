<ResourceDictionary xmlns="https://github.com/ferroui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">
  <ControlTheme x:Key="DefaultComboBoxItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource DefaultListBoxItemStyle}">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Padding" Value="12,8" />
  </ControlTheme>
  <ControlTheme x:Key="{x:Type ComboBoxItem}" TargetType="ComboBoxItem" BasedOn="{StaticResource DefaultComboBoxItemStyle}" />

</ResourceDictionary>

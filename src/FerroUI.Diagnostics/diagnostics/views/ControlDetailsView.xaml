<UserControl xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:FerroUI.Diagnostics.Converters"
             xmlns:local="using:FerroUI.Diagnostics.Views"
             xmlns:controls="using:FerroUI.Diagnostics.Controls"
             xmlns:vm="using:FerroUI.Diagnostics.ViewModels"
             xmlns:vmm="using:FerroUI.Diagnostics.ViewModels"
             xmlns:lb="using:FerroUI.Diagnostics.Behaviors"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             x:Class="FerroUI.Diagnostics.Views.ControlDetailsView"
             x:Name="Main"
             x:DataType="vm:ControlDetailsViewModel">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Assets/Icons.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <conv:BoolToOpacityConverter x:Key="BoolToOpacity" Opacity="0.6"/>
      <conv:GetTypeNameConverter x:Key="GetTypeName"/>
      <conv:BoolToImageConverter x:Key="pc"
                                 TrueImage="{StaticResource PinIcon}"
                                 FalseImage="{StaticResource UnpinIcon}"/>
      <!-- The cells of the "Property" column of the property grid: a group, or a property with its pin. -->
      <DataTemplate x:Key="PropertyNameCell" x:DataType="vm:PropertiesViewItem">
        <!--
        Do not remove the DockPanel background set to Transparent
        because if Background is null HitTest on empty space returns false
        -->
        <DockPanel Background="Transparent">
          <DockPanel.Styles>
            <Style Selector="DockPanel[IsPointerOver=False] > Panel > ToggleButton">
              <Setter Property="IsVisible" Value="False"/>
            </Style>
          </DockPanel.Styles>
          <Panel DockPanel.Dock="Right" IsVisible="{Binding !IsGroup}">
            <ToggleButton
              Classes="pin"
              IsChecked="{Binding IsPinned}"
              Background="Transparent"
              BorderBrush="Transparent"
              Command="{Binding #Main.((vm:ControlDetailsViewModel)DataContext).TogglePinnedProperty}"
              CommandParameter="{Binding}">
              <Image Source="{Binding IsPinned, Converter={StaticResource pc}}"
                     Width="12"
                     Height="12"/>
            </ToggleButton>
          </Panel>
          <TextBlock Text="{Binding Name}"
                     Classes.Pinned="{Binding IsPinned}"
                     Classes.Group="{Binding IsGroup}"
                     VerticalAlignment="Center"
                     />
        </DockPanel>
      </DataTemplate>
      <!-- Deviation (DEVIATIONS.md, Developer tools): the menu of a setter of the value frames is a
           flyout shared by the setters, which takes the setter it is opened on as its data
           context (a flyout is the child of the control it is shown at), in place of a context
           menu with its items built for every setter of every selected control. -->
      <MenuFlyout x:Key="SetterMenu" x:DataType="vm:SetterViewModel">
        <MenuItem Header="Copy property name" Command="{Binding CopyPropertyName}" />
        <MenuItem Header="Copy value" Command="{Binding CopyValue}" />
      </MenuFlyout>
      <MenuFlyout x:Key="BindingSetterMenu" x:DataType="vm:BindingSetterViewModel">
        <MenuItem Header="Copy property name" Command="{Binding CopyPropertyName}" />
        <MenuItem Header="Copy value" Command="{Binding CopyValue}" />
      </MenuFlyout>
      <MenuFlyout x:Key="ResourceSetterMenu" x:DataType="vm:ResourceSetterViewModel">
        <MenuItem Header="Copy property name" Command="{Binding CopyPropertyName}" />
        <MenuItem Header="Copy value" Command="{Binding CopyValue}" />
        <MenuItem Header="Copy resource key" Command="{Binding CopyResourceKey}" />
      </MenuFlyout>
      <!-- The cells of the "Value" column of the property grid: the editor of the value. -->
      <DataTemplate x:Key="PropertyValueCell" x:DataType="vm:PropertiesViewItem">
        <local:PropertyValueEditorView />
      </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBlock.Pinned">
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="TextBlock.Group">
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </UserControl.Styles>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
      <!--
      When selecting the Application node, we need this trick to hide Layout Visualizer 
      because when using the GridSplitter it sets the Width property of ColumnDefinition
      (see https://github.com/FerroUI/FerroUI/blob/master/src/FerroUI.Controls/GridSplitter.cs#L528) 
      and if we hide the contents of the column, the space is not reclaimed 
      (see discussion https://github.com/FerroUI/FerroUI/discussions/6773). 
      -->
      <!-- Deviation (DEVIATIONS.md, Developer tools): the side pane is also hidden while the toggle
           of the header (IsSidePaneOpen of the main view model, an addition of the port) is off. -->
      <ColumnDefinition Width="320">
        <lb:ColumnDefinition.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="Layout" Converter="{x:Static ObjectConverters.IsNotNull}" />
            <Binding Path="$parent[local:MainView].((vmm:MainViewModel)DataContext).IsSidePaneOpen" />
          </MultiBinding>
        </lb:ColumnDefinition.IsVisible>
      </ColumnDefinition>
    </Grid.ColumnDefinitions>
    
    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*">

      <!-- Deviation (DEVIATIONS.md, Developer tools): the header of the selected object in the
           design of the tools (DevToolsStyles.xaml): its name, its type below in the secondary
           colour, and the button to the parent property as an icon. -->
      <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto" Margin="12,10,12,8">
        <Button Grid.Column="0" Grid.RowSpan="2"
                Theme="{StaticResource SubtleButtonStyle}"
                Width="28" Height="28" Padding="0" MinWidth="0" MinHeight="0"
                VerticalAlignment="Center"
                IsEnabled="{Binding CanNavigateToParentProperty}"
                Margin="0,0,8,0"
                ToolTip.Tip="Navigate to parent property"
                Command="{Binding NavigateToParentProperty}">
          <PathIcon Width="12" Height="12" Data="M7.47 3.47a.75.75 0 0 1 1.06 0l5 5a.75.75 0 0 1-1.06 1.06L8 5.06 3.53 9.53a.75.75 0 0 1-1.06-1.06l5-5z" />
        </Button>
        <TextBlock Grid.Column="1" Grid.Row="0" Classes="section-header" Text="{Binding SelectedEntityName}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Grid.Row="1" Classes="caption" Text="{Binding SelectedEntityType}" TextTrimming="CharacterEllipsis" />
      </Grid>

      <controls:FilterTextBox Grid.Row="1"
                              Margin="12,0,12,8"
                              DataContext="{Binding TreePage.PropertiesFilter}"
                              Text="{Binding FilterString}"
                              PlaceholderText="Filter properties"
                              UseCaseSensitiveFilter="{Binding UseCaseSensitiveFilter}"
                              UseWholeWordFilter="{Binding UseWholeWordFilter}"
                              UseRegexFilter="{Binding UseRegexFilter}"/>
      
      <!--
      Deviation (DEVIATIONS.md, Developer tools). The property grid is a TreeDataGrid (upstream compiled a copy of DataGrid into the project):
      the rows of the groups of PropertiesView, with the properties below them. The columns, their
      sorting and the selection are those of the source (ControlDetailsViewModel.cs); the cells of
      the name and value columns are the templates PropertyNameCell and PropertyValueCell.
      -->
      <TreeDataGrid x:Name="DataGrid"
                    Classes="property-grid"
                    Source="{Binding PropertiesView.Source}"
                    Grid.Row="2"
                    BorderThickness="0"
                    CanUserResizeColumns="True"
                    DoubleTapped="PropertiesGrid_OnDoubleTapped">
        <TreeDataGrid.Styles>
          <!-- Deviation (DEVIATIONS.md, Developer tools): the pin of a property, a subtle button of
               20 px in the compact rows (the editors are styled by DevToolsStyles.xaml). -->
          <Style Selector="ToggleButton.pin">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
          </Style>
        </TreeDataGrid.Styles>
      </TreeDataGrid>

    </Grid>

    <GridSplitter Grid.Column="1" Classes="divider vertical"
                  IsVisible="{Binding $parent[local:MainView].((vmm:MainViewModel)DataContext).IsSidePaneOpen}"/>

    <Grid Grid.Column="2" RowDefinitions="*,Auto,*">
      <Grid.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="Layout" Converter="{x:Static ObjectConverters.IsNotNull}" />
          <Binding Path="$parent[local:MainView].((vmm:MainViewModel)DataContext).IsSidePaneOpen" />
        </MultiBinding>
      </Grid.IsVisible>

      <Grid RowDefinitions="Auto,*" Grid.Row="0">
        <TextBlock Classes="section-header" Grid.Row="0" Text="Layout" Margin="12,10,12,4" />
        <local:LayoutExplorerView Grid.Row="1" DataContext="{Binding Layout}" />
      </Grid>

      <GridSplitter Grid.Row="1" Classes="divider horizontal" />

      <Grid RowDefinitions="Auto,*,Auto" Grid.Row="2">

        <Grid Grid.Row="0" Margin="12,10,12,8" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">

          <!-- Deviation (DEVIATIONS.md, Developer tools): the controls of WinUI 3 are wider; the
               status takes the room that is left and is trimmed, so the buttons stay visible. -->
          <TextBlock Grid.Row="0" Classes="section-header" Text="{Binding FramesStatus}" TextTrimming="CharacterEllipsis" />
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <CheckBox MinWidth="0" MinHeight="0" VerticalAlignment="Center" Content="Show inactive" IsChecked="{Binding ShowInactiveFrames}" ToolTip.Tip="Show values that are currently inactive" />
            <ToggleButton MinHeight="0" Padding="10,3" VerticalAlignment="Center" ToolTip.Tip="Snapshot current values (Alt+S/Alt+D to enable/disable within debugged window)" Content="Snapshot" IsChecked="{Binding SnapshotFrames}" />
          </StackPanel>

          <controls:FilterTextBox Grid.Row="2" Grid.Column="0"
                                  DataContext="{Binding TreePage.SettersFilter}"
                                  Text="{Binding FilterString}"
                                  PlaceholderText="Filter values"
                                  UseCaseSensitiveFilter="{Binding UseCaseSensitiveFilter}"
                                  UseWholeWordFilter="{Binding UseWholeWordFilter}"
                                  UseRegexFilter="{Binding UseRegexFilter}" />
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding AppliedFrames}" >
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="12,0,12,6" Opacity="{Binding IsActive, Converter={StaticResource BoolToOpacity}}">
                  <Border.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                      <MultiBinding Converter="{x:Static BoolConverters.Or}" >
                        <Binding Path="IsActive" />
                        <!-- Rider marks it as an error, because it doesn't know about new binding rules yet. -->
                        <Binding Path="#Main.DataContext.ShowInactiveFrames" />
                      </MultiBinding>
                      <Binding Path="IsVisible" />
                    </MultiBinding>
                  </Border.IsVisible>
                  <Expander IsExpanded="True" Margin="0" Padding="12,6" ContentTransition="{x:Null}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" >
                    <Expander.Header>
                      <TextBlock Grid.Row="0" Text="{Binding Description}" />
                    </Expander.Header>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Setters}">
                      
                      <ItemsControl.Styles>
                        <Style Selector="TextBlock.property-name">
                          <Setter Property="FontWeight" Value="SemiBold" />
                          <Setter Property="Background" Value="Transparent" />
                        </Style>
                        <!-- Deviation (DEVIATIONS.md, Developer tools): a line of space between
                             the setters, in the size of the property grid. -->
                        <Style Selector="ContentPresenter > Panel">
                          <Setter Property="Margin" Value="0,2" />
                        </Style>
                        <Style Selector="TextBlock">
                          <Setter Property="FontSize" Value="13" />
                        </Style>
                        
                        <Style Selector="TextBlock.property-name:pointerover">
                          <Setter Property="TextDecorations" Value="Underline" />
                        </Style>
                        
                        <Style Selector="Rectangle.property-inactive">
                          <Setter Property="IsHitTestVisible" Value="False" />
                          <Setter Property="Height" Value="1" />
                          <Setter Property="Fill" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                          <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                        
                      </ItemsControl.Styles>
                      
                      <ItemsControl.DataTemplates>

                        <DataTemplate DataType="IBrush">
                          <StackPanel Orientation="Horizontal" Spacing="2">
                            <Border BorderThickness="1" BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" Background="{Binding}" Width="8" Height="8"/>
                            <TextBlock Text="{Binding}" />
                          </StackPanel>
                        </DataTemplate>

                        <DataTemplate DataType="Color">
                          <StackPanel Orientation="Horizontal" Spacing="2">
                            <Border BorderThickness="1" BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" Width="8" Height="8">
                              <Border.Background>
                                <SolidColorBrush Color="{Binding}" />
                              </Border.Background>
                            </Border>
                            <TextBlock Text="{Binding}" />
                          </StackPanel>
                        </DataTemplate>
                        
                        <DataTemplate DataType="vm:BindingSetterViewModel">
                          <Panel ContextFlyout="{StaticResource BindingSetterMenu}" Opacity="{Binding IsActive, Converter={StaticResource BoolToOpacity}}" IsVisible="{Binding IsVisible}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                              <TextBlock Classes="property-name" PointerPressed="PropertyNamePressed" Text="{Binding Name}" />
                              <TextBlock Text=":" />
                              <TextBlock>{</TextBlock>
                              <Rectangle Height="8" Width="8" VerticalAlignment="Center" Fill="{Binding Tint}" ToolTip.Tip="{Binding ValueTypeTooltip}"/>
                              <TextBlock Text="{Binding Path}" />
                              <TextBlock>}</TextBlock>
                            </StackPanel>
                            <Rectangle Classes="property-inactive" IsVisible="{Binding !IsActive}" />
                          </Panel>
                        </DataTemplate>

                        <DataTemplate DataType="vm:ResourceSetterViewModel">
                          <Panel ContextFlyout="{StaticResource ResourceSetterMenu}" Opacity="{Binding IsActive, Converter={StaticResource BoolToOpacity}}" IsVisible="{Binding IsVisible}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Left">
                              <TextBlock Classes="property-name" PointerPressed="PropertyNamePressed" Text="{Binding Name}" />
                              <TextBlock Text=":" />
                              <TextBlock Text="{Binding Value}" />
                              <TextBlock>(</TextBlock>
                              <Ellipse Height="8" Width="8" VerticalAlignment="Center" Fill="{Binding Tint}" ToolTip.Tip="{Binding ValueTypeTooltip}"/>
                              <TextBlock FontStyle="Italic" Text="{Binding Key}" />
                              <TextBlock>)</TextBlock>
                            </StackPanel>
                            <Rectangle Classes="property-inactive" IsVisible="{Binding !IsActive}" />
                          </Panel>
                        </DataTemplate>

                        <DataTemplate DataType="vm:SetterViewModel">
                          <Panel ContextFlyout="{StaticResource SetterMenu}" Opacity="{Binding IsActive, Converter={StaticResource BoolToOpacity}}" IsVisible="{Binding IsVisible}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                              <TextBlock Classes="property-name" PointerPressed="PropertyNamePressed" Text="{Binding Name}" />
                              <TextBlock Text=":" />
                              <TextBlock Text="{Binding Value}" />
                            </StackPanel>
                            <Rectangle Classes="property-inactive" IsVisible="{Binding !IsActive}" />
                          </Panel>
                        </DataTemplate>

                      </ItemsControl.DataTemplates>
                    </ItemsControl>

                  </Expander>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <Expander Header="Pseudo-classes" Grid.Row="2" Margin="12,6,12,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
          <ItemsControl ItemsSource="{Binding PseudoClasses}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <CheckBox Margin="0,0,12,4" MinWidth="0" MinHeight="0" Content="{Binding Name}" IsChecked="{Binding IsActive, Mode=TwoWay}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Expander>

      </Grid>

    </Grid>
  </Grid>

</UserControl>

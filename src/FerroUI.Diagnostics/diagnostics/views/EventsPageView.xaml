<UserControl xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FerroUI.Diagnostics.ViewModels"
             xmlns:controls="using:FerroUI.Diagnostics.Controls"
             xmlns:models="using:FerroUI.Diagnostics.Models"
             xmlns:local="using:FerroUI.Diagnostics.Views"
             xmlns:vmm="using:FerroUI.Diagnostics.ViewModels"
             xmlns:lb="using:FerroUI.Diagnostics.Behaviors"
             x:Class="FerroUI.Diagnostics.Views.EventsPageView"
             Margin="2"
             x:DataType="vm:EventsPageViewModel">
  <UserControl.Resources>
    <!-- Deviation (DEVIATIONS.md, Developer tools): the cells of the nodes of the TreeDataGrid of
         the routed events (EventsPageViewModel.cs), what the item template of upstream's tree view
         shows. -->
    <DataTemplate x:Key="EventTreeNodeCell" x:DataType="vm:EventTreeNodeBase">
      <CheckBox Classes="event-node" Content="{Binding Text}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Deviation (DEVIATIONS.md, Developer tools): the underline has no stroke of its own, so that
         it has the colour of the text in the light and the dark variants (upstream: Black). -->
    <Style Selector="TextBlock.nav" >
      <Setter Property="TextDecorations">
        <TextDecorationCollection>
          <TextDecoration Location="Underline" StrokeThickness="1" StrokeDashArray="2,2"/>
        </TextDecorationCollection>
      </Setter>
    </Style>

    <!-- Deviation (DEVIATIONS.md, Developer tools): the brushes of the WinUI 3 theme in place of
         the ones of the Simple theme (ThemeAccentBrush) and of Black. -->
    <Style Selector="TextBlock.nav:pointerover" >
      <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
      <Setter Property="Cursor" Value="Help" />
    </Style>

    <Style Selector="ListBoxItem" >
      <Setter Property="BorderThickness" Value="1" />
      <!-- Deviation (DEVIATIONS.md, Developer tools): the items of WinUI 3 align their content
           left and are at least 40 high; the rows of the tools are stretched and compact. -->
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="8,2" />
    </Style>

    <Style Selector="ListBoxItem:selected /template/ ContentPresenter" >
      <Setter Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- Deviation (DEVIATIONS.md, Developer tools): the check boxes of the compact rows of the
         TreeDataGrid, without the minimum size of a WinUI 3 check box. -->
    <Style Selector="CheckBox.event-node">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="6,0,0,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- A handled event: the success background of the theme in place of #34c940 with black text,
         which the selection of the WinUI list turned into white text on bright green. -->
    <Style Selector="ListBoxItem.handled" >
      <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
    </Style>
  </UserControl.Styles>

  <!-- Deviation (DEVIATIONS.md, Developer tools): the margins, dividers and headers of the
       design of the tools (DevToolsStyles.xaml). -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1.1*" lb:ColumnDefinition.IsVisible="{Binding $parent[local:MainView].((vmm:MainViewModel)DataContext).IsTreePaneOpen}" />
      <ColumnDefinition Width="1" lb:ColumnDefinition.IsVisible="{Binding $parent[local:MainView].((vmm:MainViewModel)DataContext).IsTreePaneOpen}" />
      <ColumnDefinition Width="3*" />
    </Grid.ColumnDefinitions>

    <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" Classes="tree-pane">

      <controls:FilterTextBox Grid.Row="0" Margin="12,10,12,8"
                              DataContext="{Binding EventsFilter}"
                              Text="{Binding FilterString}"
                              PlaceholderText="Filter events"
                              UseCaseSensitiveFilter="{Binding UseCaseSensitiveFilter}"
                              UseWholeWordFilter="{Binding UseWholeWordFilter}"
                              UseRegexFilter="{Binding UseRegexFilter}" />

      <!--
      Deviation (DEVIATIONS.md, Developer tools): the routed events are the rows of a TreeDataGrid,
      not the items of a tree view. The source of the grid (the visible nodes: the filter hides a
      node by removing its row), its expander column and the selection of its rows (SelectedNode)
      are those of EventsPageViewModel; the cells are the template EventTreeNodeCell.
      -->
      <TreeDataGrid Grid.Row="1"
                    Name="EventsTree"
                    BorderThickness="0"
                    ShowColumnHeaders="False"
                    CanUserResizeColumns="False"
                    CanUserSortColumns="False"
                    Source="{Binding NodesSource}" />

      <StackPanel Grid.Row="2" Margin="12,8" Orientation="Horizontal" Spacing="8">
        <Button Content="Disable all" Command="{Binding DisableAll}" />
        <Button Content="Enable default" Command="{Binding EnableDefault}" />
      </StackPanel>

    </Grid>

    <GridSplitter Classes="divider vertical" Grid.Column="1" />

    <Grid RowDefinitions="*,1,2*,Auto" Grid.Column="2">

      <ListBox Name="EventsList" ItemsSource="{Binding RecordedEvents}"
               SelectedItem="{Binding SelectedEvent, Mode=TwoWay}">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Classes.handled" Value="{Binding IsHandled, DataType=vm:FiredEvent}" />
          </Style>
        </ListBox.Styles>

        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">

              <TextBlock Grid.Column="0"  Text="{Binding TriggerTime, StringFormat={}{0:HH:mm:ss.fff}}"/>

              <StackPanel Margin="10,0,0,0" Grid.Column="1" Spacing="2" Orientation="Horizontal" >
                <TextBlock Tag="{Binding Event}" DoubleTapped="NavigateTo" Text="{Binding Event.Name}" FontWeight="Bold" Classes="nav" />
                <TextBlock Text="on" />
                <TextBlock Tag="{Binding Originator}" DoubleTapped="NavigateTo" Text="{Binding Originator.HandlerName}" Classes="nav" />
              </StackPanel>

              <StackPanel Margin="2,0,0,0" Grid.Column="2" Spacing="2" Orientation="Horizontal" IsVisible="{Binding IsHandled}" >
                <TextBlock Text="::" />
                <TextBlock Text="Handled by" />
                <TextBlock Tag="{Binding HandledBy}" DoubleTapped="NavigateTo" Text="{Binding HandledBy.HandlerName}" Classes="nav" />
              </StackPanel>

              <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Routing (" />
                <TextBlock Text="{Binding Event.RoutingStrategies}"/>
                <TextBlock Text=")"/>
              </StackPanel>

            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- No events yet: what to do, so that the page with the events pane collapsed is not blank. -->
      <TextBlock Grid.Row="0" Classes="empty-state"
                 IsVisible="{Binding !#EventsList.ItemCount}"
                 Text="No events recorded yet. Choose the events to record in the events pane, then interact with the application." />

      <GridSplitter Classes="divider horizontal" Grid.Row="1" />

      <DockPanel Grid.Row="2" LastChildFill="True">
        <TextBlock DockPanel.Dock="Top" Classes="section-header" Margin="12,10,12,6" Text="Event chain" />

        <ListBox ItemsSource="{Binding SelectedEvent.EventChain}">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Classes.handled" Value="{Binding Handled, DataType=models:EventChainLink}" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Vertical"
                          Background="Transparent"
                          PointerEntered="ListBoxItem_PointerEntered"
                          PointerExited="ListBoxItem_PointerExited">

                <Rectangle IsVisible="{Binding BeginsNewRoute}" StrokeDashArray="2,2" StrokeThickness="1" Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />

                <StackPanel Orientation="Horizontal" Spacing="2">
                  <TextBlock Text="{Binding Route}" FontWeight="Bold" />
                  <TextBlock Tag="{Binding}"
                             DoubleTapped="NavigateTo"
                             Text="{Binding HandlerName}"
                             Classes="nav" />
                </StackPanel>

              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

      </DockPanel>

      <StackPanel Orientation="Horizontal" Grid.Row="3" Spacing="8" Margin="12,8">
        <Button Content="Clear" Command="{Binding Clear}" />
      </StackPanel>

    </Grid>
  </Grid>
</UserControl>

<Styles xmlns="https://github.com/ferroui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:FerroUI.Diagnostics.Controls"
        x:ClassModifier="internal">
  <!--
  Deviation (DEVIATIONS.md, Developer tools): the design of the developer tools on the WinUI 3
  theme, shared by their views: one spacing scale (4, 8, 12, 16), section headers, secondary text,
  the status bar, the dividers between the panes, and the editors of the property grid, which are
  one compact form (24 px high, the text in the middle) in rows of 28 px. Upstream's views have no
  such sheet; their controls took the sizes of the Simple theme.
  -->

  <!--
  The brushes the included themes of the TreeDataGrid and of the colour picker take from the Fluent
  theme, as the WinUI 3 brushes of the same roles. The TreeDataGrid theme keys its light brushes
  "Default", which is the dark variant of the WinUI theme, so in a light window its header text
  turned white on hover and its grid lines and hover backgrounds disappeared; the colour picker's
  tabs use TabItemHeader brushes only the Fluent theme defines. Each alias is resolved in the
  variant of its dictionary (Dark falls back to the "Default" dictionary of the WinUI theme).
  -->
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <StaticResource x:Key="TreeDataGridGridLinesBrush" ResourceKey="DividerStrokeColorDefaultBrush" />
          <StaticResource x:Key="TreeDataGridHeaderBackgroundPointerOverBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
          <StaticResource x:Key="TreeDataGridHeaderBackgroundPressedBrush" ResourceKey="SubtleFillColorTertiaryBrush" />
          <StaticResource x:Key="TreeDataGridHeaderBorderBrushPointerOverBrush" ResourceKey="SubtleFillColorTransparentBrush" />
          <StaticResource x:Key="TreeDataGridHeaderBorderBrushPressedBrush" ResourceKey="SubtleFillColorTransparentBrush" />
          <StaticResource x:Key="TreeDataGridHeaderForegroundPointerOverBrush" ResourceKey="TextFillColorPrimaryBrush" />
          <StaticResource x:Key="TreeDataGridHeaderForegroundPressedBrush" ResourceKey="TextFillColorSecondaryBrush" />
          <StaticResource x:Key="TreeDataGridSelectedCellBackgroundBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
          <StaticResource x:Key="TabItemHeaderBackgroundSelected" ResourceKey="SelectorBarItemBackgroundSelected" />
          <StaticResource x:Key="TabItemHeaderBackgroundSelectedPointerOver" ResourceKey="SelectorBarItemBackgroundPointerOver" />
          <StaticResource x:Key="TabItemHeaderBackgroundSelectedPressed" ResourceKey="SelectorBarItemBackgroundPressed" />
          <StaticResource x:Key="TabItemHeaderBackgroundUnselected" ResourceKey="SelectorBarItemBackground" />
          <StaticResource x:Key="TabItemHeaderBackgroundUnselectedPointerOver" ResourceKey="SelectorBarItemBackgroundPointerOver" />
          <StaticResource x:Key="TabItemHeaderBackgroundUnselectedPressed" ResourceKey="SelectorBarItemBackgroundPressed" />
          <StaticResource x:Key="TabItemHeaderForegroundSelected" ResourceKey="SelectorBarItemForegroundSelected" />
          <StaticResource x:Key="TabItemHeaderForegroundSelectedPointerOver" ResourceKey="SelectorBarItemForegroundPointerOver" />
          <StaticResource x:Key="TabItemHeaderForegroundSelectedPressed" ResourceKey="SelectorBarItemForegroundPressed" />
          <StaticResource x:Key="TabItemHeaderForegroundUnselected" ResourceKey="SelectorBarItemForeground" />
          <StaticResource x:Key="TabItemHeaderForegroundUnselectedPointerOver" ResourceKey="SelectorBarItemForegroundPointerOver" />
          <StaticResource x:Key="TabItemHeaderForegroundUnselectedPressed" ResourceKey="SelectorBarItemForegroundPressed" />
          <StaticResource x:Key="TabItemHeaderSelectedPipeFill" ResourceKey="SelectorBarItemPillFill" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <StaticResource x:Key="TreeDataGridGridLinesBrush" ResourceKey="DividerStrokeColorDefaultBrush" />
          <StaticResource x:Key="TreeDataGridHeaderBackgroundPointerOverBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
          <StaticResource x:Key="TreeDataGridHeaderBackgroundPressedBrush" ResourceKey="SubtleFillColorTertiaryBrush" />
          <StaticResource x:Key="TreeDataGridHeaderBorderBrushPointerOverBrush" ResourceKey="SubtleFillColorTransparentBrush" />
          <StaticResource x:Key="TreeDataGridHeaderBorderBrushPressedBrush" ResourceKey="SubtleFillColorTransparentBrush" />
          <StaticResource x:Key="TreeDataGridHeaderForegroundPointerOverBrush" ResourceKey="TextFillColorPrimaryBrush" />
          <StaticResource x:Key="TreeDataGridHeaderForegroundPressedBrush" ResourceKey="TextFillColorSecondaryBrush" />
          <StaticResource x:Key="TreeDataGridSelectedCellBackgroundBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
          <StaticResource x:Key="TabItemHeaderBackgroundSelected" ResourceKey="SelectorBarItemBackgroundSelected" />
          <StaticResource x:Key="TabItemHeaderBackgroundSelectedPointerOver" ResourceKey="SelectorBarItemBackgroundPointerOver" />
          <StaticResource x:Key="TabItemHeaderBackgroundSelectedPressed" ResourceKey="SelectorBarItemBackgroundPressed" />
          <StaticResource x:Key="TabItemHeaderBackgroundUnselected" ResourceKey="SelectorBarItemBackground" />
          <StaticResource x:Key="TabItemHeaderBackgroundUnselectedPointerOver" ResourceKey="SelectorBarItemBackgroundPointerOver" />
          <StaticResource x:Key="TabItemHeaderBackgroundUnselectedPressed" ResourceKey="SelectorBarItemBackgroundPressed" />
          <StaticResource x:Key="TabItemHeaderForegroundSelected" ResourceKey="SelectorBarItemForegroundSelected" />
          <StaticResource x:Key="TabItemHeaderForegroundSelectedPointerOver" ResourceKey="SelectorBarItemForegroundPointerOver" />
          <StaticResource x:Key="TabItemHeaderForegroundSelectedPressed" ResourceKey="SelectorBarItemForegroundPressed" />
          <StaticResource x:Key="TabItemHeaderForegroundUnselected" ResourceKey="SelectorBarItemForeground" />
          <StaticResource x:Key="TabItemHeaderForegroundUnselectedPointerOver" ResourceKey="SelectorBarItemForegroundPointerOver" />
          <StaticResource x:Key="TabItemHeaderForegroundUnselectedPressed" ResourceKey="SelectorBarItemForegroundPressed" />
          <StaticResource x:Key="TabItemHeaderSelectedPipeFill" ResourceKey="SelectorBarItemPillFill" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <StaticResource x:Key="TabItemHeaderFontSize" ResourceKey="ControlContentThemeFontSize" />
      <FontWeight x:Key="TabItemHeaderThemeFontWeight">Normal</FontWeight>
      <StaticResource x:Key="TabItemPipeThickness" ResourceKey="SelectorBarItemPillHeight" />
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Text -->
  <Style Selector="TextBlock.section-header">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>

  <!-- The header in the title bar, as high as the command bar in it (48) and as the title bar the
       window asks for: room for the caption buttons of the system, at the left on macOS and at
       the right on Windows, when the window extends into its decorations. -->
  <Style Selector="Border.title-bar">
    <Setter Property="Height" Value="48" />
    <Setter Property="Padding" Value="8,0" />
  </Style>
  <Style Selector="Window.macos[IsExtendedIntoWindowDecorations=True] Border.title-bar">
    <Setter Property="Padding" Value="78,0,8,0" />
  </Style>
  <Style Selector="Window.windows[IsExtendedIntoWindowDecorations=True] Border.title-bar">
    <Setter Property="Padding" Value="8,0,140,0" />
  </Style>
  <Style Selector="Button.title-bar-button">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.title-bar-button PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>

  <!-- The status bar at the bottom of the window. -->
  <Style Selector="Border.status-bar">
    <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="12,4" />
  </Style>
  <Style Selector="Border.status-bar TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.status-bar TextBlock.label">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>

  <!-- The pane of a tree (the trees, the routed events): a shade darker than the details beside it,
       as the pane of a WinUI navigation view, with room around its rows. -->
  <Style Selector="Grid.tree-pane">
    <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" />
  </Style>
  <Style Selector="Border.tree-pane">
    <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" />
    <Setter Property="Padding" Value="4,6,0,6" />
  </Style>
  <Style Selector=".tree-pane TreeDataGrid">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- The icon of an image or a geometry value and the preview of a geometry in its tool tip. -->
  <Style Selector="Path.value-icon">
    <Setter Property="Fill" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>
  <Style Selector="Path.preview-geometry">
    <Setter Property="Fill" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>

  <!-- The text of an empty page or list: what to do. -->
  <Style Selector="TextBlock.empty-state">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="MaxWidth" Value="360" />
    <Setter Property="Margin" Value="24" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <!-- A pane beside another one: the details, the layout and the frames, the events. -->
  <Style Selector="Border.pane">
    <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
  </Style>

  <!-- The dividers between panes: a line of one pixel in a grip of five. -->
  <Style Selector="GridSplitter.divider">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}">
          <Rectangle Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="GridSplitter.divider.vertical">
    <Setter Property="Width" Value="5" />
    <Setter Property="Margin" Value="-2,0" />
  </Style>
  <Style Selector="GridSplitter.divider.vertical /template/ Rectangle">
    <Setter Property="Width" Value="1" />
  </Style>
  <Style Selector="GridSplitter.divider.horizontal">
    <Setter Property="Height" Value="5" />
    <Setter Property="Margin" Value="0,-2" />
  </Style>
  <Style Selector="GridSplitter.divider.horizontal /template/ Rectangle">
    <Setter Property="Height" Value="1" />
  </Style>
  <Style Selector="GridSplitter.divider:pointerover /template/ Rectangle">
    <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
  </Style>

  <!-- The filter boxes above the trees, the properties, the frames and the events. -->
  <Style Selector="controls|FilterTextBox">
    <Setter Property="MinHeight" Value="28" />
  </Style>
  <Style Selector="controls|FilterTextBox ToggleButton.filter-text-box-toggle">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Width" Value="22" />
    <Setter Property="Margin" Value="0,0,2,0" />
  </Style>

  <!-- The property grid. -->
  <Style Selector="TreeDataGrid.property-grid :is(TreeDataGridCell)">
    <Setter Property="MinHeight" Value="28" />
  </Style>
  <Style Selector="TreeDataGrid.property-grid TreeDataGridTextCell">
    <Setter Property="Padding" Value="8,0" />
  </Style>
  <Style Selector="TreeDataGrid.property-grid TreeDataGridTemplateCell">
    <Setter Property="Padding" Value="8,0" />
  </Style>
  <Style Selector="TreeDataGrid.property-grid TreeDataGridColumnHeader">
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="28" />
  </Style>

  <!-- The editors of the values: one compact form. -->
  <Style Selector=":is(TemplatedControl).editor">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Margin" Value="0,2" />
  </Style>
  <Style Selector="TextBox.editor, ComboBox.editor, NumericUpDown.editor">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Height" Value="24" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBox.editor">
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <!-- A value that cannot be edited reads as text, not as a box. -->
  <Style Selector="TextBox.editor[IsReadOnly=True], TextBox.editor[IsReadOnly=True]:pointerover, TextBox.editor[IsReadOnly=True]:focus">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="TextBox.editor[IsReadOnly=True] /template/ Border#BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ComboBox.editor">
    <Setter Property="Padding" Value="8,0,0,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="CheckBox.editor">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="controls|BrushEditor.editor">
    <Setter Property="Height" Value="22" />
    <Setter Property="Margin" Value="0,3" />
  </Style>
  <Style Selector="StackPanel.editor">
    <Setter Property="Spacing" Value="6" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</Styles>

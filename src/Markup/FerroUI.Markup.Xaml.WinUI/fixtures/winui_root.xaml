<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Tag="construction value">
  <TextBlock x:Name="initial" Text="{x:Bind Tag}" />
  <TextBox x:Name="editor" Text="{x:Bind Tag, Mode=TwoWay}" />
  <TextBlock x:Name="mirror" Text="{x:Bind Tag, Mode=OneWay}" />
</StackPanel>

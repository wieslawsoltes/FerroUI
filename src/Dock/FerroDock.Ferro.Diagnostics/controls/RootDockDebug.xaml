<UserControl x:Name="Root" x:Class="FerroDock.Ferro.Diagnostics.Controls.RootDockDebug"
             xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:FerroDock.Model.Controls;assembly=FerroDock.Model"
             xmlns:core="clr-namespace:FerroDock.Model.Core;assembly=FerroDock.Model"
             xmlns:converters="clr-namespace:FerroDock.Ferro.Converters;assembly=FerroDock.Ferro"
             xmlns:behaviors="using:FerroDock.Ferro.Diagnostics.Behaviors"
             behaviors:RootDockDebugBehavior.IsEnabled="True"
             xmlns:diagnostics="clr-namespace:FerroDock.Ferro.Diagnostics.Controls"
             mc:Ignorable="d"
             d:DesignWidth="300" d:DesignHeight="680"
             x:DataType="controls:IRootDock"
             x:CompileBindings="True">
  <UserControl.Resources>
    <x:Double x:Key="TabItemHeaderFontSize">14</x:Double>
  </UserControl.Resources>
  <UserControl.DataTemplates>
    <DataTemplate DataType="core:IDock" x:DataType="core:IDock">
      <diagnostics:DockDebugView />
    </DataTemplate>
    <DataTemplate DataType="core:IDockable" x:DataType="core:IDockable">
      <diagnostics:DockableDebugView />
    </DataTemplate>
    <DataTemplate DataType="controls:IProportionalDock" x:DataType="controls:IProportionalDock">
      <diagnostics:ProportionalDockDebugView />
    </DataTemplate>
    <DataTemplate DataType="controls:IStackDock" x:DataType="controls:IStackDock">
      <diagnostics:StackDockDebugView />
    </DataTemplate>
    <DataTemplate DataType="controls:IDockDock" x:DataType="controls:IDockDock">
      <diagnostics:DockDockDebugView />
    </DataTemplate>
    <DataTemplate DataType="controls:IGridDock" x:DataType="controls:IGridDock">
      <diagnostics:GridDockDebugView />
    </DataTemplate>
    <DataTemplate DataType="controls:IUniformGridDock" x:DataType="controls:IUniformGridDock">
      <diagnostics:UniformGridDockDebugView />
    </DataTemplate>
    <DataTemplate DataType="controls:IWrapDock" x:DataType="controls:IWrapDock">
      <diagnostics:WrapDockDebugView />
    </DataTemplate>
    <DataTemplate DataType="controls:IToolDock" x:DataType="controls:IToolDock">
      <diagnostics:ToolDockDebugView />
    </DataTemplate>
    <DataTemplate DataType="controls:IDocumentDock" x:DataType="controls:IDocumentDock">
      <diagnostics:DocumentDockDebugView />
    </DataTemplate>
    <DataTemplate DataType="controls:IDocumentDockContent" x:DataType="controls:IDocumentDockContent">
      <diagnostics:DocumentDockContentDebugView />
    </DataTemplate>
    <DataTemplate DataType="core:IDockWindow" x:DataType="core:IDockWindow">
      <diagnostics:DockWindowDebugView />
    </DataTemplate>
    <DataTemplate DataType="controls:IProportionalDockSplitter" x:DataType="controls:IProportionalDockSplitter">
      <diagnostics:ProportionalDockSplitterDebugView />
    </DataTemplate>
    <DataTemplate DataType="controls:IGridDockSplitter" x:DataType="controls:IGridDockSplitter">
      <diagnostics:GridDockSplitterDebugView />
    </DataTemplate>
    <DataTemplate DataType="controls:IToolContent" x:DataType="controls:IToolContent">
      <diagnostics:ToolContentDebugView />
    </DataTemplate>
    <DataTemplate DataType="controls:IDocumentContent" x:DataType="controls:IDocumentContent">
      <diagnostics:DocumentContentDebugView />
    </DataTemplate>
    <DataTemplate DataType="controls:IDocumentTemplate" x:DataType="controls:IDocumentTemplate">
      <diagnostics:DocumentTemplateDebugView />
    </DataTemplate>
    <DataTemplate DataType="controls:IRootDock" x:DataType="controls:IRootDock">
      <diagnostics:RootDockInfoDebugView />
    </DataTemplate>
  </UserControl.DataTemplates>
  <DockPanel>
  <TabControl DockPanel.Dock="Top">
    <TabItem Header="{DynamicResource RootDockDebugLayoutTabString}">
      <TreeView x:Name="Visible"
                ItemsSource="{Binding VisibleDockables}">
        <TreeView.Styles>
          <Style Selector="TreeViewItem">
            <Setter Property="IsExpanded" Value="True" />
          </Style>
        </TreeView.Styles>
        <TreeView.DataTemplates>
          <TreeDataTemplate DataType="controls:IRootDock" x:DataType="controls:IRootDock"
                            ItemsSource="{Binding VisibleDockables}">
            <TextBlock Text="{Binding Converter={x:Static converters:TitleOrTypeNameConverter.Instance}}" />
          </TreeDataTemplate>
          <TreeDataTemplate DataType="controls:IProportionalDock" x:DataType="controls:IProportionalDock"
                            ItemsSource="{Binding VisibleDockables}">
            <TextBlock Text="{Binding Converter={x:Static converters:TitleOrTypeNameConverter.Instance}}" />
          </TreeDataTemplate>
          <TreeDataTemplate DataType="controls:IStackDock" x:DataType="controls:IStackDock"
                            ItemsSource="{Binding VisibleDockables}">
            <TextBlock Text="{Binding Converter={x:Static converters:TitleOrTypeNameConverter.Instance}}" />
          </TreeDataTemplate>
          <TreeDataTemplate DataType="controls:IDockDock" x:DataType="controls:IDockDock"
                            ItemsSource="{Binding VisibleDockables}">
            <TextBlock Text="{Binding Converter={x:Static converters:TitleOrTypeNameConverter.Instance}}" />
          </TreeDataTemplate>
          <TreeDataTemplate DataType="controls:IGridDock" x:DataType="controls:IGridDock"
                            ItemsSource="{Binding VisibleDockables}">
            <TextBlock Text="{Binding Converter={x:Static converters:TitleOrTypeNameConverter.Instance}}" />
          </TreeDataTemplate>
          <TreeDataTemplate DataType="controls:IUniformGridDock" x:DataType="controls:IUniformGridDock"
                            ItemsSource="{Binding VisibleDockables}">
            <TextBlock Text="{Binding Converter={x:Static converters:TitleOrTypeNameConverter.Instance}}" />
          </TreeDataTemplate>
          <TreeDataTemplate DataType="controls:IWrapDock" x:DataType="controls:IWrapDock"
                            ItemsSource="{Binding VisibleDockables}">
            <TextBlock Text="{Binding Converter={x:Static converters:TitleOrTypeNameConverter.Instance}}" />
          </TreeDataTemplate>
          <TreeDataTemplate DataType="controls:IToolDock" x:DataType="controls:IToolDock"
                            ItemsSource="{Binding VisibleDockables}">
            <TextBlock Text="{Binding Converter={x:Static converters:TitleOrTypeNameConverter.Instance}}" />
          </TreeDataTemplate>
          <TreeDataTemplate DataType="controls:IDocumentDock" x:DataType="controls:IDocumentDock"
                            ItemsSource="{Binding VisibleDockables}">
            <TextBlock Text="{Binding Converter={x:Static converters:TitleOrTypeNameConverter.Instance}}" />
          </TreeDataTemplate>
          <TreeDataTemplate DataType="controls:IDocumentDockContent" x:DataType="controls:IDocumentDockContent"
                            ItemsSource="{Binding VisibleDockables}">
            <TextBlock Text="{Binding Converter={x:Static converters:TitleOrTypeNameConverter.Instance}}" />
          </TreeDataTemplate>
          <TreeDataTemplate DataType="core:IDock" x:DataType="core:IDock"
                            ItemsSource="{Binding VisibleDockables}">
            <TextBlock Text="{Binding Converter={x:Static converters:TitleOrTypeNameConverter.Instance}}" />
          </TreeDataTemplate>
          <DataTemplate DataType="controls:IGridDockSplitter" x:DataType="controls:IGridDockSplitter">
            <TextBlock Text="{Binding Converter={x:Static converters:TitleOrTypeNameConverter.Instance}}" />
          </DataTemplate>
          <DataTemplate DataType="controls:IProportionalDockSplitter" x:DataType="controls:IProportionalDockSplitter">
            <TextBlock Text="{Binding Converter={x:Static converters:TitleOrTypeNameConverter.Instance}}" />
          </DataTemplate>
          <DataTemplate DataType="controls:ITool" x:DataType="controls:ITool">
            <TextBlock Text="{Binding Converter={x:Static converters:TitleOrTypeNameConverter.Instance}}" />
          </DataTemplate>
          <DataTemplate DataType="controls:IToolContent" x:DataType="controls:IToolContent">
            <TextBlock Text="{Binding Converter={x:Static converters:TitleOrTypeNameConverter.Instance}}" />
          </DataTemplate>
          <DataTemplate DataType="controls:IDocument" x:DataType="controls:IDocument">
            <TextBlock Text="{Binding Converter={x:Static converters:TitleOrTypeNameConverter.Instance}}" />
          </DataTemplate>
          <DataTemplate DataType="controls:IDocumentContent" x:DataType="controls:IDocumentContent">
            <TextBlock Text="{Binding Converter={x:Static converters:TitleOrTypeNameConverter.Instance}}" />
          </DataTemplate>
          <DataTemplate DataType="core:IDockable" x:DataType="core:IDockable">
            <TextBlock Text="{Binding Converter={x:Static converters:TitleOrTypeNameConverter.Instance}}" />
          </DataTemplate>
        </TreeView.DataTemplates>
      </TreeView>
    </TabItem>
    <TabItem Header="{DynamicResource RootDockDebugSelectedTabString}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <ContentControl Content="{Binding #Visible.SelectedItem}" />
      </ScrollViewer>
    </TabItem>
    <TabItem Header="{DynamicResource RootDockDebugWindowsTabString}">
      <TreeView x:Name="Windows"
                DataContext="{Binding #Visible.SelectedItem}"
                ItemsSource="{Binding Windows}"
                x:DataType="controls:IRootDock">
        <TreeView.Styles>
          <Style Selector="TreeViewItem">
            <Setter Property="IsExpanded" Value="True" />
          </Style>
        </TreeView.Styles>
        <TreeView.DataTemplates>
          <TreeDataTemplate DataType="controls:IRootDock" x:DataType="controls:IRootDock"
                            ItemsSource="{Binding VisibleDockables}">
            <TextBlock Text="{Binding Converter={x:Static converters:TitleOrTypeNameConverter.Instance}}" />
          </TreeDataTemplate>
          <TreeDataTemplate DataType="controls:IProportionalDock" x:DataType="controls:IProportionalDock"
                            ItemsSource="{Binding VisibleDockables}">
            <TextBlock Text="{Binding Converter={x:Static converters:TitleOrTypeNameConverter.Instance}}" />
          </TreeDataTemplate>
          <TreeDataTemplate DataType="controls:IStackDock" x:DataType="controls:IStackDock"
                            ItemsSource="{Binding VisibleDockables}">
            <TextBlock Text="{Binding Converter={x:Static converters:TitleOrTypeNameConverter.Instance}}" />
          </TreeDataTemplate>
          <TreeDataTemplate DataType="controls:IDockDock" x:DataType="controls:IDockDock"
                            ItemsSource="{Binding VisibleDockables}">
            <TextBlock Text="{Binding Converter={x:Static converters:TitleOrTypeNameConverter.Instance}}" />
          </TreeDataTemplate>
          <TreeDataTemplate DataType="controls:IGridDock" x:DataType="controls:IGridDock"
                            ItemsSource="{Binding VisibleDockables}">
            <TextBlock Text="{Binding Converter={x:Static converters:TitleOrTypeNameConverter.Instance}}" />
          </TreeDataTemplate>
          <TreeDataTemplate DataType="controls:IUniformGridDock" x:DataType="controls:IUniformGridDock"
                            ItemsSource="{Binding VisibleDockables}">
            <TextBlock Text="{Binding Converter={x:Static converters:TitleOrTypeNameConverter.Instance}}" />
          </TreeDataTemplate>
          <TreeDataTemplate DataType="controls:IWrapDock" x:DataType="controls:IWrapDock"
                            ItemsSource="{Binding VisibleDockables}">
            <TextBlock Text="{Binding Converter={x:Static converters:TitleOrTypeNameConverter.Instance}}" />
          </TreeDataTemplate>
          <TreeDataTemplate DataType="controls:IToolDock" x:DataType="controls:IToolDock"
                            ItemsSource="{Binding VisibleDockables}">
            <TextBlock Text="{Binding Converter={x:Static converters:TitleOrTypeNameConverter.Instance}}" />
          </TreeDataTemplate>
          <TreeDataTemplate DataType="controls:IDocumentDock" x:DataType="controls:IDocumentDock"
                            ItemsSource="{Binding VisibleDockables}">
            <TextBlock Text="{Binding Converter={x:Static converters:TitleOrTypeNameConverter.Instance}}" />
          </TreeDataTemplate>
          <TreeDataTemplate DataType="controls:IDocumentDockContent" x:DataType="controls:IDocumentDockContent"
                            ItemsSource="{Binding VisibleDockables}">
            <TextBlock Text="{Binding Converter={x:Static converters:TitleOrTypeNameConverter.Instance}}" />
          </TreeDataTemplate>
          <TreeDataTemplate DataType="core:IDock" x:DataType="core:IDock"
                            ItemsSource="{Binding VisibleDockables}">
            <TextBlock Text="{Binding Converter={x:Static converters:TitleOrTypeNameConverter.Instance}}" />
          </TreeDataTemplate>
          <DataTemplate DataType="controls:IGridDockSplitter" x:DataType="controls:IGridDockSplitter">
            <diagnostics:GridDockSplitterDebugView />
          </DataTemplate>
          <DataTemplate DataType="controls:IProportionalDockSplitter" x:DataType="controls:IProportionalDockSplitter">
            <TextBlock Text="{Binding Converter={x:Static converters:TitleOrTypeNameConverter.Instance}}" />
          </DataTemplate>
          <DataTemplate DataType="controls:ITool" x:DataType="controls:ITool">
            <TextBlock Text="{Binding Converter={x:Static converters:TitleOrTypeNameConverter.Instance}}" />
          </DataTemplate>
          <DataTemplate DataType="controls:IToolContent" x:DataType="controls:IToolContent">
            <TextBlock Text="{Binding Converter={x:Static converters:TitleOrTypeNameConverter.Instance}}" />
          </DataTemplate>
          <DataTemplate DataType="controls:IDocument" x:DataType="controls:IDocument">
            <TextBlock Text="{Binding Converter={x:Static converters:TitleOrTypeNameConverter.Instance}}" />
          </DataTemplate>
          <DataTemplate DataType="controls:IDocumentContent" x:DataType="controls:IDocumentContent">
            <TextBlock Text="{Binding Converter={x:Static converters:TitleOrTypeNameConverter.Instance}}" />
          </DataTemplate>
          <DataTemplate DataType="core:IDockable" x:DataType="core:IDockable">
            <TextBlock Text="{Binding Converter={x:Static converters:TitleOrTypeNameConverter.Instance}}" />
          </DataTemplate>
          <TreeDataTemplate DataType="core:IDockWindow" x:DataType="core:IDockWindow"
                            ItemsSource="{Binding Layout.VisibleDockables, FallbackValue={x:Null}}">
            <TextBlock Text="{Binding Converter={x:Static converters:TitleOrTypeNameConverter.Instance}}" />
          </TreeDataTemplate>
        </TreeView.DataTemplates>
      </TreeView>
    </TabItem>
    <TabItem Header="{DynamicResource RootDockDebugEventsTabString}">
      <DockPanel DataContext="{Binding #Root}" x:DataType="diagnostics:RootDockDebug">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,4">
          <TextBlock Text="{DynamicResource RootDockDebugFilterString}" VerticalAlignment="Center" />
          <TextBox Width="120" Margin="2" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
          <Button Content="{DynamicResource RootDockDebugResetString}" Margin="2" Command="{Binding ClearEventsCommand}" />
        </StackPanel>
        <ListBox ItemsSource="{Binding FilteredEvents}" FontFamily="Consolas" />
      </DockPanel>
    </TabItem>
    <TabItem Header="{DynamicResource RootDockDebugRootTabString}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <ContentControl Content="{Binding}" />
      </ScrollViewer>
    </TabItem>
  </TabControl>
  <TextBlock Margin="4"
             HorizontalAlignment="Center"
             FontSize="{DynamicResource TabItemHeaderFontSize}"
             Text="{DynamicResource RootDockDebugPickInfoString}" />
  </DockPanel>
</UserControl>

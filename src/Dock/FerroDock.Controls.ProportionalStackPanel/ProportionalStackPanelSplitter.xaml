<ResourceDictionary xmlns="https://github.com/ferroui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:CompileBindings="True">
  <ControlTheme x:Key="{x:Type ProportionalStackPanelSplitter}"
                TargetType="ProportionalStackPanelSplitter"
                x:DataType="ProportionalStackPanelSplitter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate x:DataType="ProportionalStackPanelSplitter">
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>

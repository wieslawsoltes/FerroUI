<ResourceDictionary xmlns="https://github.com/ferroui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:o="using:FerroDock.Ferro.Controls.Overlays" x:CompileBindings="True">
  <ControlTheme x:Key="{x:Static o:OverlayLayerStyleKeys.BusyLayerThemeKey}"
                TargetType="o:BusyOverlayControl" x:DataType="o:BusyOverlayControl"
                BasedOn="{StaticResource {x:Type o:BusyOverlayControl}}" />
  <ControlTheme x:Key="{x:Static o:OverlayLayerStyleKeys.DialogLayerThemeKey}"
                TargetType="o:DialogOverlayControl" x:DataType="o:DialogOverlayControl"
                BasedOn="{StaticResource {x:Type o:DialogOverlayControl}}" />
  <ControlTheme x:Key="{x:Static o:OverlayLayerStyleKeys.ConfirmationLayerThemeKey}"
                TargetType="o:ConfirmationOverlayControl" x:DataType="o:ConfirmationOverlayControl"
                BasedOn="{StaticResource {x:Type o:ConfirmationOverlayControl}}" />
</ResourceDictionary>

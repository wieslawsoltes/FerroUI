<ResourceDictionary xmlns="https://github.com/ferroui"
                    xmlns:d="using:FerroDock.Ferro.Controls"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:CompileBindings="True">
  <ControlTheme x:Key="{x:Type d:PinnedDockWindow}" TargetType="d:PinnedDockWindow" x:DataType="d:PinnedDockWindow"
                BasedOn="{StaticResource {x:Type Window}}">
    <Setter Property="WindowDecorations" Value="None" />
    <Setter Property="ShowInTaskbar" Value="False" />
    <Setter Property="CanResize" Value="False" />
    <Setter Property="ShowActivated" Value="False" />
    <Setter Property="Background" Value="{x:Null}" />
    <Setter Property="TransparencyLevelHint" Value="Transparent" />
    <Setter Property="SizeToContent" Value="Manual" />
    <Setter Property="Topmost" Value="False" />
    <Setter Property="IsHitTestVisible" Value="True" />
  </ControlTheme>
</ResourceDictionary>

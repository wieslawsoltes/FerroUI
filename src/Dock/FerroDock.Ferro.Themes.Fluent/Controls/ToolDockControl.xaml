<ResourceDictionary xmlns:fd="using:FerroDock.Ferro.Controls"
                    xmlns:pc="using:FerroDock.Ferro.Converters"
                    xmlns:sp="using:FerroDock.Settings" xmlns="https://github.com/ferroui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dmc="using:FerroDock.Model.Controls"
                    x:DataType="dmc:IToolDock"
                    x:CompileBindings="True">
  <Design.PreviewWith>
    <fd:ToolDockControl Width="300" Height="300" />
  </Design.PreviewWith>

  <ControlTheme x:Key="{x:Type fd:ToolDockControl}" TargetType="fd:ToolDockControl" x:DataType="dmc:IToolDock">

    <Setter Property="(AutomationProperties.AutomationId)" Value="{Binding Id}" />
    <Setter Property="(AutomationProperties.Name)" Value="{Binding Title}" />

    <Setter Property="(sp:DockProperties.IsDragEnabled)" Value="{Binding CanDrag}" />
    <Setter Property="(sp:DockProperties.IsDropEnabled)" Value="{Binding CanDrop}" />
    <Setter Property="(sp:DockProperties.DockGroup)" Value="{Binding DockGroup}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="MinWidth" Value="{Binding MinWidth}" />
    <Setter Property="MaxWidth" Value="{Binding MaxWidth}" />
    <Setter Property="MinHeight" Value="{Binding MinHeight}" />
    <Setter Property="MaxHeight" Value="{Binding MaxHeight}" />

    <Setter Property="Template">
      <ControlTemplate>
        <fd:DockableControl Name="PART_DockableControl"
                         TrackingMode="Visible"
                         Background="{TemplateBinding Background}"
                         sp:DockProperties.IsDropArea="True"
                         sp:DockProperties.IsDockTarget="True">
          <fd:ToolChromeControl IsActive="{Binding IsActive}"
                             IsVisible="{Binding !!VisibleDockables.Count}">
            <fd:ToolControl />
          </fd:ToolChromeControl>
        </fd:DockableControl>
      </ControlTemplate>
    </Setter>
    <!--
    <Style Selector="^[(ProportionalStackPanelSplitter.IsEmpty)=False] /template/ fd|DockableControl#PART_DockableControl">
      <Setter Property="Background" Value="Blue" />
    </Style>

    <Style Selector="^[(ProportionalStackPanelSplitter.IsEmpty)=True] /template/ fd|DockableControl#PART_DockableControl">
      <Setter Property="Background" Value="Red" />
    </Style>
    -->
  </ControlTheme>

</ResourceDictionary>

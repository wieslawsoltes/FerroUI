<ResourceDictionary xmlns:fd="using:FerroDock.Ferro.Controls"
                    xmlns:pc="using:FerroDock.Ferro.Converters"
                    xmlns:sp="using:FerroDock.Settings" xmlns="https://github.com/ferroui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:FerroDock.Model.Controls"
                    x:DataType="controls:IUniformGridDock"
                    x:CompileBindings="True">
  <Design.PreviewWith>
    <fd:UniformGridDockControl Width="300" Height="300" />
  </Design.PreviewWith>

  <ControlTheme x:Key="{x:Type fd:UniformGridDockControl}" TargetType="fd:UniformGridDockControl" x:DataType="controls:IUniformGridDock">

    <Setter Property="(AutomationProperties.AutomationId)" Value="{Binding Id}" />
    <Setter Property="(AutomationProperties.Name)" Value="{Binding Title}" />

    <Setter Property="(sp:DockProperties.IsDragEnabled)" Value="{Binding CanDrag}" />
    <Setter Property="(sp:DockProperties.IsDropEnabled)" Value="{Binding CanDrop}" />
    <Setter Property="(sp:DockProperties.DockGroup)" Value="{Binding DockGroup}" />

    <Setter Property="Template">
      <ControlTemplate>
        <fd:DockableControl TrackingMode="Visible">
          <ItemsControl ItemsSource="{Binding VisibleDockables}">
            <ItemsControl.Styles>
              <Style Selector="ItemsControl > ContentPresenter">
                <Setter Property="MinWidth" Value="{Binding MinWidth}" />
                <Setter Property="MaxWidth" Value="{Binding MaxWidth}" />
                <Setter Property="MinHeight" Value="{Binding MinHeight}" />
                <Setter Property="MaxHeight" Value="{Binding MaxHeight}" />
              </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid sp:DockProperties.IsDropArea="True" Background="Transparent" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </fd:DockableControl>
      </ControlTemplate>
    </Setter>

  </ControlTheme>

</ResourceDictionary>

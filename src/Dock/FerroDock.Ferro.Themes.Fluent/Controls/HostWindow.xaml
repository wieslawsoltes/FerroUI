<ResourceDictionary xmlns:fd="using:FerroDock.Ferro.Controls"
                    xmlns:ov="using:FerroDock.Ferro.Controls.Overlays"
                    xmlns:bh="using:FerroDock.Ferro.Behaviors"
                    xmlns:pc="using:FerroDock.Ferro.Converters"
                    xmlns:sp="using:FerroDock.Settings" xmlns="https://github.com/ferroui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:FerroDock.Model.Controls"
                    x:CompileBindings="True"
                    x:DataType="controls:IRootDock">
  <Design.PreviewWith>
    <fd:HostWindow IsToolWindow="False" Width="300" Height="400" />
  </Design.PreviewWith>

  <pc:IntLessThanConverter x:Key="LessThan2" TrueIfLessThan="2" />

  <ControlTheme x:Key="{x:Type fd:HostWindow}" TargetType="fd:HostWindow" x:DataType="controls:IRootDock">

    <Setter Property="(AutomationProperties.AutomationId)" Value="{Binding Id}" />
    <Setter Property="(AutomationProperties.Name)" Value="{Binding Title}" />

    <Setter Property="(sp:DockProperties.IsDragEnabled)" Value="{Binding CanDrag}" />
    <Setter Property="(sp:DockProperties.IsDropEnabled)" Value="{Binding CanDrop}" />
    <Setter Property="(sp:DockProperties.DockGroup)" Value="{Binding DockGroup}" />

    <Setter Property="Background" Value="{DynamicResource DockSurfaceEditorBrush}" />
    <Setter Property="(TextElement.FontSize)" Value="{DynamicResource DockFontSizeNormal}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource DockTabForegroundBrush}" />
    <Setter Property="WindowState" Value="Normal" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Title" Value="{Binding FocusedDockable.Title}"  />
    <Setter Property="Topmost" Value="{Binding Window.Topmost}" />
    <Setter Property="WindowDecorations" Value="Full" />
    <Setter Property="ToolChromeControlsWholeWindow" Value="{Binding OpenedDockablesCount, Converter={StaticResource LessThan2}}" />
    <Setter Property="ExtendClientAreaToDecorationsHint" Value="False" />

    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_TransparencyFallback" IsHitTestVisible="False" />
          <Border Background="{TemplateBinding Background}" IsHitTestVisible="False" />
          <Panel Background="Transparent" Margin="{TemplateBinding WindowDecorationMargin}" />
          <VisualLayerManager Name="PART_VisualLayerManager">
            <DeferredContentPresenter Name="PART_ContentPresenter"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Content="{TemplateBinding Content}"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </VisualLayerManager>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Setter Property="Content" Value="{Binding}" />
    <Setter Property="ContentTemplate">
      <DataTemplate x:DataType="controls:IRootDock">
        <Panel Margin="{Binding $parent[fd:HostWindow].OffScreenMargin}">
          <Panel Margin="{Binding $parent[fd:HostWindow].WindowDecorationMargin}">
            <ov:OverlayHost bh:VisualTreeLifecycleBehavior.IsEnabled="True">
              <fd:DockControl Layout="{Binding}" />
            </ov:OverlayHost>
          </Panel>
        </Panel>
      </DataTemplate>
    </Setter>

    <Style Selector="^:documentwindow">
      <Setter Property="ExtendClientAreaTitleBarHeightHint" Value="0" />

      <Style Selector="^:documentchromecontrolswindow">
        <Setter Property="ExtendClientAreaToDecorationsHint" Value="True" />
        <Setter Property="WindowDecorations" Value="BorderOnly" />
      </Style>

    </Style>

    <Style Selector="^:toolwindow">

      <Setter Property="ExtendClientAreaTitleBarHeightHint" Value="0" />

      <Style Selector="^:toolchromecontrolswindow">
        <Setter Property="ExtendClientAreaToDecorationsHint" Value="True" />
        <Setter Property="WindowDecorations" Value="BorderOnly" />
      </Style>

      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Border Name="PART_TransparencyFallback" IsHitTestVisible="False" />
            <Border Background="{TemplateBinding Background}" IsHitTestVisible="False" />
            <Panel Background="Transparent" Margin="{TemplateBinding WindowDecorationMargin}" />
            <VisualLayerManager Name="PART_VisualLayerManager">
              <DeferredContentPresenter Name="PART_ContentPresenter"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        Content="{TemplateBinding Content}"
                                        Margin="{TemplateBinding Padding}"
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </VisualLayerManager>
          </Panel>
        </ControlTemplate>
      </Setter>

      <Setter Property="Content" Value="{Binding}" />
      <Setter Property="ContentTemplate">
        <DataTemplate x:DataType="controls:IRootDock">
          <Panel Margin="{Binding $parent[fd:HostWindow].OffScreenMargin}">
            <ov:OverlayHost bh:VisualTreeLifecycleBehavior.IsEnabled="True">
              <fd:DockControl Layout="{Binding}" />
            </ov:OverlayHost>
          </Panel>
        </DataTemplate>
      </Setter>

    </Style>

    <Style Selector="^:toolwindow">
      <Setter Property="Background" Value="{DynamicResource DockSurfaceEditorBrush}" />
      <Setter Property="TransparencyLevelHint" Value="None"/>
      <Setter Property="Opacity" Value="1.0" />
    </Style>

    <Style Selector="^:toolwindow:dragging">
      <Setter Property="Background" Value="{x:Null}" />
      <Setter Property="TransparencyLevelHint" Value="Transparent"/>
      <Setter Property="Opacity" Value="0.5" />
    </Style>

  </ControlTheme>

</ResourceDictionary>

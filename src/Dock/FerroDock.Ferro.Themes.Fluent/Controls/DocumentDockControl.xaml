<ResourceDictionary xmlns:fd="using:FerroDock.Ferro.Controls"
                    xmlns:pc="using:FerroDock.Ferro.Converters"
                    xmlns:sp="using:FerroDock.Settings" xmlns="https://github.com/ferroui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:FerroDock.Ferro.Controls"
                    xmlns:converters="using:FerroDock.Ferro.Converters"
                    xmlns:dmc="using:FerroDock.Model.Controls"
                    x:DataType="dmc:IDocumentDock"
                    x:CompileBindings="True">
  <Design.PreviewWith>
    <fd:DocumentDockControl Width="300" Height="300" />
  </Design.PreviewWith>

  <ControlTheme x:Key="{x:Type fd:DocumentDockControl}" TargetType="fd:DocumentDockControl" x:DataType="dmc:IDocumentDock">

    <Setter Property="(AutomationProperties.AutomationId)" Value="{Binding Id}" />
    <Setter Property="(AutomationProperties.Name)" Value="{Binding Title}" />

    <Setter Property="(sp:DockProperties.IsDragEnabled)" Value="{Binding CanDrag}" />
    <Setter Property="(sp:DockProperties.IsDropEnabled)" Value="{Binding CanDrop}" />
    <Setter Property="(sp:DockProperties.DockGroup)" Value="{Binding DockGroup}" />

    <Setter Property="Template">
      <ControlTemplate>
        <fd:DockableControl TrackingMode="Visible">
          <Panel>
            <fd:DocumentControl IsActive="{Binding IsActive}"
                             IsVisible="{Binding LayoutMode, Converter={x:Static converters:DocumentLayoutModeMatchConverter.Instance}, ConverterParameter=Tabbed}" />
            <controls:MdiDocumentControl IsActive="{Binding IsActive}"
                                          IsVisible="{Binding LayoutMode, Converter={x:Static converters:DocumentLayoutModeMatchConverter.Instance}, ConverterParameter=Mdi}" />
          </Panel>
        </fd:DockableControl>
      </ControlTemplate>
    </Setter>

  </ControlTheme>

</ResourceDictionary>

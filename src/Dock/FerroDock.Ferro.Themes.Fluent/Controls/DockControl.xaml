<ResourceDictionary xmlns:fd="using:FerroDock.Ferro.Controls"
                    xmlns:pc="using:FerroDock.Ferro.Converters"
                    xmlns:sp="using:FerroDock.Settings" xmlns="https://github.com/ferroui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:FerroDock.Ferro.Controls"
                    xmlns:core="using:FerroDock.Model.Core"
                    x:DataType="core:IDock"
                    x:CompileBindings="True">
  <Design.PreviewWith>
    <fd:DockControl Width="600" Height="400" />
  </Design.PreviewWith>

  <ControlTheme x:Key="{x:Type fd:DockControl}" TargetType="fd:DockControl" x:DataType="core:IDock">

    <Setter Property="(AutomationProperties.AutomationId)" Value="{Binding $self.Layout.Id, FallbackValue={x:Null}}" />
    <Setter Property="(AutomationProperties.Name)" Value="{Binding $self.Layout.Title, FallbackValue={x:Null}}" />

    <Setter Property="(sp:DockProperties.IsDragEnabled)" Value="{Binding $self.Layout.CanDrag, FallbackValue={x:True}}" />
    <Setter Property="(sp:DockProperties.IsDropEnabled)" Value="{Binding $self.Layout.CanDrop, FallbackValue={x:True}}"  />
    <Setter Property="(sp:DockProperties.DockGroup)" Value="{Binding $self.Layout.DockGroup, FallbackValue={x:Null}}" />

    <Setter Property="Template">
      <ControlTemplate>
        <Grid RowDefinitions="Auto,*">
          <controls:DockCommandBarHost x:Name="PART_CommandBarHost"
                                       Grid.Row="0" />
          <!-- Models derived from StyledElement must not become logical template children. -->
          <DeferredContentPresenter x:Name="PART_ContentControl"
                                    Grid.Row="1"
                                    Content="{TemplateBinding Layout}" />
          <controls:ManagedWindowLayer x:Name="PART_ManagedWindowLayer"
                                       Grid.Row="1"
                                       IsVisible="False" />
          <controls:DockSelectorOverlay x:Name="PART_SelectorOverlay"
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch" />
        </Grid>
      </ControlTemplate>
    </Setter>

  </ControlTheme>

</ResourceDictionary>

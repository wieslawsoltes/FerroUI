<ResourceDictionary xmlns:fd="using:FerroDock.Ferro.Controls"
                    xmlns:pc="using:FerroDock.Ferro.Converters"
                    xmlns:sp="using:FerroDock.Settings" xmlns="https://github.com/ferroui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dmc="using:FerroDock.Model.Controls"
                    x:DataType="dmc:IProportionalDock"
                    x:CompileBindings="True">
  <Design.PreviewWith>
    <fd:ProportionalDockControl Width="300" Height="300" />
  </Design.PreviewWith>

  <ControlTheme x:Key="{x:Type fd:ProportionalDockControl}" TargetType="fd:ProportionalDockControl" x:DataType="dmc:IProportionalDock">

    <Setter Property="(AutomationProperties.AutomationId)" Value="{Binding Id}" />
    <Setter Property="(AutomationProperties.Name)" Value="{Binding Title}" />

    <Setter Property="(sp:DockProperties.IsDragEnabled)" Value="{Binding CanDrag}" />
    <Setter Property="(sp:DockProperties.IsDropEnabled)" Value="{Binding CanDrop}" />
    <Setter Property="(sp:DockProperties.DockGroup)" Value="{Binding DockGroup}" />

    <Setter Property="Template">
      <ControlTemplate>
        <fd:DockableControl TrackingMode="Visible">
          <ItemsControl ItemsSource="{Binding VisibleDockables}"
                        Name="PART_ItemsControl"
                        Classes="ProportionalStackPanel">
            <ItemsControl.Styles>
              <Style Selector="ItemsControl.ProportionalStackPanel > ContentPresenter">
                <Setter Property="(ProportionalStackPanel.Proportion)"
                  Value="{Binding Proportion, Mode=TwoWay}" />
                <Setter Property="(ProportionalStackPanel.CollapsedProportion)"
                  Value="{Binding CollapsedProportion, Mode=TwoWay}" />
                <Setter Property="(ProportionalStackPanel.IsCollapsed)">
                  <Setter.Value>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                      <Binding Path="IsCollapsable" />
                      <Binding Path="IsEmpty" />
                    </MultiBinding>
                  </Setter.Value>
                </Setter>
                <Setter Property="MinWidth" Value="{Binding MinWidth}" />
                <Setter Property="MaxWidth" Value="{Binding MaxWidth}" />
                <Setter Property="MinHeight" Value="{Binding MinHeight}" />
                <Setter Property="MaxHeight" Value="{Binding MaxHeight}" />
              </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <ProportionalStackPanel sp:DockProperties.IsDropArea="True"
                                        Background="Transparent"
                                        Orientation="{Binding Orientation, Converter={x:Static pc:OrientationConverter.Instance}}" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </fd:DockableControl>
      </ControlTemplate>
    </Setter>

  </ControlTheme>

</ResourceDictionary>

<Styles xmlns="https://github.com/ferroui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fd="using:FerroDock.Ferro.Controls"
        xmlns:fluent="clr-namespace:FerroDock.Ferro.Themes.Fluent;assembly=FerroDock.Ferro.Themes.Fluent"
        x:Class="FerroDock.Ferro.Themes.Browser.BrowserTabTheme">
  <fluent:DockFluentTheme />

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="ferres://FerroDock.Ferro.Themes.Browser/Styles/BrowserTabAccents.xaml" />
        <ResourceInclude Source="ferres://FerroDock.Ferro.Themes.Browser/Styles/Controls/AllResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <ResourceInclude x:Key="CompactStyles" Source="ferres://FerroDock.Ferro.Themes.Browser/Styles/DensityStyles/Compact.xaml" />
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="fd|DocumentTabStripItem" x:DataType="fd:DocumentTabStripItem">
    <Setter Property="ClipToBounds" Value="False" />
  </Style>

  <Style Selector="fd|DocumentTabStripItem /template/ Border#PART_TabSeparatorRight" x:DataType="Border">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="Background" Value="{DynamicResource DockDocumentTabItemSeparatorBrush}" />
    <Setter Property="Opacity" Value="{DynamicResource DockDocumentTabItemSeparatorOpacity}" />
  </Style>

  <Style Selector="fd|DocumentTabStripItem /template/ Border#PART_TabGutter" x:DataType="Border">
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="fd|DocumentTabStripItem /template/ Border#PART_TabBody" x:DataType="Border">
    <Setter Property="Margin" Value="3,0,3,0" />
  </Style>

  <Style Selector="fd|DocumentTabStripItem:selected" x:DataType="fd:DocumentTabStripItem">
    <Setter Property="(Panel.ZIndex)" Value="3" />
  </Style>

  <Style Selector="fd|DocumentTabStripItem:pointerover" x:DataType="fd:DocumentTabStripItem">
    <Setter Property="(Panel.ZIndex)" Value="2" />
  </Style>

  <Style Selector="fd|DocumentTabStripItem:selected /template/ Border#PART_TabGutter" x:DataType="Border">
    <Setter Property="Margin" Value="-3,0,-2,0" />
    <Setter Property="Background" Value="{DynamicResource DockDocumentTabStripMaskBrush}" />
  </Style>

  <Style Selector="fd|DocumentTabStripItem:pointerover /template/ Border#PART_TabGutter" x:DataType="Border">
    <Setter Property="Margin" Value="-4,0,-2,0" />
    <Setter Property="Background" Value="{DynamicResource DockDocumentTabStripMaskBrush}" />
  </Style>

  <Style Selector="fd|DocumentTabStripItem:dragging /template/ Border#PART_TabGutter" x:DataType="Border">
    <Setter Property="Margin" Value="-4,0,-2,0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Compensate for active gutter expansion so tab content/body does not shift on hover/selection. -->
  <Style Selector="fd|DocumentTabStripItem:selected /template/ Border#PART_TabBody" x:DataType="Border">
    <Setter Property="Margin" Value="6,0,5,0" />
  </Style>

  <Style Selector="fd|DocumentTabStripItem:pointerover /template/ Border#PART_TabBody" x:DataType="Border">
    <Setter Property="Margin" Value="7,0,5,0" />
  </Style>

  <Style Selector="fd|DocumentTabStripItem:dragging /template/ Border#PART_TabBody" x:DataType="Border">
    <Setter Property="Margin" Value="7,0,5,0" />
  </Style>

  <Style Selector="fd|DocumentTabStripItem:selected /template/ Border#PART_TabSeparatorRight" x:DataType="Border">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="fd|DocumentTabStripItem:pointerover /template/ Border#PART_TabSeparatorRight" x:DataType="Border">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="fd|DocumentTabStripItem:dragging /template/ Border#PART_TabSeparatorRight" x:DataType="Border">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="fd|DocumentTabStripItem /template/ ContentPresenter#PART_ClosePresenter" x:DataType="ContentPresenter">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="fd|DocumentTabStripItem:selected /template/ ContentPresenter#PART_ClosePresenter" x:DataType="ContentPresenter">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <Style Selector="fd|DocumentTabStripItem:pointerover /template/ ContentPresenter#PART_ClosePresenter" x:DataType="ContentPresenter">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <Style Selector="fd|DocumentTabStripItem:ultracompact:selected /template/ ContentPresenter#PART_CompactClosePresenter" x:DataType="ContentPresenter">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <Style Selector="fd|DocumentTabStripItem:ultracompact:selected /template/ ContentPresenter#PART_IconPresenter" x:DataType="ContentPresenter">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="fd|DocumentTabStrip[Orientation=Horizontal] /template/ ScrollViewer#PART_ScrollViewer" x:DataType="ScrollViewer">
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>

</Styles>

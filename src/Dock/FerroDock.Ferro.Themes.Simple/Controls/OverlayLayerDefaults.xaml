<ResourceDictionary xmlns="https://github.com/ferroui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:overlays="using:FerroDock.Ferro.Controls.Overlays"
                    xmlns:services="using:FerroDock.Model.Services"
                    x:CompileBindings="True" x:DataType="services:IHostOverlayServices">
  <overlays:OverlayLayerCollection x:Key="DockDefaultOverlayLayers" x:Shared="False">
    <overlays:OverlayLayer ZIndex="10"
                           StyleKey="{x:Static overlays:OverlayLayerStyleKeys.DialogLayerThemeKey}">
      <overlays:DialogOverlayControl DialogService="{Binding Dialogs}"
                            GlobalDialogService="{Binding GlobalDialogService}" />
    </overlays:OverlayLayer>
    <overlays:OverlayLayer ZIndex="20"
                           StyleKey="{x:Static overlays:OverlayLayerStyleKeys.ConfirmationLayerThemeKey}">
      <overlays:ConfirmationOverlayControl ConfirmationService="{Binding Confirmations}"
                                  GlobalConfirmationService="{Binding GlobalConfirmationService}" />
    </overlays:OverlayLayer>
    <overlays:OverlayLayer ZIndex="30"
                           StyleKey="{x:Static overlays:OverlayLayerStyleKeys.BusyLayerThemeKey}">
      <overlays:BusyOverlayControl BusyService="{Binding Busy}"
                          GlobalBusyService="{Binding GlobalBusyService}" />
    </overlays:OverlayLayer>
  </overlays:OverlayLayerCollection>

  <ControlTheme x:Key="{x:Type overlays:OverlayHost}" TargetType="overlays:OverlayHost" x:DataType="services:IHostOverlayServices">
    <Setter Property="OverlayLayers" Value="{DynamicResource DockDefaultOverlayLayers}" />
  </ControlTheme>
</ResourceDictionary>

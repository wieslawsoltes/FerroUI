<ResourceDictionary xmlns:fd="using:FerroDock.Ferro.Controls"
                    xmlns:pc="using:FerroDock.Ferro.Converters"
                    xmlns:sp="using:FerroDock.Settings" xmlns="https://github.com/ferroui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:FerroDock.Ferro.Controls"
                    xmlns:core="using:FerroDock.Model.Core"
                    xmlns:dmc="using:FerroDock.Model.Controls"
                    x:DataType="dmc:IRootDock"
                    x:CompileBindings="True">
  <Design.PreviewWith>
    <fd:RootDockControl Width="300" Height="300" />
  </Design.PreviewWith>

  <ControlTheme x:Key="{x:Type fd:RootDockControl}" TargetType="fd:RootDockControl" x:DataType="dmc:IRootDock">

    <Setter Property="(AutomationProperties.AutomationId)" Value="{Binding Id}" />
    <Setter Property="(AutomationProperties.Name)" Value="{Binding Title}" />

    <Setter Property="(sp:DockProperties.IsDragEnabled)" Value="{Binding CanDrag}" />
    <Setter Property="(sp:DockProperties.IsDropEnabled)" Value="{Binding CanDrop}" />
    <Setter Property="(sp:DockProperties.DockGroup)" Value="{Binding DockGroup}" />

    <Setter Property="Template">
      <ControlTemplate>
        <fd:DockableControl TrackingMode="Visible">
          <DockPanel Background="Transparent"
                     sp:DockProperties.IsDropArea="False">
            <fd:ToolPinnedControl DockPanel.Dock="Left"
                               Orientation="Vertical"
                               ItemsSource="{Binding LeftPinnedDockables}"
                               IsVisible="{Binding !!LeftPinnedDockables?.Count, TargetNullValue={x:False}, FallbackValue={x:False}}" />
            <fd:ToolPinnedControl DockPanel.Dock="Right"
                               Orientation="Vertical"
                               ItemsSource="{Binding RightPinnedDockables}"
                               IsVisible="{Binding !!RightPinnedDockables?.Count, TargetNullValue={x:False}, FallbackValue={x:False}}" />
            <fd:ToolPinnedControl DockPanel.Dock="Top"
                               Orientation="Horizontal"
                               ItemsSource="{Binding TopPinnedDockables}"
                               IsVisible="{Binding !!TopPinnedDockables?.Count, TargetNullValue={x:False}, FallbackValue={x:False}}" />
            <fd:ToolPinnedControl DockPanel.Dock="Bottom"
                               Orientation="Horizontal"
                               ItemsSource="{Binding BottomPinnedDockables}"
                               IsVisible="{Binding !!BottomPinnedDockables?.Count, TargetNullValue={x:False}, FallbackValue={x:False}}" />
            <controls:PinnedDockHostPanel PinnedDockDisplayMode="{Binding PinnedDockDisplayMode}"
                                          PinnedDockAlignment="{Binding PinnedDock?.Alignment, TargetNullValue={x:Static core:Alignment.Unset}, FallbackValue={x:Static core:Alignment.Unset}}">
              <DeferredContentControl Content="{Binding ActiveDockable}" Name="PART_MainContent" />
              <fd:PinnedDockControl />
            </controls:PinnedDockHostPanel>
          </DockPanel>
        </fd:DockableControl>
      </ControlTemplate>
    </Setter>

  </ControlTheme>

</ResourceDictionary>

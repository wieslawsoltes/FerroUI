<ResourceDictionary xmlns:fd="using:FerroDock.Ferro.Controls"
                    xmlns:pc="using:FerroDock.Ferro.Converters"
                    xmlns:settingsp="using:FerroDock.Settings" xmlns="https://github.com/ferroui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dmc="using:FerroDock.Model.Controls"
                    x:DataType="dmc:IToolDock"
                    x:CompileBindings="True">
  <Design.PreviewWith>
    <Border Padding="20">
      <fd:ToolTabStrip>
        <fd:ToolTabStripItem>Item 1</fd:ToolTabStripItem>
        <fd:ToolTabStripItem>Item 2</fd:ToolTabStripItem>
        <fd:ToolTabStripItem IsEnabled="False">Disabled</fd:ToolTabStripItem>
      </fd:ToolTabStrip>
    </Border>
  </Design.PreviewWith>

  <ControlTheme x:Key="{x:Type fd:ToolTabStrip}" TargetType="fd:ToolTabStrip">

    <Setter Property="(settingsp:DockProperties.IsDragEnabled)" Value="{Binding CanDrag}" />
    <Setter Property="(settingsp:DockProperties.IsDropEnabled)" Value="{Binding CanDrop}" />
    <Setter Property="(settingsp:DockProperties.DockGroup)" Value="{Binding DockGroup}" />

    <Setter Property="Background" Value="{DynamicResource DockTabBackgroundBrush}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="ZIndex" Value="1" />

    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_Border"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}"
                  DockPanel.Dock="Left">
            <ScrollViewer x:Name="PART_ScrollViewer">
              <ItemsPresenter Name="PART_ItemsPresenter"
                              ItemsPanel="{TemplateBinding ItemsPanel}" />
            </ScrollViewer>
          </Border>
          <Border Name="PART_BorderLeftFill"
                  IsHitTestVisible="False" />
          <Border Name="PART_BorderRightFill"
                  IsHitTestVisible="False" />
          <Border Name="PART_BorderFill"
                  settingsp:DockProperties.IsDropArea="True"
                  settingsp:DockProperties.IsDockTarget="True"
                  settingsp:DockProperties.ShowDockIndicatorOnly="True"
                  settingsp:DockProperties.IndicatorDockOperation="Fill">
            <Border.Margin>
              <MultiBinding Converter="{x:Static pc:BorderFillMarginConverter.Instance}">
                <Binding Path="#PART_ItemsPresenter.Bounds.Width" />
                <Binding Path="#PART_ItemsPresenter.Bounds.Height" />
                <Binding Path="#PART_ItemsPresenter.IsVisible" />
                <Binding Path="#PART_ItemsPresenter.VerticalAlignment" />
                <Binding Path="#PART_ItemsPresenter.HorizontalAlignment" />
              </MultiBinding>
            </Border.Margin>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" ClipToBounds="False" />
      </ItemsPanelTemplate>
    </Setter>

    <Style Selector="^/template/ ItemsPresenter#PART_ItemsPresenter">
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style Selector="^:singleitem /template/ ItemsPresenter#PART_ItemsPresenter">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="^/template/ Border#PART_BorderFill">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="^/template/ Border#PART_BorderLeftFill">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource DockSeparatorBrush}" />
      <Setter Property="BorderThickness" Value="0 1 0  0" />
    </Style>

    <Style Selector="^/template/ Border#PART_BorderRightFill">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource DockSeparatorBrush}" />
      <Setter Property="BorderThickness" Value="0 1 0  0" />
    </Style>

    <Style Selector="^/template/ ScrollViewer#PART_ScrollViewer">
      <Setter Property="Theme" Value="{DynamicResource DockTabStripScrollViewerHorizontal}" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
      <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
    </Style>

  </ControlTheme>

</ResourceDictionary>

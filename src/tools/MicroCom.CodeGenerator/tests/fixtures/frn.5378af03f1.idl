[uuid(809c652e-7396-11d2-9771-00a0c9b4d50c)]
interface IFerroNativeFactory : IUnknown
{
     HRESULT Initialize(IFrnGCHandleDeallocatorCallback* deallocator, IFrnApplicationEvents* appCb,
        IFrnDispatcher* dispatcher);
     IFrnMacOptions* GetMacOptions();
     HRESULT CreateTopLevel(IFrnTopLevelEvents* cb, IFrnTopLevel** ppv);
     HRESULT CreateWindow(IFrnWindowEvents* cb, IFrnWindow** ppv);
     HRESULT CreatePopup(IFrnWindowEvents* cb, IFrnPopup** ppv);
     HRESULT CreatePlatformThreadingInterface(IFrnPlatformThreadingInterface** ppv);
     HRESULT CreateStorageProvider(IFrnStorageProvider** ppv);
     HRESULT CreateScreens(IFrnScreenEvents* cb, IFrnScreens** ppv);
     HRESULT CreateClipboard(IFrnClipboard** ppv);
     HRESULT CreateCursorFactory(IFrnCursorFactory** ppv);
     HRESULT ObtainGlDisplay(IFrnGlDisplay** ppv);
     HRESULT ObtainMetalDisplay(IFrnMetalDisplay** ppv);
     HRESULT SetAppMenu(IFrnMenu* menu);
     HRESULT SetServicesMenu(IFrnMenu* menu);
     HRESULT CreateMenu(IFrnMenuEvents* cb, IFrnMenu** ppv);
     HRESULT CreateMenuItem(IFrnMenuItem** ppv);
     HRESULT CreateMenuItemSeparator(IFrnMenuItem** ppv);
     HRESULT CreateTrayIcon(IFrnTrayIcon** ppv);
     HRESULT CreateApplicationCommands(IFrnApplicationCommands** ppv);
     HRESULT CreatePlatformSettings(IFrnPlatformSettings** ppv);
     HRESULT CreatePlatformBehaviorInhibition(IFrnPlatformBehaviorInhibition** ppv);
     HRESULT CreatePlatformRenderTimer(IFrnPlatformRenderTimer** ppv);
     HRESULT ImportMTLSharedEvent([intptr]void* idMtlSharedEvent, IFrnMTLSharedEvent** ppv);
     HRESULT CreateMemoryManagementHelper(IFrnNativeObjectsMemoryManagement** ppv);
     HRESULT SetDockMenu(IFrnMenu* menu);
}

[uuid(233e094f-9b9f-44a3-9a6e-6948bbdd9fb1)]
interface IFrnString : IUnknown
{
     HRESULT Pointer(void**retOut);
     HRESULT Length(int*ret);
}

[uuid(e8cccd3e-e6dc-430a-a0b9-2ce7d7922de6)]
interface IFrnTopLevel : IUnknown
{
     HRESULT GetClientSize(FrnSize*ret);
     HRESULT GetScaling(double*ret);
     
     HRESULT Invalidate();
     
     HRESULT PointToClient(FrnPoint point, FrnPoint*ret);
     HRESULT PointToScreen(FrnPoint point, FrnPoint*ret);
     
     HRESULT SetCursor(IFrnCursor* cursor);
     HRESULT CreateGlRenderTarget(IFrnGlContext* context, IFrnGlSurfaceRenderTarget** ret);
     HRESULT CreateSoftwareRenderTarget(IFrnSoftwareRenderTarget** ret);
     HRESULT CreateMetalRenderTarget(IFrnMetalDevice* device, IFrnMetalRenderTarget** ret);
     
     HRESULT ObtainNSViewHandle([intptr]void** retOut);
     HRESULT ObtainNSViewHandleRetained([intptr]void** retOut);
     
     HRESULT CreateNativeControlHost(IFrnNativeControlHost** retOut);
     
     HRESULT GetInputMethod(IFrnTextInputMethod **ppv);
     HRESULT SetTransparencyMode(FrnWindowTransparencyMode mode);
     
     HRESULT GetCurrentDisplayId(uint* ret);

     HRESULT BeginDragAndDropOperation(
             FrnDragDropEffects effects,
             FrnPoint point,
             IFrnClipboardDataSource* source,
             IFrnDndResultCallback* callback,
             [intptr]void* sourceHandle);
}

[uuid(e5aca675-02b7-4129-aa79-d6e417210bda), cpp-virtual-inherits]
interface IFrnWindowBase : IFrnTopLevel
{
     HRESULT GetFrameSize(FrnSize*result);
     HRESULT SetFrameThemeVariant(FrnPlatformThemeVariant mode);
     HRESULT SetParent(IFrnWindowBase* parent);
     HRESULT Show(bool activate, bool isDialog);
     HRESULT Hide();
     HRESULT Close();
     HRESULT Activate(); 
     HRESULT SetMinMaxSize(FrnSize minSize, FrnSize maxSize);
     HRESULT Resize(double width, double height, FrnPlatformResizeReason reason);
     HRESULT BeginMoveDrag();
     HRESULT BeginResizeDrag(FrnWindowEdge edge);
     HRESULT GetPosition(FrnPoint*ret);
     HRESULT SetPosition(FrnPoint point);
     HRESULT SetTopMost(bool value);
     HRESULT SetMainMenu(IFrnMenu* menu);
     HRESULT ObtainNSWindowHandle([intptr]void** retOut);
     HRESULT ObtainNSWindowHandleRetained([intptr]void** retOut);
}

[uuid(83e588f3-6981-4e48-9ea0-e1e569f79a91), cpp-virtual-inherits]
interface IFrnPopup : IFrnWindowBase
{
    
}

[uuid(cab661de-49d6-4ead-b59c-eac9b2b6c28d), cpp-virtual-inherits]
interface IFrnWindow : IFrnWindowBase
{
     HRESULT SetEnabled(bool enable);
     HRESULT SetCanResize(bool value);
     HRESULT SetCanMinimize(bool value);
     HRESULT SetCanMaximize(bool value);
     HRESULT SetDecorations(SystemDecorations value);
     HRESULT SetTitle(char* utf8Title);
     HRESULT SetTitleBarColor(FrnColor color);
     HRESULT SetWindowState(FrnWindowState state);
     HRESULT GetWindowState(FrnWindowState*ret);
     HRESULT TakeFocusFromChildren();
     HRESULT SetExtendClientArea(bool enable);
     HRESULT GetExtendTitleBarHeight(double*ret);
     HRESULT SetExtendTitleBarHeight(double value);
     HRESULT GetWindowZOrder(long*ret);
}

[uuid(fda9c1b3-69e0-43d7-9459-8cc97cb41f6a)]
interface IFrnTopLevelEvents : IUnknown
{
    void Closed();

    HRESULT Paint();
    void Resized([const] FrnSize& size, FrnPlatformResizeReason reason);
    void RawMouseEvent(FrnRawMouseEventType type,
                                    FrnPointerDeviceType deviceType,
                                    u_int64_t timeStamp,
                                    FrnInputModifiers modifiers,
                                    FrnPoint point,
                                    FrnVector delta,
                                    float pressure,
                                    float xTilt,
                                    float yTilt

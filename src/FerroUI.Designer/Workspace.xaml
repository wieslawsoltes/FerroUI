<Grid xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Name="WorkspaceRoot" RowDefinitions="44,0,*,1,220,24" Background="{DynamicResource DesignerChromeBrush}">
  <Grid.Styles>
    <StyleInclude Source="ferres://FerroUI.Controls.TreeDataGrid/Themes/Generic.xaml" />
  </Grid.Styles>

  <!-- One stable application bar: document commands, editor modes, collaboration. -->
  <Border Classes="designer-chrome" Background="{DynamicResource DesignerChromeBrush}" BorderBrush="{DynamicResource DesignerBorderBrush}" BorderThickness="0,0,0,1" Padding="12,4">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Border Width="26" Height="26" CornerRadius="6" Background="{DynamicResource DesignerAccentBrush}">
          <PathIcon Classes="designer-icon" Width="14" Height="16" Foreground="#FF14233D" Data="F1 M1,0 L15,0 15,3 4,3 4,7 12,7 12,10 4,10 4,17 1,17 Z" />
        </Border>
        <TextBlock Text="FerroUI" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
        <Border Width="1" Height="20" Background="{DynamicResource DesignerBorderBrush}" Margin="0,0,4,0" />
        <CommandBar DefaultLabelPosition="Collapsed" Background="Transparent" IsDynamicOverflowEnabled="True" ToolTip.Tip="File and edit commands">
        <CommandBar.PrimaryCommands>
          <CommandBarButton Name="OpenFile" Label="Open" ToolTip.Tip="Open XAML · Ctrl+O">
            <CommandBarButton.Icon><PathIcon Classes="designer-icon" Width="16" Height="16" Data="F1 M1,4 L7,4 9,6 19,6 19,16 1,16 Z M2,7 L2,15 18,15 18,7 Z" /></CommandBarButton.Icon>
          </CommandBarButton>
          <CommandBarButton Name="SaveFile" Label="Save" ToolTip.Tip="Save · Ctrl+S">
            <CommandBarButton.Icon><PathIcon Classes="designer-icon" Width="16" Height="16" Data="F1 M2,1 L15,1 19,5 19,19 1,19 1,1 Z M4,2 L4,8 14,8 14,2 Z M5,12 L5,18 15,18 15,12 Z" /></CommandBarButton.Icon>
          </CommandBarButton>
          <CommandBarSeparator />
          <CommandBarButton Name="Undo" Label="Undo" ToolTip.Tip="Undo · Ctrl+Z">
            <CommandBarButton.Icon><PathIcon Classes="designer-icon" Width="16" Height="16" Data="F1 M7,2 L1,8 7,14 7,10 12,10 Q17,10 17,16 L19,16 Q19,8 12,8 L7,8 Z" /></CommandBarButton.Icon>
          </CommandBarButton>
          <CommandBarButton Name="Redo" Label="Redo" ToolTip.Tip="Redo · Ctrl+Shift+Z">
            <CommandBarButton.Icon><PathIcon Classes="designer-icon" Width="16" Height="16" Data="F1 M13,2 L19,8 13,14 13,10 8,10 Q3,10 3,16 L1,16 Q1,8 8,8 L13,8 Z" /></CommandBarButton.Icon>
          </CommandBarButton>
        </CommandBar.PrimaryCommands>
        <CommandBar.SecondaryCommands>
          <CommandBarButton Name="OpenProject" Label="Open solution…" />
          <CommandBarButton Name="SaveAll" Label="Save all documents" />
          <CommandBarButton Name="SaveFileAs" Label="Save as…" />
          <CommandBarSeparator />
          <CommandBarButton Name="Duplicate" Label="Duplicate selection" ToolTip.Tip="Duplicate · Ctrl+D" />
          <CommandBarButton Name="Delete" Label="Delete selection" ToolTip.Tip="Delete" />
        </CommandBar.SecondaryCommands>

        </CommandBar>
      </StackPanel>
      <TextBlock Name="DocumentTitle" Grid.Column="1" Text="Untitled.xaml" FontSize="12" Foreground="{DynamicResource DesignerSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Border Background="{DynamicResource DesignerCanvasBrush}" CornerRadius="5" Padding="3">
          <StackPanel Orientation="Horizontal" Spacing="1">
            <Button Name="DesignView" Classes="nav active" Content="Design" ToolTip.Tip="Design canvas · F6" />
            <Button Name="SplitView" Classes="nav" Content="Split" ToolTip.Tip="Design and XAML · F6" />
            <Button Name="CodeView" Classes="nav" Content="XAML" ToolTip.Tip="Source editor · F6" />
          </StackPanel>
        </Border>
        <Button Name="TimelineToggle" Classes="icon active" ToolTip.Tip="Show or hide the animation timeline">
          <PathIcon Classes="designer-icon" Width="16" Height="16" Data="F1 M1,2 L19,2 19,4 1,4 Z M1,8 L4,8 4,10 1,10 Z M1,14 L4,14 4,16 1,16 Z M8,6 L11,9 8,12 5,9 Z M15,12 L18,15 15,18 12,15 Z" />
        </Button>
        <Button Name="NativePreview" Classes="nav" ToolTip.Tip="Open an interactive native preview window">
          <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Classes="designer-icon" Width="12" Height="12" Data="F1 M4,2 L17,10 4,18 Z" /><TextBlock Text="Preview" /></StackPanel>
        </Button>
        <TextBlock Name="PeerCount" Text="" Foreground="{DynamicResource DesignerAccentBrush}" VerticalAlignment="Center" />
        <Button Name="Share" Content="Share" Classes="primary" Padding="16,4" ToolTip.Tip="Collaborate on this document" />
      </StackPanel>
    </Grid>
  </Border>

  <Grid Name="MainLayout" Grid.Row="2" ColumnDefinitions="248,1,*,1,320">
    <Border Name="NavigationDock" Classes="designer-chrome" Background="{DynamicResource DesignerPanelBrush}">
      <Grid RowDefinitions="36,*">
        <Border BorderBrush="{DynamicResource DesignerBorderBrush}" BorderThickness="0,0,0,1">
          <StackPanel Orientation="Horizontal" Spacing="2" Margin="8,0">
            <Button Name="LayersTab" Classes="panel-tab active" Content="Layers" />
            <Button Name="AssetsTab" Classes="panel-tab" Content="Assets" />
            <Button Name="LibraryTab" Classes="panel-tab" Content="Library" ToolTip.Tip="Components, templates, themes and resources" />
            <Button Name="ProjectTab" Classes="panel-tab" Content="Project" />
          </StackPanel>
        </Border>
        <Grid Name="LayersPane" Grid.Row="1" RowDefinitions="36,32,*,28">
          <Grid ColumnDefinitions="*,28" Margin="12,7,8,3">
            <TextBox Name="OutlineSearch" PlaceholderText="Search layers" Margin="0,0,4,0" ToolTip.Tip="Filter by name, type or resource key">
              <TextBox.InnerLeftContent><PathIcon Classes="designer-icon" Width="12" Height="12" Margin="7,0,0,0" Foreground="{DynamicResource DesignerMutedBrush}" Data="F1 M8 1A7 7 0 1 1 8 15A7 7 0 1 1 8 1Z M8 3A5 5 0 1 0 8 13A5 5 0 1 0 8 3Z M12 11L19 18L17.6 19.4L10.6 12.4Z" /></TextBox.InnerLeftContent>
            </TextBox>
            <Button Name="CollapseLayers" Grid.Column="1" Classes="icon" Height="26" ToolTip.Tip="Collapse layers · keep the selected paths visible"><PathIcon Classes="designer-icon" Width="14" Height="14" Data="F1 M2,1 L8,7 14,1 15,2 8,9 1,2 Z M2,17 L8,11 14,17 15,16 8,9 1,16 Z" /></Button>
          </Grid>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="3" Margin="10,2,10,4">
            <Button Name="SourceMode" Classes="nav active" Content="Source" FontSize="11" Padding="8,3" ToolTip.Tip="Authored XAML hierarchy · drag to reorder or nest" />
            <Button Name="VisualMode" Classes="nav" Content="Visual" FontSize="11" Padding="8,3" ToolTip.Tip="Inspect the live visual tree" />
            <Button Name="LogicalMode" Classes="nav" Content="Logical" FontSize="11" Padding="8,3" ToolTip.Tip="Inspect the live logical tree" />
            <Button Name="LayerActions" Classes="icon" Width="24" Height="26" ToolTip.Tip="Layer visibility, locking, isolation and selection"><PathIcon Classes="designer-icon" Width="14" Height="14" Data="F1 M2 7A1 1 0 1 1 2 9A1 1 0 1 1 2 7Z M8 7A1 1 0 1 1 8 9A1 1 0 1 1 8 7Z M14 7A1 1 0 1 1 14 9A1 1 0 1 1 14 7Z" />
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Name="LayerToggleLock" Header="Lock / unlock in editor" />
                  <MenuItem Name="LayerToggleHidden" Header="Hide / show in editor" />
                  <MenuItem Name="LayerIsolate" Header="Isolate selection" />
                  <MenuItem Name="LayerExitIsolation" Header="Exit isolation" />
                  <Separator />
                  <MenuItem Name="LayerUnlockAll" Header="Unlock all layers" />
                  <MenuItem Name="LayerShowAll" Header="Show all layers" />
                  <Separator />
                  <MenuItem Name="LayerSelectParent" Header="Select parent" />
                  <MenuItem Name="LayerSelectChildren" Header="Select children" />
                  <MenuItem Name="LayerSelectNext" Header="Select next sibling" />
                  <MenuItem Name="LayerSelectPrevious" Header="Select previous sibling" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
          <ContentControl Name="OutlineHost" Grid.Row="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Margin="4,2,4,4" />
          <Border Grid.Row="3" BorderBrush="{DynamicResource DesignerBorderBrush}" BorderThickness="0,1,0,0" Padding="12,5">
            <TextBlock Name="OutlineHint" Classes="designer-muted" Text="Drag to reorder · Alt + arrows to nest" FontSize="10" />
          </Border>
        </Grid>
        <ContentControl Name="AssetsPane" Grid.Row="1" IsVisible="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
          <ContentControl Name="AssetHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Margin="12,8,12,8" />
        </ContentControl>
        <ContentControl Name="LibraryPane" Grid.Row="1" IsVisible="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
          <ContentControl Name="ComponentLibraryHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </ContentControl>
        <Grid Name="ProjectPane" Grid.Row="1" IsVisible="False" RowDefinitions="Auto,Auto,*" Margin="12,12,12,8">
          <StackPanel Spacing="8">
            <TextBlock Text="Project" Classes="designer-section-title" />
            <TextBox Name="ProjectPath" PlaceholderText="Folder or Cargo.toml path" ToolTip.Tip="Enter a path and choose Check to load the solution" />
            <ComboBox Name="RunTarget" PlaceholderText="Choose a binary target" HorizontalAlignment="Stretch" />
          </StackPanel>
          <WrapPanel Grid.Row="1" Margin="0,8,0,10">
            <Button Name="CheckProject" Content="Check" Margin="0,0,4,4" />
            <Button Name="BuildProject" Content="Build" Margin="0,0,4,4" />
            <Button Name="RunProject" Content="Run" Margin="0,0,4,4" />
            <Button Name="CancelBuild" Content="Stop" Margin="0,0,0,4" />
          </WrapPanel>
          <ContentControl Name="ProjectTreeHost" Grid.Row="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
      </Grid>
    </Border>
    <GridSplitter Name="NavigationDivider" Grid.Column="1" Classes="designer-splitter" Width="5" Background="{DynamicResource DesignerBorderBrush}" />

    <Grid Name="DocumentLayout" Grid.Column="2" RowDefinitions="36,32,*,0,0">
      <Border Classes="designer-chrome" Background="{DynamicResource DesignerChromeBrush}" BorderBrush="{DynamicResource DesignerBorderBrush}" BorderThickness="0,0,0,1" Padding="8,5,8,0">
        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
          <StackPanel Name="DocumentTabs" Orientation="Horizontal" Spacing="2" />
        </ScrollViewer>
      </Border>
      <Border Name="CanvasToolbar" Classes="designer-chrome" Grid.Row="1" Background="{DynamicResource DesignerPanelBrush}" BorderBrush="{DynamicResource DesignerBorderBrush}" BorderThickness="0,0,0,1" Padding="12,2">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <PathIcon Classes="designer-icon" Width="13" Height="13" Foreground="{DynamicResource DesignerMutedBrush}" Data="F1 M2,0 L4,0 4,2 14,2 14,0 16,0 16,2 18,2 18,4 16,4 16,14 18,14 18,16 16,16 16,18 14,18 14,16 4,16 4,18 2,18 2,16 0,16 0,14 2,14 2,4 0,4 0,2 2,2 Z M4,4 L4,14 14,14 14,4 Z" />
            <TextBlock Name="CanvasSize" Text="800 × 520" Foreground="{DynamicResource DesignerSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
            <Button Name="PreviewEnvironment" Classes="icon" Width="24" Height="26" ToolTip.Tip="Preview environment · size presets, orientation, theme and reading direction"><PathIcon Classes="designer-icon" Width="14" Height="14" Data="F1 M2 7A1 1 0 1 1 2 9A1 1 0 1 1 2 7Z M8 7A1 1 0 1 1 8 9A1 1 0 1 1 8 7Z M14 7A1 1 0 1 1 14 9A1 1 0 1 1 14 7Z" /></Button>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
            <Button Name="LayoutHelpersToggle" Classes="nav active" Content="Helpers" FontSize="11" Padding="7,3" ToolTip.Tip="Layout helpers · H. Drag gaps, margins and Grid tracks. F8 cycles handles; arrows adjust. Hold Alt for free movement." />
            <Button Name="PreviewTheme" Classes="nav" Content="Light preview" FontSize="11" Padding="6,3" ToolTip.Tip="Switch only the document preview theme" />
            <Border Width="1" Height="16" Background="{DynamicResource DesignerBorderBrush}" Margin="7,0" />
            <Button Name="ZoomOut" Classes="icon" Width="24" Height="26" ToolTip.Tip="Zoom out"><PathIcon Classes="designer-icon" Width="14" Height="14" Data="F1 M1 7H15V9H1Z" /></Button>
            <Button Name="ZoomReset" Classes="nav" Content="100%" Width="64" Padding="4,3" FontSize="11" ToolTip.Tip="Reset zoom to 100%" />
            <Button Name="ZoomIn" Classes="icon" Width="24" Height="26" ToolTip.Tip="Zoom in"><PathIcon Classes="designer-icon" Width="14" Height="14" Data="F1 M7 1H9V7H15V9H9V15H7V9H1V7H7Z" /></Button>
            <Button Name="ZoomFit" Classes="nav" Content="Fit" FontSize="11" ToolTip.Tip="Fit the artboard in the canvas" />
            <Button Name="ZoomOptions" Classes="icon" Width="24" Height="26" ToolTip.Tip="Zoom percentage, fit selection and wheel options"><PathIcon Classes="designer-icon" Width="14" Height="14" Data="F1 M2 7A1 1 0 1 1 2 9A1 1 0 1 1 2 7Z M8 7A1 1 0 1 1 8 9A1 1 0 1 1 8 7Z M14 7A1 1 0 1 1 14 9A1 1 0 1 1 14 7Z" />
              <Button.Flyout>
                <Flyout>
                  <StackPanel Width="256" Spacing="8">
                    <TextBlock Text="Canvas navigation" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBox Name="ZoomPercent" Text="100" Watermark="Zoom percentage" AutomationProperties.Name="Zoom percentage from 1 to 1600" />
                      <Button Name="ZoomApply" Grid.Column="1" Content="Apply %" />
                    </Grid>
                    <TextBlock Name="ZoomError" Foreground="#FFFF8C86" FontSize="11" TextWrapping="Wrap" />
                    <Button Name="ZoomActualSize" Content="Actual size · Ctrl/Cmd+0" HorizontalAlignment="Stretch" />
                    <Button Name="ZoomFitMenu" Content="Fit artboard · Shift+1" HorizontalAlignment="Stretch" />
                    <Button Name="ZoomSelection" Content="Fit selection · Shift+2" HorizontalAlignment="Stretch" />
                    <TextBlock Text="Mouse wheel" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <Button Name="WheelPan" Classes="nav active" Content="Pan · Ctrl/Cmd to zoom" HorizontalAlignment="Stretch" />
                    <Button Name="WheelZoom" Classes="nav" Content="Zoom · Ctrl/Cmd to pan" HorizontalAlignment="Stretch" />
                    <TextBlock Text="Shift+wheel pans horizontally. Middle-drag or Space+drag pans the canvas." FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Name="CanvasViewport" Grid.Row="2" RowDefinitions="Auto,*" Background="{DynamicResource DesignerCanvasBrush}">
        <StackPanel>
        <Border Name="ComponentScopeBar" Classes="designer-chrome" IsVisible="False" Background="#FF302A40" BorderBrush="#FF594C73" BorderThickness="0,0,0,1" Padding="10,4">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Button Name="ComponentScopeBack" Classes="nav" ToolTip.Tip="Return to the document and its previous selection"><StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Classes="designer-icon" Width="14" Height="14" Data="F1 M8 1L9.4 2.4L4.8 7H15V9H4.8L9.4 13.6L8 15L1 8Z" /><TextBlock Text="Document" /></StackPanel></Button>
            <TextBlock Name="ComponentScopeTitle" Grid.Column="1" Foreground="#FFD2C4F5" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis" />
            <Button Name="ComponentScopeDefinition" Grid.Column="2" Classes="nav" Content="Definition" ToolTip.Tip="Inspect the active definition" />
          </Grid>
        </Border>
        <Border Name="LayerIsolationBanner" Classes="designer-chrome" IsVisible="False" Background="{DynamicResource DesignerPanelBrush}" BorderBrush="{DynamicResource DesignerBorderBrush}" BorderThickness="0,0,0,1" Padding="12,4">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Name="LayerIsolationText" Text="Isolated layers" Foreground="{DynamicResource DesignerAccentBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Name="LayerIsolationExit" Grid.Column="1" Classes="nav" Content="Exit isolation" />
          </Grid>
        </Border>
        </StackPanel>
        <Grid Name="ArtboardScroll" Grid.Row="1" ClipToBounds="True" Background="Transparent" Focusable="True">
          <Canvas Name="ArtboardPlane">
                <Border Name="ArtboardTransform" RenderTransformOrigin="0,0" BoxShadow="0 4 24 0 #66000000">
                  <Grid Name="Artboard" Width="800" Height="520" Background="White">
                    <ThemeVariantScope Name="PreviewThemeScope" RequestedThemeVariant="Light">
                      <ContentControl Name="Preview" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                    </ThemeVariantScope>
                  </Grid>
                </Border>
              <TextBlock Name="ArtboardTitle" Text="Artboard" IsHitTestVisible="False" Foreground="{DynamicResource DesignerMutedBrush}" FontFamily="Segoe UI, Noto Sans, DejaVu Sans, sans-serif" FontSize="11" />
          </Canvas>
        </Grid>
        <Border Grid.Row="1" Classes="designer-chrome" Background="{DynamicResource DesignerPanelBrush}" BorderBrush="{DynamicResource DesignerBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="5" BoxShadow="0 4 14 0 #66000000" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12,0,12,14">
          <StackPanel Orientation="Horizontal" Spacing="3">
            <Button Name="SelectTool" Classes="icon active" Width="32" Height="30" ToolTip.Tip="Move and select · V">
              <PathIcon Classes="designer-icon" Width="16" Height="16" Data="F1 M3,1 L17,12 11,13 8,19 Z M6,5 L9,14 10,11 13,11 Z" />
            </Button>
            <Button Name="PreviewTool" Classes="icon" Width="32" Height="30" ToolTip.Tip="Interact with preview controls · I">
              <PathIcon Classes="designer-icon" Width="16" Height="16" Data="F1 M8,1 Q6,1 6,3 L6,9 5,8 Q3,6 2,8 L6,16 Q7,18 10,18 L14,18 Q17,18 17,15 L17,7 Q17,5 15,6 Q14,3 12,5 Q10,2 9,4 L9,3 Q9,1 8,1 Z" />
            </Button>
            <Button Name="PanTool" Classes="nav" Content="Pan" ToolTip.Tip="Pan the canvas · middle-drag or Space+drag" />
            <Border Width="1" Height="20" Background="{DynamicResource DesignerBorderBrush}" Margin="5,0" />
            <Button Name="ArrangeSelection" Classes="nav" ToolTip.Tip="Align, distribute, reorder or nest selected elements">
              <StackPanel Orientation="Horizontal" Spacing="7"><PathIcon Classes="designer-icon" Width="14" Height="14" Data="F1 M1,0 L3,0 3,18 1,18 Z M5,3 L17,3 17,7 5,7 Z M5,11 L12,11 12,15 5,15 Z" /><TextBlock Text="Arrange" /></StackPanel>
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Name="AlignLeft" Header="Align left" />
                  <MenuItem Name="AlignCenter" Header="Align horizontal centers" />
                  <MenuItem Name="AlignRight" Header="Align right" />
                  <Separator />
                  <MenuItem Name="AlignTop" Header="Align top" />
                  <MenuItem Name="AlignMiddle" Header="Align vertical centers" />
                  <MenuItem Name="AlignBottom" Header="Align bottom" />
                  <Separator />
                  <MenuItem Name="DistributeHorizontal" Header="Distribute horizontally" />
                  <MenuItem Name="DistributeVertical" Header="Distribute vertically" />
                  <Separator />
                  <MenuItem Name="OutlineMoveFirst" Header="Send to back" InputGesture="Alt+Home" />
                  <MenuItem Name="OutlineMoveLast" Header="Bring to front" InputGesture="Alt+End" />
                  <MenuItem Name="OutlineMoveUp" Header="Move earlier" InputGesture="Alt+Up" />
                  <MenuItem Name="OutlineMoveDown" Header="Move later" InputGesture="Alt+Down" />
                  <Separator />
                  <MenuItem Name="OutlineIndent" Header="Nest in previous container" InputGesture="Alt+Right" />
                  <MenuItem Name="OutlineOutdent" Header="Move to parent container" InputGesture="Alt+Left" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Button Name="FocusCanvas" Classes="icon" ToolTip.Tip="Focus canvas · hide side panels · Ctrl+Shift+F">
              <PathIcon Classes="designer-icon" Width="15" Height="15" Data="F1 M0,0 L7,0 7,2 2,2 2,7 0,7 Z M11,0 L18,0 18,7 16,7 16,2 11,2 Z M0,11 L2,11 2,16 7,16 7,18 0,18 Z M16,11 L18,11 18,18 11,18 11,16 16,16 Z" />
            </Button>
            <Border Width="1" Height="20" Background="{DynamicResource DesignerBorderBrush}" Margin="5,0" />
            <Button Name="DesignData" Classes="nav" Content="Data" ToolTip.Tip="Design-time property overrides and sample data" />
            <Button Name="FocusOrder" Classes="nav" Content="Focus" ToolTip.Tip="Keyboard tab order and label targets" />
          </StackPanel>
        </Border>
      </Grid>
      <GridSplitter Name="SourceDivider" Classes="designer-splitter" Grid.Row="3" IsVisible="False" Height="5" Background="{DynamicResource DesignerBorderBrush}" />
      <Grid Name="SourcePane" Classes="designer-chrome" Grid.Row="4" IsVisible="False" RowDefinitions="Auto,*,Auto" Background="{DynamicResource DesignerChromeBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Horizontal" Spacing="3" Margin="8,5">
            <TextBlock Name="SourcePosition" Text="XAML" Classes="designer-section-title" VerticalAlignment="Center" Margin="2,0,8,0" />
            <Button Name="CompleteSource" Classes="nav" Content="Complete" />
            <Button Name="SourceDefinition" Classes="nav" Content="Definition" />
            <Button Name="SourceReferences" Classes="nav" Content="References" />
            <Button Name="SourceDiagnostics" Classes="nav" Content="Problems" />
            <Button Name="FormatSource" Classes="nav" Content="Format" />
            <TextBox Name="RenameSymbol" Width="100" PlaceholderText="New name" />
            <Button Name="RenameSource" Classes="nav" Content="Rename" />
            <Button Name="ApplySource" Content="Apply" ToolTip.Tip="Apply the current XAML buffer" />
          </StackPanel>
        </ScrollViewer>
        <TextBox Name="Source" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" FontFamily="monospace" FontSize="12" TextWrapping="NoWrap" Padding="16,12" Background="{DynamicResource DesignerCanvasBrush}" Foreground="#FFDFE8EE" BorderThickness="0" />
        <ScrollViewer Grid.Row="2" MaxHeight="130"><StackPanel Name="LanguageResults" Spacing="2" /></ScrollViewer>
      </Grid>
    </Grid>
    <GridSplitter Name="InspectorDivider" Grid.Column="3" Classes="designer-splitter" Width="5" Background="{DynamicResource DesignerBorderBrush}" />

    <Border Name="InspectorDock" Classes="designer-chrome" Grid.Column="4" Background="{DynamicResource DesignerPanelBrush}">
      <Grid RowDefinitions="36,*">
        <Border BorderBrush="{DynamicResource DesignerBorderBrush}" BorderThickness="0,0,0,1">
          <StackPanel Orientation="Horizontal" Spacing="2" Margin="8,0">
            <Button Name="CloseAuthoring" Classes="panel-tab active" Content="Design" ToolTip.Tip="Properties and layout" />
            <Button Name="StatesMode" Classes="panel-tab" Content="States" ToolTip.Tip="Visual states and transitions" />
            <Button Name="BehaviorsMode" Classes="panel-tab" Content="Behaviors" ToolTip.Tip="Triggers and actions" />
            <Button Name="DefinitionMode" Classes="panel-tab" Content="Definition" ToolTip.Tip="Inspect the selected component or resource" />
          </StackPanel>
        </Border>
        <Grid Name="InspectorDesignPane" Grid.Row="1" RowDefinitions="54,Auto,38,Auto,*">
          <Grid ColumnDefinitions="24,*" Margin="12,10,12,6">
            <PathIcon Classes="designer-icon" Name="SelectionIcon" Width="16" Height="16" VerticalAlignment="Top" Margin="0,3,0,0" Foreground="{DynamicResource DesignerAccentBrush}" Data="F1 M1,1 L17,1 17,17 1,17 Z M3,3 L3,15 15,15 15,3 Z" />
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Name="SelectionTitle" Text="Select an element" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Name="SelectionType" Text="Select on the canvas or in Layers" Foreground="{DynamicResource DesignerMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
          <ContentControl Name="ComponentInstanceHost" Grid.Row="1" HorizontalContentAlignment="Stretch" Margin="12,0,12,8" IsVisible="False" />
          <TextBox Name="PropertySearch" Grid.Row="2" PlaceholderText="Search properties" Margin="12,3,12,8" ToolTip.Tip="Filter properties · @modified for authored values">
            <TextBox.InnerLeftContent><PathIcon Classes="designer-icon" Width="12" Height="12" Margin="7,0,0,0" Foreground="{DynamicResource DesignerMutedBrush}" Data="F1 M8 1A7 7 0 1 1 8 15A7 7 0 1 1 8 1Z M8 3A5 5 0 1 0 8 13A5 5 0 1 0 8 3Z M12 11L19 18L17.6 19.4L10.6 12.4Z" /></TextBox.InnerLeftContent>
          </TextBox>
          <ContentControl Name="LayoutHost" Grid.Row="3" HorizontalContentAlignment="Stretch" Margin="8,0,8,6" />
          <ContentControl Name="PropertyHost" Grid.Row="4" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Margin="8,0,8,4" />
        </Grid>
        <ScrollViewer Name="AuthoringScroll" Grid.Row="1" IsVisible="False" Margin="12,12,12,8">
          <StackPanel Spacing="12">
            <TextBlock Name="InspectorModeTitle" Classes="designer-section-title" Text="Visual states" />
            <StackPanel Name="AuthoringPanel" Spacing="7" />
          </StackPanel>
        </ScrollViewer>
        <ContentControl Name="ComponentInspectorPane" Grid.Row="1" IsVisible="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
          <ContentControl Name="ComponentDefinitionHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </ContentControl>
      </Grid>
    </Border>
  </Grid>

  <GridSplitter Name="TimelineDivider" Classes="designer-splitter" Grid.Row="3" Height="5" Background="{DynamicResource DesignerBorderBrush}" />
  <Grid Name="TimelinePane" Classes="designer-chrome" Grid.Row="4" RowDefinitions="44,34,*,Auto,Auto" Background="{DynamicResource DesignerChromeBrush}">
    <Border Background="{DynamicResource DesignerPanelBrush}" BorderBrush="{DynamicResource DesignerBorderBrush}" BorderThickness="0,0,0,1" Padding="10,6">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
          <PathIcon Classes="designer-icon" Width="14" Height="14" Foreground="{DynamicResource DesignerMotionBrush}" Margin="2,0,4,0" Data="F1 M9,0 L18,9 9,18 0,9 Z M9,3 L3,9 9,15 15,9 Z" />
          <ComboBox Name="AnimationPrograms" Width="184" ToolTip.Tip="Active animation program" />
          <Button Name="NewAnimation" Classes="icon" ToolTip.Tip="New animation program"><PathIcon Classes="designer-icon" Width="14" Height="14" Data="F1 M7 1H9V7H15V9H9V15H7V9H1V7H7Z" /></Button>
          <Button Name="DuplicateAnimation" Classes="icon" ToolTip.Tip="Duplicate animation program">
            <PathIcon Classes="designer-icon" Width="14" Height="14" Data="F1 M1,1 L13,1 13,3 3,3 3,13 1,13 Z M5,5 L19,5 19,19 5,19 Z M7,7 L7,17 17,17 17,7 Z" />
          </Button>
          <Button Name="DeleteAnimation" Classes="icon" ToolTip.Tip="Delete animation program">
            <PathIcon Classes="designer-icon" Width="14" Height="14" Data="F1 M6,1 L14,1 14,3 19,3 19,5 1,5 1,3 6,3 Z M3,7 L17,7 16,19 4,19 Z M6,9 L7,17 8,17 7,9 Z M12,9 L11,17 13,17 14,9 Z" />
          </Button>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Button Name="Play" Classes="icon" ToolTip.Tip="Play or pause the active animation"><Grid><PathIcon Classes="designer-icon" Name="PlayIcon" Width="14" Height="14" Data="F1 M4,2 L17,10 4,18 Z" /><PathIcon Classes="designer-icon" Name="PauseIcon" Width="14" Height="14" IsVisible="False" Data="F1 M3,2 L7,2 7,18 3,18 Z M11,2 L15,2 15,18 11,18 Z" /></Grid></Button>
          <Button Name="Stop" Classes="icon" ToolTip.Tip="Stop playback and rewind"><PathIcon Classes="designer-icon" Width="12" Height="12" Data="F1 M2,2 L16,2 16,16 2,16 Z" /></Button>
          <Button Name="PlayAll" Classes="icon" ToolTip.Tip="Play all animation programs"><PathIcon Classes="designer-icon" Width="15" Height="15" Data="F1 M0,2 L10,9 0,16 Z M10,2 L20,9 10,16 Z" /></Button>
          <Border Width="1" Height="18" Background="{DynamicResource DesignerBorderBrush}" Margin="5,0" />
          <Button Name="Record" Classes="nav" ToolTip.Tip="Record property edits as keyframes">
            <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="7" Height="7" Fill="{DynamicResource DesignerRecordingBrush}" VerticalAlignment="Center" /><TextBlock Name="RecordLabel" Text="Record" FontSize="11" /></StackPanel>
          </Button>
          <Button Name="Keyframe" Classes="icon" ToolTip.Tip="Add a keyframe at the playhead"><PathIcon Classes="designer-icon" Width="16" Height="16" Foreground="{DynamicResource DesignerMotionBrush}" Data="F1 M7,0 L14,7 7,14 0,7 Z M7,3 L3,7 7,11 11,7 Z M15,10 L17,10 17,13 20,13 20,15 17,15 17,18 15,18 15,15 12,15 12,13 15,13 Z" /></Button>
          <Button Name="CommitAnimation" Classes="icon" ToolTip.Tip="Write active animation to document XAML"><PathIcon Classes="designer-icon" Width="14" Height="14" Data="F1 M2,1 L15,1 19,5 19,19 1,19 1,1 Z M4,2 L4,8 14,8 14,2 Z M5,12 L5,18 15,18 15,12 Z" /></Button>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <TextBox Name="Time" Classes="designer-clock" Text="0.00" Width="64" FontFamily="monospace" ToolTip.Tip="Playhead in seconds · Enter to seek" />
          <TextBlock Text="/" Classes="designer-muted" VerticalAlignment="Center" Margin="2,0" />
          <TextBox Name="Duration" Text="3" Width="48" ToolTip.Tip="Duration in seconds · Enter to apply" />
          <TextBlock Text="s" Classes="designer-muted" VerticalAlignment="Center" Margin="0,0,4,0" />
          <Button Name="TimelineDetails" Classes="icon" ToolTip.Tip="Animation name and target"><PathIcon Classes="designer-icon" Width="14" Height="14" Data="F1 M2,3 L18,3 18,5 2,5 Z M2,9 L13,9 13,11 2,11 Z M2,15 L10,15 10,17 2,17 Z M14,12 L16,14 12,18 10,18 10,16 Z" /></Button>
          <Button Name="AnimationSource" Classes="icon" ToolTip.Tip="Reveal the animation XAML"><PathIcon Classes="designer-icon" Width="15" Height="13" Data="F1 M6,1 L0,7 6,13 7,12 2,7 7,2 Z M14,1 L13,2 18,7 13,12 14,13 20,7 Z M11,0 L8,14 10,14 13,0 Z" /></Button>
          <Button Name="AnimationSettings" Classes="icon" ToolTip.Tip="Animation timing, repeat and direction"><PathIcon Classes="designer-icon" Width="15" Height="15" Data="F1 M0,4 L20,4 20,6 0,6 Z M0,14 L20,14 20,16 0,16 Z M4,1 L8,1 8,9 4,9 Z M12,11 L16,11 16,19 12,19 Z" /></Button>
        </StackPanel>
      </Grid>
    </Border>
    <ContentControl Name="TimelineRulerHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Margin="8,0" />
    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled"><StackPanel Name="Tracks" Spacing="1" Margin="8,0,8,4" /></ScrollViewer>
    <ContentControl Name="TimelineInspectorHost" Grid.Row="3" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Margin="8,0" />
    <Slider Name="Scrubber" IsVisible="False" Minimum="0" Maximum="3" Value="0" TickFrequency="0.1" IsSnapToTickEnabled="True" />
    <Border Name="AnimationDetails" Grid.Row="4" IsVisible="False" Background="{DynamicResource DesignerPanelBrush}" Padding="12,6" BorderBrush="{DynamicResource DesignerBorderBrush}" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Name" Classes="designer-muted" VerticalAlignment="Center" />
        <TextBox Name="AnimationName" Width="180" PlaceholderText="Animation name" />
        <Button Name="RenameAnimation" Content="Rename" />
        <TextBlock Text="Target" Classes="designer-muted" VerticalAlignment="Center" Margin="12,0,0,0" />
        <TextBox Name="AnimationSelector" Width="240" PlaceholderText="Type#Name selector" />
        <Button Name="SetAnimationSelector" Content="Apply target" />
      </StackPanel>
    </Border>
  </Grid>

  <ContentControl Name="SharingHost" Grid.Row="2" Grid.RowSpan="3" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
  <Border Classes="designer-chrome" Name="BuildDrawer" Grid.Row="2" Grid.RowSpan="3" IsVisible="False" VerticalAlignment="Bottom" Height="240" Background="{DynamicResource DesignerChromeBrush}" BorderBrush="{DynamicResource DesignerBorderBrush}" BorderThickness="0,1,0,0" Padding="12,6">
    <Grid RowDefinitions="36,*">
      <Grid ColumnDefinitions="*,Auto"><TextBlock Name="BuildStatus" Text="Build output" FontSize="13" VerticalAlignment="Center" /><Button Name="HideBuildOutput" Grid.Column="1" Classes="nav" Content="Close output" /></Grid>
      <TextBox Name="BuildOutput" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" FontFamily="monospace" FontSize="11" BorderThickness="0" Background="{DynamicResource DesignerCanvasBrush}" />
    </Grid>
  </Border>
  <Border Classes="designer-chrome" Grid.Row="5" Background="{DynamicResource DesignerChromeBrush}" BorderBrush="{DynamicResource DesignerBorderBrush}" BorderThickness="0,1,0,0" Padding="12,4">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Name="Status" Text="Ready" Foreground="{DynamicResource DesignerSecondaryBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Column="1" Text="FerroUI Studio" Foreground="{DynamicResource DesignerMutedBrush}" FontSize="10" Margin="12,0,0,0" />
    </Grid>
  </Border>
  <Border Classes="designer-chrome" Name="FilePrompt" Grid.RowSpan="6" Background="#A0000000" IsVisible="False">
    <Border Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#FF2B2B2B" BorderBrush="#FF494949" BorderThickness="1" Padding="24" CornerRadius="8">
      <StackPanel Spacing="18">
        <TextBlock Name="FilePromptTitle" Text="Open another document?" FontSize="20" FontWeight="Normal" />
        <TextBlock Name="FilePromptText" Text="Save the current document before opening another file." TextWrapping="Wrap" Foreground="#FFC6C6C6" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Name="SaveAndOpen" Classes="accent" Content="Save and open" />
          <Button Name="DiscardAndOpen" Content="Discard and open" />
          <Button Name="CancelOpen" Content="Cancel" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Border>

</Grid>

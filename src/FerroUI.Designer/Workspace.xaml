<Grid xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      RowDefinitions="48,40,*,5,220,26" Background="#FF1E2028">
  <Grid.Styles>
    <Style Selector=".designer-chrome Button">
      <Setter Property="Background" Value="#FF303746" />
      <Setter Property="Foreground" Value="#FFE1E8F6" />
      <Setter Property="BorderBrush" Value="#FF424D64" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector=".designer-chrome TextBox">
      <Setter Property="Background" Value="#FF1A1F2B" />
      <Setter Property="Foreground" Value="#FFE1E8F6" />
      <Setter Property="BorderBrush" Value="#FF3B465C" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="7,4" />
    </Style>
    <Style Selector=".designer-chrome ComboBox">
      <Setter Property="Background" Value="#FF1A1F2B" />
      <Setter Property="Foreground" Value="#FFE1E8F6" />
      <Setter Property="BorderBrush" Value="#FF3B465C" />
      <Setter Property="Padding" Value="7,4" />
    </Style>
    <Style Selector=".designer-chrome CheckBox">
      <Setter Property="Foreground" Value="#FFE1E8F6" />
    </Style>
  </Grid.Styles>
  <Border Background="#FF191B22" Padding="16,8">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
        <TextBlock Text="F" FontSize="24" FontWeight="Bold" Foreground="#FF8CA9FF" />
        <TextBlock Text="FerroUI  /  Designer Studio" FontSize="17" Foreground="#FFF0F2F8" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
        <TextBlock Name="PeerCount" Text="" Foreground="#FF9DBAD1" FontSize="11" />
        <TextBlock Name="DocumentTitle" Text="Untitled.xaml" Foreground="#FF9AA4B9" FontSize="11" />
      </StackPanel>
    </Grid>
  </Border>
  <Border Classes="designer-chrome" Grid.Row="1" Background="#FF252832" Padding="10,4">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal" Spacing="6">
      <Button Name="OpenFile" Content="Open" />
      <Button Name="OpenProject" Content="Solution" />
      <Button Name="SaveAll" Content="Save all" />
      <Button Name="Share" Content="Share" />
      <Button Name="SaveFile" Content="Save" />
      <Button Name="SaveFileAs" Content="Save as" />
      <Button Name="Undo" Content="Undo" />
      <Button Name="Redo" Content="Redo" />
      <Button Name="Delete" Content="Delete" />
      <Button Name="Duplicate" Content="Duplicate" />
      <Button Name="ZoomOut" Content="−" />
      <Button Name="ZoomReset" Content="100%" />
      <Button Name="ZoomIn" Content="+" />
      <Button Name="SelectTool" Content="Select" />
      <Button Name="PreviewTool" Content="Interact" />
      <Button Name="ApplySource" Content="Apply XAML" />
      <Button Name="SourceMode" Content="Source tree" />
      <Button Name="VisualMode" Content="Visual tree" />
      <Button Name="LogicalMode" Content="Logical tree" />
      <Button Name="PreviewTheme" Content="Light preview" />
      <Button Name="NativePreview" Content="Native window" />
    </StackPanel></ScrollViewer>
  </Border>
  <Grid Grid.Row="2" ColumnDefinitions="226,5,*,5,292">
    <Grid Classes="designer-chrome" RowDefinitions="Auto,128,Auto,*,Auto,170" Margin="8">
      <TextBlock Text="ASSETS" Foreground="#FF9AA4B9" Margin="6,10" FontSize="11" />
      <ScrollViewer Grid.Row="1"><WrapPanel Name="Assets" ItemWidth="92" ItemHeight="34" /></ScrollViewer>
      <TextBlock Grid.Row="2" Text="OBJECTS AND HIERARCHY" Foreground="#FF9AA4B9" Margin="6,12" FontSize="11" />
      <ScrollViewer Grid.Row="3"><StackPanel Name="Outline" Spacing="2" /></ScrollViewer>
      <StackPanel Grid.Row="4" Spacing="4" Margin="0,6">
        <TextBlock Text="SOLUTION" Foreground="#FF9AA4B9" FontSize="11" />
        <TextBox Name="ProjectPath" PlaceholderText="Folder or Cargo.toml path" />
        <WrapPanel><Button Name="CheckProject" Content="Check" /><Button Name="BuildProject" Content="Build" /><Button Name="RunProject" Content="Run" /><Button Name="CancelBuild" Content="Stop" /></WrapPanel>
        <ComboBox Name="RunTarget" PlaceholderText="Binary target" />
      </StackPanel>
      <ScrollViewer Grid.Row="5"><StackPanel Name="ProjectTree" Spacing="2" /></ScrollViewer>
    </Grid>
    <GridSplitter Grid.Column="1" Width="5" Background="#FF353947" />
    <Grid Grid.Column="2" RowDefinitions="30,*,5,245">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Name="DocumentTabs" Classes="designer-chrome" Orientation="Horizontal" Spacing="4" /></ScrollViewer>
      <ScrollViewer Grid.Row="1" Name="ArtboardScroll" Background="#FF15171E" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Border Padding="32"><LayoutTransformControl Name="ArtboardTransform"><Grid Name="Artboard" Width="800" Height="520" Background="White">
          <ThemeVariantScope Name="PreviewThemeScope" RequestedThemeVariant="Light"><ContentControl Name="Preview" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" /></ThemeVariantScope>
        </Grid></LayoutTransformControl></Border>
      </ScrollViewer>
      <GridSplitter Grid.Row="2" Height="5" Background="#FF353947" />
      <Grid Classes="designer-chrome" Grid.Row="3" RowDefinitions="30,*,Auto">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Name="SourcePosition" Text="XAML" Foreground="#FF9AA4B9" VerticalAlignment="Center" Margin="8,0" />
          <Button Name="CompleteSource" Content="Complete" /><Button Name="SourceDefinition" Content="Definition" /><Button Name="SourceReferences" Content="References" /><Button Name="SourceDiagnostics" Content="Problems" /><Button Name="FormatSource" Content="Format" />
          <TextBox Name="RenameSymbol" Width="110" PlaceholderText="New name" /><Button Name="RenameSource" Content="Rename" />
        </StackPanel></ScrollViewer>
        <TextBox Name="Source" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True"
                 FontFamily="monospace" FontSize="12" TextWrapping="NoWrap"
                 Background="#FF191B22" Foreground="#FFDBE5FA" BorderThickness="0" />
        <ScrollViewer Grid.Row="2" MaxHeight="110"><StackPanel Name="LanguageResults" Spacing="2" /></ScrollViewer>
      </Grid>
    </Grid>
    <GridSplitter Grid.Column="3" Width="5" Background="#FF353947" />
    <Grid Classes="designer-chrome" Grid.Column="4" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="10">
      <TextBlock Text="PROPERTIES" Foreground="#FF9AA4B9" Margin="4,10" FontSize="11" />
      <TextBlock Name="SelectionTitle" Grid.Row="1" Text="Select an element" Foreground="#FFDFE6F5" FontSize="15" Margin="4,4,4,12" />
      <TextBox Name="PropertySearch" Grid.Row="2" PlaceholderText="Search properties" Margin="2,0,2,10" />
      <ScrollViewer Grid.Row="3"><StackPanel Name="Properties" Spacing="7" /></ScrollViewer>
      <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="4"><Button Name="StatesMode" Content="States" /><Button Name="BehaviorsMode" Content="Behaviors" /><Button Name="CloseAuthoring" Content="Hide" /></StackPanel>
      <ScrollViewer Grid.Row="5" MaxHeight="300"><StackPanel Name="AuthoringPanel" Spacing="5" /></ScrollViewer>
    </Grid>
  </Grid>
  <GridSplitter Grid.Row="3" Height="5" Background="#FF353947" />
  <Grid Classes="designer-chrome" Grid.Row="4" RowDefinitions="30,36,28,*" Margin="12,4">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal" Spacing="5">
      <TextBlock Text="ANIMATIONS" Foreground="#FF9AA4B9" VerticalAlignment="Center" />
      <ComboBox Name="AnimationPrograms" Width="210" />
      <TextBox Name="AnimationName" Width="130" PlaceholderText="Program name" />
      <TextBox Name="AnimationSelector" Width="130" PlaceholderText="Selector" />
      <Button Name="NewAnimation" Content="New" /><Button Name="RenameAnimation" Content="Rename" /><Button Name="DuplicateAnimation" Content="Duplicate" /><Button Name="DeleteAnimation" Content="Delete" /><Button Name="SetAnimationSelector" Content="Target" />
      <Button Name="AnimationSource" Content="Source" /><Button Name="AnimationSettings" Content="Settings" />
    </StackPanel></ScrollViewer>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal" Spacing="6">
      <TextBlock Text="ANIMATION TIMELINE" Foreground="#FF9AA4B9" FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0" />
      <Button Name="Play" Content="Play" /><Button Name="PlayAll" Content="Play all" />
      <Button Name="Stop" Content="Stop" />
      <Button Name="Record" Content="Record off" />
      <Button Name="Keyframe" Content="Add keyframe" />
      <Button Name="CommitAnimation" Content="Write animation to XAML" />
      <TextBlock Text="Time" Foreground="#FF9AA4B9" VerticalAlignment="Center" />
      <TextBox Name="Time" Text="0" Width="70" />
      <TextBlock Text="Duration" Foreground="#FF9AA4B9" VerticalAlignment="Center" />
      <TextBox Name="Duration" Text="3" Width="70" />
    </StackPanel></ScrollViewer>
    <Slider Name="Scrubber" Grid.Row="2" Minimum="0" Maximum="3" Value="0" TickFrequency="0.1" IsSnapToTickEnabled="True" />
    <ScrollViewer Grid.Row="3"><StackPanel Name="Tracks" Spacing="4" /></ScrollViewer>
  </Grid>
  <ContentControl Name="SharingHost" Grid.Row="1" Grid.RowSpan="4" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
  <Border Classes="designer-chrome" Name="BuildDrawer" Grid.Row="2" Grid.RowSpan="3" IsVisible="False" VerticalAlignment="Bottom" Height="210" Background="#FF171D29" Padding="10">
    <Grid RowDefinitions="28,*"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Name="BuildStatus" Foreground="#FFDCE5F6" Text="Build output" /><Button Name="HideBuildOutput" Content="Hide output" /></StackPanel><TextBox Name="BuildOutput" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" FontFamily="monospace" FontSize="11" /></Grid>
  </Border>
  <Border Grid.Row="5" Background="#FF272F47" Padding="12,4">
    <TextBlock Name="Status" Text="Ready" Foreground="#FFD9E2FF" FontSize="11" />
  </Border>
  <Border Classes="designer-chrome" Name="FilePrompt" Grid.RowSpan="6" Background="#A0000000" IsVisible="False">
    <Border Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#FF252832" Padding="24" CornerRadius="8">
      <StackPanel Spacing="16">
        <TextBlock Name="FilePromptTitle" Text="Open another document?" FontSize="20" Foreground="White" />
        <TextBlock Name="FilePromptText" Text="Save the current document before opening another file." TextWrapping="Wrap" Foreground="#FFD0D9ED" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Name="SaveAndOpen" Content="Save and open" />
          <Button Name="DiscardAndOpen" Content="Discard and open" />
          <Button Name="CancelOpen" Content="Cancel" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Border>
</Grid>

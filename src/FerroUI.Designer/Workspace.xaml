<Grid xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      RowDefinitions="48,40,*,5,190,26" Background="#FF1E2028">
  <Grid.Styles>
    <Style Selector=".designer-chrome Button">
      <Setter Property="Background" Value="#FF303746" />
      <Setter Property="Foreground" Value="#FFE1E8F6" />
      <Setter Property="BorderBrush" Value="#FF424D64" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector=".designer-chrome TextBox">
      <Setter Property="Background" Value="#FF1A1F2B" />
      <Setter Property="Foreground" Value="#FFE1E8F6" />
      <Setter Property="BorderBrush" Value="#FF3B465C" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="7,4" />
    </Style>
    <Style Selector=".designer-chrome ComboBox">
      <Setter Property="Background" Value="#FF1A1F2B" />
      <Setter Property="Foreground" Value="#FFE1E8F6" />
      <Setter Property="BorderBrush" Value="#FF3B465C" />
      <Setter Property="Padding" Value="7,4" />
    </Style>
    <Style Selector=".designer-chrome CheckBox">
      <Setter Property="Foreground" Value="#FFE1E8F6" />
    </Style>
  </Grid.Styles>
  <Border Background="#FF191B22" Padding="16,8">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
        <TextBlock Text="F" FontSize="24" FontWeight="Bold" Foreground="#FF8CA9FF" />
        <TextBlock Text="FerroUI  /  Designer Studio" FontSize="17" Foreground="#FFF0F2F8" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
        <TextBlock Name="PeerCount" Text="" Foreground="#FF9DBAD1" FontSize="11" />
        <TextBlock Name="DocumentTitle" Text="Untitled.xaml" Foreground="#FF9AA4B9" FontSize="11" />
      </StackPanel>
    </Grid>
  </Border>
  <Border Classes="designer-chrome" Grid.Row="1" Background="#FF252832" Padding="10,4">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal" Spacing="6">
      <Button Name="OpenFile" Content="Open" />
      <Button Name="SaveFile" Content="Save" />
      <Button Name="SaveFileAs" Content="Save as" />
      <Button Name="Undo" Content="Undo" />
      <Button Name="Redo" Content="Redo" />
      <Button Name="Delete" Content="Delete" />
      <Button Name="Duplicate" Content="Duplicate" />
      <Button Name="ZoomOut" Content="−" />
      <Button Name="ZoomReset" Content="100%" />
      <Button Name="ZoomIn" Content="+" />
      <Button Name="SelectTool" Content="Select" />
      <Button Name="PreviewTool" Content="Interact" />
      <Button Name="ApplySource" Content="Apply XAML" />
      <Button Name="SourceMode" Content="Source tree" />
      <Button Name="VisualMode" Content="Visual tree" />
      <Button Name="LogicalMode" Content="Logical tree" />
      <Button Name="PreviewTheme" Content="Light preview" />
    </StackPanel></ScrollViewer>
  </Border>
  <Grid Grid.Row="2" ColumnDefinitions="226,5,*,5,292">
    <Grid Classes="designer-chrome" RowDefinitions="Auto,170,Auto,*" Margin="8">
      <TextBlock Text="ASSETS" Foreground="#FF9AA4B9" Margin="6,10" FontSize="11" />
      <ScrollViewer Grid.Row="1"><WrapPanel Name="Assets" ItemWidth="92" ItemHeight="34" /></ScrollViewer>
      <TextBlock Grid.Row="2" Text="OBJECTS AND HIERARCHY" Foreground="#FF9AA4B9" Margin="6,12" FontSize="11" />
      <ScrollViewer Grid.Row="3"><StackPanel Name="Outline" Spacing="2" /></ScrollViewer>
    </Grid>
    <GridSplitter Grid.Column="1" Width="5" Background="#FF353947" />
    <Grid Grid.Column="2" RowDefinitions="*,5,200">
      <ScrollViewer Name="ArtboardScroll" Background="#FF15171E" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Border Padding="32"><LayoutTransformControl Name="ArtboardTransform"><Grid Name="Artboard" Width="800" Height="520" Background="White">
          <ThemeVariantScope Name="PreviewThemeScope" RequestedThemeVariant="Light"><ContentControl Name="Preview" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" /></ThemeVariantScope>
        </Grid></LayoutTransformControl></Border>
      </ScrollViewer>
      <GridSplitter Grid.Row="1" Height="5" Background="#FF353947" />
      <Grid Classes="designer-chrome" Grid.Row="2" RowDefinitions="24,*">
        <TextBlock Text="XAML  ·  synchronized source" Foreground="#FF9AA4B9" Margin="12,4" FontSize="11" />
        <TextBox Name="Source" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True"
                 FontFamily="monospace" FontSize="12" TextWrapping="NoWrap"
                 Background="#FF191B22" Foreground="#FFDBE5FA" BorderThickness="0" />
      </Grid>
    </Grid>
    <GridSplitter Grid.Column="3" Width="5" Background="#FF353947" />
    <Grid Classes="designer-chrome" Grid.Column="4" RowDefinitions="Auto,Auto,Auto,*" Margin="10">
      <TextBlock Text="PROPERTIES" Foreground="#FF9AA4B9" Margin="4,10" FontSize="11" />
      <TextBlock Name="SelectionTitle" Grid.Row="1" Text="Select an element" Foreground="#FFDFE6F5" FontSize="15" Margin="4,4,4,12" />
      <TextBox Name="PropertySearch" Grid.Row="2" PlaceholderText="Search properties" Margin="2,0,2,10" />
      <ScrollViewer Grid.Row="3"><StackPanel Name="Properties" Spacing="7" /></ScrollViewer>
    </Grid>
  </Grid>
  <GridSplitter Grid.Row="3" Height="5" Background="#FF353947" />
  <Grid Classes="designer-chrome" Grid.Row="4" RowDefinitions="36,28,*" Margin="12,4">
    <StackPanel Orientation="Horizontal" Spacing="6">
      <TextBlock Text="ANIMATION TIMELINE" Foreground="#FF9AA4B9" FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0" />
      <Button Name="Play" Content="Play" />
      <Button Name="Stop" Content="Stop" />
      <Button Name="Record" Content="Record off" />
      <Button Name="Keyframe" Content="Add keyframe" />
      <Button Name="CommitAnimation" Content="Write animation to XAML" />
      <TextBlock Text="Time" Foreground="#FF9AA4B9" VerticalAlignment="Center" />
      <TextBox Name="Time" Text="0" Width="70" />
      <TextBlock Text="Duration" Foreground="#FF9AA4B9" VerticalAlignment="Center" />
      <TextBox Name="Duration" Text="3" Width="70" />
    </StackPanel>
    <Slider Name="Scrubber" Grid.Row="1" Minimum="0" Maximum="3" Value="0" TickFrequency="0.1" IsSnapToTickEnabled="True" />
    <ScrollViewer Grid.Row="2"><StackPanel Name="Tracks" Spacing="4" /></ScrollViewer>
  </Grid>
  <Border Grid.Row="5" Background="#FF272F47" Padding="12,4">
    <TextBlock Name="Status" Text="Ready" Foreground="#FFD9E2FF" FontSize="11" />
  </Border>
  <Border Classes="designer-chrome" Name="FilePrompt" Grid.RowSpan="6" Background="#A0000000" IsVisible="False">
    <Border Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#FF252832" Padding="24" CornerRadius="8">
      <StackPanel Spacing="16">
        <TextBlock Name="FilePromptTitle" Text="Open another document?" FontSize="20" Foreground="White" />
        <TextBlock Name="FilePromptText" Text="Save the current document before opening another file." TextWrapping="Wrap" Foreground="#FFD0D9ED" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Name="SaveAndOpen" Content="Save and open" />
          <Button Name="DiscardAndOpen" Content="Discard and open" />
          <Button Name="CancelOpen" Content="Cancel" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Border>
</Grid>

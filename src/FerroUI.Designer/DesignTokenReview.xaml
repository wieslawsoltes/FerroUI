<Grid xmlns="https://github.com/ferroui" RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource DesignerChromeBrush}">
  <Border Padding="12,8" BorderBrush="{DynamicResource DesignerBorderBrush}" BorderThickness="0,0,0,1">
    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
      <Button Name="ImportTokens" Classes="designer-icon-button" ToolTip.Tip="Open design tokens JSON" AutomationProperties.Name="Open design tokens JSON" />
      <Button Name="ExportTokens" Grid.Column="1" Classes="designer-icon-button" ToolTip.Tip="Export the active XAML dictionary" AutomationProperties.Name="Export the active XAML dictionary" />
      <TextBlock Name="TokenSource" Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <Button Name="SaveTokens" Grid.Column="3" Classes="designer-icon-button" IsEnabled="False" ToolTip.Tip="Create the reviewed file" AutomationProperties.Name="Create the reviewed file" />
    </Grid>
  </Border>
  <Border Name="MappingOptions" Grid.Row="1" Padding="12,8" BorderBrush="{DynamicResource DesignerBorderBrush}" BorderThickness="0,0,0,1" IsVisible="False">
    <Grid ColumnDefinitions="*,*,Auto,Auto,Auto" ColumnSpacing="6">
      <ComboBox Name="TokenEntry" AutomationProperties.Name="Select a token or resource" HorizontalAlignment="Stretch" />
      <TextBox Name="TokenMapping" Grid.Column="1" AutomationProperties.Name="Mapped key or token path" />
      <ComboBox Name="TokenRepresentation" Grid.Column="2" MinWidth="145" AutomationProperties.Name="Token representation" HorizontalAlignment="Stretch" />
      <TextBox Name="TokenScale" Grid.Column="3" MinWidth="115" PlaceholderText="Pixels per rem" AutomationProperties.Name="Logical pixels per rem" />
      <Button Name="ReviewMapping" Grid.Column="4" Classes="designer-icon-button" ToolTip.Tip="Update token review" AutomationProperties.Name="Update token review" />
    </Grid>
  </Border>
  <Grid Grid.Row="2" ColumnDefinitions="2*,3*" ColumnSpacing="10" Margin="12">
    <Grid RowDefinitions="Auto,*" RowSpacing="6">
      <TextBlock Text="Mappings" FontWeight="SemiBold" />
      <TextBox Name="TokenReport" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" AutomationProperties.Name="Token mappings and conversion issues" VerticalContentAlignment="Top" />
    </Grid>
    <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="6">
      <TextBlock Text="Generated source" FontWeight="SemiBold" />
      <TextBox Name="TokenOutput" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" FontFamily="monospace" FontSize="12" AutomationProperties.Name="Generated source" VerticalContentAlignment="Top" />
    </Grid>
  </Grid>
  <TextBlock Name="TokenStatus" Grid.Row="3" Margin="12,0,12,10" TextWrapping="Wrap" AutomationProperties.Name="Token review status" />
</Grid>

  "sources": {
    "core.rs": "use std::{any::Any,cell::Cell,hash::{Hash,Hasher},hint::black_box,marker::PhantomData,mem,ops::Deref,ptr::NonNull,rc::{Rc,Weak}};\n\n#[cfg(not(raw))] struct Carrier(Rc<dyn Any>);\n#[cfg(raw)] struct Carrier(NonNull<dyn Any>, PhantomData<Rc<dyn Any>>);\nimpl Carrier {\n    #[inline] fn new(x: Rc<dyn Any>) -> Self {\n        #[cfg(not(raw))] {Self(x)}\n        #[cfg(raw)] {Self(NonNull::new(Rc::into_raw(x).cast_mut()).unwrap(), PhantomData)}\n    }\n    #[inline] fn pointer(&self) -> *const dyn Any {\n        #[cfg(not(raw))] {Rc::as_ptr(&self.0)}\n        #[cfg(raw)] {self.0.as_ptr()}\n    }\n    #[inline] fn weak(&self) -> Weak<dyn Any> {\n        #[cfg(not(raw))] {Rc::downgrade(&self.0)}\n        #[cfg(raw)] {\n            let p=self.0.as_ptr();\n            // Add a separate owned reference for the temporary Rc, which drops normally.\n            unsafe{ Rc::increment_strong_count(p); Rc::downgrade(&Rc::from_raw(p)) }\n        }\n    }\n}\nimpl Clone for Carrier {\n    #[cfg_attr(shared,inline(never))] #[cfg_attr(not(shared),inline)]\n    fn clone(&self)->Self {\n        #[cfg(not(raw))] {Self(self.0.clone())}\n        #[cfg(raw)] {unsafe{Rc::increment_strong_count(self.0.as_ptr())} Self(self.0,PhantomData)}\n    }\n}\n#[cfg(raw)] impl Drop for Carrier {\n    #[cfg_attr(shared,inline(never))] #[cfg_attr(not(shared),inline)]\n    fn drop(&mut self){ unsafe{drop(Rc::from_raw(self.0.as_ptr()))} }\n}\n#[repr(transparent)] struct Handle<T:'static>(Carrier,PhantomData<T>);\nimpl<T:'static> Handle<T> {\n    fn make(x:T)->Self { Self(Carrier::new(Rc::new(x)),PhantomData) }\n    fn upcast(self)->Handle<Base> where T:BasePrefix { Handle(self.0, PhantomData) }\n    fn is_eq<U:'static>(&self,y:&Handle<U>)->bool {\n        #[cfg(identity)] { Rc::ptr_eq(&self.0.0, &y.0.0) }\n        #[cfg(not(identity))] { std::ptr::addr_eq(self.0.pointer(),y.0.pointer()) }\n    }\n    fn weak(&self)->Weak<dyn Any>{self.0.weak()}\n}\nimpl<T:'static> Clone for Handle<T>{#[inline] fn clone(&self)->Self {Handle(self.0.clone(),PhantomData)}}\nimpl<T:'static> Hash for Handle<T>{#[inline] fn hash<H:Hasher>(&self,s:&mut H){(self.0.pointer().cast::<()>() as usize).hash(s)}}\nimpl<T:'static> Deref for Handle<T>{type Target=T;#[inline] fn deref(&self)->&T{unsafe{&*self.0.pointer().cast::<T>()}}}\nfn upgrade(w:&Weak<dyn Any>)->Option<Handle<Base>> {w.upgrade().map(|x|Handle(Carrier::new(x),PhantomData))}\n#[repr(C)] struct Base{value:Cell<u64>,tag:usize}\nunsafe trait BasePrefix{} // Each implementing repr(C) object has Base as its first field.\nunsafe impl BasePrefix for Base{}\n#[repr(C)] struct Plain<const N:usize>{base:Base, extra:[u64;3]}\n#[repr(C,align(64))] struct Align<const N:usize>{base:Base, extra:[u64;3]}\nunsafe impl<const N:usize> BasePrefix for Plain<N>{}\nunsafe impl<const N:usize> BasePrefix for Align<N>{}\nfn base(n:usize)->Base{Base{value:Cell::new((n*13+7) as u64),tag:n}}\nfn plain<const N:usize>(n:usize)->Handle<Plain<N>> {Handle::make(Plain{base:base(n),extra:[3,5,7]})}\nfn align<const N:usize>(n:usize)->Handle<Align<N>> {Handle::make(Align{base:base(n),extra:[3,5,7]})}\n",
    "gen.py": "from pathlib import Path\nd=Path(__file__).resolve().parent\ndef ty(i): return 'Align' if i%2 else 'Plain'\ns=['#![allow(dead_code,unused_imports,private_interfaces)]','include!(\"core.rs\");']\n# Every slot is an externally addressable, concretely typed leaf that simulates a generated property\n# accessor. A per-owner field and conversion constant force concrete distinct endpoints.\nfor n in range(96):\n t=f'{ty(n)}<{n}>'\n s += [f'#[no_mangle] pub fn read_{n}(x:&Handle<{t}>)->u64{{x.base.value.get().wrapping_add(x.extra[{n%3}]) ^ {n}}}',\n       f'#[no_mangle] pub fn owned_{n}(x:&Handle<{t}>)->u64{{let y=black_box(x.clone());y.base.value.get().wrapping_add(y.extra[{n%3}]) ^ {n}}}',\n       f'#[no_mangle] pub fn eq_{n}(x:&Handle<{t}>,y:&Handle<Base>)->usize{{if x.is_eq(y) {{{n+1}}} else {{0}}}}']\n(d/'size.rs').write_text('\\n'.join(s)+'\\n')\n",
    "bench.rs": "#![allow(dead_code,unused_imports)]\ninclude!(\"core.rs\");\nuse std::{collections::hash_map::DefaultHasher,panic::{catch_unwind,AssertUnwindSafe}};\nfn digest<T:'static>(h:&Handle<T>)->u64 {let mut s=DefaultHasher::new();h.hash(&mut s);s.finish()}\nfn qa(){\n assert_eq!(mem::size_of::<Handle<Base>>(),2*mem::size_of::<usize>());assert_eq!(mem::size_of::<Option<Handle<Base>>>(),mem::size_of::<Handle<Base>>());\n let x=align::<1>(7);let addr=x.0.pointer().cast::<()>() as usize;assert_eq!(addr%64,0);\n let w=x.weak();assert_eq!(w.strong_count(),1);let y=x.clone().upcast();assert!(x.is_eq(&y));assert_eq!(digest(&x),digest(&y));\n drop(x);assert_eq!(w.strong_count(),1);assert!(upgrade(&w).unwrap().is_eq(&y));drop(y);assert!(upgrade(&w).is_none());\n struct Watch(Rc<Cell<usize>>);impl Drop for Watch{fn drop(&mut self){self.0.set(self.0.get()+1)}}\n #[repr(C,align(64))] struct P {base:Base,watch:Watch} unsafe impl BasePrefix for P {}\n let count=Rc::new(Cell::new(0));let h=Handle::make(P{base:base(17),watch:Watch(count.clone())}).upcast();let w=h.weak();\n let panic=catch_unwind(AssertUnwindSafe(move||{let _owned=h.clone();let _h=h;std::panic::panic_any(119u32)}));\n assert_eq!(*panic.unwrap_err().downcast::<u32>().unwrap(),119);assert!(upgrade(&w).is_none());assert_eq!(count.get(),1);\n}\n#[inline(never)] fn run(lane:usize,v:&[Handle<Base>],weak:&[Weak<dyn Any>],iterations:usize)->u64 {\n let mut acc=0u64;let len=v.len();\n macro_rules! bench {($step:expr)=>{for i in 0..iterations {let j=(i.wrapping_mul(40503)>>4)&(len-1);acc=acc.wrapping_add($step(j,i))}}}\n match lane {\n  0=>bench!(|j:usize,_|black_box(&v[j]).value.get()),\n  1=>bench!(|j:usize,_|{let x=black_box(v[j].clone());x.value.get()}),\n  2=>bench!(|j:usize,_|{let x=black_box(upgrade(black_box(&weak[j])).unwrap());x.value.get()}),\n  3=>bench!(|j:usize,i:usize|{let t=if i&1==0 {j}else{j.wrapping_add(1)&(len-1)};black_box(&v[j]).is_eq(black_box(&v[t]))as u64}),\n  4=>bench!(|j:usize,_|{let w=black_box(v[j].weak());let x=black_box(upgrade(&w).unwrap());x.value.get()}),\n  _=>unreachable!()\n };black_box(acc)\n}\n#[repr(C)]struct Timespec{secs:i64,nanos:i64}\nunsafe extern \"C\"{fn clock_gettime(clock:i32,ts:*mut Timespec)->i32;}\nfn clock()->i64{let mut t=Timespec{secs:0,nanos:0};assert_eq!(unsafe{clock_gettime(3,&mut t)},0);t.secs*1_000_000_000+t.nanos}\nfn main(){if std::env::args().nth(1).as_deref()==Some(\"qa\"){qa();return}\n let seed:usize=std::env::args().nth(1).unwrap().parse().unwrap();let n=1<<20;\n let v:Vec<_>=(0..512).map(|i|match i%4{0=>plain::<0>(i).upcast(),1=>align::<1>(i).upcast(),2=>plain::<2>(i).upcast(),_=>align::<3>(i).upcast()}).collect();\n let w:Vec<_>=v.iter().map(Handle::weak).collect();\n for k in 0..5 {let lane=(k+seed)%5;let a=clock();let checksum=run(lane,black_box(&v),black_box(&w),n);let dur=clock()-a;println!(\"{} {} {}\",lane,checksum,dur);}\n}\n"
  },

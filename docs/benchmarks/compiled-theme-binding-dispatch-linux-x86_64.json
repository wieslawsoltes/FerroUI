    "property_workload_source": "#![allow(dead_code)]\nuse ferroui_base::*;\nuse ferroui_base::data::BindingPriority;\nuse ferroui_base::reactive::{IObserver,LightweightSubject};\nuse std::rc::Rc;\nuse std::hint::black_box;\nuse std::time::Instant;\n#[repr(C)] struct Timespec { seconds:i64, nanos:i64 }\nunsafe extern \"C\" { fn clock_gettime(id:i32, ts:*mut Timespec) -> i32; }\nfn cpu_ns()->u64 { let mut t=Timespec { seconds:0, nanos:0 }; assert_eq!(unsafe { clock_gettime(3,&mut t) },0); t.seconds as u64*1_000_000_000 +t.nanos as u64 }\nmacro_rules! class {($n:ident,$b:ident)=>{ #[repr(C)]pub struct $n {base:$b} ferro_class!($n: $b); ferro_impl_classes!($n: FerroObjectImpl); impl $n {pub fn construct()->Self{Self {base:$b::construct()}}pub fn object()->Ref<FerroObject>{instantiate(Self::construct()).cast::<FerroObject>().unwrap()}} }}\nclass!(Node,FerroObject);class!(Branch,Node);class!(Leaf,Branch);class!(Sibling,Node);\nimpl Node {\n ferro_property!(fn plain() -> StyledProperty<i32> {FerroProperty::register::<Node,_>(\"Plain\",17)});\n ferro_property!(fn scoped() -> StyledProperty<i32> {FerroProperty::register_with::<Node,_>(\"Scoped\",StyledPropertyOptions::new(17).coerce(|_,n| n.max(0)))});\n ferro_property!(fn varied() -> StyledProperty<i32> {FerroProperty::register::<Node,_>(\"Varied\",17)});\n ferro_property!(fn local() -> StyledProperty<i32> {FerroProperty::register::<Node,_>(\"Local\",13)});\n}\n#[derive(Copy,Clone)]enum Lane{MetaPlain,MetaScoped,MetaOverride,GetPlain,GetOverride,GetMixedHost,GetEffective,MixedReadWrite,StyleInstallDispose,StyledBinding,Coercion}\nimpl Lane {\n fn name(self)->&'static str {match self {Self::MetaPlain=>\"metadata_default\",Self::MetaScoped=>\"metadata_scoped\",Self::MetaOverride=>\"metadata_cached_override\",Self::GetPlain=>\"get_plain\",Self::GetOverride=>\"get_derived_default\",Self::GetMixedHost=>\"get_mixed_hosts\",Self::GetEffective=>\"get_effective_local\",Self::MixedReadWrite=>\"mixed_75read_25write\", Self::StyleInstallDispose=>\"style_set_read_dispose\", Self::StyledBinding=>\"style_binding_emit_read\",Self::Coercion=>\"coerce_scoped_local\"}}\n}\nstruct Work {hosts:[Ref<FerroObject>;4],plain:&'static StyledProperty<i32>,scoped:&'static StyledProperty<i32>,varied:&'static StyledProperty<i32>,local:&'static StyledProperty<i32>}\nimpl Work {\n fn setup()->Self {let varied=Node::varied();varied.override_default_value::<Branch>(29);varied.override_default_value::<Sibling>(31);let hosts=[Node::object(),Branch::object(),Leaf::object(),Sibling::object()];for (i,h) in hosts.iter().enumerate() {h.set_value(Node::local(),100+i as i32);}\n Self {hosts,plain:Node::plain(),scoped:Node::scoped(),varied,local:Node::local()}}\n #[inline(never)] fn execute(&self,lane:Lane,steps:usize)->i64 {\n let order=black_box([2usize,2,1,0,2,3,2,1,0,3,2,1,3,2,2,0]);let mut sum=0i64;\n macro_rules! read {($code:expr)=>{{for i in 0..steps {sum+=black_box($code(i)) as i64;}}}}\n match lane {\n Lane::MetaPlain=> read!(|i:usize| *self.plain.get_metadata_for(black_box(&self.hosts[order[i&15]])).default_value()),\n Lane::MetaScoped=> read!(|i:usize| *self.scoped.get_metadata_for(black_box(&self.hosts[order[i&15]])).default_value()),\n Lane::MetaOverride=>read!(|_:usize| *self.varied.get_metadata_for(black_box(&self.hosts[2])).default_value()),\n Lane::GetPlain=> read!(|i:usize| black_box(&self.hosts[order[i&15]]).get_value(self.plain)),\n Lane::GetOverride=> read!(|_:usize| black_box(&self.hosts[2]).get_value(self.varied)),\n Lane::GetMixedHost=> read!(|i:usize| black_box(&self.hosts[order[i&15]]).get_value(self.varied)),\n Lane::GetEffective=> read!(|i:usize| black_box(&self.hosts[order[i&15]]).get_value(self.local)),\n Lane::StyleInstallDispose=> {\n   let host=black_box(&self.hosts[2]);\n   for i in 0..steps {\n     let slot=host.set_value_with_priority(self.varied,(i&1023) as i32,BindingPriority::Style).unwrap();\n     sum+=host.get_value(self.varied) as i64;\n     slot.dispose();\n     sum+=host.get_value(self.varied) as i64;\n   }\n }\n Lane::StyledBinding=> {\n   let host=black_box(&self.hosts[2]);\n   let source=Rc::new(LightweightSubject::<i32>::new());\n   let lease=host.bind(self.varied,source.clone(),BindingPriority::Style);\n   for i in 0..steps {source.on_next((i&1023) as i32);sum+=host.get_value(self.varied) as i64;}\n   lease.dispose();\n }\n Lane::Coercion=> {\n   let host=black_box(&self.hosts[2]);host.set_value(self.scoped,7);\n   for _ in 0..steps {host.coerce_value(self.scoped);sum+=host.get_value(self.scoped) as i64;}\n   host.clear_value(self.scoped);\n }\n Lane::MixedReadWrite=> {\n  for i in 0..steps {let host=black_box(&self.hosts[order[(i>>3)&15]]);match i&7 {\n    0=>{host.set_value(self.varied,(i&1023) as i32);},\n    1|2=>sum+=host.get_value(self.varied) as i64,\n    3=>host.clear_value(self.varied),\n    4=>sum+=host.get_value(self.plain) as i64,\n    5=>sum+=host.get_value(self.local) as i64,\n    _=>sum+=host.get_value(self.varied) as i64,\n  }}\n }\n }; sum\n }\n}\nfn main(){let round:usize=std::env::args().nth(1).unwrap().parse().unwrap();let n=200_000;ferroui_base::register_types(); assert!(black_box(TypeInfo::registered_types().len())>100);let w=Work::setup();let lanes=[Lane::MetaPlain,Lane::MetaScoped,Lane::MetaOverride,Lane::GetPlain,Lane::GetOverride,Lane::GetMixedHost,Lane::GetEffective,Lane::MixedReadWrite,Lane::StyleInstallDispose,Lane::StyledBinding,Lane::Coercion];\nfor off in 0..lanes.len(){let lane=lanes[(off+round)%lanes.len()];let n=if matches!(lane,Lane::StyleInstallDispose|Lane::StyledBinding|Lane::Coercion){20_000}else{n};black_box(w.execute(lane,n/25));let wall=Instant::now();let cpu=cpu_ns();let sum=w.execute(lane,n);let dt=cpu_ns()-cpu;println!(\"{} {} {} {} {}\",lane.name(),n,sum,dt,wall.elapsed().as_nanos());}}\n"

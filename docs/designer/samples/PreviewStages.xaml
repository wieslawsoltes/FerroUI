    <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource StageInk}" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource StageMuted}" /></Style>
    <Style Selector="Border.scenario">
      <Setter Property="Background" Value="{DynamicResource StageCard}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StageOutline}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="22" />
    </Style>
  </UserControl.Styles>
  <Grid Background="{DynamicResource StageBackground}" RowDefinitions="Auto,*,Auto"
        RowSpacing="20" Margin="0">
    <StackPanel Margin="24,24,24,0" Spacing="8">
      <TextBlock Classes="muted" Text="FERROUI / PREVIEW STAGES" FontSize="11" FontWeight="SemiBold" />
      <TextBlock Text="Project inbox" FontSize="28" FontWeight="SemiBold" />
      <TextBlock Classes="muted" Text="One view. Four states. A layout that follows its available space."
                 TextWrapping="Wrap" />
      <TextBox Name="SearchInput" PlaceholderText="Find a project" d:Text="Design review" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" Margin="24,0" HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <Grid>
        <Border Name="LoadingPanel" Classes="scenario" IsVisible="False">
          <StackPanel Spacing="14">
            <TextBlock Text="Loading your projects" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Classes="muted" Text="The loading state keeps the page structure stable."
                       TextWrapping="Wrap" />
            <ProgressBar Value="42" Maximum="100" Height="6" />
            <Border Height="12" CornerRadius="6" Background="{DynamicResource StageOutline}" />
            <Border Height="12" Width="160" HorizontalAlignment="Left" CornerRadius="6"
                    Background="{DynamicResource StageOutline}" />
          </StackPanel>
        </Border>
        <Border Name="EmptyPanel" Classes="scenario" IsVisible="False">
          <StackPanel Spacing="14">
            <TextBlock Text="A fresh start" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Classes="muted" Text="There are no projects here yet. Create a workspace when you are ready."
                       TextWrapping="Wrap" />
            <Button Content="Create workspace" Template="{StaticResource ActionPreviewTemplate}"
                    HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
        <Border Name="ContentPanel" Classes="scenario">
          <StackPanel Spacing="16">
            <TextBlock Text="Recent work" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Classes="muted" Text="Design-time data supplies these rows without changing the runtime binding."
                       TextWrapping="Wrap" />
            <ItemsControl Name="Results" ItemsSource="{Binding Results}"
                          d:ItemsSource="{d:SampleData ItemCount=3}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Padding="12" Margin="0,0,0,10" CornerRadius="8"
                          BorderBrush="{DynamicResource StageOutline}" BorderThickness="1">
                    <StackPanel Spacing="5">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Classes="muted" Text="{Binding Owner.Name}" FontSize="12" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Open workspace" Template="{StaticResource ActionPreviewTemplate}"
                    HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
        <Border Name="ErrorPanel" Classes="scenario" IsVisible="False">
          <StackPanel Spacing="14">
            <TextBlock Text="We could not load your projects" FontSize="20" FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock Classes="muted" Text="Check the connection and try again. Your saved work is still available."
                       TextWrapping="Wrap" />
            <Button Content="Try again" Template="{StaticResource ActionPreviewTemplate}"
                    HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>
    <TextBlock Grid.Row="2" Margin="24,0,24,22" Classes="muted" FontSize="11"
               Text="Use Select to reveal source. Use Live to try native text entry and controls."
               TextWrapping="Wrap" />
  </Grid>
</UserControl>


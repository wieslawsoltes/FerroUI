<UserControl xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" x:Name="PreviewScene"
             d:DesignWidth="390" d:DesignHeight="760">
  <!-- Open Preview stages, duplicate a stage, and choose the Screen group's
       Loading, Empty, Content and Error endpoints. Each card keeps its own native
       state and environment. The authored default is Content.
       Compare matrix can combine Screen states with sizes and themes. Try Fit
       content on ActionPreviewTemplate, drag a card's resize grip, and use Save
       preview image to export its native frame without designer chrome.
       This sample uses ordinary native styles and animations. Encoded comments
       retain the designer's state-group identity; they have no runtime behavior. -->
  <UserControl.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="StageAccent" Color="#FF6653D9" />
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="StageBackground" Color="#FFF3F4F8" />
          <SolidColorBrush x:Key="StageCard" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="StageInk" Color="#FF202433" />
          <SolidColorBrush x:Key="StageMuted" Color="#FF656B7D" />
          <SolidColorBrush x:Key="StageOutline" Color="#FFE0E3EC" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="StageBackground" Color="#FF171923" />
          <SolidColorBrush x:Key="StageCard" Color="#FF252936" />
          <SolidColorBrush x:Key="StageInk" Color="#FFF2F3FA" />
          <SolidColorBrush x:Key="StageMuted" Color="#FFB4BBCE" />
          <SolidColorBrush x:Key="StageOutline" Color="#FF3A4052" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <ControlTemplate x:Key="ActionPreviewTemplate" TargetType="Button">
        <Border Name="ActionFrame" Background="{DynamicResource StageAccent}"
                CornerRadius="8" Padding="16,10">
          <ContentPresenter Name="ActionContent" Content="{TemplateBinding Content}"
                            Foreground="White" HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="UserControl#PreviewScene">

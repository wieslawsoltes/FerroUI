+    result: SynchronousCompletionAsyncResult<T>,
+    map: impl FnOnce(T) -> U + 'static,
+) -> SynchronousCompletionAsyncResult<U> {
+    if result.is_completed() {
+        return SynchronousCompletionAsyncResult::new(map(result.get_result()));
+    }

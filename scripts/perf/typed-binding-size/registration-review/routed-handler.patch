+
+/// Compile-time selection for the common routed-event handler signature.
+#[doc(hidden)]
+pub struct RoutedMethodProbe<This, A, B>(std::marker::PhantomData<fn(&This, A, B)>);
+
+#[doc(hidden)]
+pub type MethodAdapter<This, A, B> =
+    fn(&[MarkupValue], fn(&This, A, B)) -> Result<MarkupValue, MarkupInvokeError>;
+
+type RoutedEvent = std::rc::Rc<dyn crate::interactivity::IRoutedEventArgs>;
+type Sender = Option<crate::BoxedValue>;
+
+impl<T: crate::ObjectType> RoutedMethodProbe<crate::Ref<T>, Sender, RoutedEvent> {
+    pub const ADAPTER: Option<MethodAdapter<crate::Ref<T>, Sender, RoutedEvent>> = Some(invoke_routed_handler::<T>);
+}
+
+#[inline(never)]
+fn invoke_routed_handler<T: crate::ObjectType>(
+    values: &[MarkupValue],
+    handler: fn(&crate::Ref<T>, Sender, RoutedEvent),
+) -> Result<MarkupValue, MarkupInvokeError> {
+    let mut arguments = MarkupArguments::new(values, 3)?;
+    let receiver = crate::__ferro_markup_receiver!(crate::Ref<T>, arguments)?;
+    handler(&receiver, arguments.next()?, arguments.next()?);
+    Ok(None)
+}
+
+#[doc(hidden)]
+pub trait RoutedMethodFallback<This, A, B> {
+    const ADAPTER: Option<MethodAdapter<This, A, B>> = None;
+}
+
+impl<This, A, B> RoutedMethodFallback<This, A, B> for RoutedMethodProbe<This, A, B> {}

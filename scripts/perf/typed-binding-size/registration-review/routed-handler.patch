+/// Specialize a two-parameter void closure only when its concrete receiver and
+/// arguments are the framework routed-handler types. Keep the original invoke
+/// function for user-defined receivers, other arguments and alias mismatches.
+#[doc(hidden)]
+#[macro_export]
+macro_rules! __ferro_markup_routed_method {
+    ($index:ident $this:ty; $name:ident ($a:ty, $b:ty) ($call:expr)) => { const {
+        let mut method = $crate::__ferro_markup_method!($index $this; [] [] $name ($a, $b) () ($call) []);
+        #[allow(unused_imports)]
+        use $crate::metadata::accessor::RoutedMethodFallback as _;
+        if $crate::metadata::accessor::RoutedMethodProbe::<$this, $a, $b>::ADAPTER.is_some() {
+            method.invoke = |arguments| {
+                let adapter = $crate::metadata::accessor::RoutedMethodProbe::<$this, $a, $b>::ADAPTER.unwrap();
+                adapter(arguments, |this, first, second| {
+                    let _ = ($call)(this, first, second);
+                })
+            };
+        }
+        method
+    }};
+}

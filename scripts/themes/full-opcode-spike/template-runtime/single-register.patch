     #[test]
+    fn single_register_is_checked_and_released_on_errors() {
+        let empty = ConstructionProgram { code: &[], imports: &[] };
+        assert!(empty.single(&[], None, None).is_err());
+        static ONE: ConstructionProgram = ConstructionProgram {
+            code: &[op::NEW, 0, op::BEGIN_INIT, 1, op::END_INIT, 1, 1, 1],
+            imports: &[ConstructionImport::New(|| Border::new().upcast())],
+        };
+        assert!(ONE.single(&[], None, None).unwrap().into_object::<Border>().is_ok());
+        thread_local! { static ORDER: std::cell::RefCell<Vec<i32>> = const { std::cell::RefCell::new(Vec::new()) }; }
+        struct Witness(i32);
+        impl Drop for Witness { fn drop(&mut self) { ORDER.with(|o| o.borrow_mut().push(self.0)); } }
+        static TWO: ConstructionProgram = ConstructionProgram {
+            code: &[op::CALL_RESULT, 0, 0, 0, 0, op::CALL_RESULT, 1, 0, 0, 0],
+            imports: &[
+                ConstructionImport::Call(|_| Ok(Some(ConstructionRegister::Value(Box::new(Witness(1)))))),
+                ConstructionImport::Call(|_| Ok(Some(ConstructionRegister::Value(Box::new(Witness(2)))))),
+            ],
+        };
+        assert!(TWO.single(&[], None, None).is_err());
+        ORDER.with(|o| assert_eq!(*o.borrow(), [2, 1]));
+    }

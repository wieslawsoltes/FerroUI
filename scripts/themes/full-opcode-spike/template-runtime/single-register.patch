+/// Generated programs with one result can keep it in their caller's stack frame.
+enum RegisterStorage<'a> {
+    Single(&'a mut Option<ConstructionRegister>),
+    Multiple(&'a mut Vec<ConstructionRegister>),
+}
+
+impl RegisterStorage<'_> {
+    fn as_slice(&self) -> &[ConstructionRegister] {
+        match self {
+            Self::Single(slot) => slot.as_slice(),
+            Self::Multiple(items) => items,
+        }
+    }
+
+    fn push(&mut self, value: ConstructionRegister) -> Result<(), XamlLoadError> {
+        match self {
+            Self::Single(slot) if slot.is_none() => **slot = Some(value),
+            Self::Single(_) => return Err(invalid()),
+            Self::Multiple(items) => items.push(value),
+        }
+        Ok(())
+    }
+}

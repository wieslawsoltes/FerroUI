{
  "//": "Project list shared by scripts/api-extract (upstream extractor) and scripts/port-status (Rust scanner).",
  "//path": "Upstream directory relative to the upstream checkout. A trailing /* expands to every sub-directory that contains a .csproj.",
  "//detail": "full = files + types + members; types = files + types only (backends that are out of the current scope); files = plain file list (non-C# sources).",
  "//rust": "FerroUI directory for the project. When omitted it is derived from the upstream path (Avalonia.X -> FerroUI.X).",
  "//phase": "Planning data shown in TRACKING.md. Edit freely; it does not affect scanning.",
  "preprocessorSymbols": ["NET", "NET6_0_OR_GREATER", "NET7_0_OR_GREATER", "NET8_0_OR_GREATER", "NET9_0_OR_GREATER", "NET10_0_OR_GREATER", "NETCOREAPP", "NETCOREAPP3_0_OR_GREATER", "NETCOREAPP3_1_OR_GREATER", "NET5_0_OR_GREATER"],
  "excludeDirs": ["bin", "obj", "node_modules", ".vs", "Generated", "generated"],
  "excludeFiles": ["*.g.cs", "*.g.i.cs", "*.generated.cs", "*.Generated.cs", "*.Designer.cs", "*.designer.cs", "*.AssemblyAttributes.cs"],
  "projects": [
    { "path": "src/Avalonia.Base", "detail": "full", "crate": "ferroui-base", "phase": "0 - core", "priority": "P0" },
    { "path": "src/Avalonia.Controls", "detail": "full", "crate": "ferroui-controls", "phase": "1 - controls", "priority": "P0" },
    { "path": "src/Avalonia.Controls.ColorPicker", "detail": "full", "crate": "ferroui-controls-color-picker", "phase": "3 - extras", "priority": "P2" },
    { "path": "src/Avalonia.Desktop", "detail": "full", "crate": "ferroui-desktop", "phase": "1 - desktop (macOS)", "priority": "P0" },
    { "path": "src/Avalonia.Dialogs", "detail": "full", "crate": "ferroui-dialogs", "phase": "3 - extras", "priority": "P3" },
    { "path": "src/Avalonia.Native", "detail": "full", "crate": "ferroui-native", "phase": "1 - desktop (macOS)", "priority": "P0",
      "idl": ["avn.idl"], "rustIdl": ["frn.idl"] },
    { "path": "native/Avalonia.Native", "detail": "files", "name": "Avalonia.Native (native sources)", "rust": "native/FerroUI.Native",
      "patterns": ["*.h", "*.mm", "*.m", "*.cpp", "*.c"], "crate": "(Objective-C++ sources built by ferroui-native)", "phase": "1 - desktop (macOS)", "priority": "P0" },
    { "path": "src/Avalonia.MicroCom", "detail": "full", "crate": "ferroui-microcom", "phase": "0 - core", "priority": "P0" },
    { "path": "src/Avalonia.OpenGL", "detail": "full", "crate": "ferroui-opengl", "phase": "2 - rendering backends", "priority": "P2" },
    { "path": "src/Avalonia.Metal", "detail": "full", "rust": "src/FerroUI.Metal", "crate": "ferroui-metal", "phase": "1 - desktop (macOS)", "priority": "P1" },
    { "path": "src/Avalonia.Themes.Fluent", "detail": "full", "crate": "ferroui-themes-fluent", "phase": "2 - xaml + themes", "priority": "P1",
      "extraFiles": [ { "label": "axaml", "patterns": ["*.axaml", "*.xaml"] } ] },
    { "path": "src/Avalonia.Themes.Simple", "detail": "full", "crate": "ferroui-themes-simple", "phase": "2 - xaml + themes", "priority": "P2",
      "extraFiles": [ { "label": "axaml", "patterns": ["*.axaml", "*.xaml"] } ] },
    { "path": "src/Markup/*", "detail": "full", "phase": "2 - xaml + themes", "priority": "P1" },
    { "path": "src/Skia/Avalonia.Skia", "detail": "full", "crate": "ferroui-skia", "phase": "1 - rendering", "priority": "P0" },
    { "path": "src/HarfBuzz/*", "detail": "full", "phase": "1 - rendering", "priority": "P0" },
    { "path": "src/Headless/*", "detail": "full", "phase": "1 - test infrastructure", "priority": "P1" },
    { "path": "src/Browser/Avalonia.Browser", "detail": "full", "crate": "ferroui-browser", "phase": "3 - browser", "priority": "P2",
      "extraFiles": [ { "label": "typescript", "patterns": ["*.ts", "*.js", "*.mjs", "*.json"] } ] },
    { "path": "src/Avalonia.Fonts.Inter", "detail": "full", "crate": "ferroui-fonts-inter", "phase": "3 - browser", "priority": "P2",
      "extraFiles": [ { "label": "fonts", "patterns": ["*.ttf", "*.otf"] } ] },
    { "path": "src/Avalonia.Remote.Protocol", "detail": "full", "crate": "ferroui-remote-protocol", "phase": "4 - tooling", "priority": "P3" },
    { "path": "src/Avalonia.DesignerSupport", "detail": "full", "crate": "ferroui-designer-support", "phase": "4 - tooling", "priority": "P3" },
    { "path": "src/Avalonia.Build.Tasks", "detail": "full", "crate": "ferroui-build", "phase": "2 - xaml + themes", "priority": "P1" },
    { "path": "src/tools/Avalonia.Generators", "detail": "full", "crate": "(merged into ferroui-build, see docs/porting/xaml.md)", "phase": "2 - xaml + themes", "priority": "P2" },
    { "path": "external/XamlX/src/XamlX", "detail": "full", "name": "XamlX", "rust": "external/XamlX/src/XamlX", "crate": "xamlx", "phase": "2 - xaml + themes", "priority": "P1" },

    { "path": "src/Windows/*", "detail": "types", "scope": "out", "phase": "not started / out of current scope", "priority": "-" },
    { "path": "src/Avalonia.X11", "detail": "types", "scope": "out", "phase": "not started / out of current scope", "priority": "-" },
    { "path": "src/Avalonia.FreeDesktop", "detail": "types", "scope": "out", "phase": "not started / out of current scope", "priority": "-" },
    { "path": "src/Avalonia.FreeDesktop.AtSpi", "detail": "types", "scope": "out", "phase": "not started / out of current scope", "priority": "-" },
    { "path": "src/Avalonia.Wayland", "detail": "types", "scope": "out", "phase": "not started / out of current scope", "priority": "-" },
    { "path": "src/Android/*", "detail": "types", "scope": "out", "phase": "not started / out of current scope", "priority": "-" },
    { "path": "src/iOS/*", "detail": "types", "scope": "out", "phase": "not started / out of current scope", "priority": "-" },
    { "path": "src/Linux/*", "detail": "types", "scope": "out", "phase": "not started / out of current scope", "priority": "-" },
    { "path": "src/Avalonia.Vulkan", "detail": "types", "scope": "out", "phase": "not started / out of current scope", "priority": "-" }
  ]
}

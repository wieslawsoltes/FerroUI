<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <!-- The algorithms and delegate backend compile directly from the pinned,
         unmodified source checkout. No native renderer or Uno is referenced. -->
    <Compile Include="$(PretextSource)/src/Pretext.Contracts/*.cs" />
    <Compile Include="$(PretextSource)/src/Pretext/*.cs" />
    <Compile Include="$(PretextSource)/src/Pretext/Generated/*.cs" />
    <Compile Include="$(PretextSource)/tests/Pretext.Uno.Tests/DelegateTextMeasurerFactory.cs" />
  </ItemGroup>
  <Target Name="RequireSource" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(PretextSource)/src/Pretext/PretextLayout.cs')"
           Text="Set PretextSource to the pinned PretextSharp checkout." />
  </Target>
</Project>

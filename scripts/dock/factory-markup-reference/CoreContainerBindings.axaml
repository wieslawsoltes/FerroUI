<StackPanel xmlns="https://github.com/avaloniaui"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:core="clr-namespace:Dock.Model.Core;assembly=Dock.Model"
 x:DataType="core:IDockItemContainerMetadata">
 <ContentControl Content="{Binding ItemContainerTheme}" />
 <TextBox Text="{Binding ItemTemplateSelector, Mode=TwoWay}" />
</StackPanel>

<StackPanel xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:m="clr-namespace:Dock.Model.Controls;assembly=Dock.Model" x:CompileBindings="True" x:DataType="m:IToolDock">
<TextBlock Text="{Binding ActiveDockable.Title}"/><CheckBox IsChecked="{Binding AutoHide, Mode=TwoWay}"/><Button Command="{Binding AddTool}" CommandParameter="{Binding DefaultDockable}"/>
</StackPanel>

<StackPanel xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:m="clr-namespace:Dock.Model.Controls;assembly=Dock.Model" x:CompileBindings="True" x:DataType="m:IMdiDocument">
<TextBox Text="{Binding Title, Mode=TwoWay}"/><TextBlock Text="{Binding MdiZIndex}"/><TextBlock Text="{Binding MdiState}"/>
</StackPanel>

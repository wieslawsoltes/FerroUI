<StackPanel xmlns="https://github.com/avaloniaui"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:core="clr-namespace:Dock.Model.Core;assembly=Dock.Model"
 x:DataType="core:IDock">
 <TextBlock Text="{Binding Title}" />
 <TextBlock Text="{Binding ActiveDockable.Title}" />
 <TextBlock Text="{Binding VisibleDockables.Count}" />
 <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay}" />
 <Button Command="{Binding Navigate}" CommandParameter="{Binding DefaultDockable}" />
</StackPanel>

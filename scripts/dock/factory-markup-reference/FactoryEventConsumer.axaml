<local:FactoryEventConsumer xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:DockFactoryMarkupReference"
    xmlns:models="clr-namespace:Dock.Model.ReactiveUI;assembly=Dock.Model.ReactiveUI">
  <local:FactoryEventConsumer.Factory>
    <models:Factory DockableClosing="OnClosing" />
  </local:FactoryEventConsumer.Factory>
</local:FactoryEventConsumer>

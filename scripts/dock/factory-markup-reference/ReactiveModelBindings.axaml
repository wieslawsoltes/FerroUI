<StackPanel xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:m="clr-namespace:Dock.Model.ReactiveUI.Controls;assembly=Dock.Model.ReactiveUI"
 x:CompileBindings="True" x:DataType="m:Document">
 <TextBlock Text="{Binding Title}" />
 <TextBox Text="{Binding Title, Mode=TwoWay}" />
 <CheckBox IsChecked="{Binding IsOpen, Mode=TwoWay}" />
</StackPanel>

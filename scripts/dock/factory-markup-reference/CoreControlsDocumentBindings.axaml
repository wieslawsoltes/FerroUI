<StackPanel xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:m="clr-namespace:Dock.Model.Controls;assembly=Dock.Model" x:CompileBindings="True" x:DataType="m:IDocumentDock">
<TextBox Text="{Binding Title, Mode=TwoWay}"/><ContentControl Content="{Binding EmptyContent}"/><CheckBox IsChecked="{Binding CanCreateDocument, Mode=TwoWay}"/><Button Command="{Binding AddDocument}" CommandParameter="{Binding DefaultDockable}"/>
</StackPanel>

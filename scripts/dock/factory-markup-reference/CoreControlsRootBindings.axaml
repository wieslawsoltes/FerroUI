<StackPanel xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:m="clr-namespace:Dock.Model.Controls;assembly=Dock.Model" x:CompileBindings="True" x:DataType="m:IRootDock">
<TextBlock Text="{Binding Title}"/><TextBlock Text="{Binding Windows.Count}"/><TextBlock Text="{Binding LeftPinnedDockables.Count}"/><CheckBox IsChecked="{Binding IsFocusableRoot, Mode=TwoWay}"/>
</StackPanel>

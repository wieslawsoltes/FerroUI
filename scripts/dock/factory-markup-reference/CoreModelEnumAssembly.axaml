<StackPanel xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:core="clr-namespace:Dock.Model.Core;assembly=Dock.Model">
 <ContentControl Content="{x:Static core:SplitViewDisplayMode.CompactOverlay}" />
 <ContentControl Content="{x:Static core:SplitViewPanePlacement.Bottom}" />
 <ContentControl Content="{x:Static core:Orientation.Vertical}" />
</StackPanel>

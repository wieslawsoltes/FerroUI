<StackPanel xmlns="https://github.com/avaloniaui"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:model="clr-namespace:Dock.Model.Controls;assembly=Dock.Model"
 x:DataType="model:IRootDock" x:CompileBindings="True">
 <TextBlock Text="{Binding Windows.Count}" />
 <ContentControl Content="{Binding Windows[0]}" />
 <ItemsControl ItemsSource="{Binding Windows}" />
</StackPanel>

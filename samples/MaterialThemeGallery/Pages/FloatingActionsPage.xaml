<UserControl xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:material="using:FerroUI.Themes.Material"
             x:Class="MaterialThemeGallery.Pages.FloatingActionsPage">
  <StackPanel Margin="24" Spacing="16">
    <StackPanel Spacing="4">
      <TextBlock Theme="{StaticResource MaterialHeadlineMedium}" Text="Make space for the action"/>
      <TextBlock Theme="{StaticResource MaterialBodyMedium}" Text="A clear label when you need it. A compact icon when you don't." TextWrapping="Wrap"/>
    </StackPanel>
    <WrapPanel ItemSpacing="8">
      <Button x:Name="ToggleExpanded" Content="Collapse labels" Theme="{StaticResource MaterialTonalButton}"/>
      <Button x:Name="ToggleDirection" Content="Reverse direction" Theme="{StaticResource MaterialOutlinedButton}"/>
    </WrapPanel>
    <ContentControl Theme="{StaticResource MaterialFilledCard}">
      <Grid x:Name="SizeExamples" ColumnDefinitions="72,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
        <TextBlock Text="Small" Theme="{StaticResource MaterialLabelLarge}" VerticalAlignment="Center"/>
        <material:MaterialExtendedFab x:Name="SmallFab" Grid.Column="1" Content="Compose" SizeVariant="Small">
          <material:MaterialExtendedFab.Icon><PathIcon Theme="{StaticResource MaterialSymbolIcon}" FlowDirection="LeftToRight" Width="24" Height="24" Data="M11,5 L13,5 L13,11 L19,11 L19,13 L13,13 L13,19 L11,19 L11,13 L5,13 L5,11 L11,11 Z"/></material:MaterialExtendedFab.Icon>
        </material:MaterialExtendedFab>
        <TextBlock Grid.Row="1" Text="Medium" Theme="{StaticResource MaterialLabelLarge}" VerticalAlignment="Center"/>
        <material:MaterialExtendedFab x:Name="MediumFab" Grid.Row="1" Grid.Column="1" Content="Compose" SizeVariant="Medium">
          <material:MaterialExtendedFab.Icon><PathIcon Theme="{StaticResource MaterialSymbolIcon}" FlowDirection="LeftToRight" Width="28" Height="28" Data="M11,5 L13,5 L13,11 L19,11 L19,13 L13,13 L13,19 L11,19 L11,13 L5,13 L5,11 L11,11 Z"/></material:MaterialExtendedFab.Icon>
        </material:MaterialExtendedFab>
        <TextBlock Grid.Row="2" Text="Large" Theme="{StaticResource MaterialLabelLarge}" VerticalAlignment="Center"/>
        <material:MaterialExtendedFab x:Name="LargeFab" Grid.Row="2" Grid.Column="1" Content="Compose" SizeVariant="Large">
          <material:MaterialExtendedFab.Icon><PathIcon Theme="{StaticResource MaterialSymbolIcon}" FlowDirection="LeftToRight" Width="36" Height="36" Data="M11,5 L13,5 L13,11 L19,11 L19,13 L13,13 L13,19 L11,19 L11,13 L5,13 L5,11 L11,11 Z"/></material:MaterialExtendedFab.Icon>
        </material:MaterialExtendedFab>
      </Grid>
    </ContentControl>
    <ContentControl Theme="{StaticResource MaterialOutlinedCard}">
      <StackPanel Spacing="12">
        <TextBlock Text="Choose your color" Theme="{StaticResource MaterialTitleMedium}"/>
        <WrapPanel ItemSpacing="12" LineSpacing="12">
          <material:MaterialExtendedFab x:Name="SecondaryFab" Content="Share" Background="{DynamicResource MaterialSecondaryContainerBrush}"
                                        Foreground="{DynamicResource MaterialOnSecondaryContainerBrush}">
            <material:MaterialExtendedFab.Icon><PathIcon Theme="{StaticResource MaterialSymbolIcon}" FlowDirection="LeftToRight" Width="24" Height="24" Data="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92 1.61 0 2.92-1.31 2.92-2.92s-1.31-2.92-2.92-2.92z"/></material:MaterialExtendedFab.Icon>
          </material:MaterialExtendedFab>
          <material:MaterialExtendedFab x:Name="TertiaryFab" Content="Create" Background="{DynamicResource MaterialTertiaryContainerBrush}"
                                        Foreground="{DynamicResource MaterialOnTertiaryContainerBrush}">
            <material:MaterialExtendedFab.Icon><PathIcon Theme="{StaticResource MaterialSymbolIcon}" FlowDirection="LeftToRight" Width="24" Height="24" Data="M11,5 L13,5 L13,11 L19,11 L19,13 L13,13 L13,19 L11,19 L11,13 L5,13 L5,11 L11,11 Z"/></material:MaterialExtendedFab.Icon>
          </material:MaterialExtendedFab>
          <material:MaterialExtendedFab Content="Unavailable" IsEnabled="False" IsExpanded="False" AutomationProperties.Name="Unavailable action">
            <material:MaterialExtendedFab.Icon><PathIcon Theme="{StaticResource MaterialSymbolIcon}" FlowDirection="LeftToRight" Width="24" Height="24" Data="M11,5 L13,5 L13,11 L19,11 L19,13 L13,13 L13,19 L11,19 L11,13 L5,13 L5,11 L11,11 Z"/></material:MaterialExtendedFab.Icon>
          </material:MaterialExtendedFab>
        </WrapPanel>
      </StackPanel>
    </ContentControl>
    <ContentControl Theme="{StaticResource MaterialFilledCard}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="Right-to-left" Theme="{StaticResource MaterialTitleMedium}"/>
          <TextBlock Text="The icon stays at the start." Theme="{StaticResource MaterialBodyMedium}" TextWrapping="Wrap"/>
        </StackPanel>
        <material:MaterialExtendedFab x:Name="RtlFab" Grid.Column="1" Content="New note" FlowDirection="RightToLeft">
          <material:MaterialExtendedFab.Icon><PathIcon Theme="{StaticResource MaterialSymbolIcon}" FlowDirection="LeftToRight" Width="24" Height="24" Data="M11,5 L13,5 L13,11 L19,11 L19,13 L13,13 L13,19 L11,19 L11,13 L5,13 L5,11 L11,11 Z"/></material:MaterialExtendedFab.Icon>
        </material:MaterialExtendedFab>
      </Grid>
    </ContentControl>
    <TextBlock x:Name="ActionStatus" Text="Choose an action to try it." Theme="{StaticResource MaterialBodyMedium}"
               AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource MaterialOnSurfaceVariantBrush}"/>
  </StackPanel>
</UserControl>

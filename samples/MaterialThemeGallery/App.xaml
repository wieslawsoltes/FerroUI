<Application xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Name="Material theme gallery"
             x:Class="MaterialThemeGallery.App">
  <!-- The theme is added by the class of the document (app.rs), before these styles: its use is
       in one place, theme.rs. These styles are the window's own; the pages set what they show
       on the elements themselves, as their native counterparts do. -->
  <Application.Styles>
    <Style Selector="TextBlock.toolbar-label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style Selector="ComboBox.toolbar-choice">
      <Setter Property="MinWidth" Value="140" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Application.Styles>
</Application>

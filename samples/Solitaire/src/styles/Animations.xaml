<Styles xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <GradientStops x:Key="GoldBrush">
      <GradientStop Offset="0" Color="#FFFCFC80" />
      <GradientStop Offset="0.06861601" Color="#FFD09C14" />
      <GradientStop Offset="0.13723001" Color="#FFFCFC80" />
      <GradientStop Offset="0.2105" Color="#FFD09C14" />
      <GradientStop Offset="0.28178003" Color="#FFFCFC80" />
      <GradientStop Offset="0.36184004" Color="#FFD09C14" />
      <GradientStop Offset="0.45447004" Color="#FFFCFC80" />
      <GradientStop Offset="0.51927006" Color="#FFD09C14" />
      <GradientStop Offset="0.62017" Color="#FFFCFC80" />
      <GradientStop Offset="0.69228" Color="#FFD09C14" />
      <GradientStop Offset="0.78029996" Color="#FFFCFC80" />
      <GradientStop Offset="0.85488003" Color="#FFD09C14" />
      <GradientStop Offset="0.94064" Color="#FFFCFC80" />
      <GradientStop Offset="1" Color="#FFD09C14" />
    </GradientStops>
  </Styles.Resources>
  <Style Selector="Panel.mainContent">
    <Style.Animations>
      <Animation Duration="0:0:2.5" Easing="QuadraticEaseInOut" FillMode="Both">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Border.tray">
    <Style.Animations>
      <Animation Duration="0:1:0" IterationCount="Infinite" PlaybackDirection="Alternate">
        <KeyFrame Cue="0%">
          <Setter Property="BorderBrush">
            <LinearGradientBrush StartPoint="-1000,1000" EndPoint="1000,0" GradientStops="{StaticResource GoldBrush}" Transform="rotate(120deg)" />
          </Setter>
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="BorderBrush">
            <LinearGradientBrush StartPoint="-2000,1000" EndPoint="0,-1000" GradientStops="{StaticResource GoldBrush}" />
          </Setter>
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Border.downDeck">
    <Setter Property="RenderTransform" Value="translateY(70px)" />
    <Setter Property="Transitions">
      <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.downDeck.animateUp"><Setter Property="RenderTransform" Value="translateY(0px)" /></Style>
</Styles>

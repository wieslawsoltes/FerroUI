<UserControl xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Viewbox Margin="28" MaxWidth="550" StretchDirection="DownOnly">
    <StackPanel Width="400" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Image x:Name="SolitaireGlyph" Height="85" Margin="50,0" />
      <TextBlock Text="SOLITAIRE" FontFamily="fonts:Solitaire#Quentell CF" FontWeight="Bold" FontSize="62" Foreground="White" HorizontalAlignment="Center" />
      <TextBlock Text="Built with FerroUI · Rust" Foreground="#DDEBDD" FontSize="18" HorizontalAlignment="Center" Margin="0,-10,0,12" />
      <Border x:Name="Tray" Classes="tray downDeck" Background="#DF102419" BorderBrush="#D6B34B" BorderThickness="2" CornerRadius="10" Padding="22">
        <StackPanel Spacing="12">
          <Button x:Name="Klondike" Classes="casino" Content="Klondike" HorizontalAlignment="Stretch" />
          <Button x:Name="FreeCell" Classes="casino" Content="FreeCell" HorizontalAlignment="Stretch" />
          <Button x:Name="Spider" Classes="casino" Content="Spider" HorizontalAlignment="Stretch" />
          <Border Background="#D6B34B" Height="1" Margin="8" />
          <Button x:Name="Statistics" Classes="casino" Content="Statistics" HorizontalAlignment="Stretch" />
          <Button x:Name="Settings" Classes="casino" Content="Settings" HorizontalAlignment="Stretch" />
        </StackPanel>
      </Border>
    </StackPanel>
  </Viewbox>
</UserControl>

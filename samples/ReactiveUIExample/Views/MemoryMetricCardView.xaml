<rxui:ReactiveUserControlBase xmlns="https://github.com/ferroui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:rxui="using:ReactiveUI.FerroUI"
                              xmlns:vm="using:ReactiveUIExample.ViewModels"
                              x:Class="ReactiveUIExample.Views.MemoryMetricCardView"
                              x:DataType="vm:MetricCardViewModel">
  <Border Classes="panel"
          BorderBrush="#D1FAE5"
          Background="#ECFDF5">
    <StackPanel Spacing="8">
      <TextBlock Classes="eyebrow" Text="{Binding Title}" />
      <TextBlock Classes="metricValue" Text="{Binding Value}" />
      <TextBlock Classes="subtitle" Text="{Binding Caption}" />
    </StackPanel>
  </Border>
</rxui:ReactiveUserControlBase>

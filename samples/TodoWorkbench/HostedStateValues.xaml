                    <TextBlock Text="Renewal review" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Waiting for an account owner" FontSize="15" Foreground="#D7E7FC"/>
                </StackPanel>
            </Border>
        </StackPanel>
        <Border Name="ApprovalWidth" IsVisible="False" Width="528"/>
    </Canvas>
</Window>

<UserControl x:Class="BehaviorsGallery.Views.Pages.ScrollChangedTriggerView"
             xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BehaviorsGallery.ViewModels"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="250">
  <!-- Ported from Views/Pages/ScrollChangedTriggerView of the reference sample. -->
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>
  <StackPanel Spacing="10">
    <ScrollViewer Height="150">
      <Interaction.Behaviors>
        <ScrollChangedTrigger>
          <ChangePropertyAction TargetObject="InfoText" PropertyName="Text" Value="Scrolled" />
        </ScrollChangedTrigger>
      </Interaction.Behaviors>
      <StackPanel>
        <Border Height="200" Background="LightGray" />
        <Border Height="200" Background="LightGray" />
        <Border Height="200" Background="LightGray" />
      </StackPanel>
    </ScrollViewer>
    <TextBlock x:Name="InfoText" Text="Scroll inside viewer" />
  </StackPanel>
</UserControl>

<UserControl x:Class="BehaviorsGallery.Views.Pages.InitializedBehaviorView"
             xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BehaviorsGallery.ViewModels"
             xmlns:b="using:BehaviorsGallery.Behaviors"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="120">
  <!-- Ported from Views/Pages/InitializedBehaviorView of the reference sample. -->
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>
  <StackPanel Spacing="5">
    <Border x:Name="Target" Background="LightGray" Padding="20">
      <Interaction.Behaviors>
        <b:InitializedMessageBehavior Target="{Binding #MessageText}" />
      </Interaction.Behaviors>
      <TextBlock Text="Target" />
    </Border>
    <TextBlock x:Name="MessageText" />
  </StackPanel>
</UserControl>

<UserControl x:Class="BehaviorsGallery.Views.Pages.DragLeaveEventTriggerView"
             xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:BehaviorsGallery.Views.Pages"
             x:DataType="local:DragLeaveEventTriggerView"
             mc:Ignorable="d"
             d:DesignWidth="360"
             d:DesignHeight="300">
  <!-- Ported from Views/Pages/DragLeaveEventTriggerView of the reference sample. -->
  <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
    <TextBlock Text="Start a drag, move it over the drop zone, then leave to fire DragLeaveEventTrigger." TextWrapping="Wrap" />
    <Button Grid.Row="1" Content="Start drag" HorizontalAlignment="Left" PointerPressed="OnStartDrag" />
    <Border Grid.Row="2"
            x:Name="DropZone"
            DragDrop.AllowDrop="True"
            Background="Lavender"
            BorderBrush="Purple"
            BorderThickness="1"
            CornerRadius="6"
            Padding="24">
      <Interaction.Behaviors>
        <DragLeaveEventTrigger>
          <CallMethodAction TargetObject="{Binding}" MethodName="OnDragLeave" />
        </DragLeaveEventTrigger>
      </Interaction.Behaviors>
      <TextBlock Text="Drag over this area, then leave" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
    </Border>
    <ListBox Grid.Row="3" ItemsSource="{Binding Events}" Height="100" />
  </Grid>
</UserControl>

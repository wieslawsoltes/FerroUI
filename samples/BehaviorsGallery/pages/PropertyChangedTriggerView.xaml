<UserControl x:Class="BehaviorsGallery.Views.Pages.PropertyChangedTriggerView"
             xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BehaviorsGallery.ViewModels"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450">
  <!-- Ported from Views/Pages/PropertyChangedTriggerView of the reference sample. -->
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>
  <StackPanel>
    <TextBox Text="{Binding MyString}" Margin="0,0,0,8" />
    <TextBlock Name="CountText" Text="{Binding Count}" HorizontalAlignment="Center">
      <Interaction.Behaviors>
        <PropertyChangedTrigger Binding="{Binding MyString}">
          <CallMethodAction TargetObject="{Binding}" MethodName="IncrementCount" />
        </PropertyChangedTrigger>
      </Interaction.Behaviors>
    </TextBlock>
  </StackPanel>
</UserControl>

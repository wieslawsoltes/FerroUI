<UserControl x:Class="BehaviorsGallery.Views.Pages.DataContextChangedTriggerView"
             xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BehaviorsGallery.ViewModels"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="100">
  <!-- Ported from Views/Pages/DataContextChangedTriggerView of the reference sample. -->
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>
  <TextBlock x:Name="MessageText" Text="Waiting" />
  <Interaction.Behaviors>
    <DataContextChangedTrigger>
      <ChangePropertyAction TargetObject="MessageText" PropertyName="Text" Value="Changed" />
    </DataContextChangedTrigger>
  </Interaction.Behaviors>
</UserControl>

<UserControl xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BehaviorsGallery.Views.Pages.BreakActionView">
  <!-- Ported from Views/Pages/BreakActionView of the reference sample. -->
    <StackPanel Spacing="10">
        <TextBlock Text="BreakAction" FontWeight="Bold" />
        <Button Content="Trigger Debug Break">
            <Interaction.Behaviors>
                <EventTriggerBehavior EventName="Click">
                    <BreakAction />
                </EventTriggerBehavior>
            </Interaction.Behaviors>
        </Button>
    </StackPanel>
</UserControl>

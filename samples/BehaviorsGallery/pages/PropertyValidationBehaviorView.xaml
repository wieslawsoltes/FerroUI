<UserControl x:Class="BehaviorsGallery.Views.Pages.PropertyValidationBehaviorView"
             xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BehaviorsGallery.ViewModels"
             xmlns:custom="using:FerroUI.Xaml.Interactions.Custom"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d"
             d:DesignWidth="500"
             d:DesignHeight="300">
  <!-- Ported from Views/Pages/PropertyValidationBehaviorView of the reference sample. -->
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <StackPanel Spacing="12" Margin="16">
    <TextBlock Text="PropertyValidationBehavior applies rules to a FerroUI property and surfaces IsValid/Error values." TextWrapping="Wrap" />
    <TextBox Width="260" PlaceholderText="Enter at least 3 characters" Text="{Binding ValidatedText}">
      <Interaction.Behaviors>
        <!-- Deviation (DEVIATIONS.md, Behaviors gallery): no x:TypeArguments="TextBox, sys:String". Markup cannot give a class
             of the object model type arguments; the behavior markup creates validates the property of
             any associated object whatever the type of its value (DEVIATIONS.md, Behaviors). -->
        <custom:PropertyValidationBehavior Property="{x:Static TextBox.TextProperty}"
                                           IsValid="{Binding IsTextValid, Mode=TwoWay}"
                                           Error="{Binding TextValidationError, Mode=TwoWay}">
          <custom:RequiredTextValidationRule ErrorMessage="Value is required." />
          <custom:MinLengthValidationRule Length="3" ErrorMessage="Minimum length is 3." />
        </custom:PropertyValidationBehavior>
      </Interaction.Behaviors>
    </TextBox>
    <CheckBox Content="Is valid" IsChecked="{Binding IsTextValid}" IsEnabled="False" />
    <Border Background="{DynamicResource ThemeBackgroundBrush}"
            BorderBrush="{DynamicResource ThemeBorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="8">
      <TextBlock Text="{Binding TextValidationError}" Foreground="{DynamicResource SystemAccentColor}" TextWrapping="Wrap" />
    </Border>
  </StackPanel>
</UserControl>

<UserControl x:Class="BehaviorsGallery.Views.Pages.FadeInBehaviorView"
             xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BehaviorsGallery.ViewModels"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="200">
  <!-- Ported from Views/Pages/FadeInBehaviorView of the reference sample. -->
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>
  <Border Background="SteelBlue" Width="100" Height="100">
    <Interaction.Behaviors>
      <FadeInBehavior Duration="0:0:1" InitialDelay="0:0:0.5" />
    </Interaction.Behaviors>
  </Border>
</UserControl>

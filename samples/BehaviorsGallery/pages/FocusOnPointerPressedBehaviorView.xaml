<UserControl x:Class="BehaviorsGallery.Views.Pages.FocusOnPointerPressedBehaviorView"
             xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BehaviorsGallery.ViewModels"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="120">
  <!-- Ported from Views/Pages/FocusOnPointerPressedBehaviorView of the reference sample. -->
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>
  <TextBox Text="Press pointer to focus" Width="200">
    <Interaction.Behaviors>
      <FocusOnPointerPressedBehavior />
    </Interaction.Behaviors>
  </TextBox>
</UserControl>

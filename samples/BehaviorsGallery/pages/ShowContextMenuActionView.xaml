<UserControl x:Class="BehaviorsGallery.Views.Pages.ShowContextMenuActionView"
             xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BehaviorsGallery.ViewModels"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450">
  <!-- Ported from Views/Pages/ShowContextMenuActionView of the reference sample. -->
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>
  <Button x:Name="Target" Content="Open Context Menu" Margin="5">
    <Button.ContextMenu>
      <ContextMenu>
        <MenuItem Header="Item 1" />
        <MenuItem Header="Item 2" />
      </ContextMenu>
    </Button.ContextMenu>
    <Interaction.Behaviors>
      <EventTriggerBehavior EventName="Click">
        <ShowContextMenuAction />
      </EventTriggerBehavior>
    </Interaction.Behaviors>
  </Button>
</UserControl>

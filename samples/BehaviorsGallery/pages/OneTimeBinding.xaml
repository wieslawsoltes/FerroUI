<UserControl x:Class="BehaviorsGallery.Views.Pages.OneTimeBinding"
             xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BehaviorsGallery.ViewModels"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="450">
  <!-- Ported from Views/Pages/OneTimeBinding of the reference sample. -->
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <Carousel ItemsSource="{Binding Items, Mode=OneTime}">
    <Carousel.DataTemplates>
      <DataTemplate DataType="vm:ItemViewModel">
        <Border Width="200"
                Height="200"
                Background="LightGray"
                Name="Border">
          <TextBlock
            Text="{Binding Value, Mode=OneTime}"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">
            <Interaction.Behaviors>
              <EventTriggerBehavior EventName="PointerPressed" SourceObject="Border">
                <InvokeCommandAction
                  Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).OpenItemCommand, Mode=OneTime}"
                  CommandParameter="{Binding}"
                  PassEventArgsToCommand="False" />
              </EventTriggerBehavior>
            </Interaction.Behaviors>
          </TextBlock>
        </Border>
      </DataTemplate>
    </Carousel.DataTemplates>
  </Carousel>

</UserControl>

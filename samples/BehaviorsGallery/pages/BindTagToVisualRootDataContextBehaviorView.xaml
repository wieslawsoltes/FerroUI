<UserControl x:Class="BehaviorsGallery.Views.Pages.BindTagToVisualRootDataContextBehaviorView"
             xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BehaviorsGallery.ViewModels"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="180">
  <!-- Ported from Views/Pages/BindTagToVisualRootDataContextBehaviorView of the reference sample. -->
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>
  <StackPanel Spacing="5" HorizontalAlignment="Center">
    <Button x:Name="IncrementButton" Content="Increment Count" />
    <TextBlock Text="{Binding Count, StringFormat={}Count: {0}}" />
    <!-- Deviation (DEVIATIONS.md, Behaviors gallery): the items of the view model are an
         enumerable without an indexer for markup (`Items[0]`); the code-behind sets the data
         context of the text block to the first item. -->
    <TextBlock x:Name="ItemText"
               Text="{Binding $self.((vm:MainWindowViewModel)Tag).Count}"
               x:DataType="vm:ItemViewModel">
      <Interaction.Behaviors>
        <BindTagToVisualRootDataContextBehavior />
      </Interaction.Behaviors>
    </TextBlock>
  </StackPanel>
  <Interaction.Behaviors>
    <EventTriggerBehavior EventName="Click" SourceObject="IncrementButton">
      <CallMethodAction TargetObject="{Binding}" MethodName="IncrementCount" />
    </EventTriggerBehavior>
  </Interaction.Behaviors>
</UserControl>

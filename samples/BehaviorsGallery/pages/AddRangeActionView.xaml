<UserControl x:Class="BehaviorsGallery.Views.Pages.AddRangeActionView"
             xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BehaviorsGallery.ViewModels"
             xmlns:col="using:System.Collections"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450">
  <!-- Ported from Views/Pages/AddRangeActionView of the reference sample. -->
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>
  <StackPanel Spacing="10" Margin="5">
    <StackPanel Orientation="Horizontal" Spacing="5">
      <Button Content="Add Range">
        <Interaction.Behaviors>
          <EventTriggerBehavior EventName="Click">
            <AddRangeAction Target="{Binding Items}">
              <!-- Deviation (DEVIATIONS.md, Behaviors gallery): the reference lists the items in a
                   List<ItemViewModel>; the compiled markup cannot add a view model to a typed list of
                   the runtime library (it states no Rust type for the item), so the items are in an
                   untyped list (ArrayList), which the action reads the same way. -->
              <col:ArrayList>
                <vm:ItemViewModel>
                  <x:Arguments>
                    <x:String>Added 1</x:String>
                    <x:String>Black</x:String>
                  </x:Arguments>
                </vm:ItemViewModel>
                <vm:ItemViewModel>
                  <x:Arguments>
                    <x:String>Added 2</x:String>
                    <x:String>Gray</x:String>
                  </x:Arguments>
                </vm:ItemViewModel>
              </col:ArrayList>
            </AddRangeAction>
          </EventTriggerBehavior>
        </Interaction.Behaviors>
      </Button>
      <Button Content="Clear">
        <Interaction.Behaviors>
          <EventTriggerBehavior EventName="Click">
            <ClearCollectionAction Target="{Binding Items}" />
          </EventTriggerBehavior>
        </Interaction.Behaviors>
      </Button>
    </StackPanel>
    <ItemsControl ItemsSource="{Binding Items}" Margin="0,5">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="vm:ItemViewModel">
          <DockPanel>
            <TextBlock Text="{Binding Value}" Margin="5" />
          </DockPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>

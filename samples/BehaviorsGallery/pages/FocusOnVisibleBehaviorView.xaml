<UserControl x:Class="BehaviorsGallery.Views.Pages.FocusOnVisibleBehaviorView"
             xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BehaviorsGallery.ViewModels"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="160">
  <!-- Ported from Views/Pages/FocusOnVisibleBehaviorView of the reference sample. -->
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>
  <StackPanel Spacing="12">
    <TextBlock Text="Toggle the checkbox to make the input visible." />
    <CheckBox x:Name="VisibilityToggle" Content="Show input" />
    <TextBox Width="200" PlaceholderText="Focus when visible" IsVisible="{Binding #VisibilityToggle.IsChecked}">
      <Interaction.Behaviors>
        <FocusOnVisibleBehavior />
      </Interaction.Behaviors>
    </TextBox>
  </StackPanel>
</UserControl>

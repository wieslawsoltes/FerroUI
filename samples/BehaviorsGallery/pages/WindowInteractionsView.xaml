<UserControl x:Class="BehaviorsGallery.Views.Pages.WindowInteractionsView"
             xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BehaviorsGallery.ViewModels"
             xmlns:views="using:BehaviorsGallery.Views.Windows"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="200">
  <!-- Ported from Views/Pages/WindowInteractionsView of the reference sample. -->
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>
  <StackPanel Spacing="5" Margin="5">
    <Button Content="Open Window">
      <Interaction.Behaviors>
        <EventTriggerBehavior EventName="Click">
          <ShowWindowAction>
            <views:SampleWindow />
          </ShowWindowAction>
        </EventTriggerBehavior>
      </Interaction.Behaviors>
    </Button>
    <TextBlock x:Name="StateText" Text="{Binding $parent[Window].WindowState, StringFormat={}Window state: {0}}" />
  </StackPanel>
  <Interaction.Behaviors>
    <CenterWindowBehavior Window="{Binding $parent[Window]}" />
    <WindowStateTrigger State="Maximized">
      <ChangePropertyAction TargetObject="{Binding #StateText}" PropertyName="Text" Value="Window state: Maximized" />
    </WindowStateTrigger>
  </Interaction.Behaviors>
</UserControl>

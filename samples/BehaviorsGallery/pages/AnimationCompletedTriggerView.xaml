<UserControl x:Class="BehaviorsGallery.Views.Pages.AnimationCompletedTriggerView"
             xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BehaviorsGallery.ViewModels"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450">
  <!-- Ported from Views/Pages/AnimationCompletedTriggerView of the reference sample. -->
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
    <TextBlock x:Name="MessageText" Text="Ready" HorizontalAlignment="Center" />
    <Border x:Name="AnimatedBorder" Width="100" Height="100" Background="SteelBlue">
      <Interaction.Behaviors>
        <AnimationCompletedTrigger>
          <AnimationCompletedTrigger.Animation>
            <Animation Duration="0:0:1" x:SetterTargetType="Visual">
              <KeyFrame Cue="0%">
                <Setter Property="Opacity" Value="0" />
              </KeyFrame>
              <KeyFrame Cue="100%">
                <Setter Property="Opacity" Value="1" />
              </KeyFrame>
            </Animation>
          </AnimationCompletedTrigger.Animation>
          <ChangePropertyAction TargetObject="{Binding #MessageText}" PropertyName="Text" Value="Completed!" />
        </AnimationCompletedTrigger>
      </Interaction.Behaviors>
    </Border>
  </StackPanel>
</UserControl>

<UserControl x:Class="BehaviorsGallery.Views.Pages.SelectingItemsControlBehaviorView"
             xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BehaviorsGallery.ViewModels"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="200">
  <!-- Ported from Views/Pages/SelectingItemsControlBehaviorView of the reference sample. -->
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>
  <TabControl SelectingItemsControlBehavior.EnableSelectionAnimation="True">
    <TabItem Header="First">
      <Border Background="Red" Width="0" Height="0" />
    </TabItem>
    <TabItem Header="Second">
      <Border Background="Red" Width="0" Height="0" />
    </TabItem>
    <TabItem Header="Third">
      <Border Background="Red" Width="0" Height="0" />
    </TabItem>
  </TabControl>
</UserControl>

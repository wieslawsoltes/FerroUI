<UserControl x:Class="BehaviorsGallery.Views.Pages.SetClipboardDataObjectActionView"
             xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BehaviorsGallery.ViewModels"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450">
  <!-- Ported from Views/Pages/SetClipboardDataObjectActionView of the reference sample. -->
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>
  <Grid>
    <Button x:Name="SetDataButton" Content="Set Clipboard Data Object" Margin="5">
      <Interaction.Behaviors>
        <EventTriggerBehavior EventName="Click" SourceObject="SetDataButton">
          <SetClipboardDataObjectAction DataTransfer="{Binding ClipboardDataTransfer}" />
        </EventTriggerBehavior>
      </Interaction.Behaviors>
    </Button>
  </Grid>
</UserControl>

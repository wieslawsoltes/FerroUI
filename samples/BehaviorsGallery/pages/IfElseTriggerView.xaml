<UserControl x:Class="BehaviorsGallery.Views.Pages.IfElseTriggerView"
             xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BehaviorsGallery.ViewModels"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450">
  <!-- Ported from Views/Pages/IfElseTriggerView of the reference sample. -->
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>
  <StackPanel>
    <TextBlock Name="TargetTextBlock"
               Text="">
      <Interaction.Behaviors>
        <IfElseTrigger Condition="{Binding #TargetCheckBox.IsChecked}">
          <IfElseTrigger.IfActions>
            <ChangePropertyAction PropertyName="Text"
                                  Value="Checked" />
          </IfElseTrigger.IfActions>
          <IfElseTrigger.ElseActions>
            <ChangePropertyAction PropertyName="Text"
                                  Value="Unchecked" />
          </IfElseTrigger.ElseActions>
        </IfElseTrigger>
      </Interaction.Behaviors>
    </TextBlock>
    <CheckBox Name="TargetCheckBox"
              Content="Check"
              IsChecked="False" />
  </StackPanel>
</UserControl>

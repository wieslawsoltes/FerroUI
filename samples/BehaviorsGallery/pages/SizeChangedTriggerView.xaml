<UserControl x:Class="BehaviorsGallery.Views.Pages.SizeChangedTriggerView"
             xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BehaviorsGallery.ViewModels"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="200">
  <!-- Ported from Views/Pages/SizeChangedTriggerView of the reference sample. -->
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>
  <StackPanel Spacing="5">
    <Slider x:Name="WidthSlider" Minimum="100" Maximum="300" Value="150" Width="200" />
    <Border x:Name="Target" Background="LightGray" Height="80" Width="{Binding Value, ElementName=WidthSlider}">
      <Interaction.Behaviors>
        <SizeChangedTrigger>
          <CallMethodAction TargetObject="{Binding}" MethodName="IncrementCount" />
        </SizeChangedTrigger>
      </Interaction.Behaviors>
    </Border>
    <TextBlock Text="{Binding Count, StringFormat={}Size changed count: {0}}" />
  </StackPanel>
</UserControl>

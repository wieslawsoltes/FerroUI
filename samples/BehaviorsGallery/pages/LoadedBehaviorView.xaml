<UserControl x:Class="BehaviorsGallery.Views.Pages.LoadedBehaviorView"
             xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BehaviorsGallery.ViewModels"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="120">
  <!-- Ported from Views/Pages/LoadedBehaviorView of the reference sample. -->
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>
  <StackPanel Spacing="5">
    <Button x:Name="Target" Content="Load">
      <Interaction.Behaviors>
        <LoadedMessageBehavior Target="{Binding #MessageText}" />
      </Interaction.Behaviors>
    </Button>
    <TextBlock x:Name="MessageText" />
  </StackPanel>
</UserControl>

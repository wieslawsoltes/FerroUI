<UserControl x:Class="BehaviorsGallery.Views.Pages.SliderValidationBehaviorView"
             xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BehaviorsGallery.ViewModels"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="150">
  <!-- Ported from Views/Pages/SliderValidationBehaviorView of the reference sample. -->
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>
  <StackPanel Spacing="4">
    <Slider Width="200"
            Minimum="0"
            Maximum="200"
            TickFrequency="1"
            IsSnapToTickEnabled="True"
            Value="{Binding ValidatedSlider}">
      <Interaction.Behaviors>
        <SliderValidationBehavior IsValid="{Binding IsSliderValid, Mode=OneWayToSource}">
          <!-- Deviation (DEVIATIONS.md, Behaviors gallery): the rule of the port is not generic (its values are untyped), so the type argument of the reference (x:TypeArguments) is left out. -->
          <RangeValidationRule Minimum="{Binding SliderValidationMinimum}"
                               Maximum="{Binding SliderValidationMaximum}"
                               ErrorMessage="Value is outside the configured range." />
        </SliderValidationBehavior>
      </Interaction.Behaviors>
    </Slider>
    <CheckBox IsEnabled="False"
              Content="IsSliderValid "
              IsChecked="{Binding IsSliderValid}" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Slider Width="90"
              Minimum="0"
              Maximum="200"
              Value="{Binding SliderValidationMinimum}" />
      <Slider Width="90"
              Minimum="0"
              Maximum="200"
              Value="{Binding SliderValidationMaximum}" />
    </StackPanel>
    <TextBlock Text="{Binding ValidatedSlider}" />
  </StackPanel>
</UserControl>

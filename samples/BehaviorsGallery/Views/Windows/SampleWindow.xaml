<Window xmlns="https://github.com/ferroui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BehaviorsGallery.Views.Windows.SampleWindow"
        Width="300" Height="200" Title="Sample Window">
  <!-- Ported from Views/Windows/SampleWindow of the reference sample. -->
  <StackPanel Margin="10" Spacing="5">
    <TextBlock Text="This is a window" />
    <Button Content="Close">
      <Interaction.Behaviors>
        <EventTriggerBehavior EventName="Click">
          <CloseWindowAction />
        </EventTriggerBehavior>
      </Interaction.Behaviors>
    </Button>
  </StackPanel>
</Window>

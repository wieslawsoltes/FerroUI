// onClick(object: int, tag: int) -> int: dispatches `tag` to the dispatcher of the application
// on every Click (Button, MenuItem, SplitButton). Defines the `Click` event.
fn onClick(object, tag) = {
    let _ = ferro_subscribe_dispatch(object: object, event: 4, tag: tag)
    object
}
// raiseClick(object: int) -> int: raises Click on the object, as the control does (for tests
// and scripts).
fn raiseClick(object) = {
    let _ = ferro_raise(object: object, event: 4)
    object
}

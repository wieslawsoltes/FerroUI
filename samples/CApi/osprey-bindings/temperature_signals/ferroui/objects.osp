    let _ = ferro_raise(object: object, event: 95)
    object
}
// onWindowOpened(object: int, tag: int) -> int: dispatches `tag` to the dispatcher of the
// application on every WindowOpened (Window). Routed event that can be used for global
// tracking of opening windows.
fn onWindowOpened(object, tag) = {
    let _ = ferro_subscribe_dispatch(object: object, event: 96, tag: tag)
    object
}
// raiseWindowOpened(object: int) -> int: raises WindowOpened on the object, as the control
// does (for tests and scripts).
fn raiseWindowOpened(object) = {
    let _ = ferro_raise(object: object, event: 96)
    object
}

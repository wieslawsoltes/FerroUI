// ---- events --------------------------------------------------------------------------------

// onBackRequested(object: int, tag: int) -> int: dispatches `tag` to the dispatcher of the
// application on every BackRequested (TopLevel). Defines the `BackRequested` event.
fn onBackRequested(object, tag) = {
    let _ = ferro_subscribe_dispatch(object: object, event: 3, tag: tag)
    object
}
// raiseBackRequested(object: int) -> int: raises BackRequested on the object, as the control
// does (for tests and scripts).
fn raiseBackRequested(object) = {
    let _ = ferro_raise(object: object, event: 3)
    object
}
// onContextCanceled(object: int, tag: int) -> int: dispatches `tag` to the dispatcher of the
// application on every ContextCanceled (InputElement). Provides event data for the
// `ContextCanceled` event.
fn onContextCanceled(object, tag) = {
    let _ = ferro_subscribe_dispatch(object: object, event: 9, tag: tag)
    object
}
// raiseContextCanceled(object: int) -> int: raises ContextCanceled on the object, as the
// control does (for tests and scripts).
fn raiseContextCanceled(object) = {
    let _ = ferro_raise(object: object, event: 9)
    object
}
// onContextRequested(object: int, tag: int) -> int: dispatches `tag` to the dispatcher of the
// application on every ContextRequested (InputElement). Provides event data for the
// `ContextRequested` event.

// ---- driving an interface from a script --------------------------------------------------

// raiseBackRequestedAt(key: int) -> int: raises BackRequested on the control of the element
// with the key `key`, as the control does.
fn raiseBackRequestedAt(key) = toInt(ferro_raise(object: findKey(key: key), event: 3))
// raiseClickAt(key: int) -> int: raises Click on the control of the element with the key
// `key`, as the control does.

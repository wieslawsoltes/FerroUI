extern fn ferro_get_cstr_or(object: int, property: int, fallback: string) -> string
// A null pointer, for the reserved options of ferro_app_run (from the runtime of Osprey).
extern fn osprey_ffi_null() -> Ptr

// Not declared, because Osprey cannot pass what they take (a pointer to a result, a buffer,
// UTF-16, bytes) or return (a string that can be NULL): ferro_subscribe_data, ferro_frame_str16, ferro_frame_commit_bytes, ferro_post_data, ferro_get_f64, ferro_get_i64, ferro_get_bool, ferro_get_str, ferro_get_cstr, ferro_get_handle, ferro_set_str16.

// ---- enumerations ----------------------------------------------------------------------------

// Defines how a background is drawn relative to its border.
type BackgroundSizing = BackgroundSizingInnerBorderEdge | BackgroundSizingOuterBorderEdge | BackgroundSizingCenterBorder
// backgroundSizingName(value: BackgroundSizing) -> string: the name of a member, which the ABI sets by name.
fn backgroundSizingName(value) = match value {
    BackgroundSizingInnerBorderEdge => "InnerBorderEdge"
    BackgroundSizingOuterBorderEdge => "OuterBorderEdge"
    BackgroundSizingCenterBorder => "CenterBorder"
}

// Describes the flow direction of content.
type FlowDirection = FlowDirectionLeftToRight | FlowDirectionRightToLeft
// flowDirectionName(value: FlowDirection) -> string: the name of a member, which the ABI sets by name.
fn flowDirectionName(value) = match value {
    FlowDirectionLeftToRight => "LeftToRight"
    FlowDirectionRightToLeft => "RightToLeft"
}

// Specifies the available font stretches (the OS/2 `usWidthClass` scale).
type FontStretch = FontStretchNormal | FontStretchUltraCondensed | FontStretchExtraCondensed | FontStretchCondensed | FontStretchSemiCondensed | FontStretchSemiExpanded | FontStretchExpanded | FontStretchExtraExpanded | FontStretchUltraExpanded
// fontStretchName(value: FontStretch) -> string: the name of a member, which the ABI sets by name.
fn fontStretchName(value) = match value {
    FontStretchNormal => "Normal"
    FontStretchUltraCondensed => "UltraCondensed"
    FontStretchExtraCondensed => "ExtraCondensed"
    FontStretchCondensed => "Condensed"
    FontStretchSemiCondensed => "SemiCondensed"
    FontStretchSemiExpanded => "SemiExpanded"
    FontStretchExpanded => "Expanded"
    FontStretchExtraExpanded => "ExtraExpanded"
    FontStretchUltraExpanded => "UltraExpanded"
}

// Defines the available font styles.
type FontStyle = FontStyleNormal | FontStyleItalic | FontStyleOblique
// fontStyleName(value: FontStyle) -> string: the name of a member, which the ABI sets by name.
fn fontStyleName(value) = match value {
    FontStyleNormal => "Normal"
    FontStyleItalic => "Italic"
    FontStyleOblique => "Oblique"
}

// Defines how a control aligns itself horizontally in its parent control.
type HorizontalAlignment = HorizontalAlignmentStretch | HorizontalAlignmentLeft | HorizontalAlignmentCenter | HorizontalAlignmentRight
// horizontalAlignmentName(value: HorizontalAlignment) -> string: the name of a member, which the ABI sets by name.
fn horizontalAlignmentName(value) = match value {
    HorizontalAlignmentStretch => "Stretch"
    HorizontalAlignmentLeft => "Left"
    HorizontalAlignmentCenter => "Center"
    HorizontalAlignmentRight => "Right"
}

// Defines vertical or horizontal orientation.
type Orientation = OrientationHorizontal | OrientationVertical
// orientationName(value: Orientation) -> string: the name of a member, which the ABI sets by name.
fn orientationName(value) = match value {
    OrientationHorizontal => "Horizontal"
    OrientationVertical => "Vertical"
}

// Defines constants that specify the orientation of a RefreshVisualizer.
type RefreshVisualizerOrientation = RefreshVisualizerOrientationAuto | RefreshVisualizerOrientationNormal | RefreshVisualizerOrientationRotate90DegreesCounterclockwise | RefreshVisualizerOrientationRotate270DegreesCounterclockwise
// refreshVisualizerOrientationName(value: RefreshVisualizerOrientation) -> string: the name of a member, which the ABI sets by name.
fn refreshVisualizerOrientationName(value) = match value {
    RefreshVisualizerOrientationAuto => "Auto"
    RefreshVisualizerOrientationNormal => "Normal"
    RefreshVisualizerOrientationRotate90DegreesCounterclockwise => "Rotate90DegreesCounterclockwise"
    RefreshVisualizerOrientationRotate270DegreesCounterclockwise => "Rotate270DegreesCounterclockwise"
}

// Defines how text is aligned.
type TextAlignment = TextAlignmentLeft | TextAlignmentCenter | TextAlignmentRight | TextAlignmentStart | TextAlignmentEnd | TextAlignmentDetectFromContent | TextAlignmentJustify
// textAlignmentName(value: TextAlignment) -> string: the name of a member, which the ABI sets by name.
fn textAlignmentName(value) = match value {
    TextAlignmentLeft => "Left"
    TextAlignmentCenter => "Center"
    TextAlignmentRight => "Right"
    TextAlignmentStart => "Start"
    TextAlignmentEnd => "End"
    TextAlignmentDetectFromContent => "DetectFromContent"
    TextAlignmentJustify => "Justify"
}

// Where a text block puts the height layout rounding adds to it: below its text (the
// reference's placement, the default) or above it (WinUI's).
type TextLayoutRoundingPlacement = TextLayoutRoundingPlacementBelow | TextLayoutRoundingPlacementAbove
// textLayoutRoundingPlacementName(value: TextLayoutRoundingPlacement) -> string: the name of a member, which the ABI sets by name.
fn textLayoutRoundingPlacementName(value) = match value {
    TextLayoutRoundingPlacementBelow => "Below"
    TextLayoutRoundingPlacementAbove => "Above"
}

// How the box of each line of text is bounded: by the ascent and the descent of its font (the
// default), or trimmed to the cap height above the baseline, to the baseline below it, or
// both.
type TextLineBounds = TextLineBoundsFull | TextLineBoundsTrimToCapHeight | TextLineBoundsTrimToBaseline | TextLineBoundsTight
// textLineBoundsName(value: TextLineBounds) -> string: the name of a member, which the ABI sets by name.
fn textLineBoundsName(value) = match value {
    TextLineBoundsFull => "Full"
    TextLineBoundsTrimToCapHeight => "TrimToCapHeight"
    TextLineBoundsTrimToBaseline => "TrimToBaseline"
    TextLineBoundsTight => "Tight"
}

// Controls the wrapping mode of text.
type TextWrapping = TextWrappingNoWrap | TextWrappingWrap | TextWrappingWrapWithOverflow
// textWrappingName(value: TextWrapping) -> string: the name of a member, which the ABI sets by name.
fn textWrappingName(value) = match value {
    TextWrappingNoWrap => "NoWrap"
    TextWrappingWrap => "Wrap"
    TextWrappingWrapWithOverflow => "WrapWithOverflow"
}

// Defines how a control aligns itself vertically in its parent control.
type VerticalAlignment = VerticalAlignmentStretch | VerticalAlignmentTop | VerticalAlignmentCenter | VerticalAlignmentBottom
// verticalAlignmentName(value: VerticalAlignment) -> string: the name of a member, which the ABI sets by name.
fn verticalAlignmentName(value) = match value {
    VerticalAlignmentStretch => "Stretch"
    VerticalAlignmentTop => "Top"
    VerticalAlignmentCenter => "Center"
    VerticalAlignmentBottom => "Bottom"
}

// Describes how the [`Window::closing`] event behaves in the presence of child windows.
type WindowClosingBehavior = WindowClosingBehaviorOwnerAndChildWindows | WindowClosingBehaviorOwnerWindowOnly
// windowClosingBehaviorName(value: WindowClosingBehavior) -> string: the name of a member, which the ABI sets by name.
fn windowClosingBehaviorName(value) = match value {
    WindowClosingBehaviorOwnerAndChildWindows => "OwnerAndChildWindows"
    WindowClosingBehaviorOwnerWindowOnly => "OwnerWindowOnly"
}

// Determines window decorations (title bar, border, etc) for a window.
type WindowDecorations = WindowDecorationsNone | WindowDecorationsBorderOnly | WindowDecorationsFull
// windowDecorationsName(value: WindowDecorations) -> string: the name of a member, which the ABI sets by name.
fn windowDecorationsName(value) = match value {
    WindowDecorationsNone => "None"
    WindowDecorationsBorderOnly => "BorderOnly"
    WindowDecorationsFull => "Full"
}

// Determines the startup location of the window.
type WindowStartupLocation = WindowStartupLocationManual | WindowStartupLocationCenterScreen | WindowStartupLocationCenterOwner
// windowStartupLocationName(value: WindowStartupLocation) -> string: the name of a member, which the ABI sets by name.
fn windowStartupLocationName(value) = match value {
    WindowStartupLocationManual => "Manual"
    WindowStartupLocationCenterScreen => "CenterScreen"
    WindowStartupLocationCenterOwner => "CenterOwner"
}

// Defines the minimized/maximized state of a window.
type WindowState = WindowStateNormal | WindowStateMinimized | WindowStateMaximized | WindowStateFullScreen
// windowStateName(value: WindowState) -> string: the name of a member, which the ABI sets by name.
fn windowStateName(value) = match value {
    WindowStateNormal => "Normal"
    WindowStateMinimized => "Minimized"
    WindowStateMaximized => "Maximized"
    WindowStateFullScreen => "FullScreen"
}

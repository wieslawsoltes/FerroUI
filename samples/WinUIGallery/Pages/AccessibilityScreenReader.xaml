<!-- Ported from the eleven pinned AccessibilityScreenReader examples of WinUI Gallery (14061eea);
     see ../NOTICE.md. The page has no code-behind upstream; accessibility_samples.rs sets the
     source's grapes.jpg and treetops.jpg. The headings are the theme's text styles with their
     heading levels (ThemeResource is DynamicResource); Bold is a Run with the weight, and
     WrapWholeWords is WrapWithOverflow. ScreenReaderOutputStyle is its FontSize, 12. WinUI's
     ListView is FerroUI's ListBox, and StackPanels with padding, background and corners are
     Borders (ControlCornerRadius is 4). The x:Bind of an element (LabeledBy) is a Binding of the
     element by name. FerroUI's TextBox has no Header: each header is a TextBlock above the box
     that labels it (LabeledBy). FerroUI's automation has no FullDescription (the description is
     HelpText) and no Custom landmark with a LocalizedLandmarkType (the sidebar is a named Region):
     the page is partial. -->
<StackPanel xmlns="https://github.com/ferroui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Spacing="12">

  <RichTextBlock TextWrapping="Wrap">
    <Paragraph><Run Text="Accessibility is about building experiences that make your Windows application usable by people of all abilities. For more information about designing accessible apps: " /><Hyperlink NavigateUri="https://learn.microsoft.com/windows/apps/design/accessibility/accessibility-overview"><Run Text="Accessibility overview" /></Hyperlink><Run Text="." /></Paragraph>
    <Paragraph><Run Text="Screen readers, such as " /><Hyperlink NavigateUri="https://support.microsoft.com/windows/complete-guide-to-narrator-e4397a0d-ef4f-b386-d8ae-c172f109bdb1"><Run Text="Narrator" /></Hyperlink><Run Text=", convert text into spoken words to help blind or low vision users. Screen readers use the UI Automation (UIA) names of each control to report their name, role and content." /></Paragraph>
  </RichTextBlock>

  <TextBlock Margin="0,20,0,0" AutomationProperties.HeadingLevel="2" Theme="{DynamicResource SubtitleTextBlockStyle}"
             Text="Accessible names" />

  <RichTextBlock TextWrapping="Wrap">
    <Paragraph><Run Text="An " /><Run FontWeight="Bold" Text="accessible name" /><Run Text=" is a short, descriptive text string that a screen reader uses to describe a UI element." /></Paragraph>
    <Paragraph><Run Text="Typically, the accessible name should be short and match the visual label of the control. Screen reader users will hear this name every time they navigate to that control." /></Paragraph>
    <Paragraph><Run Text="If the control's content can be converted to a string, an accessible name is automatically determined from the visible text. However, elements such as images or input fields need to have a custom accessible name." /></Paragraph>
    <Paragraph><Run Text="See " /><Hyperlink NavigateUri="https://learn.microsoft.com/windows/apps/design/accessibility/basic-accessibility-information#accessible-name"><Run Text="Expose basic accessibility information#Accessible name" /></Hyperlink><Run Text=" and " /><Hyperlink NavigateUri="https://learn.microsoft.com/windows/apps/design/accessibility/basic-accessibility-information#name-from-inner-text"><Run Text="Expose basic accessibility information#Name from inner text" /></Hyperlink><Run Text="." /></Paragraph>
  </RichTextBlock>

  <TextBlock Margin="0,20,0,0" AutomationProperties.HeadingLevel="3" Theme="{DynamicResource BodyStrongTextBlockStyle}"
             Text="Getting an accessible name automatically" />

  <RichTextBlock TextWrapping="Wrap">
    <Paragraph><Run Text="For most controls, XAML automatically sets an accessible name from the control's content (if the content is a string)." /></Paragraph>
  </RichTextBlock>
  <StackPanel x:Name="Example1" Spacing="8">
    <TextBlock Text="Name From Content" FontSize="18" />
    <StackPanel Spacing="12">
      <Button x:Name="DownloadSurveyButton" Content="Download survey" />
      <RichTextBlock FontSize="12" TextWrapping="Wrap">
        <Paragraph><Run Text="Screen readers will read this button as " /><Run FontWeight="Bold" Text="Download survey" /><Run Text=". The name is automatically derived from the Button's Content." /></Paragraph>
      </RichTextBlock>
    </StackPanel>
  </StackPanel>
  <StackPanel x:Name="Example2" Spacing="8">
    <TextBlock Text="Name From Header" FontSize="18" />
    <StackPanel Spacing="12">
      <!-- Headers are promoted to name: the composed header labels the box. -->
      <StackPanel Spacing="4">
        <TextBlock x:Name="NameHeader" AutomationProperties.AccessibilityView="Raw" Text="Name" />
        <TextBox x:Name="NameBox" Width="200" HorizontalAlignment="Left"
                 AutomationProperties.LabeledBy="{Binding ElementName=NameHeader}" />
      </StackPanel>
      <!-- As are placeholders. -->
      <TextBox x:Name="NicknameBox" Width="200" HorizontalAlignment="Left" PlaceholderText="Nickname" />
      <!-- If both are provided, headers are name and placeholders are moved to description. -->
      <StackPanel Spacing="4">
        <TextBlock x:Name="EmailHeader" AutomationProperties.AccessibilityView="Raw" Text="Email" />
        <TextBox x:Name="EmailBox" MinWidth="200" HorizontalAlignment="Left" PlaceholderText="test@example.com"
                 AutomationProperties.LabeledBy="{Binding ElementName=EmailHeader}" />
      </StackPanel>
      <RichTextBlock FontSize="12" TextWrapping="Wrap">
        <Paragraph><Run Text="Screen readers will read these TextBoxes as " /><Run FontWeight="Bold" Text="Name" /><Run Text=", " /><Run FontWeight="Bold" Text="Nickname" /><Run Text=" and " /><Run FontWeight="Bold" Text="Email" /><Run Text=". The names are automatically derived from their headers or placeholders." /></Paragraph>
        <Paragraph><Run Text="When both Header and PlaceholderText are present, Header is used as name and PlaceholderText is used as description." /></Paragraph>
      </RichTextBlock>
    </StackPanel>
  </StackPanel>

  <TextBlock Margin="0,20,0,0" AutomationProperties.HeadingLevel="3" Theme="{DynamicResource BodyStrongTextBlockStyle}"
             Text="Setting an accessible name manually" />

  <RichTextBlock TextWrapping="Wrap">
    <Paragraph><Run Text="Controls without stringable content will not get an accessible name automatically." /></Paragraph>
  </RichTextBlock>
  <StackPanel x:Name="Example3" Spacing="8">
    <TextBlock Text="Name On List View" FontSize="18" />
    <StackPanel Spacing="12">
      <ListBox x:Name="ContactsList" Width="300" HorizontalAlignment="Left" AutomationProperties.Name="Contacts">
        <ListBoxItem>Nathan Quinn</ListBoxItem>
        <ListBoxItem>Jessica Lamber</ListBoxItem>
        <ListBoxItem>Carl Bond</ListBoxItem>
        <ListBoxItem>Jessica Russel</ListBoxItem>
      </ListBox>
      <RichTextBlock FontSize="12" TextWrapping="Wrap">
        <Paragraph><Run Text="Screen readers will read this ListView as " /><Run FontWeight="Bold" Text="Contacts" /><Run Text=", while each item will be read using its respective text content." /></Paragraph>
      </RichTextBlock>
    </StackPanel>
  </StackPanel>
  <StackPanel x:Name="Example4" Spacing="8">
    <TextBlock Text="Name On Image" FontSize="18" />
    <StackPanel Spacing="12">
      <Border HorizontalAlignment="Left" CornerRadius="4" ClipToBounds="True">
        <Image x:Name="GrapesImage" Height="150" HorizontalAlignment="Left" AutomationProperties.Name="Grapes" />
      </Border>
      <RichTextBlock FontSize="12" TextWrapping="Wrap">
        <Paragraph><Run Text="The image above will be read out as " /><Run FontWeight="Bold" Text="Grapes" /><Run Text=". To navigate in Narrator through elements that aren't focusable, use Caps + Left/Right arrow." /></Paragraph>
      </RichTextBlock>
    </StackPanel>
  </StackPanel>

  <TextBlock Margin="0,20,0,0" AutomationProperties.HeadingLevel="3" Theme="{DynamicResource BodyStrongTextBlockStyle}"
             Text="Using another control to provide an accessible name" />

  <RichTextBlock TextWrapping="Wrap">
    <Paragraph><Run Text="Controls with accessible names can be used as labels for other controls. They should be removed from the UIA tree (see " /><Run FontWeight="Bold" Text="Visual tree" /><Run Text=" below), to avoid being redundant." /></Paragraph>
  </RichTextBlock>
  <StackPanel x:Name="Example5" Spacing="8">
    <TextBlock Text="Labeled By" FontSize="18" />
    <StackPanel Spacing="8">
      <TextBlock x:Name="InputLabel" AutomationProperties.AccessibilityView="Raw"
                 Theme="{DynamicResource BodyTextBlockStyle}" Text="Searching Photos:" />
      <TextBox x:Name="SearchPhotosBox" Width="200" HorizontalAlignment="Left"
               AutomationProperties.LabeledBy="{Binding ElementName=InputLabel}" />
      <RichTextBlock FontSize="12" TextWrapping="Wrap">
        <Paragraph><Run Text="The TextBox above is labeled by the TextBlock and will be read as " /><Run FontWeight="Bold" Text="Searching Photos" /><Run Text="." /></Paragraph>
      </RichTextBlock>
    </StackPanel>
  </StackPanel>

  <TextBlock Margin="0,20,0,0" AutomationProperties.HeadingLevel="2" Theme="{DynamicResource SubtitleTextBlockStyle}"
             Text="Common accessibility properties" />

  <RichTextBlock TextWrapping="Wrap">
    <Paragraph><Run Text="Besides accessible name, common accessibility properties include:" /></Paragraph>
    <Paragraph><Run Text="- Description and help text" /></Paragraph>
    <Paragraph><Run Text="- Position in set" /></Paragraph>
    <Paragraph><Run Text="- Headings and landmarks (see below)" /></Paragraph>
    <Paragraph><Run Text="See " /><Hyperlink NavigateUri="https://learn.microsoft.com/windows/apps/design/accessibility/basic-accessibility-information"><Run Text="Expose basic accessibility information" /></Hyperlink><Run Text=" and " /><Hyperlink NavigateUri="https://learn.microsoft.com/accessibility-tools-docs/items/uwpxaml/control_fulldescription_describedby_helptext"><Run Text="UWP XAML: Setting supplemental information on a control" /></Hyperlink><Run Text="." /></Paragraph>
  </RichTextBlock>
  <StackPanel x:Name="Example6" Spacing="8">
    <TextBlock Text="Description and help text: add descriptions and help text to controls" FontSize="18" />
    <StackPanel Spacing="8">
      <!-- Use FullDescription to connect visible descriptions to their controls: FerroUI's
           automation has HelpText for the description. -->
      <StackPanel Spacing="8">
        <CheckBox x:Name="ClearCacheCheckBox" Content="Clear cache on exit"
                  AutomationProperties.HelpText="{Binding #ClearCacheDescription.Text}" />
        <TextBlock x:Name="ClearCacheDescription" AutomationProperties.AccessibilityView="Raw"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                   Text="Deletes all cached items when closing the browser. This includes cookies, images, and browsing history." />
      </StackPanel>
      <!-- Use HelpText and/or tooltips to explain nuances of controls. -->
      <Button x:Name="CancelSubscriptionsButton" AutomationProperties.HelpText="Launch the cancellation wizard"
              Content="Cancel RSS subscriptions" ToolTip.Tip="Launch the cancellation wizard" />
    </StackPanel>
  </StackPanel>
  <StackPanel x:Name="Example7" Spacing="8">
    <TextBlock Text="Position in set: indicate the position of an element within a set" FontSize="18" />
    <StackPanel>
      <!-- Many controls automatically indicate position in set. -->
      <TextBlock x:Name="StudentsLabel" AutomationProperties.AccessibilityView="Raw"
                 Theme="{DynamicResource BodyStrongTextBlockStyle}" Text="Students" />
      <ListBox x:Name="StudentsList" AutomationProperties.LabeledBy="{Binding ElementName=StudentsLabel}">
        <x:String>Nathan Quinn</x:String>
        <x:String>Jessica Lamber</x:String>
        <x:String>Carl Bond</x:String>
        <x:String>Jessica Russel</x:String>
      </ListBox>
      <!-- Custom layouts may need to specify PositionInSet and SizeOfSet manually. -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="ViewButton" AutomationProperties.PositionInSet="1" AutomationProperties.SizeOfSet="3"
                Content="View" />
        <Button x:Name="RenameButton" AutomationProperties.PositionInSet="2" AutomationProperties.SizeOfSet="3"
                Content="Rename" />
        <Button x:Name="DeleteButton" AutomationProperties.PositionInSet="3" AutomationProperties.SizeOfSet="3"
                Content="Delete" />
      </StackPanel>
    </StackPanel>
  </StackPanel>

  <TextBlock Margin="0,20,0,0" AutomationProperties.HeadingLevel="2" Theme="{DynamicResource SubtitleTextBlockStyle}"
             Text="Visual tree" />

  <RichTextBlock TextWrapping="Wrap">
    <Paragraph><Run Text="UIA exposes multiple views of the UI tree: Control, Content, and Raw." /></Paragraph>
    <Paragraph><Run Text="Most accessibility tools use the &quot;Control&quot; or &quot;Content&quot; views, so you can effectively &quot;hide&quot; redundant or unhelpful controls from screen readers by putting them in the &quot;Raw&quot; view." /></Paragraph>
    <Paragraph><Run Text="See " /><Hyperlink NavigateUri="https://learn.microsoft.com/windows/apps/design/accessibility/basic-accessibility-information#influencing-the-ui-automation-tree-views"><Run Text="Expose basic accessibility information#Influencing the UI Automation tree views" /></Hyperlink><Run Text="." /></Paragraph>
  </RichTextBlock>
  <StackPanel x:Name="Example8" Spacing="8">
    <TextBlock Text="Remove a control from the content visual tree" FontSize="18" />
    <StackPanel Orientation="Horizontal">
      <!-- The image is not necessary for screen readers as it does not contain any information.
           Thus we remove it from the content visual tree with AccessibilityView="Raw". -->
      <Border VerticalAlignment="Top" CornerRadius="4" ClipToBounds="True">
        <Image x:Name="TreetopsImage" Height="40" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw" />
      </Border>
      <TextBlock MaxWidth="400" Margin="8,-4,0,0" TextWrapping="WrapWithOverflow"
                 Text="This is some demo text. The image on the right is just for decoration and serves no informational purpose. To prevent Narrator or other screen readers from reading out the image, we set the accessibility view to &quot;Raw&quot; which removes it from the content visual tree." />
    </StackPanel>
  </StackPanel>

  <TextBlock Margin="0,20,0,0" AutomationProperties.HeadingLevel="2" Theme="{DynamicResource SubtitleTextBlockStyle}"
             Text="Landmarks and headings" />

  <RichTextBlock TextWrapping="Wrap">
    <Paragraph><Run FontWeight="Bold" Text="Landmarks and headings" /><Run Text=" indicate, or label, different sections of a user interface for screen readers and other Assistive Technologies (ATs), just like visible headings do for visual users. Marking up your content with landmarks and headings lets screen reader users skim content similarly to sighted users." /></Paragraph>
    <Paragraph><Run Text="See " /><Hyperlink NavigateUri="https://learn.microsoft.com/windows/apps/design/accessibility/landmarks-and-headings"><Run Text="Landmarks and headings" /></Hyperlink><Run Text="." /></Paragraph>
  </RichTextBlock>

  <TextBlock Margin="0,20,0,0" AutomationProperties.HeadingLevel="3" Theme="{DynamicResource SubtitleTextBlockStyle}"
             Text="Landmarks" />

  <RichTextBlock TextWrapping="Wrap">
    <Paragraph><Run FontWeight="Bold" Text="Landmarks" /><Run Text=" typically identify big sections of your UI, like &quot;search&quot;, &quot;main content&quot;, or &quot;navigation.&quot; You can also add landmarks with custom names." /></Paragraph>
  </RichTextBlock>
  <StackPanel x:Name="Example9" Spacing="8">
    <TextBlock Text="Landmarks" FontSize="18" />
    <StackPanel>
      <TextBlock Margin="0,0,0,10" HorizontalAlignment="Left" Theme="{DynamicResource CaptionTextBlockStyle}"
                 TextWrapping="Wrap"
                 Text="The sample below showcases landmarks. To navigate landmarks in Narrator, press D or Shift+D while in Scan mode." />
      <Grid ColumnDefinitions="200,*,200">
        <!-- The navigation pane for our app. -->
        <Border x:Name="NavigationLandmark" Padding="6" AutomationProperties.LandmarkType="Navigation"
                Background="{DynamicResource CardStrokeColorDefaultBrush}" CornerRadius="4">
          <StackPanel Spacing="8">
            <AutoSuggestBox x:Name="SearchLandmark" AutomationProperties.LandmarkType="Search" PlaceholderText="Search" />
            <Button Content="Open settings" />
          </StackPanel>
        </Border>
        <!-- The main content of our app. -->
        <Border x:Name="MainLandmark" Grid.Column="1" Padding="6" AutomationProperties.LandmarkType="Main">
          <TextBlock TextWrapping="WrapWithOverflow"
                     Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum" />
        </Border>
        <!-- A custom sidebar with a custom landmark name: FerroUI has no Custom landmark or
             LocalizedLandmarkType, so it is a named Region. -->
        <Border x:Name="ViewersLandmark" Grid.Column="2" Padding="6" AutomationProperties.LandmarkType="Region"
                AutomationProperties.Name="Current viewers"
                Background="{DynamicResource CardStrokeColorDefaultBrush}" CornerRadius="4">
          <StackPanel Spacing="8">
            <TextBlock AutomationProperties.HeadingLevel="1" Theme="{DynamicResource BodyStrongTextBlockStyle}"
                       Text="Current viewers" />
            <TextBlock FontStyle="Italic" Theme="{DynamicResource BodyTextBlockStyle}" Text="(No other users viewing)" />
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </StackPanel>

  <TextBlock Margin="0,20,0,0" AutomationProperties.HeadingLevel="3" Theme="{DynamicResource SubtitleTextBlockStyle}"
             Text="Headings" />

  <RichTextBlock TextWrapping="Wrap">
    <Paragraph><Run FontWeight="Bold" Text="Headings" /><Run Text=" typically identify smaller groups of content. They usually correspond to the &quot;visual&quot; headings in your UI — the text that labels sections in your UI visually." /></Paragraph>
    <Paragraph><Run Text="For example, all of the section headings on this page are accessible headings." /></Paragraph>
  </RichTextBlock>
  <StackPanel x:Name="Example10" Spacing="8">
    <TextBlock Text="Headings" FontSize="18" />
    <StackPanel HorizontalAlignment="Left">
      <TextBlock Margin="0,0,0,10" HorizontalAlignment="Left" Theme="{DynamicResource CaptionTextBlockStyle}"
                 TextWrapping="Wrap"
                 Text="The sample below showcases headings. To navigate headings in Narrator, press H or Shift+H while in Scan mode." />
      <StackPanel x:Name="HeadingsPanel" MaxWidth="500" HorizontalAlignment="Left">
        <!-- Here is the main header for the whole text. It gets HeadingLevel 1. -->
        <TextBlock AutomationProperties.HeadingLevel="1" FontSize="26" Text="Lorem ipsums" />
        <!-- The following TextBlock is the header for the standard lorem ipsum text, thus it is
             only HeadingLevel 2. -->
        <TextBlock AutomationProperties.HeadingLevel="2" FontSize="22" Text="Lorem ipsum" />
        <TextBlock TextWrapping="WrapWithOverflow"
                   Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Pellentesque feugiat velit pulvinar, vehicula nisi at, molestie risus. Duis consequat auctor libero vitae consectetur. Nullam efficitur euismod lacinia." />
        <TextBlock AutomationProperties.HeadingLevel="2" FontSize="22" Text="Cat ipsum" />
        <!-- This is the header for the standard cat ipsum section, which is hierarchically below
             the cat ipsum header, resulting in HeadingLevel 3. -->
        <TextBlock AutomationProperties.HeadingLevel="3" FontSize="18" Text="Standard" />
        <TextBlock TextWrapping="WrapWithOverflow"
                   Text="Mice litter kitter kitty litty little kitten big roar roar feed me but i will ruin the couch with my claws and hunt by meowing loudly at 5am next to human." />
        <TextBlock AutomationProperties.HeadingLevel="3" FontSize="18" Text="Cat breeds" />
        <TextBlock TextWrapping="WrapWithOverflow"
                   Text="Tabby abyssinian for jaguar. Thai russian blue and ragdoll, ocicat. Mouser puma so american bobtail for donskoy balinese . Scottish fold manx so siamese." />
        <TextBlock AutomationProperties.HeadingLevel="2" FontSize="22" Text="Bacon ipsum" />
        <TextBlock TextWrapping="WrapWithOverflow"
                   Text="Bacon ipsum dolor amet meatball nulla labore, tempor sirloin chicken frankfurter tail drumstick ex cupim ground round." />
      </StackPanel>
    </StackPanel>
  </StackPanel>

  <TextBlock Margin="0,20,0,0" AutomationProperties.HeadingLevel="3" Theme="{DynamicResource SubtitleTextBlockStyle}"
             Text="Associating smaller groups of controls" />

  <RichTextBlock TextWrapping="Wrap">
    <Paragraph><Run Text="You can also group controls together manually, even if the controls don't have a visible heading or landmark, by adding an accessible name to the parent container. When entering a region with a name or a landmark, Narrator will read it out as " /><Run FontWeight="Bold" Text="Context" /><Run Text=". Narrator users can control their " /><Run FontWeight="Bold" Text="Context level" /><Run Text=" in Settings." /></Paragraph>
    <Paragraph><Run Text="This is helpful in complicated UI with many similar elements, where the grouping might be obvious to visual users, but not screen reader users." /></Paragraph>
  </RichTextBlock>
  <StackPanel x:Name="Example11" Spacing="8">
    <TextBlock Text="Control Groups" FontSize="18" />
    <StackPanel Spacing="8">
      <TextBlock Theme="{DynamicResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                 Text="The sample below groups items using accessible names. Screen readers will read this as users navigate between different groups. To force read the current context in Narrator, press Caps+/." />
      <TextBlock Theme="{DynamicResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                 Text="Note how Narrator reads 'My albums' or 'Shared with me' if you tab between the ListViews, and reads the additional context 'Album browser' when Caps+/ is pressed." />
      <StackPanel x:Name="AlbumBrowser" AutomationProperties.Name="Album browser">
        <StackPanel x:Name="MyAlbums" AutomationProperties.Name="My albums">
          <!-- These TextBlocks could reasonably be headings, too. -->
          <TextBlock Theme="{DynamicResource BodyStrongTextBlockStyle}" Text="My albums" />
          <ListBox>
            <x:String>Trip to Redmond</x:String>
            <x:String>Visiting Ben</x:String>
          </ListBox>
        </StackPanel>
        <StackPanel x:Name="SharedWithMe" AutomationProperties.Name="Shared with me">
          <TextBlock Theme="{DynamicResource BodyStrongTextBlockStyle}" Text="Shared with me" />
          <ListBox>
            <x:String>Valeria's cat</x:String>
            <x:String>Paul's winter vacation</x:String>
            <x:String>Cool street photography</x:String>
          </ListBox>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </StackPanel>

</StackPanel>

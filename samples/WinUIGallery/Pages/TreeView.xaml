<!-- Ported from the four pinned TreeView examples of WinUI Gallery (14061eea) and the code behind
     of TreeViewPage.xaml.cs (tree_samples.rs); see ../NOTICE.md. The trees get their items and
     templates from tree_samples.rs, as the source's constructor; the bound trees' items are
     expanded by the source's IsExpanded="True" of their templates, a style here. ThemeResource
     becomes DynamicResource and the bordered Grids are Borders (FerroUI's Grid has no border).
     The first tree's CanDragItems and AllowDrop are the drag of tree_samples.rs; the styles below
     show where a dragged item lands. -->
<StackPanel xmlns="https://github.com/ferroui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Spacing="24">
  <StackPanel.Styles>
    <Style Selector="TreeViewItem.DropBefore">
      <Setter Property="AdornerLayer.Adorner">
        <Template>
          <Border BorderThickness="0 2 0 0" BorderBrush="{DynamicResource SystemAccentColor}" IsHitTestVisible="False" />
        </Template>
      </Setter>
    </Style>
    <Style Selector="TreeViewItem.DropAfter">
      <Setter Property="AdornerLayer.Adorner">
        <Template>
          <Border BorderThickness="0 0 0 2" BorderBrush="{DynamicResource SystemAccentColor}" IsHitTestVisible="False" />
        </Template>
      </Setter>
    </Style>
    <Style Selector="TreeViewItem.DropInside">
      <Setter Property="AdornerLayer.Adorner">
        <Template>
          <Border BorderThickness="2" BorderBrush="{DynamicResource SystemAccentColor}" IsHitTestVisible="False" />
        </Template>
      </Setter>
    </Style>
  </StackPanel.Styles>
  <StackPanel x:Name="TreeViewExample1" Spacing="8">
    <TextBlock Text="A simple TreeView with drag and drop support" FontSize="18" />
    <Border Height="280" BorderBrush="{DynamicResource TextControlBorderBrush}" BorderThickness="1">
      <TreeView x:Name="sampleTreeView" MinWidth="345" MaxHeight="400" Margin="0,12,0,0"
                HorizontalAlignment="Center" VerticalAlignment="Top" />
    </Border>
  </StackPanel>

  <StackPanel x:Name="TreeViewExample2" Spacing="8">
    <TextBlock Text="A TreeView with Multi-selection enabled" FontSize="18" />
    <Border Height="280" BorderBrush="{DynamicResource TextControlBorderBrush}" BorderThickness="1">
      <TreeView x:Name="sampleTreeView2" MinWidth="345" MaxHeight="400" Margin="0,12,0,0"
                HorizontalAlignment="Center" VerticalAlignment="Top" />
    </Border>
  </StackPanel>

  <StackPanel x:Name="TreeViewExample3" Spacing="8">
    <TextBlock Text="A TreeView with DataBinding Using ItemSource" FontSize="18" />
    <Border Height="200" BorderBrush="{DynamicResource TextControlBorderBrush}" BorderThickness="1">
      <TreeView x:Name="TreeView1" MinWidth="345" MaxHeight="400" Margin="0,12,0,0"
                HorizontalAlignment="Center" VerticalAlignment="Top">
        <TreeView.Styles>
          <Style Selector="TreeViewItem">
            <Setter Property="IsExpanded" Value="True" />
          </Style>
        </TreeView.Styles>
      </TreeView>
    </Border>
  </StackPanel>

  <StackPanel x:Name="TreeViewExample4" Spacing="8">
    <TextBlock Text="A TreeView with ItemTemplateSelector" FontSize="18" />
    <Border Height="200" BorderBrush="{DynamicResource TextControlBorderBrush}" BorderThickness="1">
      <TreeView x:Name="FileTree" MinWidth="345" MaxHeight="400" Margin="0,12,0,0"
                HorizontalAlignment="Center" VerticalAlignment="Top">
        <TreeView.Styles>
          <Style Selector="TreeViewItem">
            <Setter Property="IsExpanded" Value="True" />
          </Style>
        </TreeView.Styles>
      </TreeView>
    </Border>
  </StackPanel>
</StackPanel>

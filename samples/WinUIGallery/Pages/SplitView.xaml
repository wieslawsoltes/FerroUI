<!-- Ported from the pinned SplitView example of WinUI Gallery (14061eea) and the code behind of
     SplitViewPage.xaml.cs (navigation_samples.rs); see ../NOTICE.md. The source's x:Bind of the
     pane lengths and the TwoWay x:Bind of IsPaneOpen are kept (the binding converts the nullable
     IsChecked; no converter is needed). FerroUI has no ListView: the links are a ListBox whose
     ItemClick is a tap on an item. The source's visual states are classes of the split view
     (PaneBackground) and of the list (the item template), set by the handlers; ThemeResource
     becomes DynamicResource. The Headers of the options are composed, IsOn is IsChecked and the
     Header of the switch is its Content; StepFrequency 8 is a TickFrequency with
     IsSnapToTickEnabled. The Tags of the background items feed the source viewer only. -->
<StackPanel xmlns="https://github.com/ferroui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Spacing="24">
  <StackPanel.Resources>
    <DataTemplate x:Key="LeftIconNavLinkItemTemplate">
      <Grid Margin="2,0,0,0" ColumnDefinitions="Auto,*" AutomationProperties.Name="{Binding Label}">
        <SymbolIcon Grid.Column="0" Symbol="{Binding Symbol}" />
        <TextBlock Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center" Text="{Binding Label}" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="RightIconNavLinkItemTemplate">
      <Grid Margin="0,0,2,0" ColumnDefinitions="*,Auto" AutomationProperties.Name="{Binding Label}">
        <TextBlock Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center" Text="{Binding Label}" />
        <SymbolIcon Grid.Column="1" Symbol="{Binding Symbol}" />
      </Grid>
    </DataTemplate>
  </StackPanel.Resources>
  <StackPanel.Styles>
    <!-- The PaneBackground states: the theme brush, Red, Blue and Green. -->
    <Style Selector="SplitView#splitView">
      <Setter Property="PaneBackground" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
    </Style>
    <Style Selector="SplitView#splitView.Red">
      <Setter Property="PaneBackground" Value="Red" />
    </Style>
    <Style Selector="SplitView#splitView.Blue">
      <Setter Property="PaneBackground" Value="Blue" />
    </Style>
    <Style Selector="SplitView#splitView.Green">
      <Setter Property="PaneBackground" Value="Green" />
    </Style>
    <!-- The NavLinkItemLayoutStates: LeftIconLayout and RightIconLayout. -->
    <Style Selector="ListBox#NavLinksList">
      <Setter Property="ItemTemplate" Value="{StaticResource LeftIconNavLinkItemTemplate}" />
    </Style>
    <Style Selector="ListBox#NavLinksList.RightIconLayout">
      <Setter Property="ItemTemplate" Value="{StaticResource RightIconNavLinkItemTemplate}" />
    </Style>
  </StackPanel.Styles>

  <StackPanel x:Name="SplitViewExample1" Spacing="8">
    <TextBlock Text="A basic SplitView." FontSize="18" />
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="24">
      <Grid Width="400" Height="300" VerticalAlignment="Top">
        <SplitView x:Name="splitView" MaxWidth="400" IsTabStop="False"
                   CompactPaneLength="{x:Bind compactPaneLengthSlider.Value, Mode=OneWay}"
                   DisplayMode="CompactOverlay"
                   IsPaneOpen="{x:Bind togglePaneButton.IsChecked, Mode=TwoWay}"
                   OpenPaneLength="{x:Bind openPaneLengthSlider.Value, Mode=OneWay}">
          <SplitView.Pane>
            <Grid RowDefinitions="Auto,*,Auto">
              <TextBlock x:Name="PaneHeader" Margin="60,12,0,0" FontWeight="SemiBold" Text="PANE CONTENT" />
              <ListBox x:Name="NavLinksList" Grid.Row="1" Margin="0,12,0,0" VerticalAlignment="Stretch"
                       SelectionMode="Single" />
            </Grid>
          </SplitView.Pane>
          <Grid RowDefinitions="Auto,*">
            <TextBlock Margin="12,12,0,0" FontWeight="SemiBold" Text="SPLITVIEW CONTENT" />
            <TextBlock x:Name="content" Grid.Row="1" Margin="12,12,0,0" TextWrapping="Wrap" />
          </Grid>
        </SplitView>
      </Grid>
      <StackPanel Grid.Column="1">
        <ToggleButton x:Name="togglePaneButton" Content="IsPaneOpen" IsChecked="True" />
        <ToggleSwitch x:Name="PanePlacement" MinWidth="120" Margin="0,12,0,0" Content="Placement"
                      OffContent="Left" OnContent="Right" />
        <TextBlock Margin="0,4,0,0" Text="DisplayMode" />
        <ComboBox x:Name="displayModeCombobox" Width="196" VerticalAlignment="Center" SelectedIndex="0"
                  AutomationProperties.Name="DisplayMode">
          <ComboBoxItem>Inline</ComboBoxItem>
          <ComboBoxItem>CompactInline</ComboBoxItem>
          <ComboBoxItem>Overlay</ComboBoxItem>
          <ComboBoxItem>CompactOverlay</ComboBoxItem>
        </ComboBox>
        <TextBlock Margin="0,12,0,0" Text="PaneBackground" />
        <ComboBox x:Name="paneBackgroundCombobox" Width="196" VerticalAlignment="Center" SelectedIndex="0"
                  AutomationProperties.Name="PaneBackground">
          <ComboBoxItem>SystemControlBackgroundChromeMediumLowBrush</ComboBoxItem>
          <ComboBoxItem>Red</ComboBoxItem>
          <ComboBoxItem>Blue</ComboBoxItem>
          <ComboBoxItem>Green</ComboBoxItem>
        </ComboBox>
        <TextBlock Margin="0,12,0,0" Text="OpenPaneLength" />
        <Slider x:Name="openPaneLengthSlider" Width="196" AutomationProperties.Name="OpenPaneLength"
                Maximum="500" Minimum="128" IsSnapToTickEnabled="True" TickFrequency="8" Value="256" />
        <TextBlock Text="CompactPaneLength" />
        <Slider x:Name="compactPaneLengthSlider" Width="196" AutomationProperties.Name="CompactPaneLength"
                Maximum="128" Minimum="24" IsSnapToTickEnabled="True" TickFrequency="8" Value="48" />
      </StackPanel>
    </Grid>
  </StackPanel>
</StackPanel>

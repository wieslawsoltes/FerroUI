<!-- Adapted from Samples/Clipboard/{CopyTextClipboard,PasteTextClipboard,OtherClipboardOperations}.txt; see ../NOTICE.md. -->
<StackPanel xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Spacing="12">
  <TextBlock Text="Copy and paste text" FontSize="18"/>
  <TextBox x:Name="ClipboardText" Text="Copy this text" Width="400" HorizontalAlignment="Left" AutomationProperties.Name="Text to copy"/>
  <StackPanel Orientation="Horizontal" Spacing="8">
    <Button x:Name="CopyText" Content="Copy Text to the Clipboard"/>
    <Button x:Name="PasteText" Content="Paste Text from the Clipboard"/>
  </StackPanel>
  <TextBox x:Name="PastedText" IsReadOnly="True" TextWrapping="Wrap" Width="400" MinHeight="60" HorizontalAlignment="Left" AutomationProperties.Name="Pasted text"/>
  <TextBlock Text="Other clipboard operations" FontSize="18"/>
  <StackPanel Orientation="Horizontal" Spacing="8">
    <Button x:Name="ShowClipboardFormats" Content="Show available formats"/>
    <Button x:Name="ClearClipboard" Content="Clear the Clipboard"/>
  </StackPanel>
  <TextBlock x:Name="ClipboardOutput" Text="Choose an operation." TextWrapping="Wrap"/>
</StackPanel>

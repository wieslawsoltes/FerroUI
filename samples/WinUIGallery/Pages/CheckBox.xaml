<!-- Adapted from Samples/CheckBox and its page code behind; see ../NOTICE.md. -->
<StackPanel xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Spacing="12">
  <CheckBox x:Name="TwoState" Content="Two-state CheckBox"/>
  <TextBlock x:Name="TwoStateOutput"/>
  <CheckBox x:Name="ThreeState" Content="Three-state CheckBox" IsThreeState="True"/>
  <TextBlock x:Name="ThreeStateOutput"/>
  <StackPanel Spacing="8">
    <CheckBox x:Name="OptionsAllCheckBox" Content="Select all" IsThreeState="True"/>
    <CheckBox x:Name="Option1CheckBox" Content="Option 1" Margin="24,0,0,0"/>
    <CheckBox x:Name="Option2CheckBox" Content="Option 2" Margin="24,0,0,0" IsChecked="True"/>
    <CheckBox x:Name="Option3CheckBox" Content="Option 3" Margin="24,0,0,0"/>
  </StackPanel>
</StackPanel>

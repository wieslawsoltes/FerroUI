<!-- Adapted from Samples/PasswordBox and its page code behind; see ../NOTICE.md. -->
<StackPanel xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Spacing="12">
  <TextBlock Text="A simple password box" FontSize="18"/>
  <TextBox x:Name="SimplePassword" Width="300" HorizontalAlignment="Left" PasswordChar="●" AutomationProperties.Name="Simple PasswordBox"/>
  <TextBlock x:Name="PasswordValidation" IsVisible="False" TextWrapping="Wrap"/>
  <TextBlock Text="A header, placeholder and custom password character" FontSize="18"/>
  <StackPanel Spacing="8">
    <TextBlock Text="Password"/>
    <TextBox Width="300" HorizontalAlignment="Left" PasswordChar="#" PlaceholderText="Enter your password" AutomationProperties.Name="Password"/>
  </StackPanel>
  <TextBlock Text="Password reveal mode" FontSize="18"/>
  <StackPanel Orientation="Horizontal" Spacing="8">
    <TextBox x:Name="passworBoxWithRevealmode" Width="250" PasswordChar="●" RevealPassword="False" AutomationProperties.Name="Sample password box"/>
    <CheckBox x:Name="revealModeCheckBox" Content="Show password" IsChecked="False"/>
  </StackPanel>
</StackPanel>

<!-- Ported from the three pinned PasswordBox examples of WinUI Gallery (14061eea) and the handlers
     of PasswordBoxPage.xaml.cs (input_samples.rs); see ../NOTICE.md. FerroUI has no PasswordBox:
     each box is a TextBox with a PasswordChar, whose Text, text changes and RevealPassword stand
     for WinUI's Password, PasswordChanged and PasswordRevealMode. Header is composed above the
     box, whose automation name it is. -->
<StackPanel xmlns="https://github.com/ferroui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Spacing="24">
  <StackPanel x:Name="PasswordBoxExample1" Spacing="8">
    <TextBlock Text="A simple PasswordBox." FontSize="18" />
    <StackPanel>
      <TextBox x:Name="SimplePassword" Width="300" HorizontalAlignment="Left" PasswordChar="●"
               AutomationProperties.Name="Simple PasswordBox" />
      <TextBlock x:Name="Control1Output" IsVisible="False" TextWrapping="Wrap" />
    </StackPanel>
  </StackPanel>

  <StackPanel x:Name="PasswordBoxExample2" Spacing="8">
    <TextBlock Text="A PasswordBox with header, placeholder text and custom character." FontSize="18" />
    <StackPanel Spacing="4">
      <TextBlock Text="Password" />
      <TextBox x:Name="HeaderPassword" Width="300" HorizontalAlignment="Left" PasswordChar="#"
               PlaceholderText="Enter your password" AutomationProperties.Name="Password" />
    </StackPanel>
  </StackPanel>

  <StackPanel x:Name="PasswordBoxExample3" Spacing="8">
    <TextBlock Text="A PasswordBox with reveal mode." FontSize="18" />
    <StackPanel Orientation="Horizontal">
      <TextBox x:Name="passworBoxWithRevealmode" Width="250" Margin="0,0,8,0" PasswordChar="●"
               RevealPassword="False" AutomationProperties.Name="Sample password box" />
      <CheckBox x:Name="revealModeCheckBox" Content="Show password" IsChecked="False" />
    </StackPanel>
  </StackPanel>
</StackPanel>

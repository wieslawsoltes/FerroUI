<!-- Ported from the pinned StandardUICommand example of WinUI Gallery (14061eea) and the code behind
     of StandardUICommandPage.xaml.cs (command_samples.rs); see ../NOTICE.md. The Delete command is
     WinUI's StandardUICommand of ferroui-controls, set on the Edit menu's item, on the execute
     SwipeItem of each list item, on the AppBarButton (FerroUI's CommandBarButton) the pointer shows
     over an item and on the item's context menu: each takes the command's label, icon, keyboard
     accelerator and description. WinUI's MenuBar, MenuBarItem and MenuFlyoutItem are FerroUI's Menu
     and MenuItems; the ListView is FerroUI's ListBox, its items built by the code behind
     (ContainerContentChanging gives each container its context menu); the HoveringStates of the
     item template are the hover button's visibility, set on PointerEntered and PointerExited. -->
<StackPanel xmlns="https://github.com/ferroui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="rootGrid" RowDefinitions="Auto,Auto,*">
    <TextBlock Margin="0,0,0,12" TextWrapping="Wrap"
               Text="StandardUICommand allows the sharing of the UX associated with a command. In this instance we are using a StandardUICommand to quickly place the delete command in multiple controls. The StandardUICommand contains the icon, label, keyboard shortcut, and a description." />
    <Menu Grid.Row="1">
      <MenuItem Header="File">
        <MenuItem Header="New" />
        <MenuItem Header="Open..." />
        <MenuItem Header="Save" />
        <MenuItem Header="Exit" />
      </MenuItem>
      <MenuItem Header="Edit">
        <MenuItem x:Name="DeleteFlyoutItem" />
      </MenuItem>
      <MenuItem Header="Help">
        <MenuItem Header="About" />
      </MenuItem>
    </Menu>
    <ListBox x:Name="ListViewRight" Grid.Row="2" Height="500" SelectionMode="Single" />
  </Grid>
</StackPanel>

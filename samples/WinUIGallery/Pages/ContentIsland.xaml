<!-- Ported from the pinned ContentIsland page of WinUI Gallery (14061eea); see ../NOTICE.md. The
     example is not applicable: ContentIsland, ChildSiteLink and the SceneNode model the source
     loads into each card are Windows App SDK APIs for content of another framework or process,
     which FerroUI does not host. The page keeps the text, the button (disabled) and the six cards
     of CardRectangleStyle in the WrapPanel, with a visible diagnostic. ThemeResource is
     DynamicResource, Style is Theme; the card style is written on each rectangle. -->
<StackPanel xmlns="https://github.com/ferroui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Spacing="24">
  <StackPanel x:Name="ContentIslandExample1" Spacing="8">
    <TextBlock Text="A basic content island with content." FontSize="18" />
    <TextBlock Text="Here's an ContentIsland in a ScrollViewer. Notice now the content scrolls and clips correctly."
               TextWrapping="Wrap" />
    <Button x:Name="LoadModelButton" Content="Load model" IsEnabled="False"
            Theme="{DynamicResource AccentButtonStyle}" />
    <TextBlock x:Name="ContentIslandDiagnostic" TextWrapping="Wrap"
               Text="Not applicable: ContentIsland and ChildSiteLink are Windows App SDK APIs that host the content of another framework or process, here a SceneNode model. FerroUI has no content islands; content of a FerroUI composition tree is hosted in an element with ElementCompositionPreview.SetElementChildVisual." />
    <WrapPanel x:Name="_rectanglePanel" HorizontalAlignment="Left">
      <Rectangle Width="400" Height="400" Margin="8" RadiusX="8" RadiusY="8" StrokeThickness="1"
                 Fill="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                 Stroke="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Rectangle Width="400" Height="400" Margin="8" RadiusX="8" RadiusY="8" StrokeThickness="1"
                 Fill="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                 Stroke="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Rectangle Width="400" Height="400" Margin="8" RadiusX="8" RadiusY="8" StrokeThickness="1"
                 Fill="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                 Stroke="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Rectangle Width="400" Height="400" Margin="8" RadiusX="8" RadiusY="8" StrokeThickness="1"
                 Fill="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                 Stroke="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Rectangle Width="400" Height="400" Margin="8" RadiusX="8" RadiusY="8" StrokeThickness="1"
                 Fill="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                 Stroke="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Rectangle Width="400" Height="400" Margin="8" RadiusX="8" RadiusY="8" StrokeThickness="1"
                 Fill="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                 Stroke="{DynamicResource CardStrokeColorDefaultBrush}" />
    </WrapPanel>
  </StackPanel>
</StackPanel>

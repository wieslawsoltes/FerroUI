<!-- Adapted from the pinned Microsoft WinUI Gallery; see ../NOTICE.md. -->
<StackPanel xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Spacing="12">
  <RadioButtons x:Name="Options" Header="Options:">
    <RadioButton x:Name="Option1" AutomationProperties.AutomationId="Option1RadioButton" Content="Option 1"/>
    <RadioButton x:Name="Option2" AutomationProperties.AutomationId="Option2RadioButton" Content="Option 2"/>
    <RadioButton x:Name="Option3" AutomationProperties.AutomationId="Option3RadioButton" Content="Option 3"/>
  </RadioButtons>
  <TextBlock x:Name="Control1Output" Text="Select an option."/>
  <RadioButtons x:Name="BackgroundRadioButtons" SelectedIndex="2" MaxColumns="3" Header="Background">
    <x:String>Green</x:String><x:String>Yellow</x:String><x:String>White</x:String>
  </RadioButtons>
  <RadioButtons x:Name="BorderRadioButtons" SelectedIndex="1" MaxColumns="3" Header="Border">
    <x:String>Green</x:String><x:String>Yellow</x:String><x:String>White</x:String>
  </RadioButtons>
  <Border x:Name="ControlOutput" BorderThickness="10" BorderBrush="#FFFFD700" Background="#FFFFFFFF" Height="50" Margin="0,10,0,10"/>
</StackPanel>

<!-- Ported from the two pinned RadioButton examples of WinUI Gallery (14061eea) and the handlers of
     RadioButtonPage.xaml.cs (examples.rs: RadioButton_Checked, BackgroundColor_SelectionChanged and
     BorderBrush_SelectionChanged); see ../NOTICE.md. The options are named for the Rust handlers.
     As in the source, the border keeps its white background and gold border until a selection
     changes: the source's handlers run while ControlOutput is not created yet. -->
<StackPanel xmlns="https://github.com/ferroui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Spacing="24">
  <StackPanel x:Name="RadioButtonExample1" Spacing="8">
    <TextBlock Text="A group of RadioButton controls in a RadioButtons group." FontSize="18" />
    <StackPanel>
      <RadioButtons x:Name="Options" Header="Options:">
        <RadioButton x:Name="Option1" AutomationProperties.AutomationId="Option1RadioButton" Content="Option 1" />
        <RadioButton x:Name="Option2" AutomationProperties.AutomationId="Option2RadioButton" Content="Option 2" />
        <RadioButton x:Name="Option3" AutomationProperties.AutomationId="Option3RadioButton" Content="Option 3" />
      </RadioButtons>
    </StackPanel>
    <TextBlock x:Name="Control1Output" Text="Select an option." />
  </StackPanel>

  <StackPanel x:Name="RadioButtonExample2" Spacing="8">
    <TextBlock Text="Two RadioButtons controls with strings as options." FontSize="18" />
    <StackPanel>
      <RadioButtons x:Name="BackgroundRadioButtons" Header="Background" MaxColumns="3" SelectedIndex="0">
        <x:String>Green</x:String>
        <x:String>Yellow</x:String>
        <x:String>White</x:String>
      </RadioButtons>
      <RadioButtons x:Name="BorderRadioButtons" Header="Border" MaxColumns="3" SelectedIndex="1">
        <x:String>Green</x:String>
        <x:String>Yellow</x:String>
        <x:String>White</x:String>
      </RadioButtons>
      <Border x:Name="ControlOutput"
              Height="50"
              Margin="0,10,0,10"
              Background="#FFFFFFFF"
              BorderBrush="#FFFFD700"
              BorderThickness="10" />
    </StackPanel>
  </StackPanel>
</StackPanel>

<!-- Ported from the pinned PageTransition example of WinUI Gallery (14061eea), the code behind of
     PageTransitionPage.xaml.cs and its two sample pages (frame_sample.rs); see ../NOTICE.md. The
     native Frame navigates between the source's SamplePage1 and SamplePage2 with
     ForwardButton1_Click (the page type follows BackStackDepth) and BackwardButton1_Click.
     TransitionRadioButton_Checked keeps the selected NavigationTransitionInfo and its code (the
     source's TransitionParameter substitution), which the next navigation plays. The
     RadioButtons' Header is the control's. -->
<Grid xmlns="https://github.com/ferroui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ColumnDefinitions="*,Auto" ColumnSpacing="24">
  <StackPanel x:Name="Example1" Spacing="8">
    <TextBlock Text="Page transitions" FontSize="18" />
    <Frame x:Name="ContentFrame" MinHeight="600" HorizontalAlignment="Stretch" />
    <TextBlock x:Name="NavigationStatus" Text="First page" AutomationProperties.LiveSetting="Polite" />
  </StackPanel>
  <StackPanel Grid.Column="1">
    <RadioButtons x:Name="TransitionModes" Header="Transition modes" SelectedIndex="0">
      <RadioButton x:Name="DefaultRB" AutomationProperties.Name="Default NavigationTransitionInfo" Content="Default" />
      <RadioButton x:Name="EntranceRB" AutomationProperties.Name="EntranceNavigationTransitionInfo" Content="Entrance" />
      <RadioButton x:Name="DrillRB" AutomationProperties.Name="DrillInNavigationTransitionInfo" Content="DrillIn" />
      <RadioButton x:Name="SuppressRB" AutomationProperties.Name="SuppressNavigationTransitionInfo" Content="Suppress" />
      <RadioButton x:Name="SlideFromRightRB" AutomationProperties.Name="SlideNavigationTransitionInfo From Right"
                   Content="Slide from Right" />
      <RadioButton x:Name="SlideFromLeftRB" AutomationProperties.Name="SlideNavigationTransitionInfo From Left"
                   Content="Slide from Left" />
      <RadioButton x:Name="Common" AutomationProperties.Name="CommonNavigationTransitionInfo" Content="Common" />
      <RadioButton x:Name="Continuum" AutomationProperties.Name="ContinuumNavigationTransitionInfo" Content="Continuum" />
    </RadioButtons>
    <TextBlock x:Name="TransitionValue" Margin="0,4,0,0" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
    <TextBlock Margin="0,12,0,8" Text="Navigate" />
    <Button x:Name="NavigationNext" Margin="0,0,0,4" HorizontalAlignment="Stretch" Content="Navigate Forward" />
    <Button x:Name="NavigationBack" HorizontalAlignment="Stretch" Content="Navigate Backward" />
  </StackPanel>
</Grid>

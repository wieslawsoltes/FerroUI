<!-- Ported from the three pinned InfoBar examples of WinUI Gallery (14061eea) and the handlers of
     InfoBarPage.xaml.cs (control_samples.rs); see ../NOTICE.md. The options keep the source's
     TwoWay x:Bind to the InfoBars, compiled by the x:Bind core (#525). The ComboBoxes' Headers
     are composed above them. -->
<StackPanel xmlns="https://github.com/ferroui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Spacing="24">
  <StackPanel x:Name="InfoBarExample1" Spacing="8">
    <TextBlock Text="A closable InfoBar with options to change its Severity." FontSize="18" />
    <Grid ColumnDefinitions="*,150" ColumnSpacing="24">
      <InfoBar x:Name="TestInfoBar1" Title="Title" IsOpen="True" Severity="Informational"
               Message="Essential app message for your users to be informed of, acknowledge, or take action on." />
      <StackPanel Grid.Column="1" Width="150" Spacing="4">
        <CheckBox x:Name="IsOpenCheckBox1" Content="Is Open" IsChecked="{x:Bind TestInfoBar1.IsOpen, Mode=TwoWay}" />
        <TextBlock Text="Severity" />
        <ComboBox x:Name="SeverityComboBox" HorizontalAlignment="Stretch" SelectedIndex="0"
                  AutomationProperties.Name="Severity">
          <x:String>Informational</x:String>
          <x:String>Success</x:String>
          <x:String>Warning</x:String>
          <x:String>Error</x:String>
        </ComboBox>
      </StackPanel>
    </Grid>
  </StackPanel>

  <StackPanel x:Name="InfoBarExample2" Spacing="8">
    <TextBlock Text="A closable InfoBar with a long or short message and various buttons" FontSize="18" />
    <Grid ColumnDefinitions="*,150" ColumnSpacing="24">
      <InfoBar x:Name="TestInfoBar2" Title="Title" IsOpen="True" />
      <StackPanel Grid.Column="1" Width="150" Spacing="4">
        <CheckBox x:Name="IsOpenCheckBox2" Content="Is Open" IsChecked="{x:Bind TestInfoBar2.IsOpen, Mode=TwoWay}" />
        <TextBlock Text="Message Length" />
        <ComboBox x:Name="MessageComboBox" HorizontalAlignment="Stretch" SelectedIndex="1"
                  AutomationProperties.Name="Message Length">
          <x:String>Short</x:String>
          <x:String>Long</x:String>
        </ComboBox>
        <TextBlock Text="Action Button" />
        <ComboBox x:Name="ActionButtonComboBox" HorizontalAlignment="Stretch" SelectedIndex="0"
                  AutomationProperties.Name="Action Button">
          <x:String>None</x:String>
          <x:String>Button</x:String>
          <x:String>Hyperlink</x:String>
        </ComboBox>
      </StackPanel>
    </Grid>
  </StackPanel>

  <StackPanel x:Name="InfoBarExample3" Spacing="8">
    <TextBlock Text="A closable InfoBar with options to display the close button and icon" FontSize="18" />
    <Grid ColumnDefinitions="*,150" ColumnSpacing="24">
      <InfoBar x:Name="TestInfoBar3" Title="Title" IsClosable="True" IsIconVisible="True" IsOpen="True"
               Message="Essential app message for your users to be informed of, acknowledge, or take action on." />
      <StackPanel Grid.Column="1" Width="150" Spacing="4">
        <CheckBox x:Name="IsOpenCheckBox3" Content="Is Open" IsChecked="{x:Bind TestInfoBar3.IsOpen, Mode=TwoWay}" />
        <CheckBox x:Name="IsIconVisibleCheckBox" Content="Is Icon Visible"
                  IsChecked="{x:Bind TestInfoBar3.IsIconVisible, Mode=TwoWay}" />
        <CheckBox x:Name="IsClosableCheckBox" Content="Is Closable"
                  IsChecked="{x:Bind TestInfoBar3.IsClosable, Mode=TwoWay}" />
      </StackPanel>
    </Grid>
  </StackPanel>
</StackPanel>

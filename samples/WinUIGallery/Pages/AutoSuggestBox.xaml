<!-- Ported from the two pinned AutoSuggestBox examples of WinUI Gallery (14061eea) and the
     handlers of AutoSuggestBoxPage.xaml.cs (control_samples.rs); see ../NOTICE.md. The output is
     the gallery's OutputTextBlockStyle (a margin of 8,8,0,0), the title its BaseTextBlockStyle
     (semibold), WrapWholeWords is WrapWithOverflow and the query icon is the Find symbol. -->
<StackPanel xmlns="https://github.com/ferroui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Spacing="24">
  <StackPanel x:Name="Example1" Spacing="8">
    <TextBlock Text="A basic autosuggest box." FontSize="18" />
    <StackPanel Orientation="Horizontal">
      <AutoSuggestBox x:Name="CatSuggestions" Width="300"
                      AutomationProperties.Name="Basic AutoSuggestBox" />
      <TextBlock x:Name="SuggestionOutput" Margin="8,8,0,0" />
    </StackPanel>
  </StackPanel>

  <StackPanel x:Name="Example2" Spacing="8">
    <TextBlock Text="An AutoSuggestBox that provides a SearchBox experience" FontSize="18" />
    <Grid RowDefinitions="Auto,Auto">
      <AutoSuggestBox x:Name="ControlSuggestions" Width="300" HorizontalAlignment="Left"
                      PlaceholderText="Type a control name" UpdateTextOnSelect="False"
                      AutomationProperties.Name="Control search">
        <AutoSuggestBox.QueryIcon><SymbolIcon Symbol="Find" /></AutoSuggestBox.QueryIcon>
      </AutoSuggestBox>
      <RelativePanel x:Name="ControlDetails" Grid.Row="1" Margin="0,8,0,0" HorizontalAlignment="Left"
                     IsVisible="False">
        <Image x:Name="ControlImage" Height="75" />
        <TextBlock x:Name="ControlTitle" Margin="8,0,0,0" FontWeight="SemiBold"
                   RelativePanel.RightOf="ControlImage" />
        <TextBlock x:Name="ControlSubtitle" Margin="8,0,0,0" RelativePanel.AlignLeftWith="ControlTitle"
                   RelativePanel.Below="ControlTitle" TextWrapping="WrapWithOverflow" />
      </RelativePanel>
    </Grid>
    <TextBlock x:Name="ControlImageError" IsVisible="False" TextWrapping="Wrap" />
  </StackPanel>
</StackPanel>

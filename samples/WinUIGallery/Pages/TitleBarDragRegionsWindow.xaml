<!-- Ported from TitleBarDragRegionsWindow.xaml of the pinned WinUI Gallery (14061eea,
     SampleSupport/SamplePages); see ../NOTICE.md. The content of the sample window; the window
     (its Mica backdrop, ExtendsContentIntoTitleBar) and the handlers are in Rust
     (window_samples.rs). The ImageIconSource is a PathIconSource (FerroUI has none). -->
<Grid xmlns="https://github.com/ferroui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="DragRegionsWindowRoot" RowDefinitions="Auto,*">
  <TitleBar x:Name="titleBar" Title="Drag regions" Subtitle="Try dragging the window">
    <TitleBar.Resources>
      <!-- Make TitleBar.Content stretch to fill the available space. -->
      <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
    </TitleBar.Resources>
    <TitleBar.IconSource>
      <PathIconSource Data="M2,2 L14,2 L14,14 L2,14 Z M5,5 L5,11 L11,11 L11,5 Z" />
    </TitleBar.IconSource>
    <TitleBar.Content>
      <Grid ColumnSpacing="8" HorizontalAlignment="Stretch" ColumnDefinitions="*,Auto">
        <!-- Interactive control: excluded from the drag region. -->
        <AutoSuggestBox MaxWidth="580" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                        PlaceholderText="Search...">
          <AutoSuggestBox.QueryIcon><SymbolIcon Symbol="Find" /></AutoSuggestBox.QueryIcon>
        </AutoSuggestBox>
        <!-- Right-side container. Extra elements added at runtime are inserted here so they
             do not collide with the status badge. -->
        <StackPanel x:Name="RightHeaderPanel" Grid.Column="1" Orientation="Horizontal"
                    Spacing="8" VerticalAlignment="Center">
          <!-- Interactive Button. Its drag behavior is controlled with the
               TitleBar.IsDragRegion attached property. -->
          <Button x:Name="StatusBadge" VerticalAlignment="Center" Content="Status" Classes="accent" />
        </StackPanel>
      </Grid>
    </TitleBar.Content>
  </TitleBar>

  <ScrollViewer Grid.Row="1" Padding="32,24">
    <StackPanel MaxWidth="640" Spacing="16">
      <TextBlock Text="Custom drag regions" FontSize="20" FontWeight="SemiBold" />
      <TextBlock TextWrapping="Wrap"
                 Text="Try dragging the window from different parts of the title bar. Interactive controls (like the search box) are automatically excluded from the drag region." />
      <TextBlock Text="Status badge: TitleBar.IsDragRegion" FontWeight="SemiBold" />
      <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                 Text="Pick a value for the badge in the title bar." />
      <RadioButtons x:Name="BadgeIsDragRegionRadios" SelectedIndex="0"
                    AutomationProperties.Name="Status badge IsDragRegion">
        <x:String>Unset (framework decides — clickable, since Button is interactive)</x:String>
        <x:String>True (always draggable — overrides the framework default)</x:String>
        <x:String>False (always clickable)</x:String>
      </RadioButtons>
      <TextBlock Text="Dynamic content" FontWeight="SemiBold" />
      <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                 Text="When you add or remove elements in TitleBar.Content at runtime, call RecomputeDragRegions() to refresh." />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="ToggleExtraButton" Content="Toggle extra title bar button" />
        <Button x:Name="RecomputeDragRegionsButton" Content="RecomputeDragRegions()" />
      </StackPanel>
      <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                 Text="" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</Grid>

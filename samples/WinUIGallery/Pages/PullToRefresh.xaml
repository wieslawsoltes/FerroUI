<StackPanel xmlns="https://github.com/ferroui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Spacing="12">
  <TextBlock Text="Basic PullToRefresh" FontSize="18"/>
  <RefreshContainer x:Name="Refresh" HorizontalAlignment="Left" IsMouseEnabled="True">
    <ListBox x:Name="RefreshItems" Width="300" Height="300" BorderThickness="1" BorderBrush="Black"/>
  </RefreshContainer>
  <Button x:Name="RequestRefresh" Content="Request refresh"/>
  <TextBlock x:Name="RefreshOutput" Text="Pull down or request refresh to insert NewControl." TextWrapping="Wrap"/>
</StackPanel>

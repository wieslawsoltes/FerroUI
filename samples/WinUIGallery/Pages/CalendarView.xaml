<!-- Ported from the pinned CalendarView example of WinUI Gallery (14061eea) and
     CalendarViewPage.xaml.cs (date_samples.rs); see ../NOTICE.md. WinUI's CalendarView is
     FerroUI's Calendar; its SelectionMode Single is SingleDate and Multiple is MultipleRange.
     The calendar identifiers and the languages of the code-behind fill the two last combo
     boxes; the x:Bind of the options are the handlers of date_samples.rs. The Headers of the
     combo boxes are composed above them. -->
<StackPanel xmlns="https://github.com/ferroui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Spacing="24">
  <StackPanel x:Name="CalendarViewExample1" Spacing="8">
    <TextBlock Text="A basic calendar view." FontSize="18" />
    <Grid ColumnDefinitions="*,220" ColumnSpacing="24">
      <Calendar x:Name="Control1" HorizontalAlignment="Left" VerticalAlignment="Top"
                IsGroupLabelVisible="True" SelectionMode="SingleDate" />
      <StackPanel Grid.Column="1" Spacing="4">
        <CheckBox x:Name="isGroupLabelVisible" Content="IsGroupLabelVisible" IsChecked="True" />
        <CheckBox x:Name="isOutOfScopeEnabled" Content="IsOutOfScopeEnabled" IsChecked="True" />
        <TextBlock Text="SelectionMode" Margin="0,10,0,0" />
        <ComboBox x:Name="selectionMode" HorizontalAlignment="Stretch" SelectedIndex="1"
                  AutomationProperties.Name="SelectionMode">
          <x:String>None</x:String>
          <x:String>Single</x:String>
          <x:String>Multiple</x:String>
        </ComboBox>
        <TextBlock Text="CalendarIdentifier" Margin="0,10,0,0" />
        <ComboBox x:Name="calendarIdentifier" Width="220" HorizontalAlignment="Left"
                  AutomationProperties.Name="CalendarIdentifier" />
        <TextBlock Text="Language" Margin="0,10,0,0" />
        <ComboBox x:Name="calendarLanguages" Width="220" HorizontalAlignment="Left"
                  AutomationProperties.Name="Language" />
      </StackPanel>
    </Grid>
  </StackPanel>
</StackPanel>

                <FontIcon FontSize="14" Glyph="&#xE8C8;" />
              </Button>
            </Grid>
          </Border>
        </Grid>
        <Grid MinHeight="68">
          <Border Padding="0,12" CornerRadius="4" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <Grid ColumnDefinitions="272,136,112,194,Auto">
              <TextBlock x:Name="BodyStrongTextBlockStyleExample" Margin="16,0,0,0" VerticalAlignment="Center"
                         Theme="{DynamicResource BodyStrongTextBlockStyle}" Text="Body Strong" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center"
                         Theme="{DynamicResource CaptionTextBlockStyle}" Text="Text, SemiBold" />
              <TextBlock Grid.Column="2" VerticalAlignment="Center"
                         Theme="{DynamicResource CaptionTextBlockStyle}" Text="14/20 epx" />
              <SelectableTextBlock Grid.Column="3" VerticalAlignment="Center" FontFamily="Consolas"
                                   FontSize="12" Text="BodyStrongTextBlockStyle" />
              <Button x:Name="CopyBodyStrongTextBlockStyle" Grid.Column="4" Margin="4,2,8,0"
                      ToolTip.Tip="Copy to clipboard" AutomationProperties.Name="Copy to clipboard">
                <FontIcon FontSize="14" Glyph="&#xE8C8;" />
              </Button>
            </Grid>
          </Border>
        </Grid>
        <Grid MinHeight="68">
          <Border Padding="0,12" CornerRadius="4">
            <Grid ColumnDefinitions="272,136,112,194,Auto">
              <TextBlock x:Name="BodyLargeTextBlockStyleExample" Margin="16,0,0,0" VerticalAlignment="Center"
                         Theme="{DynamicResource BodyLargeTextBlockStyle}" Text="Body Large" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center"
                         Theme="{DynamicResource CaptionTextBlockStyle}" Text="Text, Regular" />
              <TextBlock Grid.Column="2" VerticalAlignment="Center"
                         Theme="{DynamicResource CaptionTextBlockStyle}" Text="18/24 epx" />
              <SelectableTextBlock Grid.Column="3" VerticalAlignment="Center" FontFamily="Consolas"
                                   FontSize="12" Text="BodyLargeTextBlockStyle" />
              <Button x:Name="CopyBodyLargeTextBlockStyle" Grid.Column="4" Margin="4,2,8,0"

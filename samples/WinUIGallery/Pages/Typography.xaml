              </Button>
            </Grid>
          </Border>
        </Grid>
        <Grid MinHeight="68">
          <Border Padding="0,12" CornerRadius="4">
            <Grid ColumnDefinitions="272,136,112,194,Auto">
              <TextBlock x:Name="TitleLargeTextBlockStyleExample" Margin="16,0,0,0" VerticalAlignment="Center"
                         Theme="{DynamicResource TitleLargeTextBlockStyle}" Text="Title Large" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center"
                         Theme="{DynamicResource CaptionTextBlockStyle}" Text="Display, SemiBold" />
              <TextBlock Grid.Column="2" VerticalAlignment="Center"
                         Theme="{DynamicResource CaptionTextBlockStyle}" Text="40/52 epx" />
              <SelectableTextBlock Grid.Column="3" VerticalAlignment="Center" FontFamily="Consolas"
                                   FontSize="12" Text="TitleLargeTextBlockStyle" />
              <Button x:Name="CopyTitleLargeTextBlockStyle" Grid.Column="4" Margin="4,2,8,0"
                      ToolTip.Tip="Copy to clipboard" AutomationProperties.Name="Copy to clipboard">
                <FontIcon FontSize="14" Glyph="&#xE8C8;" />
              </Button>
            </Grid>
          </Border>
        </Grid>
        <Grid MinHeight="68">
          <Border Padding="0,12" CornerRadius="4" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <Grid ColumnDefinitions="272,136,112,194,Auto">
              <TextBlock x:Name="DisplayTextBlockStyleExample" Margin="16,0,0,0" VerticalAlignment="Center"
                         Theme="{DynamicResource DisplayTextBlockStyle}" Text="Display" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center"
                         Theme="{DynamicResource CaptionTextBlockStyle}" Text="Display, SemiBold" />
              <TextBlock Grid.Column="2" VerticalAlignment="Center"
                         Theme="{DynamicResource CaptionTextBlockStyle}" Text="68/92 epx" />
              <SelectableTextBlock Grid.Column="3" VerticalAlignment="Center" FontFamily="Consolas"
                                   FontSize="12" Text="DisplayTextBlockStyle" />
              <Button x:Name="CopyDisplayTextBlockStyle" Grid.Column="4" Margin="4,2,8,0"
                      ToolTip.Tip="Copy to clipboard" AutomationProperties.Name="Copy to clipboard">
                <FontIcon FontSize="14" Glyph="&#xE8C8;" />
              </Button>
            </Grid>
          </Border>
        </Grid>
        <TextBlock x:Name="CopyOutput" Margin="16,8,0,0" FontSize="12" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
    </ScrollViewer>
  </StackPanel>
</StackPanel>

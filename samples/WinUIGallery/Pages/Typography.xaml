              </Button>
            </Grid>
          </Border>
        </Grid>
        <Grid MinHeight="68">
          <Border Padding="0,12" CornerRadius="4">
            <Grid ColumnDefinitions="272,136,112,194,Auto">
              <TextBlock x:Name="SubtitleTextBlockStyleExample" Margin="16,0,0,0" VerticalAlignment="Center"
                         Theme="{DynamicResource SubtitleTextBlockStyle}" Text="Subtitle" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center"
                         Theme="{DynamicResource CaptionTextBlockStyle}" Text="Display, SemiBold" />
              <TextBlock Grid.Column="2" VerticalAlignment="Center"
                         Theme="{DynamicResource CaptionTextBlockStyle}" Text="20/28 epx" />
              <SelectableTextBlock Grid.Column="3" VerticalAlignment="Center" FontFamily="Consolas"
                                   FontSize="12" Text="SubtitleTextBlockStyle" />
              <Button x:Name="CopySubtitleTextBlockStyle" Grid.Column="4" Margin="4,2,8,0"
                      ToolTip.Tip="Copy to clipboard" AutomationProperties.Name="Copy to clipboard">
                <FontIcon FontSize="14" Glyph="&#xE8C8;" />
              </Button>
            </Grid>
          </Border>
        </Grid>
        <Grid MinHeight="68">
          <Border Padding="0,12" CornerRadius="4" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <Grid ColumnDefinitions="272,136,112,194,Auto">
              <TextBlock x:Name="TitleTextBlockStyleExample" Margin="16,0,0,0" VerticalAlignment="Center"
                         Theme="{DynamicResource TitleTextBlockStyle}" Text="Title" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center"
                         Theme="{DynamicResource CaptionTextBlockStyle}" Text="Display, SemiBold" />
              <TextBlock Grid.Column="2" VerticalAlignment="Center"
                         Theme="{DynamicResource CaptionTextBlockStyle}" Text="28/36 epx" />
              <SelectableTextBlock Grid.Column="3" VerticalAlignment="Center" FontFamily="Consolas"
                                   FontSize="12" Text="TitleTextBlockStyle" />
              <Button x:Name="CopyTitleTextBlockStyle" Grid.Column="4" Margin="4,2,8,0"
                      ToolTip.Tip="Copy to clipboard" AutomationProperties.Name="Copy to clipboard">

<Grid xmlns="https://github.com/ferroui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      RowDefinitions="Auto,*">
  <TextBlock x:Name="CollectionImageErrors" TextWrapping="Wrap" MaxLines="3"
             Margin="0,0,0,12" IsVisible="False" />
  <ScrollViewer x:Name="CollectionScroll" Grid.Row="1" KeyboardNavigation.TabNavigation="Once">
    <ItemsRepeater x:Name="CollectionItems" XYFocus.NavigationModes="Enabled">
      <ItemsRepeater.Layout>
        <UniformGridLayout MinColumnSpacing="8" MinRowSpacing="8" MinItemWidth="150" MinItemHeight="120" />
      </ItemsRepeater.Layout>
    </ItemsRepeater>
  </ScrollViewer>
</Grid>

<!-- Ported from the pinned ScrollViewer example of WinUI Gallery (14061eea) and the code behind of
     ScrollViewerPage.xaml.cs (scroll_samples.rs); see ../NOTICE.md. The image is the source's
     cliff.jpg, set by scroll_samples.rs; the zoom slider keeps the source's OneWay x:Bind of the
     scroll viewer's MinZoomFactor and MaxZoomFactor (its Header is composed). FerroUI's ScrollViewer
     has no HorizontalScrollMode or VerticalScrollMode: a Disabled scroll mode is the bar's Disabled
     visibility (no scrolling), Enabled and Auto keep the visibility of the bar's box. WinUI's
     ViewChanged is the change of ZoomFactor; IsVerticalScrollChainingEnabled is
     IsScrollChainingEnabled. -->
<StackPanel xmlns="https://github.com/ferroui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Spacing="24">
  <StackPanel x:Name="Example1" Spacing="8">
    <TextBlock Text="Content inside of a ScrollViewer." FontSize="18" />
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
      <ScrollViewer x:Name="ScrollViewerControl" Width="400" Height="266" HorizontalAlignment="Left"
                    VerticalAlignment="Top" IsTabStop="True" IsScrollChainingEnabled="True" ZoomMode="Enabled"
                    HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Image x:Name="CliffImage" HorizontalAlignment="Left" VerticalAlignment="Top"
               AutomationProperties.Name="cliff" Stretch="None" />
      </ScrollViewer>
      <Grid Grid.Column="1" MinWidth="200" ColumnDefinitions="Auto,*"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
        <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Text="ZoomMode" />
        <ComboBox x:Name="zoomCombo" Grid.Column="1" HorizontalAlignment="Stretch"
                  AutomationProperties.Name="zoom mode" SelectedIndex="1">
          <ComboBoxItem>Disabled</ComboBoxItem>
          <ComboBoxItem>Enabled</ComboBoxItem>
        </ComboBox>
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Text="Zoom" />
        <Slider x:Name="ZoomSlider" Grid.Row="2" Grid.ColumnSpan="2" AutomationProperties.Name="Zoom"
                IsEnabled="True"
                Maximum="{x:Bind ScrollViewerControl.MaxZoomFactor, Mode=OneWay}"
                Minimum="{x:Bind ScrollViewerControl.MinZoomFactor, Mode=OneWay}"
                Value="4" />
        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Margin="0,12" HorizontalAlignment="Center" Text="ScrollMode" />
        <TextBlock Grid.Row="4" Margin="0,0,10,0" VerticalAlignment="Center" Text="Horizontal" />
        <ComboBox x:Name="hsmCombo" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Stretch"
                  AutomationProperties.Name="horizontal scroll mode" SelectedIndex="1">
          <ComboBoxItem>Disabled</ComboBoxItem>
          <ComboBoxItem>Enabled</ComboBoxItem>
          <ComboBoxItem>Auto</ComboBoxItem>
        </ComboBox>
        <TextBlock Grid.Row="5" Margin="0,8,10,0" VerticalAlignment="Center" Text="Vertical" />
        <ComboBox x:Name="vsmCombo" Grid.Row="5" Grid.Column="1" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                  AutomationProperties.Name="vertical scroll mode" SelectedIndex="1">
          <ComboBoxItem>Disabled</ComboBoxItem>
          <ComboBoxItem>Enabled</ComboBoxItem>
          <ComboBoxItem>Auto</ComboBoxItem>
        </ComboBox>
        <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Margin="0,20,0,12" HorizontalAlignment="Center"
                   Text="ScrollbarVisibility" />
        <TextBlock Grid.Row="7" Margin="0,0,10,0" VerticalAlignment="Center" Text="Horizontal" />
        <ComboBox x:Name="hsbvCombo" Grid.Row="7" Grid.Column="1" HorizontalAlignment="Stretch"
                  AutomationProperties.Name="horizontal scroll bar visibility" SelectedIndex="1">
          <ComboBoxItem>Disabled</ComboBoxItem>
          <ComboBoxItem>Auto</ComboBoxItem>
          <ComboBoxItem>Hidden</ComboBoxItem>
          <ComboBoxItem>Visible</ComboBoxItem>
        </ComboBox>
        <TextBlock Grid.Row="8" Margin="0,8,10,0" VerticalAlignment="Center" Text="Vertical" />
        <ComboBox x:Name="vsbvCombo" Grid.Row="8" Grid.Column="1" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                  AutomationProperties.Name="vertical scroll bar visibility" SelectedIndex="1">
          <ComboBoxItem>Disabled</ComboBoxItem>
          <ComboBoxItem>Auto</ComboBoxItem>
          <ComboBoxItem>Hidden</ComboBoxItem>
          <ComboBoxItem>Visible</ComboBoxItem>
        </ComboBox>
      </Grid>
    </Grid>
  </StackPanel>
</StackPanel>

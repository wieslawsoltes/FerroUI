<rxui:ReactiveUserControlBase xmlns="https://github.com/ferroui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:rxui="http://reactiveui.net"
                              x:Class="ReactiveDemo.NugetDetailsView">
  <!-- Deviation (DEVIATIONS.md, samples): the reference's root is the generic
       ReactiveUserControl<NugetDetailsViewModel> (x:TypeArguments); the root is the class markup
       creates, ReactiveUserControlBase, and the code behind types the control with
       ReactiveUserControl::<NugetDetailsViewModel>::from_control (nuget_details_view.rs). -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Image x:Name="iconImage" Margin="6" Width="64" Height="64"
           HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <!-- Deviation (DEVIATIONS.md, samples): the reference ends its text block with an inline
         Hyperlink. FerroUI has no inline hyperlink; the link is a HyperlinkButton below the
         text, a command source as the Hyperlink is. -->
    <StackPanel Grid.Column="1" Margin="6" VerticalAlignment="Center">
      <TextBlock TextWrapping="WrapWithOverflow">
        <Run FontSize="14" FontWeight="SemiBold" x:Name="titleRun"/>
        <LineBreak />
        <Run FontSize="12" x:Name="descriptionRun"/>
      </TextBlock>
      <HyperlinkButton x:Name="openButton" Content="Open" Padding="0" />
    </StackPanel>
  </Grid>
</rxui:ReactiveUserControlBase>

<!-- Not as in upstream: the shell of the catalog is a NavigationView (docs/porting/winui-controls.md,
     "The ControlCatalog shell"), where upstream's MainView is a DrawerPage with a drawer of
     buttons and expanders. The sections are top-level items with their pages as child items, the
     search box is the AutoSuggestBox of the pane, the settings page is the settings item, the logo
     is the pane header, and the content is a Frame whose journal drives the back button. The class
     (main_view.rs) builds the items from the page list of the view model. -->
<ContentPage x:Class="ControlCatalog.MainView"
             xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:ControlCatalog"
             xmlns:viewModels="using:ControlCatalog.ViewModels"
             d:DesignWidth="1200"
             d:DesignHeight="720"
             x:DataType="viewModels:MainWindowViewModel">
  <Design.DataContext>
    <viewModels:MainWindowViewModel/>
  </Design.DataContext>
  <ContentPage.Resources>
    <ResourceDictionary>
      <x:Double x:Key="TabbedPageTabItemHeaderFontSize">20</x:Double>
      <Thickness x:Key="TabbedPageTabStripPadding">10</Thickness>
      <ControlTheme x:Key="{x:Type local:MainView}"
                    TargetType="local:MainView"
                    BasedOn="{StaticResource {x:Type ContentPage}}" />
    </ResourceDictionary>
  </ContentPage.Resources>
  <ContentPage.Styles>
    <Style Selector="TextBlock.h2">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="MaxWidth" Value="400" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
  </ContentPage.Styles>

  <Grid RowDefinitions="Auto,*">
  <!-- The title bar of the shell, as in WinUI Gallery: drawn in the title bar of the window while
       its client area extends into it (desktop), a plain top row where there is no window chrome
       (mobile, browser), collapsed otherwise; the class moves the search box into it and hides
       the back and toggle buttons and the logo of the pane header of the navigation view while it
       is shown (WinUI Gallery has no pane header; the logo stays for the classic chrome). -->
  <TitleBar x:Name="AppTitleBar"
            Title="FerroUI Control Gallery"
            IsPaneToggleButtonVisible="True"
            IsVisible="False">
    <TitleBar.Resources>
      <!-- As WinUI Gallery: the search box stretches up to its maximum width, centred. -->
      <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
    </TitleBar.Resources>
  </TitleBar>
  <NavigationView x:Name="Navigation"
                  Grid.Row="1"
                  PaneDisplayMode="Auto"
                  CompactModeThresholdWidth="640"
                  ExpandedModeThresholdWidth="1008"
                  OpenPaneLength="260"
                  IsSettingsVisible="True"
                  IsBackButtonVisible="Visible"
                  IsBackEnabled="False"
                  AlwaysShowHeader="False">
    <NavigationView.PaneHeader>
      <Border x:Name="Logo"
              Margin="4,0"
              Background="Transparent"
              Cursor="Hand"
              VerticalAlignment="Center"
              Tapped="FerroIcon_OnTapped">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <PathIcon Width="28" Height="28"
                    Foreground="#007DF9"
                    Data="{StaticResource AppIcon}" />
          <TextBlock Text="FerroUI" VerticalAlignment="Center" FontWeight="SemiBold" />
        </StackPanel>
      </Border>
    </NavigationView.PaneHeader>
    <NavigationView.AutoSuggestBox>
      <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search..." VerticalAlignment="Center">
        <AutoSuggestBox.QueryIcon>
          <PathIcon Data="{StaticResource SearchIcon}" />
        </AutoSuggestBox.QueryIcon>
      </AutoSuggestBox>
    </NavigationView.AutoSuggestBox>
    <Frame x:Name="ContentFrame" />
  </NavigationView>
  </Grid>
</ContentPage>

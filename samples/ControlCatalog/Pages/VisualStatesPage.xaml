<ContentPage Theme="{StaticResource ScrollPage}" x:Class="ControlCatalog.Pages.VisualStatesPage"
             xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Header="Visual States">
  <!-- Not from upstream: WinUI's VisualStateManager (docs/porting/winui-calculator-gaps.md). The
       groups are on the content of the page, as WinUI applications declare them on the root of a
       page or a user control; the buttons call VisualStateManager.GoToState. -->
  <StackPanel x:Name="LayoutRoot" Spacing="16">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="CommonStates">
        <VisualState x:Name="Normal"/>
        <VisualState x:Name="Highlighted">
          <VisualState.Setters>
            <Setter Target="Card.Background" Value="#FF0F6CBD"/>
            <Setter Target="Caption.Foreground" Value="White"/>
            <Setter Target="Caption.Text" Value="Highlighted"/>
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Dimmed">
          <VisualState.Setters>
            <Setter Target="Card.Opacity" Value="0.4"/>
            <Setter Target="Caption.Text" Value="Dimmed"/>
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
      <VisualStateGroup x:Name="SizeStates">
        <VisualState x:Name="Compact"/>
        <VisualState x:Name="Expanded">
          <VisualState.Setters>
            <Setter Target="Card.Width" Value="380"/>
            <Setter Target="Card.Height" Value="180"/>
            <Setter Target="Caption.FontSize" Value="28"/>
            <Setter Target="Badge.(DockPanel.Dock)" Value="Bottom"/>
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <TextBlock TextWrapping="Wrap"
               Text="A page with two visual state groups. Each button goes to a state; a state of CommonStates and one of SizeStates are current at the same time. The setters of a state set properties of named elements while the state is current, above their local values." />

    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="CommonStates" Width="100" VerticalAlignment="Center"/>
      <Button Content="Normal" Tag="Normal" Click="GoToState_OnClick"/>
      <Button Content="Highlighted" Tag="Highlighted" Click="GoToState_OnClick"/>
      <Button Content="Dimmed" Tag="Dimmed" Click="GoToState_OnClick"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="SizeStates" Width="100" VerticalAlignment="Center"/>
      <Button Content="Compact" Tag="Compact" Click="GoToState_OnClick"/>
      <Button Content="Expanded" Tag="Expanded" Click="GoToState_OnClick"/>
    </StackPanel>

    <Border x:Name="Card"
            Width="240"
            Height="110"
            HorizontalAlignment="Left"
            CornerRadius="8"
            Background="#FFE5E5E5">
      <DockPanel Margin="16">
        <TextBlock x:Name="Badge" DockPanel.Dock="Top" Text="Card" Opacity="0.7"/>
        <TextBlock x:Name="Caption" Text="Normal" FontSize="18" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <TextBlock x:Name="CurrentStates" Text="CommonStates: (none), SizeStates: (none)"/>
  </StackPanel>
</ContentPage>

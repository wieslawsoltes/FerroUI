<ContentPage Theme="{StaticResource ScrollPage}" xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Header="ScrollView"
             x:Class="ControlCatalog.Pages.ScrollViewPage">
  <!-- Not from upstream: WinUI's ScrollView (docs/porting/winui-controls.md, section 10.12). Its
       template is in the WinUI theme and the macOS and Material themes derived from it. The
       buttons are handled by the class of the page. -->
  <StackPanel Orientation="Vertical" Spacing="4" MaxWidth="800">
    <TextBlock Margin="2" Classes="h2" TextWrapping="Wrap">A ScrollView scrolls and zooms its content through a ScrollPresenter, with a scroll bar on each axis. ScrollTo, ScrollBy and ZoomTo change the view in code, animated unless the options turn the animation off.</TextBlock>

    <TextBlock Margin="2,12,2,2" FontSize="14" FontWeight="Bold">Both axes and zoom (ContentOrientation None, ZoomMode Enabled; Ctrl and the wheel zoom)</TextBlock>
    <ScrollView x:Name="Both" Margin="2" Width="300" Height="200" HorizontalAlignment="Left"
                ContentOrientation="None" ZoomMode="Enabled">
      <Grid Width="600" Height="400" ColumnDefinitions="*,*" RowDefinitions="*,*">
        <Border Background="SteelBlue" />
        <Border Grid.Column="1" Background="Goldenrod" />
        <Border Grid.Row="1" Background="SeaGreen" />
        <Border Grid.Row="1" Grid.Column="1" Background="IndianRed" />
      </Grid>
    </ScrollView>
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="2">
      <Button x:Name="ScrollToEnd" Content="ScrollTo the end" />
      <Button x:Name="ZoomIn" Content="ZoomBy 0.5" />
      <Button x:Name="Reset" Content="Reset" />
    </StackPanel>
    <TextBlock x:Name="View" Margin="2" />

    <TextBlock Margin="2,12,2,2" FontSize="14" FontWeight="Bold">Vertical (the default orientation) with the vertical bar always visible</TextBlock>
    <ScrollView x:Name="Vertical" Margin="2" Width="300" Height="150" HorizontalAlignment="Left"
                VerticalScrollBarVisibility="Visible">
      <StackPanel x:Name="Lines" Spacing="4" />
    </ScrollView>
  </StackPanel>
</ContentPage>

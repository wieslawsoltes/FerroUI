<ContentPage Theme="{StaticResource ScrollPage}" xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ControlCatalog.ViewModels"
             xmlns:media="using:FerroUI.Media"
             Header="TransitioningContentControl"
             x:DataType="vm:TransitioningContentControlPageViewModel"
             x:Class="ControlCatalog.Pages.TransitioningContentControlPage">

    <ContentPage.DataContext>
        <vm:TransitioningContentControlPageViewModel />
    </ContentPage.DataContext>

    <StackPanel MaxWidth="720" HorizontalAlignment="Stretch" Spacing="16" Margin="2,4,2,16">
        <TextBlock Classes="h2" TextWrapping="Wrap">Choose a transition, then switch photos to see it in action.</TextBlock>

        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12" ClipToBounds="True">
            <StackPanel Spacing="12">
                <Border x:Name="PhotoViewport" Height="320" ClipToBounds="{Binding ClipToBounds}">
                    <TransitioningContentControl Content="{Binding SelectedImage}"
                                                 PageTransition="{Binding SelectedTransition.Transition}"
                                                 IsTransitionReversed="{Binding Reversed}">
                        <TransitioningContentControl.ContentTemplate>
                            <DataTemplate x:DataType="media:IImage">
                                <Image Source="{Binding}" Stretch="UniformToFill" />
                            </DataTemplate>
                        </TransitioningContentControl.ContentTemplate>
                    </TransitioningContentControl>
                </Border>

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Button Command="{Binding PrevImage}" Content="Previous" AutomationProperties.Name="Previous photo" />
                    <TextBlock Grid.Column="1" Text="{Binding SelectedImageCaption}" TextWrapping="Wrap"
                               TextAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Button Grid.Column="2" Command="{Binding NextImage}" Content="Next" AutomationProperties.Name="Next photo" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12">
            <WrapPanel ItemSpacing="20" LineSpacing="12">
                <StackPanel Width="180" Spacing="4">
                    <TextBlock Text="Transition" />
                    <ComboBox x:Name="TransitionChoice" HorizontalAlignment="Stretch" AutomationProperties.Name="Transition"
                              ItemsSource="{Binding PageTransitions}" SelectedItem="{Binding SelectedTransition, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Width="128" Spacing="4">
                    <TextBlock Text="Duration (ms)" />
                    <NumericUpDown x:Name="TransitionDuration" AutomationProperties.Name="Duration in milliseconds"
                                   Value="{Binding Duration, Mode=TwoWay}" Increment="250" Minimum="100" FormatString="0" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Clip to bounds" />
                    <ToggleSwitch x:Name="TransitionClipping" AutomationProperties.Name="Clip to bounds"
                                  IsChecked="{Binding ClipToBounds, Mode=TwoWay}" />
                </StackPanel>
            </WrapPanel>
        </Border>
    </StackPanel>
</ContentPage>

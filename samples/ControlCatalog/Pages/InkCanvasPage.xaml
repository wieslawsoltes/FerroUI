<ContentPage xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ControlCatalog.Pages.InkCanvasPage"
             Header="InkCanvas">
  <!-- Not from upstream: the page of the port's InkCanvas (docs/porting/winui-inking.md), after
       WinUI's InkCanvas test page. -->
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12" Margin="20">
    <StackPanel Spacing="6">
      <TextBlock Classes="h2" Text="InkCanvas" />
      <TextBlock TextWrapping="Wrap" Text="An InkCanvas collects ink: draw with a pen, the mouse or touch (this page enables all three; the default is pen only). Its strokes can be selected, copied, pasted, cleared, saved and restored through its stroke container." />
    </StackPanel>
    <Border Grid.Row="1" MinHeight="320" BorderBrush="Gray" BorderThickness="1" Background="White">
      <InkCanvas x:Name="InkSurface" />
    </Border>
    <WrapPanel Grid.Row="2" Orientation="Horizontal" ItemSpacing="10" LineSpacing="10">
      <Button x:Name="SelectInk" Content="Select all" />
      <Button x:Name="CopyInk" Content="Copy" />
      <Button x:Name="PasteInk" Content="Paste" />
      <Button x:Name="ClearInk" Content="Clear" />
      <Button x:Name="SaveInk" Content="Save snapshot" />
      <Button x:Name="RestoreInk" Content="Restore snapshot" />
      <TextBlock x:Name="InkStatus" VerticalAlignment="Center" Text="Ready" />
    </WrapPanel>
  </Grid>
</ContentPage>

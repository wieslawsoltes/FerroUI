<ContentPage Theme="{StaticResource ScrollPage}" xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Header="MapControl"
             x:Class="ControlCatalog.Pages.MapControlPage">
  <Grid x:Name="LayoutRoot" RowDefinitions="Auto,480">
    <TextBlock Margin="0,0,0,8" TextWrapping="Wrap"
               Text="Drag to move, use the wheel or a pinch to zoom, or focus the map and use the arrow, plus and minus keys. The tiles are an offline grid: the catalog makes no network requests." />
  </Grid>
</ContentPage>

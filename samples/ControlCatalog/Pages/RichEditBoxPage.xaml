<ContentPage xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ControlCatalog.Controls"
             x:Class="ControlCatalog.Pages.RichEditBoxPage"
             Theme="{StaticResource ScrollPage}"
             Header="RichEditBox">
  <StackPanel Spacing="24" MaxWidth="920">
    <TextBlock Text="Edit formatted paragraphs with undo, the context menu and input methods, and show the same document in a read-only view."
               TextWrapping="Wrap" />

    <controls:SampleSection Header="Rich editing"
                            Description="Select a range and use the toolbar or context menu. Undo and redo include both text and formatting changes. The list buttons set the list type of the selected paragraphs (ParagraphFormat.ListType) and change their level.">
      <StackPanel Spacing="12">
        <WrapPanel>
          <ToggleButton Content="Bold" FontWeight="Bold" Margin="0,0,6,6" Focusable="False"
                        Command="{Binding #Editor.ToggleBold}"
                        IsEnabled="{Binding #Editor.CanFormat}"
                        IsChecked="{Binding #Editor.IsBold, Mode=OneWay}" />
          <ToggleButton Content="Italic" FontStyle="Italic" Margin="0,0,6,6" Focusable="False"
                        Command="{Binding #Editor.ToggleItalic}"
                        IsEnabled="{Binding #Editor.CanFormat}"
                        IsChecked="{Binding #Editor.IsItalic, Mode=OneWay}" />
          <ToggleButton Margin="0,0,18,6" Focusable="False"
                        Command="{Binding #Editor.ToggleUnderline}"
                        IsEnabled="{Binding #Editor.CanFormat}"
                        IsChecked="{Binding #Editor.IsUnderlined, Mode=OneWay}">
            <TextBlock Text="Underline" TextDecorations="Underline" />
          </ToggleButton>
          <Button Content="Undo" Margin="0,0,6,6" Focusable="False"
                  Command="{Binding #Editor.Undo}" IsEnabled="{Binding #Editor.CanUndo}" />
          <Button Content="Redo" Margin="0,0,18,6" Focusable="False"
                  Command="{Binding #Editor.Redo}" IsEnabled="{Binding #Editor.CanRedo}" />
          <CheckBox Content="Read only" Margin="0,0,0,6"
                    IsChecked="{Binding #Editor.IsReadOnly, Mode=TwoWay}" />
        </WrapPanel>
        <WrapPanel>
          <Button Name="BulletsButton" Content="Bullets" Margin="0,0,6,6" Focusable="False"
                  IsEnabled="{Binding #Editor.CanFormat}" />
          <Button Name="NumbersButton" Content="Numbers" Margin="0,0,6,6" Focusable="False"
                  IsEnabled="{Binding #Editor.CanFormat}" />
          <Button Name="RomanButton" Content="Roman numerals" Margin="0,0,6,6" Focusable="False"
                  IsEnabled="{Binding #Editor.CanFormat}" />
          <Button Name="NoListButton" Content="No list" Margin="0,0,18,6" Focusable="False"
                  IsEnabled="{Binding #Editor.CanFormat}" />
          <Button Name="IndentButton" Content="Indent" Margin="0,0,6,6" Focusable="False"
                  IsEnabled="{Binding #Editor.CanFormat}" />
          <Button Name="OutdentButton" Content="Outdent" Margin="0,0,0,6" Focusable="False"
                  IsEnabled="{Binding #Editor.CanFormat}" />
        </WrapPanel>
        <RichEditBox Name="Editor" Height="240" Header="Project notes"
                     Description="Try typing, formatting a mixed selection, or pasting rich content."
                     PlaceholderText="Write your notes here" AcceptsTab="True">
          <Paragraph>
            <Bold><Run Text="A shared document" /></Bold>
          </Paragraph>
          <!-- The inlines are on one line: whitespace between them would be text. -->
          <Paragraph><Run Text="Start with a thought, add " /><Italic><Run Text="emphasis" /></Italic><Run Text=", and " /><Underline><Run Text="mark the next step" /></Underline><Run Text=". The preview below follows every edit." /></Paragraph>
          <Paragraph>
            <Run Text="Text can include café, 日本語, العربية and emoji 😀." />
          </Paragraph>
          <Paragraph ListType="Bullet">
            <Run Text="Lists: Enter continues a list and ends it in an empty item" />
          </Paragraph>
          <Paragraph ListType="Bullet">
            <Run Text="Tab and Shift+Tab at the start of an item change its level" />
          </Paragraph>
        </RichEditBox>
      </StackPanel>
      <controls:SampleSection.Code><x:String xml:space="preserve"><![CDATA[<RichEditBox Name="Editor" Header="Project notes"
             PlaceholderText="Write your notes here">
  <Paragraph><Bold><Run Text="A shared document" /></Bold></Paragraph>
</RichEditBox>
<Button Content="Bold" Command="{Binding #Editor.ToggleBold}"
        IsEnabled="{Binding #Editor.CanFormat}" />

// Code-behind: a list is the list type of the selected paragraphs.
editor.apply_paragraph_format(&ParagraphFormat {
    list_type: Some(MarkerType::Bullet),
    ..Default::default()
})?;
editor.change_list_level(1)?;]]></x:String></controls:SampleSection.Code>
    </controls:SampleSection>

    <controls:SampleSection Header="Read-only preview"
                            Description="A read-only view of the editor's content: the page copies each change of the editor's document into the view's own document (a document belongs to one view; RichTextBlockOverflow continues a view instead).">
      <Border BorderBrush="{DynamicResource CatalogBaseMediumColor}" BorderThickness="1" Padding="16">
        <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled">
          <RichTextBlock Name="Preview" TextWrapping="Wrap" />
        </ScrollViewer>
      </Border>
      <controls:SampleSection.Code><x:String xml:space="preserve"><![CDATA[<RichTextBlock Name="Preview" TextWrapping="Wrap" />

// Code-behind: copy each change of the editor's document into the view's.
let document = editor.rich_document();
let (preview, source) = (preview.downgrade(), document.downgrade());
document.changed(move |_| {
    if let (Some(preview), Some(source)) = (preview.upgrade(), source.upgrade()) {
        let _ = preview.rich_document().restore(&source.snapshot());
    }
}).detach();]]></x:String></controls:SampleSection.Code>
    </controls:SampleSection>

  </StackPanel>
</ContentPage>

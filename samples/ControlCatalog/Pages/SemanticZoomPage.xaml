<ContentPage Theme="{StaticResource ScrollPage}" xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Header="SemanticZoom"
             x:Class="ControlCatalog.Pages.SemanticZoomPage">
  <!-- Not from upstream: WinUI's SemanticZoom (docs/porting/winui-controls.md, section 10.20). Its
       template is in the WinUI theme and its derived themes. semantic_zoom_page.rs groups the
       fruits by their first letter (a CollectionViewSource with IsSourceGrouped). -->
  <StackPanel Orientation="Vertical" Spacing="4" MaxWidth="800">
    <TextBlock Margin="2" Classes="h2" TextWrapping="Wrap">A SemanticZoom shows two views of the same content: a zoomed-in view of the items and a zoomed-out view of their groups. Tap a group header, or press Ctrl+Minus, to zoom out; tap a group to go back to its items.</TextBlock>

    <StackPanel Orientation="Horizontal" Spacing="8" Margin="2">
      <Button x:Name="ToggleButton" Content="ToggleActiveView" />
      <TextBlock x:Name="ViewStatus" VerticalAlignment="Center" Text="Zoomed in" />
    </StackPanel>

    <SemanticZoom x:Name="Fruits" Width="420" Height="320" HorizontalAlignment="Left" Margin="2">
      <SemanticZoom.ZoomedInView>
        <GridView x:Name="FruitItems" SelectionMode="None">
          <GridView.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding}" />
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </GridView.GroupStyle>
        </GridView>
      </SemanticZoom.ZoomedInView>
      <SemanticZoom.ZoomedOutView>
        <ListView x:Name="FruitGroups" SelectionMode="None">
          <ListView.ItemTemplate>
            <DataTemplate>
              <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Group}" />
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </SemanticZoom.ZoomedOutView>
    </SemanticZoom>
  </StackPanel>
</ContentPage>

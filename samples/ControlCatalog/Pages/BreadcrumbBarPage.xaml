<ContentPage Theme="{StaticResource ScrollPage}" xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Header="BreadcrumbBar"
             x:Class="ControlCatalog.Pages.BreadcrumbBarPage">
  <!-- Not from upstream: WinUI's BreadcrumbBar (docs/porting/winui-controls.md, section 10.11). Its
       template is in the WinUI theme and the macOS and Material themes derived from it. The items
       sources are set by the class of the page. -->
  <StackPanel Orientation="Vertical" Spacing="4" MaxWidth="800">
    <TextBlock Margin="2" Classes="h2" TextWrapping="Wrap">A BreadcrumbBar shows the path to the current location. Clicking a crumb raises ItemClicked; the items that do not fit are behind an ellipsis, which lists them in a flyout.</TextBlock>

    <TextBlock Margin="2,12,2,2" FontSize="14" FontWeight="Bold">A path</TextBlock>
    <BreadcrumbBar x:Name="Path" Margin="2" />
    <TextBlock x:Name="Clicked" Margin="2" Text="Click a folder to go back to it." />
    <Button x:Name="Reset" Margin="2" Content="Reset the path" />

    <TextBlock Margin="2,12,2,2" FontSize="14" FontWeight="Bold">A narrow bar: the first folders behind the ellipsis</TextBlock>
    <BreadcrumbBar x:Name="Narrow" Margin="2" Width="260" HorizontalAlignment="Left" />

    <TextBlock Margin="2,12,2,2" FontSize="14" FontWeight="Bold">An item template</TextBlock>
    <BreadcrumbBar x:Name="Templated" Margin="2">
      <BreadcrumbBar.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}" Text="&#xE8B7;" VerticalAlignment="Center" />
            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </BreadcrumbBar.ItemTemplate>
    </BreadcrumbBar>
  </StackPanel>
</ContentPage>

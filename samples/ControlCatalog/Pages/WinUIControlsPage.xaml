<ContentPage Theme="{StaticResource ScrollPage}" xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Header="WinUI controls"
             x:Class="ControlCatalog.Pages.WinUIControlsPage">
  <!-- Not from upstream: the WinUI controls FerroUI ports as controls of ferroui-controls
       (docs/porting/winui-controls.md). Their templates are in the WinUI theme and the macOS and
       Material themes derived from it; the Fluent and Simple themes have none, so the controls
       show nothing there. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel x:Name="Sections" Orientation="Vertical" Spacing="16" Margin="0,0,0,24">
      <TextBlock Classes="h2" TextWrapping="Wrap">The WinUI 3 controls of FerroUI, styled by the WinUI, macOS and Material themes</TextBlock>

      <!-- Icons (W4) -->
      <StackPanel x:Name="Icons" Spacing="8">
        <TextBlock Classes="h3" Text="Icons" />
        <TextBlock TextWrapping="Wrap" Text="SymbolIcon and FontIcon draw glyphs of the symbol font of the theme (SymbolThemeFontFamily); off Windows an application supplies the font." />
        <StackPanel Orientation="Horizontal" Spacing="16">
          <SymbolIcon Symbol="Accept" />
          <SymbolIcon Symbol="Setting" />
          <SymbolIcon Symbol="Mail" />
          <SymbolIcon Symbol="Favorite" />
          <FontIcon Glyph="&#xE710;" />
          <FontIcon Glyph="&#xE72D;" FontSize="28" />
          <PathIcon Data="M12,2L15,9L22,9L16.5,13.5L18.5,21L12,16.5L5.5,21L7.5,13.5L2,9L9,9Z" />
        </StackPanel>
      </StackPanel>

      <!-- Status (W5) -->
      <StackPanel x:Name="Status" Spacing="8">
        <TextBlock Classes="h3" Text="Status" />
        <InfoBar IsOpen="True" Severity="Informational" Title="Informational" Message="An InfoBar shows an essential app-wide message." />
        <InfoBar IsOpen="True" Severity="Success" Title="Success" Message="The operation completed." />
        <InfoBar IsOpen="True" Severity="Warning" Title="Warning" Message="Something needs attention." />
        <InfoBar IsOpen="True" Severity="Error" Title="Error" Message="The operation failed." IsClosable="False" />
        <StackPanel Orientation="Horizontal" Spacing="24">
          <InfoBadge VerticalAlignment="Center" />
          <InfoBadge Value="7" VerticalAlignment="Center" />
          <InfoBadge Value="42" VerticalAlignment="Center" />
          <ProgressRing IsIndeterminate="True" />
          <ProgressRing IsIndeterminate="False" Value="60" />
        </StackPanel>
      </StackPanel>

      <!-- Input (W6) -->
      <StackPanel x:Name="Input" Spacing="8" MaxWidth="480" HorizontalAlignment="Left">
        <TextBlock Classes="h3" Text="Input" />
        <NumberBox Header="NumberBox (inline spin buttons, expressions)" Value="42" SpinButtonPlacementMode="Inline" AcceptsExpression="True" />
        <AutoSuggestBox Header="AutoSuggestBox" PlaceholderText="Search" />
        <RadioButtons Header="RadioButtons" MaxColumns="3">
          <RadioButton Content="Red" />
          <RadioButton Content="Green" IsChecked="True" />
          <RadioButton Content="Blue" />
        </RadioButtons>
        <RatingControl Caption="RatingControl" Value="3.5" />
      </StackPanel>

      <!-- Navigation (W8) -->
      <StackPanel x:Name="Navigation" Spacing="8">
        <TextBlock Classes="h3" Text="Navigation" />
        <Border BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Height="360">
          <NavigationView PaneDisplayMode="Left" PaneTitle="NavigationView" IsSettingsVisible="True">
            <NavigationView.MenuItems>
              <NavigationViewItemHeader Content="Pages" />
              <NavigationViewItem Content="Home" IsSelected="True">
                <NavigationViewItem.Icon>
                  <SymbolIcon Symbol="Home" />
                </NavigationViewItem.Icon>
              </NavigationViewItem>
              <NavigationViewItem Content="Mail">
                <NavigationViewItem.Icon>
                  <SymbolIcon Symbol="Mail" />
                </NavigationViewItem.Icon>
              </NavigationViewItem>
              <NavigationViewItemSeparator />
              <NavigationViewItem Content="Folder">
                <NavigationViewItem.Icon>
                  <SymbolIcon Symbol="Folder" />
                </NavigationViewItem.Icon>
              </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame />
          </NavigationView>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</ContentPage>

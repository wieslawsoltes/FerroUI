# Auto detect text files and perform LF normalization
* text=auto

# Rust sources and JSON are LF in every checkout: the generated ones (emitter output and its
# position map, rust paths, compiled XAML) are compared byte for byte with what the generators
# write, which is LF, also on Windows.
*.rs text eol=lf
*.json text eol=lf

# Preserve the original upstream bytes of the legacy grammar test inputs.
src/FerroUI.TextMate/tests/fixtures/pinned-grammars/*.tmLanguage.json -text
src/FerroUI.TextMate/tests/fixtures/pinned-grammars/*.ng.json -text

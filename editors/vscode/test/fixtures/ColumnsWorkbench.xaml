<Border xmlns="https://github.com/ferroui"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="520"
        d:Fixtures='{"default":"Accounts","fixtures":[{"name":"Accounts","data":{"Accounts":[{"Account":"Alpine Labs","Owner":"Maya Novak","Region":"EMEA","Tier":"Enterprise","Active":true},{"Account":"Cedar Systems","Owner":"Owen Chen","Region":"AMER","Tier":"Growth","Active":true},{"Account":"Harbor &amp; Co","Owner":"Nina Patel","Region":"APAC","Tier":"Standard","Active":false}]}}]}'
        Background="#FFF2F5FA" Padding="26">
  <Grid RowDefinitions="Auto,Auto,*,Auto,*" RowSpacing="10">
    <TextBlock Text="Customer accounts" FontSize="27" FontWeight="SemiBold" Foreground="#FF172942" />
    <TextBlock Grid.Row="1" Text="Portfolio" FontSize="15" FontWeight="SemiBold" Foreground="#FF233E5C" />
    <Border Grid.Row="2" CornerRadius="8" Background="White" BorderBrush="#FFDFE6F0" BorderThickness="1" ClipToBounds="True">
      <TableView Name="Portfolio" ItemsSource="{Binding Accounts}">
        <TableView.Columns>
          <TableViewColumn Header="Account" Width="2*" Binding="{Binding Account}" />
          <!-- Contacts are shared by the customer and account views. -->
          <TableViewColumn Header="Owner" Width="*" Binding="{Binding Owner}" />
          <TableViewColumn Header="Region" Width="108" Binding="{Binding Region}" />
        </TableView.Columns>
      </TableView>
    </Border>
    <TextBlock Grid.Row="3" Text="Account status" FontSize="15" FontWeight="SemiBold" Foreground="#FF233E5C" />
    <Border Grid.Row="4" CornerRadius="8" Background="White" BorderBrush="#FFDFE6F0" BorderThickness="1" ClipToBounds="True">
      <TreeDataGrid Name="Status" ItemsSource="{Binding Accounts}">
        <TreeDataGridTextColumn Header="Account" Width="2*" Binding="{Binding Account}" />
        <TreeDataGridTemplateColumn Header="Tier" Width="*">
          <TreeDataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Border Background="#FFE7EFFB" CornerRadius="10" HorizontalAlignment="Left" Padding="9,2">
                <TextBlock Text="{Binding Tier}" Foreground="#FF264C73" />
              </Border>
            </DataTemplate>
          </TreeDataGridTemplateColumn.CellTemplate>
        </TreeDataGridTemplateColumn>
        <TreeDataGridCheckBoxColumn Header="Active" Width="108" Binding="{Binding Active}" IsReadOnly="True" />
      </TreeDataGrid>
    </Border>
  </Grid>
</Border>

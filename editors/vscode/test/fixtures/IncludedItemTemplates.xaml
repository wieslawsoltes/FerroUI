<UserControl xmlns="https://github.com/ferroui"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:Fixtures='{"default":"Customers","fixtures":[{"name":"Customers","data":{"Customers":[{"Name":"Alpine &amp; Co.","Tier":"Enterprise"},{"Name":"Juniper Studio","Tier":"Growth"}]}}]}'>
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="Templates/Customer%20Rows.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Border Background="#FFF6F9FB" Padding="24">
    <StackPanel Spacing="12">
      <TextBlock Text="Customer directory" FontSize="26" FontWeight="SemiBold" Foreground="#FF172F41" />
      <ListBox Name="Directory" Height="164" ItemsSource="{Binding Customers}" ItemTemplate="{StaticResource CustomerRow}" />
      <TextBlock Text="Review queue" FontSize="16" Foreground="#FF1D4862" />
      <ListBox Name="ReviewQueue" Height="82" ItemsSource="{Binding Customers}" ItemTemplate="{StaticResource CompactCustomer}" />
    </StackPanel>
  </Border>
</UserControl>

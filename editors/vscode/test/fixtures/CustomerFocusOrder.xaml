<Border xmlns="https://github.com/ferroui" Name="CustomerFocusForm" Padding="28" CornerRadius="16"
        Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#EDF3FA">
    <StackPanel Spacing="14">
        <TextBlock Text="Customer contact" FontSize="28" FontWeight="SemiBold" Foreground="#182D45"/>
        <Label Name="EmailLabel" Content="Email address" Target="{Binding ElementName=CustomerEmail}"/>
        <TextBox Name="CustomerEmail" TabIndex="1" PlaceholderText="name@example.com"/>
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Name="SaveContact" Content="Save contact" TabIndex="2"/>
            <Button Name="DiscardContact" Content="Discard changes" TabIndex="0" IsEnabled="False"/>
        </StackPanel>
        <StackPanel Name="Channels" Orientation="Horizontal" Spacing="12"
                    KeyboardNavigation.TabNavigation="Once" TabIndex="3">
            <CheckBox Name="EmailChannel" Content="Email updates" TabIndex="0"/>
            <CheckBox Name="PhoneChannel" Content="Phone updates" TabIndex="1"/>
        </StackPanel>
    </StackPanel>
</Border>

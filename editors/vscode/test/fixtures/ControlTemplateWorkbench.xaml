<StackPanel xmlns="https://github.com/ferroui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Background="#FFF5F8FC" Spacing="14" Margin="20">
  <StackPanel.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="Templates/ControlTemplates.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <ControlTemplate x:Key="InputOnly" TargetType="TextBox">
        <Border Background="#FFE3E9F1"><TextPresenter x:Name="PART_TextPresenter" /></Border>
      </ControlTemplate>
      <SolidColorBrush x:Key="LocalInk" Color="#FF20657B" />
      <ControlTemplate x:Key="LocalButton" TargetType="Button">
        <Border Background="{StaticResource LocalInk}" CornerRadius="6" Padding="12,4">
          <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </ResourceDictionary>
  </StackPanel.Resources>
  <StackPanel.Styles>
    <Style Selector="Button.inherited">
      <Setter Property="Template">
        <ControlTemplate TargetType="Button">
          <Border Background="{StaticResource LocalInk}" Padding="12,4">
            <ContentPresenter Content="{TemplateBinding Content}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
  </StackPanel.Styles>
  <TextBlock Text="Actions" FontSize="24" Foreground="#FF1F3043" />
  <Button Name="SharedAction" Height="52" Template="{StaticResource SharedButton}" Content="Continue" />
  <Button Name="LocalAction" Height="48" Template="{StaticResource LocalButton}" Content="Review">
    <Button.Resources>
      <SolidColorBrush x:Key="LocalInk" Color="#FFF39776" />
    </Button.Resources>
  </Button>
  <Button Name="SecondLocalAction" Height="48" Template="{StaticResource LocalButton}" Content="Approve" />
  <Button Name="InheritedAction" Classes="inherited" Height="48" Content="Share">
    <Button.Resources>
      <SolidColorBrush x:Key="LocalInk" Color="#FFF39776" />
    </Button.Resources>
  </Button>
  <Button Name="ThemedAction" Theme="{StaticResource SharedButtonTheme}" Height="48" Content="Archive" />
  <Button Name="PlainAction" Height="48" Content="Plain action" />
</StackPanel>

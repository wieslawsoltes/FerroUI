[graphite] Balance the references of the Metal render pipeline descriptor

MtlGraphicsPipeline::Make creates the vertex and fragment functions with
-newFunctionWithName:, the vertex descriptor with create_vertex_descriptor()
and the color attachment with create_color_attachment(), each returning an
object the caller owns (+1). It then assigns them to properties of the
MTLRenderPipelineDescriptor, which retain their values, and never releases
its own references. Under manual reference counting every pipeline that is
created leaks two MTLFunctions, an MTLVertexDescriptor and an
MTLRenderPipelineColorAttachmentDescriptor.

Hold each of the four in an sk_cfp, which releases the creation reference
when it goes out of scope, and assign the raw pointer to the descriptor.
The removed TODO asked whether the descriptor cleans the vertex descriptor
up; it does not release the caller's reference.

Found by a soak that resizes a surface and recreates the Graphite context
again and again: the native heap grew, and the retained allocation stacks
pointed at this function.

Applies to src/gpu/graphite/mtl/MtlGraphicsPipeline.mm at the m153 milestone
(`git apply -p1` from the root of a Skia checkout).

--- a/src/gpu/graphite/mtl/MtlGraphicsPipeline.mm
+++ b/src/gpu/graphite/mtl/MtlGraphicsPipeline.mm
@@ -394,20 +394,22 @@
     NSString* fsFuncName = [NSString stringWithUTF8String: std::get<1>(fragmentMain).c_str()];
 
     (*psoDescriptor).label = labelName;
-    (*psoDescriptor).vertexFunction = [vsLibrary newFunctionWithName: vsFuncName];
-    (*psoDescriptor).fragmentFunction = [fsLibrary newFunctionWithName: fsFuncName];
-
-    // TODO: I *think* this gets cleaned up by the pipelineDescriptor?
-    (*psoDescriptor).vertexDescriptor = create_vertex_descriptor(appendStepFunc,
-                                                                 staticAttrs,
-                                                                 appendAttrs);
+    sk_cfp<id<MTLFunction>> vertexFunction([vsLibrary newFunctionWithName: vsFuncName]);
+    sk_cfp<id<MTLFunction>> fragmentFunction([fsLibrary newFunctionWithName: fsFuncName]);
+    (*psoDescriptor).vertexFunction = vertexFunction.get();
+    (*psoDescriptor).fragmentFunction = fragmentFunction.get();
+
+    sk_cfp<MTLVertexDescriptor*> vertexDescriptor(create_vertex_descriptor(appendStepFunc,
+                                                                        staticAttrs,
+                                                                        appendAttrs));
+    (*psoDescriptor).vertexDescriptor = vertexDescriptor.get();
 
     TextureFormat colorFormat = renderPassDesc.fColorAttachment.fFormat;
     TextureFormat dsFormat = renderPassDesc.fDepthStencilAttachment.fFormat;
 
-    auto mtlColorAttachment =
-            create_color_attachment(TextureFormatToMTLPixelFormat(colorFormat), blendInfo);
-    (*psoDescriptor).colorAttachments[0] = mtlColorAttachment;
+    sk_cfp<MTLRenderPipelineColorAttachmentDescriptor*> mtlColorAttachment(
+            create_color_attachment(TextureFormatToMTLPixelFormat(colorFormat), blendInfo));
+    (*psoDescriptor).colorAttachments[0] = mtlColorAttachment.get();
 
     (*psoDescriptor).rasterSampleCount = (uint8_t) renderPassDesc.fColorAttachment.fSampleCount;
 

// ---- driving an interface from a script --------------------------------------------------

// Raises BackRequested on the control of the element with the key `key`, as the control does.
fn raiseBackRequestedAt(key: int) -> int = toInt(ferro_raise(object: findKey(key: key), event: 3))
// Raises Click on the control of the element with the key `key`, as the control does.
fn raiseClickAt(key: int) -> int = toInt(ferro_raise(object: findKey(key: key), event: 4))
// Raises Closed on the control of the element with the key `key`, as the control does.
fn raiseClosedAt(key: int) -> int = toInt(ferro_raise(object: findKey(key: key), event: 5))
// Raises Closing on the control of the element with the key `key`, as the control does.
fn raiseClosingAt(key: int) -> int = toInt(ferro_raise(object: findKey(key: key), event: 6))
// Raises Collapsed on the control of the element with the key `key`, as the control does.
fn raiseCollapsedAt(key: int) -> int = toInt(ferro_raise(object: findKey(key: key), event: 7))
// Raises ContextCanceled on the control of the element with the key `key`, as the control
// does.
fn raiseContextCanceledAt(key: int) -> int = toInt(ferro_raise(object: findKey(key: key), event: 9))
// Raises CopyingToClipboard on the control of the element with the key `key`, as the control
// does.
fn raiseCopyingToClipboardAt(key: int) -> int = toInt(ferro_raise(object: findKey(key: key), event: 12))
// Raises CuttingToClipboard on the control of the element with the key `key`, as the control
// does.
fn raiseCuttingToClipboardAt(key: int) -> int = toInt(ferro_raise(object: findKey(key: key), event: 13))
// Raises Expanded on the control of the element with the key `key`, as the control does.
fn raiseExpandedAt(key: int) -> int = toInt(ferro_raise(object: findKey(key: key), event: 22))
// Raises HorizontalSnapPointsChanged on the control of the element with the key `key`, as the
// control does.
fn raiseHorizontalSnapPointsChangedAt(key: int) -> int = toInt(ferro_raise(object: findKey(key: key), event: 27))
// Raises IsCheckedChanged on the control of the element with the key `key`, as the control
// does.

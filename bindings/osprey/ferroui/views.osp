// Sends the message `message` on every AccessKey (AccessKeyHandler).
fn onAccessKey<M>(message: M) -> Attr<M> = AttrOn { attrOnEvent: 1, attrOnMessage: message }
// Sends the message `message` on every AccessKeyPressed (AccessKeyHandler).

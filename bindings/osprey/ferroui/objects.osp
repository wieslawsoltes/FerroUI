// ---- events --------------------------------------------------------------------------------

// Dispatches `tag` to the dispatcher of the application on every AccessKey (AccessKeyHandler).
// Defines the AccessKey event: raised on the element an access key targets.
fn onAccessKey(object: int, tag: int) -> int = {
    let _ = ferro_subscribe(object: object, event: 1, function: dispatchEvent, token: tag)
    object
}
// Raises AccessKey on the object, as the control does (for tests and scripts).
fn raiseAccessKey(object: int) -> int = {
    let _ = ferro_raise(object: object, event: 1)
    object
}
// Dispatches `tag` to the dispatcher of the application on every AccessKeyPressed
// (AccessKeyHandler). Defines the AccessKeyPressed event: raised to find the target of an
// access key.
fn onAccessKeyPressed(object: int, tag: int) -> int = {
    let _ = ferro_subscribe(object: object, event: 2, function: dispatchEvent, token: tag)
    object
}
// Raises AccessKeyPressed on the object, as the control does (for tests and scripts).
fn raiseAccessKeyPressed(object: int) -> int = {
    let _ = ferro_raise(object: object, event: 2)
    object
}
// Dispatches `tag` to the dispatcher of the application on every BackRequested (TopLevel).
// Defines the `BackRequested` event.
fn onBackRequested(object: int, tag: int) -> int = {
    let _ = ferro_subscribe(object: object, event: 3, function: dispatchEvent, token: tag)
    object
}
// Raises BackRequested on the object, as the control does (for tests and scripts).
fn raiseBackRequested(object: int) -> int = {
    let _ = ferro_raise(object: object, event: 3)
    object
}
// Dispatches `tag` to the dispatcher of the application on every Click (Button, MenuItem,

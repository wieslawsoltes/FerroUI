// The name of a member of AcrylicBrushBackgroundSource, which the ABI sets by name.
fn acrylicBrushBackgroundSourceName(value: AcrylicBrushBackgroundSource) -> string = match value {
    AcrylicBrushBackgroundSourceHostBackdrop => "HostBackdrop"
    AcrylicBrushBackgroundSourceBackdrop => "Backdrop"
}


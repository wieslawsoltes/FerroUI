// The name of a member of TabPlacement, which the ABI sets by name.
fn tabPlacementName(value: TabPlacement) -> string = match value {
    TabPlacementAuto => "Auto"
    TabPlacementTop => "Top"
    TabPlacementBottom => "Bottom"
    TabPlacementLeft => "Left"
    TabPlacementRight => "Right"
}

// Defines how text is aligned.
type TextAlignment = TextAlignmentLeft | TextAlignmentCenter | TextAlignmentRight | TextAlignmentStart | TextAlignmentEnd | TextAlignmentDetectFromContent | TextAlignmentJustify
// The name of a member of TextAlignment, which the ABI sets by name.
fn textAlignmentName(value: TextAlignment) -> string = match value {
    TextAlignmentLeft => "Left"
    TextAlignmentCenter => "Center"
    TextAlignmentRight => "Right"
    TextAlignmentStart => "Start"
    TextAlignmentEnd => "End"
    TextAlignmentDetectFromContent => "DetectFromContent"
    TextAlignmentJustify => "Justify"
}

// Specifies the vertical position of a text decoration.
type TextDecorationLocation = TextDecorationLocationUnderline | TextDecorationLocationOverline | TextDecorationLocationStrikethrough | TextDecorationLocationBaseline
// The name of a member of TextDecorationLocation, which the ABI sets by name.
fn textDecorationLocationName(value: TextDecorationLocation) -> string = match value {
    TextDecorationLocationUnderline => "Underline"
    TextDecorationLocationOverline => "Overline"
    TextDecorationLocationStrikethrough => "Strikethrough"
    TextDecorationLocationBaseline => "Baseline"
}

// Specifies the unit type of either a text decoration offset or thickness value.
type TextDecorationUnit = TextDecorationUnitFontRecommended | TextDecorationUnitFontRenderingEmSize | TextDecorationUnitPixel
// The name of a member of TextDecorationUnit, which the ABI sets by name.
fn textDecorationUnitName(value: TextDecorationUnit) -> string = match value {
    TextDecorationUnitFontRecommended => "FontRecommended"
    TextDecorationUnitFontRenderingEmSize => "FontRenderingEmSize"
    TextDecorationUnitPixel => "Pixel"
}

// The kind of content a text input expects, which lets the platform show an appropriate

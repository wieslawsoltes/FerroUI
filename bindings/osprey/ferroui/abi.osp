type TextInputContentType = TextInputContentTypeNormal | TextInputContentTypeAlpha | TextInputContentTypeDigits | TextInputContentTypePin | TextInputContentTypeNumber | TextInputContentTypeEmail | TextInputContentTypeUrl | TextInputContentTypeName | TextInputContentTypePassword | TextInputContentTypeSocial | TextInputContentTypeSearch
// The name of a member of TextInputContentType, which the ABI sets by name.
fn textInputContentTypeName(value: TextInputContentType) -> string = match value {
    TextInputContentTypeNormal => "Normal"
    TextInputContentTypeAlpha => "Alpha"
    TextInputContentTypeDigits => "Digits"
    TextInputContentTypePin => "Pin"
    TextInputContentTypeNumber => "Number"
    TextInputContentTypeEmail => "Email"
    TextInputContentTypeUrl => "Url"
    TextInputContentTypeName => "Name"
    TextInputContentTypePassword => "Password"
    TextInputContentTypeSocial => "Social"
    TextInputContentTypeSearch => "Search"
}

// The label of the return key of an on-screen keyboard.
type TextInputReturnKeyType = TextInputReturnKeyTypeDefault | TextInputReturnKeyTypeReturn | TextInputReturnKeyTypeDone | TextInputReturnKeyTypeGo | TextInputReturnKeyTypeSend | TextInputReturnKeyTypeSearch | TextInputReturnKeyTypeNext | TextInputReturnKeyTypePrevious
// The name of a member of TextInputReturnKeyType, which the ABI sets by name.
fn textInputReturnKeyTypeName(value: TextInputReturnKeyType) -> string = match value {
    TextInputReturnKeyTypeDefault => "Default"
    TextInputReturnKeyTypeReturn => "Return"
    TextInputReturnKeyTypeDone => "Done"
    TextInputReturnKeyTypeGo => "Go"
    TextInputReturnKeyTypeSend => "Send"
    TextInputReturnKeyTypeSearch => "Search"
    TextInputReturnKeyTypeNext => "Next"
    TextInputReturnKeyTypePrevious => "Previous"
}

// Where a text block puts the height layout rounding adds to it: below its text (the
// reference's placement, the default) or above it (WinUI's).
type TextLayoutRoundingPlacement = TextLayoutRoundingPlacementBelow | TextLayoutRoundingPlacementAbove
// The name of a member of TextLayoutRoundingPlacement, which the ABI sets by name.
fn textLayoutRoundingPlacementName(value: TextLayoutRoundingPlacement) -> string = match value {
    TextLayoutRoundingPlacementBelow => "Below"
    TextLayoutRoundingPlacementAbove => "Above"
}

// How the box of each line of text is bounded: by the ascent and the descent of its font (the
// default), or trimmed to the cap height above the baseline, to the baseline below it, or
// both.
type TextLineBounds = TextLineBoundsFull | TextLineBoundsTrimToCapHeight | TextLineBoundsTrimToBaseline | TextLineBoundsTight
// The name of a member of TextLineBounds, which the ABI sets by name.
fn textLineBoundsName(value: TextLineBounds) -> string = match value {
    TextLineBoundsFull => "Full"
    TextLineBoundsTrimToCapHeight => "TrimToCapHeight"
    TextLineBoundsTrimToBaseline => "TrimToBaseline"
    TextLineBoundsTight => "Tight"
}

// Controls the wrapping mode of text.
type TextWrapping = TextWrappingNoWrap | TextWrappingWrap | TextWrappingWrapWithOverflow
// The name of a member of TextWrapping, which the ABI sets by name.
fn textWrappingName(value: TextWrapping) -> string = match value {
    TextWrappingNoWrap => "NoWrap"
    TextWrappingWrap => "Wrap"
    TextWrappingWrapWithOverflow => "WrapWithOverflow"
}

// Enum which describes how to position the [`TickBar`].
type TickBarPlacement = TickBarPlacementLeft | TickBarPlacementTop | TickBarPlacementRight | TickBarPlacementBottom
// The name of a member of TickBarPlacement, which the ABI sets by name.

// ---- driving an interface from a script --------------------------------------------------

// raiseBackRequestedAt(key: int) -> int: raises BackRequested on the control of the element
// with the key `key`, as the control does.
fn raiseBackRequestedAt(key) = toInt(ferro_raise(object: findKey(key: key), event: 3))
// raiseClickAt(key: int) -> int: raises Click on the control of the element with the key
// `key`, as the control does.
fn raiseClickAt(key) = toInt(ferro_raise(object: findKey(key: key), event: 4))
// raiseClosedAt(key: int) -> int: raises Closed on the control of the element with the key
// `key`, as the control does.
fn raiseClosedAt(key) = toInt(ferro_raise(object: findKey(key: key), event: 5))
// raiseClosingAt(key: int) -> int: raises Closing on the control of the element with the key
// `key`, as the control does.
fn raiseClosingAt(key) = toInt(ferro_raise(object: findKey(key: key), event: 6))
// raiseCollapsedAt(key: int) -> int: raises Collapsed on the control of the element with the
// key `key`, as the control does.
fn raiseCollapsedAt(key) = toInt(ferro_raise(object: findKey(key: key), event: 7))
// raiseContextCanceledAt(key: int) -> int: raises ContextCanceled on the control of the
// element with the key `key`, as the control does.
fn raiseContextCanceledAt(key) = toInt(ferro_raise(object: findKey(key: key), event: 9))
// raiseCopyingToClipboardAt(key: int) -> int: raises CopyingToClipboard on the control of the
// element with the key `key`, as the control does.
fn raiseCopyingToClipboardAt(key) = toInt(ferro_raise(object: findKey(key: key), event: 12))
// raiseCuttingToClipboardAt(key: int) -> int: raises CuttingToClipboard on the control of the
// element with the key `key`, as the control does.
fn raiseCuttingToClipboardAt(key) = toInt(ferro_raise(object: findKey(key: key), event: 13))
// raiseExpandedAt(key: int) -> int: raises Expanded on the control of the element with the key
// `key`, as the control does.
fn raiseExpandedAt(key) = toInt(ferro_raise(object: findKey(key: key), event: 22))
// raiseHorizontalSnapPointsChangedAt(key: int) -> int: raises HorizontalSnapPointsChanged on
// the control of the element with the key `key`, as the control does.
fn raiseHorizontalSnapPointsChangedAt(key) = toInt(ferro_raise(object: findKey(key: key), event: 27))
// raiseIsCheckedChangedAt(key: int) -> int: raises IsCheckedChanged on the control of the

    WrapPanelItemsAlignmentStretchAll => "StretchAll"
}

// Whether the final item of a [`WrapPanel`] fills its line (WinUI `WrapPanelItemsStretch`).
type WrapPanelItemsStretch = WrapPanelItemsStretchNone | WrapPanelItemsStretchLast
// wrapPanelItemsStretchName(value: WrapPanelItemsStretch) -> string: the name of a member, which the ABI sets by name.
fn wrapPanelItemsStretchName(value) = match value {
    WrapPanelItemsStretchNone => "None"
    WrapPanelItemsStretchLast => "Last"
}

// The window type hint of an X11 window.
type X11NetWmWindowType = X11NetWmWindowTypeNormal | X11NetWmWindowTypeDialog | X11NetWmWindowTypeUtility | X11NetWmWindowTypeMenu | X11NetWmWindowTypeToolbar | X11NetWmWindowTypeSplash | X11NetWmWindowTypeDock | X11NetWmWindowTypeDesktop
// x11NetWmWindowTypeName(value: X11NetWmWindowType) -> string: the name of a member, which the ABI sets by name.
fn x11NetWmWindowTypeName(value) = match value {
    X11NetWmWindowTypeNormal => "Normal"
    X11NetWmWindowTypeDialog => "Dialog"
    X11NetWmWindowTypeUtility => "Utility"
    X11NetWmWindowTypeMenu => "Menu"
    X11NetWmWindowTypeToolbar => "Toolbar"
    X11NetWmWindowTypeSplash => "Splash"
    X11NetWmWindowTypeDock => "Dock"
    X11NetWmWindowTypeDesktop => "Desktop"
}

// Whether the user can zoom the content of a scroll viewer (WinUI
// `Microsoft.UI.Xaml.Controls.ZoomMode`; not upstream, see docs/porting/winui-composition.md,
// phase 7).
type ZoomMode = ZoomModeDisabled | ZoomModeEnabled
// zoomModeName(value: ZoomMode) -> string: the name of a member, which the ABI sets by name.
fn zoomModeName(value) = match value {
    ZoomModeDisabled => "Disabled"
    ZoomModeEnabled => "Enabled"
}

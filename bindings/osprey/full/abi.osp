// ---- the C ABI -------------------------------------------------------------------------------

// The version of the ABI ([`FERRO_ABI_VERSION`]). A binding checks it before its first call.
// Any thread.
extern fn ferro_abi_version() -> int32
// Shows the window `window` ([`ferro_create`](crate::ferro_create) of the type `Window`).
// While it is open the library holds it (its handle can be released), and the main loop of
// [`ferro_app_run`] runs until the last window shown this way closes. [`FERRO_INVALID_STATE`]
// before `ferro_app_run` has started. UI thread only.
extern fn ferro_show(window: int) -> int32
// Closes the window `window`, as its close button does. UI thread only.
extern fn ferro_close(window: int) -> int32
// Ends the main loop of [`ferro_app_run`] once the work at hand is done; the open windows are
// left as they are. UI thread only.
extern fn ferro_quit() -> int32
// Runs an application on the platform of the operating system (macOS, Windows or Linux, with
// the Fluent theme): makes the calling thread the UI thread
// ([`ferro_init`](crate::ferro_init); on macOS it must be the main thread), sets the
// application up, calls `on_start(token)`, and runs the main loop until the last window shown
// with [`ferro_show`] closes or [`ferro_quit`] is called; then returns
// [`FERRO_OK`](crate::FERRO_OK). `on_start` creates the windows and shows them; if it returns
// a value other than `0` the loop does not run and the result is
// [`FERRO_START_FAILED`](crate::FERRO_START_FAILED). `options` is reserved and must be `NULL`
// in ABI version 1. Runs once per process ([`FERRO_INVALID_STATE`] the second time). With the
// environment variable `FERROUI_SMOKE_EXIT_MS=<n>` the windows close after `n` milliseconds,
// as for every sample of the repository (the smoke runs of continuous integration). A build
// without the desktop platform (the feature `desktop` of `ferroui-capi`) returns
// [`FERRO_NOT_SUPPORTED`](crate::FERRO_NOT_SUPPORTED).
extern fn ferro_app_run(options: Ptr, onStart: fn(int) -> int, token: int) -> int32
// The message of the last call that failed on the calling thread, as UTF-8 with a NUL at the
// end; an empty string when none has failed. Successful calls leave it as it is (as `errno`).
// The text stays valid until the next failure on the thread. Any thread.
extern fn ferro_last_error() -> string
// The status code of the last call that failed on the calling thread ([`FERRO_OK`] when none
// has failed): the code of a function that returns a handle, which is `0` on a failure. Any
// thread.
extern fn ferro_last_error_code() -> int32
// Forgets the last failure of the calling thread: [`ferro_last_error_code`] is [`FERRO_OK`]
// and [`ferro_last_error`] empty until the next failure. A binding whose language reports
// errors as values (Osprey's `Result`) clears it before a call whose result does not tell a
// failure apart (a getter with a fallback) and reads the code after it. Any thread.
extern fn ferro_clear_error()
// The horizontal position of the pointer of the routed event being handled (a pointer event,
// or a tap: `Tapped`, `DoubleTapped`), relative to the visual `relative_to`, or to the top
// level the event happened in for `0`. NaN on a failure (recorded: [`FERRO_INVALID_STATE`]
// outside a handler, [`FERRO_NOT_SUPPORTED`] for an event without a position). UI thread only.
extern fn ferro_event_x(relativeTo: int) -> float
// The vertical position of the pointer of the routed event being handled; see
// [`ferro_event_x`]. UI thread only.
extern fn ferro_event_y(relativeTo: int) -> float
// The button a pointer event being handled is about: `1` left, `2` right, `3` middle, `4` and
// `5` the first and second extra buttons (the values of `MouseButton`), for a press or a
// release; `0` for a pointer event that is not about a button (a move). A negative status for
// an event that is not a pointer event, or outside a handler. UI thread only.
extern fn ferro_event_button() -> int
// The key of the key event being handled (`KeyDown`, `KeyUp`), as the name of the member of
// `Key` (`Return`, which is also named `Enter`; `Escape`; `A`), NUL-terminated and owned by
// the library until the next call of `ferro_event_key` on the thread. `NULL` on a failure
// (recorded: an event that is not a key event, or outside a handler). UI thread only.
extern fn ferro_event_key() -> string
// Moves the keyboard focus to `object` (an input element: a text box, a button), as a click on
// it does. [`FERRO_INVALID_STATE`] when it cannot take the focus now (it is not focusable, not
// enabled, or not in a shown window yet: posting the call with
// [`ferro_post`](crate::ferro_post) focuses it once it is). UI thread only.
extern fn ferro_focus(object: int) -> int32
// Attaches `function` to the event `event` ([`ferro_event_id`](crate::ferro_event_id)) of
// `object`: it is called with `token` on every raise of the event, on the UI thread (see
// [`FerroEventFn`]). For a routed event the handler listens to the direct and the bubbling
// route of events that are not handled yet, and a result other than `0` marks the event as
// handled. Returns a positive subscription ID for [`ferro_unsubscribe`], or a negative status.
// UI thread only.
extern fn ferro_subscribe(object: int, event: int, function: fn(int, int, int) -> int, token: int) -> int
// [`ferro_subscribe`] to the one dispatcher of the thread
// ([`ferro_frame_dispatcher`](crate::ferro_frame_dispatcher)): every raise of the event calls
// it with `tag`, the sender and the argument, as an event bound in a frame does (the event
// text and number are empty). For a binding with one dispatcher, which then needs no
// trampoline of its own between the library and its dispatcher: one indirect call per event.
// Returns a positive subscription ID for [`ferro_unsubscribe`], or a negative status. UI
// thread only.
extern fn ferro_subscribe_dispatch(object: int, event: int, tag: int) -> int
// Removes the handler of the subscription `subscription` ([`ferro_subscribe`]); its user data
// is released ([`ferro_subscribe_data`]). [`FERRO_NOT_FOUND`] for an ID that is not a live
// subscription. UI thread only.
extern fn ferro_unsubscribe(subscription: int) -> int32
// Raises the routed event `event` on `object` with plain event arguments, as the control does
// when it raises it (`Click` of a button, as a click does): for tests and for driving an
// interface from code. [`FERRO_NOT_SUPPORTED`] for an event whose arguments carry more than
// the routing state (a pointer event). UI thread only.
extern fn ferro_raise(object: int, event: int) -> int32
// Gives the size of the measure or arrange callback that runs now (the innermost), for a
// language that cannot write through the `double *` of the callback. UI thread only.
extern fn ferro_layout_result(width: float, height: float) -> int32
// Registers the class `name` (UTF-8, `length` bytes, negative for NUL-terminated) on the base
// `base` (`FERRO_BASE_CONTROL`, `_PANEL`, `_DECORATOR`, `_CONTENT_CONTROL`) and returns its
// type ID, or a negative status. The class is created by name
// ([`ferro_create`](crate::ferro_create) with [`ferro_type_id`](crate::ferro_type_id)), in
// frames and wherever a class is found by name; its virtual members call the callbacks set
// with `ferro_class_on_*`, and fall through to the base where none is set. At most 64 classes
// per process. UI thread only.
extern fn ferro_class_register(name: string, length: int, base: int32) -> int
// Sets the callback that gives each new instance of the class its data (`NULL` for none). UI
// thread only.
extern fn ferro_class_on_create(classId: int, callback: fn(Ptr, int) -> int32) -> int32
// Sets the measure callback of the class (`NULL`: the base measures). UI thread only.
extern fn ferro_class_on_measure(classId: int, callback: fn(Ptr, int, float, float, Ptr, Ptr) -> int32) -> int32
// Sets the arrange callback of the class (`NULL`: the base arranges). UI thread only.
extern fn ferro_class_on_arrange(classId: int, callback: fn(Ptr, int, float, float, Ptr, Ptr) -> int32) -> int32
// Sets the render callback of the class (`NULL`: the base renders alone). The base renders
// first (the background of a panel); the callback draws over it. UI thread only.
extern fn ferro_class_on_render(classId: int, callback: fn(Ptr, int, int) -> int32) -> int32
// Sets the callback called when a property the class registered changes, with its ID. UI
// thread only.
extern fn ferro_class_on_property_changed(classId: int, callback: fn(Ptr, int, int) -> int32) -> int32
// Sets the callback called when an instance is attached to the visual tree. UI thread only.
extern fn ferro_class_on_attached(classId: int, callback: fn(Ptr, int, int) -> int32) -> int32
// Sets the callback called when an instance is detached from the visual tree. UI thread only.
extern fn ferro_class_on_detached(classId: int, callback: fn(Ptr, int, int) -> int32) -> int32
// Sets the callback called when the template of an instance is applied (a class on
// `FERRO_BASE_CONTENT_CONTROL`); [`ferro_template_part`] finds its parts. UI thread only.
extern fn ferro_class_on_apply_template(classId: int, callback: fn(Ptr, int, int) -> int32) -> int32
// Sets the callback of pointer presses, releases and moves on an instance. UI thread only.
extern fn ferro_class_on_pointer(classId: int, callback: fn(Ptr, int, int32, float, float, int) -> int32) -> int32
// Sets the callback of key presses and releases on an instance. UI thread only.
extern fn ferro_class_on_key(classId: int, callback: fn(Ptr, int, int32, int, int) -> int32) -> int32
// Sets the data of the class, given to its create callback. UI thread only.
extern fn ferro_class_set_data(classId: int, data: Ptr) -> int32
// The data of an instance of a foreign class (`NULL` for none or on a failure, recorded). UI
// thread only.
extern fn ferro_object_data(object: int) -> Ptr
// Registers a property of the foreign class `owner` (a type ID of [`ferro_class_register`])
// and returns its property ID, or a negative status. `kind` is a kind of signal
// (`FERRO_SIGNAL_I64`, `_F64`, `_BOOL`, `_TEXT`); the default is `default_number` (an integer
// or a boolean as a number) or `default_text` (UTF-8, NUL-terminated, `NULL` for no text).
// `flags` combine `FERRO_PROPERTY_AFFECTS_MEASURE`, `_ARRANGE`, `_RENDER`, `_INHERITS` and
// `_ATTACHED` (an attached property, `Owner.Name`, that every control takes). The property is
// a styled property as the ones of the framework: the setters and getters of the ABI, frames,
// signals, styles, bindings and animations use it. UI thread only.
extern fn ferro_property_register(owner: int, name: string, length: int, kind: int32, defaultNumber: float, defaultText: string, flags: int) -> int
// Measures `object` (a child, from a measure callback) at the available size. UI thread only.
extern fn ferro_layout_measure(object: int, width: float, height: float) -> int32
// Arranges `object` (a child, from an arrange callback) in the rectangle. UI thread only.
extern fn ferro_layout_arrange(object: int, x: float, y: float, width: float, height: float) -> int32
// The desired width of `object` after its measure (`0` on a failure, recorded). UI thread
// only.
extern fn ferro_layout_desired_width(object: int) -> float
// The desired height of `object` after its measure (`0` on a failure, recorded). UI thread
// only.
extern fn ferro_layout_desired_height(object: int) -> float
// The width `object` was arranged at (its bounds; `0` on a failure, recorded): what a render
// callback of a language without instance data draws in. UI thread only.
extern fn ferro_layout_bounds_width(object: int) -> float
// The height `object` was arranged at (its bounds; `0` on a failure, recorded). UI thread
// only.
extern fn ferro_layout_bounds_height(object: int) -> float
// The number of children of a panel (`0` for another object, recorded). UI thread only.
extern fn ferro_panel_child_count(object: int) -> int
// The child `index` of a panel, with one reference counted (release it), or `0` (recorded). UI
// thread only.
extern fn ferro_panel_child(object: int, index: int) -> int
// The part named `name` of the applied template of `object` (a foreign class on
// `FERRO_BASE_CONTENT_CONTROL`), with one reference counted (release it), or `0` with
// [`FERRO_NOT_FOUND`]. From the apply-template callback on. UI thread only.
extern fn ferro_template_part(object: int, name: string, length: int) -> int
// A solid brush of the colour `argb` (`0xAARRGGBB`) for the `ferro_draw_*` functions: its ID
// (a positive number), the same for the same colour, or a negative status. Make the brushes of
// a control once (at its creation) and draw with their IDs. UI thread only.
extern fn ferro_draw_brush(argb: int) -> int
// A solid pen of the colour `argb` and the thickness `thickness`: its ID, or a negative
// status. UI thread only.
extern fn ferro_draw_pen(argb: int, thickness: float) -> int
// Fills (`brush`) and strokes (`pen`) a rectangle, its corners rounded by `radius_x` and
// `radius_y`. UI thread only, in a render callback.
extern fn ferro_draw_rect(context: int, x: float, y: float, width: float, height: float, radiusX: float, radiusY: float, brush: int, pen: int) -> int32
// Fills and strokes the ellipse in the rectangle. UI thread only, in a render callback.
extern fn ferro_draw_ellipse(context: int, x: float, y: float, width: float, height: float, brush: int, pen: int) -> int32
// Strokes a line with the pen. UI thread only, in a render callback.
extern fn ferro_draw_line(context: int, x1: float, y1: float, x2: float, y2: float, pen: int) -> int32
// Fills and strokes the geometry of the path data `data` (the mini-language of markup: `M 0,0
// L 10,10 Z`, UTF-8, `length` bytes, negative for NUL-terminated). UI thread only, in a render
// callback.
extern fn ferro_draw_path(context: int, data: string, length: int, brush: int, pen: int) -> int32
// Draws `text` (UTF-8, `length` bytes, negative for NUL-terminated) with its top left at `x`,
// `y`, in the default typeface at `size`, with the brush. UI thread only, in a render
// callback.
extern fn ferro_draw_text(context: int, text: string, length: int, x: float, y: float, size: float, brush: int) -> int32
// Clips what is drawn next to the rectangle, until [`ferro_draw_pop`]. UI thread only, in a
// render callback.
extern fn ferro_draw_push_clip(context: int, x: float, y: float, width: float, height: float) -> int32
// Transforms what is drawn next by the matrix (`m11 m12 m21 m22 dx dy`), until
// [`ferro_draw_pop`]. UI thread only, in a render callback.
extern fn ferro_draw_push_transform(context: int, m11: float, m12: float, m21: float, m22: float, dx: float, dy: float) -> int32
// Draws what is drawn next with the opacity, until [`ferro_draw_pop`]. UI thread only, in a
// render callback.
extern fn ferro_draw_push_opacity(context: int, opacity: float) -> int32
// Pops the clip, transform or opacity pushed last in the context. UI thread only, in a render
// callback.
extern fn ferro_draw_pop(context: int) -> int32
// Starts a frame on the calling thread: empties the buffer of the scalar writer. Any thread
// (the buffer is the calling thread's); commit it on the UI thread.
extern fn ferro_frame_begin() -> int32
// Opens an element of the class `type_id` ([`ferro_type_id`](crate::ferro_type_id)) in the
// frame of the calling thread. `key` tells siblings apart across frames: `0` keeps the element
// by its position among the siblings without a key. Any thread.
extern fn ferro_frame_open(typeId: int, key: int) -> int32
// Gives the element opened last a text key in place of its integer key. Any thread.
extern fn ferro_frame_key_str(text: string, length: int) -> int32
// Closes the element opened last in the frame of the calling thread. Any thread.
extern fn ferro_frame_close() -> int32
// Sets `property` of the open element from text, as [`ferro_set_str`] does when the frame is
// committed. Any thread.
extern fn ferro_frame_str(property: int, text: string, length: int) -> int32
// Sets `property` of the open element from a number, as [`ferro_set_f64`] does. Any thread.
extern fn ferro_frame_f64(property: int, value: float) -> int32
// Sets `property` of the open element from an integer or the value of an enumeration member,
// as [`ferro_set_i64`] does. Any thread.
extern fn ferro_frame_i64(property: int, value: int) -> int32
// Sets `property` of the open element from a boolean, as [`ferro_set_bool`] does. Any thread.
extern fn ferro_frame_bool(property: int, value: int8) -> int32
// Binds the event `event` ([`ferro_event_id`](crate::ferro_event_id)) of the open element to
// the message tag `tag`: when it fires, the dispatcher of the thread
// ([`ferro_frame_dispatcher`]) is called with the tag, the sender, and the value of
// `value_property` (`0` for none), whose text and number [`ferro_frame_event_text`] and
// [`ferro_frame_event_f64`] give. Any thread.
extern fn ferro_frame_on(event: int, tag: int, valueProperty: int) -> int32
// Binds `property` of the open element to the signal slot `slot` (docs/c-abi.md, section 14):
// the commit binds it ([`ferro_signal_bind`](crate::ferro_signal_bind)) and keeps the binding
// while the frames keep the record, so a write of the slot updates the property with no new
// frame. Any thread.
extern fn ferro_frame_bind(property: int, slot: int) -> int32
// Makes the open element a memo element: its subtree is what `version` says it is (a revision
// of the data it shows, a hash of it), and the tags of its events are `tag_base` plus offsets
// that the version fixes. While the element keeps its key and its version, a commit does not
// look into its subtree (a new `tag_base` moves its tags), and with an integer key the next
// frame can reuse it whole ([`ferro_frame_reuse`]). A different subtree under the same key and
// version is the caller's error: the commit keeps the old one. Any thread.
extern fn ferro_frame_memo(version: int, tagBase: int) -> int32
// Writes the memo element with the integer key `key` and the version `version` of the last
// frame committed under `root` ([`ferro_frame_memo`]) into the frame of the calling thread as
// one record, in place of its whole subtree, with its tags moved to start at `tag_base`.
// Returns the number of tags the subtree uses (`0` or more: the next tag of the caller is
// `tag_base` plus it), or a negative status, and then writes nothing: [`FERRO_NOT_FOUND`] when
// the root has no such element (nothing is recorded; the caller writes the element in full),
// or [`FERRO_WRONG_THREAD`](crate::FERRO_WRONG_THREAD) off the UI thread. Commit the frame
// under the same root, before another commit under it. UI thread only.
extern fn ferro_frame_reuse(root: int, key: int, version: int, tagBase: int) -> int
// Commits the frame of the scalar writer of the calling thread under `root` (see
// [`ferro_frame_commit_bytes`]) and empties the buffer. UI thread only.
extern fn ferro_frame_commit(root: int) -> int32
// Sets the dispatcher of the events bound in frames, one for the process: called on the UI
// thread with the tag of the binding, the sender (borrowed for the call) and the value of its
// value property as an integer (a number truncated, a boolean as `0` or `1`). A result other
// than `0` marks a routed event as handled. `NULL` stops dispatching. Any thread: a language
// whose callbacks must be named functions at the call site (Osprey) sets it before
// [`ferro_app_run`](crate::ferro_app_run).
extern fn ferro_frame_dispatcher(function: fn(int, int, int) -> int) -> int32
// Calls the dispatcher of the thread ([`ferro_frame_dispatcher`]) with `tag`, `sender` and
// `arg` as an event would, and returns its result: a binding starts its loop with it (the tag
// `0` asks for the first frame), its one trampoline forwards the events of its subscriptions
// with it, and a test drives a message without an event. The event text and number are empty.
// [`FERRO_INVALID_STATE`] (as a negative result) without a dispatcher. UI thread only.
extern fn ferro_frame_dispatch(tag: int, sender: int, arg: int) -> int
// The text of the value property of the event being dispatched, NUL-terminated and owned by
// the library until the next event; empty for a binding without a value property or outside a
// dispatch. UI thread only.
extern fn ferro_frame_event_text() -> string
// The value property of the event being dispatched as a number (`0` when it is not one). UI
// thread only.
extern fn ferro_frame_event_f64() -> float
// The handle of the element with the integer key `key` in the retained tree of `root`, with
// one reference counted (release it), or `0` with [`FERRO_NOT_FOUND`]: for tests and for
// driving an interface built from frames. UI thread only.
extern fn ferro_frame_find(root: int, key: int) -> int
// Takes the elements of the frames of `root` out of it, frees them, and lets the reference to
// `root` go. UI thread only.
extern fn ferro_frame_clear(root: int) -> int32
// Creates an object of the type `type_id` ([`ferro_type_id`](crate::ferro_type_id)) with its
// default constructor and returns its handle, with one reference counted. `0` on a failure
// ([`ferro_last_error_code`](crate::ferro_last_error_code): [`FERRO_NOT_FOUND`] for an unknown
// ID, [`FERRO_NOT_SUPPORTED`] for a type without a default constructor, such as an abstract
// class). UI thread only.
extern fn ferro_create(typeId: int) -> int
// Counts one more reference to `object`, which one more [`ferro_release`] gives back. UI
// thread only.
extern fn ferro_retain(object: int) -> int32
// Gives back one reference to `object`. When the last one is given back the handle is no
// longer valid; the object itself lives on while the framework holds it (a child in a panel,
// an open window). UI thread only.
extern fn ferro_release(object: int) -> int32
// The type ID of the class of `object` (as [`ferro_type_id`](crate::ferro_type_id) gives it),
// or a negative status. UI thread only.
extern fn ferro_type_of(object: int) -> int
// The fingerprint of the stable IDs of this library: the one of the API model it was built
// with (`bindings/model/ferroui-api.json`). A binding generated from the model compares it
// with its own at start; a different value means its ID constants are not the IDs of this
// library. Any thread.
extern fn ferro_api_fingerprint() -> int
// The fingerprint of the selection of classes and calls the library was built for
// (`scripts/capi/app_library.py`, docs/c-abi.md, section 17): `0` for a library of every class
// and call (the full and the by-use builds of the crate). A binding generated from the same
// selection has the same value (`selectionFingerprint()` of the Osprey bindings,
// `FERRO_APP_SELECTION_FINGERPRINT` of the C header the generator writes); a binding accepts a
// library whose value is `0` or its own. Any thread.
extern fn ferro_selection_fingerprint() -> int
// The type ID of the class named `name` (`Button`, or `FerroUI.Controls.Button` where two
// namespaces have a class of the name): a positive ID, or [`FERRO_NOT_FOUND`]. `length` is the
// length of the name in bytes; a negative length means a NUL-terminated name. Any thread.
extern fn ferro_type_id(name: string, length: int) -> int
// The property ID of the name `name` (`Text`, or `Grid.Row` for the property a class owns,
// attached properties included): a positive ID. The ID is the name: it is checked against a
// class when it is first used with an object of that class ([`FERRO_NOT_FOUND`] then).
// `length` as for [`ferro_type_id`]. Any thread.
extern fn ferro_property_id(name: string, length: int) -> int
// The event ID of the name `name` (`Click`): a routed event of the class of the object or of a
// base class, or an event its metadata declares; `Button.Click` is the routed event a class
// owns, for a handler on an ancestor of the objects that raise it. As for
// [`ferro_property_id`], the ID is the name, checked when it is first used with a class. Any
// thread.
extern fn ferro_event_id(name: string, length: int) -> int
// [`ferro_signal_table`] for a language that cannot read memory (it calls `ferro_signal_set_*`
// and `ferro_signal_get_*`): creates the table, or keeps the one that exists, and returns a
// status. UI thread only.
extern fn ferro_signals_init(capacity: int) -> int32
// Takes a free slot of the kind `kind` (`FERRO_SIGNAL_I64` to `FERRO_SIGNAL_TEXT`), with the
// value `0` (the empty text), and returns its index, or a negative status
// ([`FERRO_INVALID_STATE`] when the table is full or not created). UI thread only.
extern fn ferro_signal_new(kind: int32) -> int
// Frees the slot `slot`: its bindings are removed and its kind is `FERRO_SIGNAL_FREE` until
// [`ferro_signal_new`] takes it again. UI thread only.
extern fn ferro_signal_free(slot: int) -> int32
// Writes an integer into the slot and marks it dirty (the store and the bit of section 14, for
// a language that cannot write memory). Any thread.
extern fn ferro_signal_set_i64(slot: int, value: int) -> int32
// Writes a number into the slot and marks it dirty. Any thread.
extern fn ferro_signal_set_f64(slot: int, value: float) -> int32
// Writes a boolean into the slot and marks it dirty. Any thread.
extern fn ferro_signal_set_bool(slot: int, value: int8) -> int32
// Writes a handle (`0` for null) into the slot and marks it dirty. Any thread.
extern fn ferro_signal_set_handle(slot: int, value: int) -> int32
// Writes UTF-8 text (`length` bytes, negative for NUL-terminated) into a text slot and marks
// it dirty; the slot value becomes the length. UI thread only.
extern fn ferro_signal_set_str(slot: int, text: string, length: int) -> int32
// The integer of the slot (the load of section 14, for a language that cannot read memory);
// `0` when the slot is not an integer slot (recorded). Any thread.
extern fn ferro_signal_get_i64(slot: int) -> int
// The number of the slot; `0` when the slot is not a number slot (recorded). Any thread.
extern fn ferro_signal_get_f64(slot: int) -> float
// The boolean of the slot; `false` when the slot is not a boolean slot (recorded). Any thread.
extern fn ferro_signal_get_bool(slot: int) -> int8
// The version of the slot (raised every time its value changes); `-1` for a slot that is not
// in the table (recorded). Any thread.
extern fn ferro_signal_version(slot: int) -> int
// The text of a text slot as NUL-terminated UTF-8 owned by the library until the next call on
// the thread; the empty text when the slot is not a text slot (recorded), never `NULL`. A
// language reads it when the version of the slot changed. UI thread only.
extern fn ferro_signal_get_cstr(slot: int) -> string
// Binds `property` of `object` to the slot: the property takes the value of the slot now and
// every time an apply finds the slot dirty, with no frame and no call of the language. Returns
// a positive binding ID for [`ferro_signal_unbind`], or a negative status. UI thread only.
extern fn ferro_signal_bind(slot: int, object: int, property: int) -> int
// Watches `property` of `object` into the slot: the library writes the value of the property
// into the slot now and every time it changes (the value, then the version, then the changed
// bit), so the language reads it with a load and no call. A text property goes into a text
// slot (read with [`ferro_signal_get_cstr`] when the version changed). Returns a positive
// binding ID for [`ferro_signal_unbind`], or a negative status. UI thread only.
extern fn ferro_signal_watch(slot: int, object: int, property: int) -> int
// Removes a binding of [`ferro_signal_bind`] or [`ferro_signal_watch`]. UI thread only.
extern fn ferro_signal_unbind(binding: int) -> int32
// Applies the dirty slots: for each slot whose dirty bit is set, its version is raised and its
// value written to every property bound to it. Returns the number of slots applied, or a
// negative status (the first failed write; the others are still made). The library applies by
// itself at the start of every frame commit and at the end of every dispatch; a language calls
// this after writing slots outside them (a timer of its own). UI thread only.
extern fn ferro_signals_apply() -> int
// Clears `changed` bits of the slot for a language that cannot write memory, and returns
// whether it was set. Any thread.
extern fn ferro_signal_take_changed(slot: int) -> int8
// Makes the calling thread the UI thread: UI objects can be created and used on it from now
// on, and on no other thread. Registers the tables of types, so that every type, property and
// event of the framework can be found by name. Calling it again on the UI thread does nothing;
// on another thread it returns [`FERRO_WRONG_THREAD`]. [`ferro_app_run`](crate::ferro_app_run)
// calls it, so an application that starts with `ferro_app_run` does not; a host that drives
// the thread itself (tests, an application of its own) calls it first. On macOS the UI thread
// of a desktop application is the main thread of the process.
extern fn ferro_init() -> int32
// Whether the calling thread is the UI thread. Any thread.
extern fn ferro_is_ui_thread() -> int8
// Runs `function(token)` on the UI thread, after the work already queued there, at the normal
// priority of the dispatcher. Any thread, the UI thread included (the work then runs later,
// not inside the call). Work that is still queued when the application ends does not run.
extern fn ferro_post(function: fn(int) -> int, token: int) -> int32
// Runs the work queued on the UI thread (posted work, timers that are due, layout and the
// other jobs of the dispatcher) and returns once the queue is empty: for a host that drives
// the UI thread itself instead of [`ferro_app_run`](crate::ferro_app_run). UI thread only.
extern fn ferro_run_jobs() -> int32
// Stops the timer `timer` ([`ferro_timer_start`]): its function is not called again.
// [`FERRO_NOT_FOUND`] for an ID that is not a running timer (one that stopped itself is gone
// after its last tick). It may be called from the function of the timer itself. UI thread
// only.
extern fn ferro_timer_stop(timer: int) -> int32
// Adds the control `child` to the children of `parent`: at the end of the `Children` of a
// panel or of the `Items` of an items control; as the one `Content` of a content control (a
// window) or of a content presenter, or the `Child` of a decorator or a popup, which must not
// hold one yet ([`FERRO_INVALID_STATE`]). The parent holds its own reference: the handle of
// the child can be released afterwards. UI thread only.
extern fn ferro_add_child(parent: int, child: int) -> int32
// Removes the control `child` from the children of `parent` (see [`ferro_add_child`]);
// [`FERRO_NOT_FOUND`] if it is not one of them. UI thread only.
extern fn ferro_remove_child(parent: int, child: int) -> int32
// Writes text to `property` of `object`: the text itself to a text property; the member of
// that name (in any case) to an enumeration; a value parsed from the text otherwise (a brush
// from `"Red"`, a thickness from `"4,2"`), or the text as the content of a content property.
// `length` is the length in bytes, a negative length means NUL-terminated. UI thread only.
extern fn ferro_set_str(object: int, property: int, text: string, length: int) -> int32
// Writes a number to `property` of `object`: straight to a `double` property, converted to any
// other numeric type. UI thread only.
extern fn ferro_set_f64(object: int, property: int, value: float) -> int32
// Writes an integer to `property` of `object`: straight to an `int32_t` or `int64_t` property,
// the member with that numeric value to an enumeration (or the combination of bits to a set of
// flags), converted to any other numeric type. UI thread only.
extern fn ferro_set_i64(object: int, property: int, value: int) -> int32
// Writes a boolean to `property` of `object`. UI thread only.
extern fn ferro_set_bool(object: int, property: int, value: int8) -> int32
// Writes an object to `property` of `object` (a `Content`, a `Child`, a brush object): `0`
// writes null. The property holds its own reference: the handle can be released afterwards. UI
// thread only.
extern fn ferro_set_handle(object: int, property: int, value: int) -> int32
// Clears the local value of `property` of `object`, which then has its styled, inherited or
// default value again. UI thread only.
extern fn ferro_clear(object: int, property: int) -> int32
// Reads a number from `property` of `object`, as [`ferro_get_f64`] does, and returns it;
// returns `fallback` when the read fails (the failure is recorded: [`ferro_last_error`]). For
// a language that cannot pass a pointer to a result. UI thread only. [`ferro_last_error`]:
// crate::ferro_last_error
extern fn ferro_get_f64_or(object: int, property: int, fallback: float) -> float
// Reads an integer from `property` of `object`, as [`ferro_get_i64`] does, and returns it;
// returns `fallback` when the read fails (the failure is recorded). UI thread only.
extern fn ferro_get_i64_or(object: int, property: int, fallback: int) -> int
// Reads a boolean from `property` of `object`, as [`ferro_get_bool`] does, and returns it;
// returns `fallback` when the read fails (the failure is recorded). UI thread only.
extern fn ferro_get_bool_or(object: int, property: int, fallback: int8) -> int8
// Reads the text of `property` of `object` as [`ferro_get_cstr`] does, and returns `fallback`
// (the caller's own string, returned as it is) in place of `NULL` when the read fails (the
// failure is recorded): for a language whose strings cannot be `NULL`. UI thread only.
extern fn ferro_get_cstr_or(object: int, property: int, fallback: string) -> string
// registerTypes() -> int: registers the classes of the selection, with the units of the theme they
// need, before the application starts (`run` calls it): what a library built for the
// selection (without the tables of types) knows. A class that failed fails where it is created.
fn registerTypes() = 0

// A null pointer, for the reserved options of ferro_app_run (from the runtime of Osprey).
extern fn osprey_ffi_null() -> Ptr

// Not declared, because Osprey cannot pass what they take (a pointer to a result, a buffer,
// UTF-16, bytes) or return (a string that can be NULL): ferro_subscribe_data, ferro_object_set_data, ferro_frame_str16, ferro_frame_commit_bytes, ferro_signal_table, ferro_post_data, ferro_timer_start, ferro_get_f64, ferro_get_i64, ferro_get_bool, ferro_get_str, ferro_get_cstr, ferro_get_handle, ferro_set_str16.

// ---- enumerations ----------------------------------------------------------------------------

// Declares how a control should included in different views of the automation tree.
type AccessibilityView = AccessibilityViewDefault | AccessibilityViewRaw | AccessibilityViewControl | AccessibilityViewContent
// accessibilityViewName(value: AccessibilityView) -> string: the name of a member, which the ABI sets by name.
fn accessibilityViewName(value) = match value {
    AccessibilityViewDefault => "Default"
    AccessibilityViewRaw => "Raw"
    AccessibilityViewControl => "Control"
    AccessibilityViewContent => "Content"
}

// Background sources for acrylic.
type AcrylicBackgroundSource = AcrylicBackgroundSourceNone | AcrylicBackgroundSourceDigger
// acrylicBackgroundSourceName(value: AcrylicBackgroundSource) -> string: the name of a member, which the ABI sets by name.
fn acrylicBackgroundSourceName(value) = match value {
    AcrylicBackgroundSourceNone => "None"
    AcrylicBackgroundSourceDigger => "Digger"
}

// What an acrylic brush blurs (WinUI 2 `AcrylicBrushBackgroundSource`, the `BackgroundSource`
// of `AcrylicBrush`; WinUI 3 has the backdrop only).
type AcrylicBrushBackgroundSource = AcrylicBrushBackgroundSourceHostBackdrop | AcrylicBrushBackgroundSourceBackdrop
// acrylicBrushBackgroundSourceName(value: AcrylicBrushBackgroundSource) -> string: the name of a member, which the ABI sets by name.
fn acrylicBrushBackgroundSourceName(value) = match value {
    AcrylicBrushBackgroundSourceHostBackdrop => "HostBackdrop"
    AcrylicBrushBackgroundSourceBackdrop => "Backdrop"
}

// Describes how content is positioned horizontally in a container.
type AlignmentX = AlignmentXLeft | AlignmentXCenter | AlignmentXRight
// alignmentXName(value: AlignmentX) -> string: the name of a member, which the ABI sets by name.
fn alignmentXName(value) = match value {
    AlignmentXLeft => "Left"
    AlignmentXCenter => "Center"
    AlignmentXRight => "Right"
}

// Describes how content is positioned vertically in a container.
type AlignmentY = AlignmentYTop | AlignmentYCenter | AlignmentYBottom
// alignmentYName(value: AlignmentY) -> string: the name of a member, which the ABI sets by name.
fn alignmentYName(value) = match value {
    AlignmentYTop => "Top"
    AlignmentYCenter => "Center"
    AlignmentYBottom => "Bottom"
}

// The theme an element is drawn for (WinUI `Microsoft.UI.Xaml.ApplicationTheme`): the type of
// [`RevealBrush::target_theme`].
type ApplicationTheme = ApplicationThemeLight | ApplicationThemeDark
// applicationThemeName(value: ApplicationTheme) -> string: the name of a member, which the ABI sets by name.
fn applicationThemeName(value) = match value {
    ApplicationThemeLight => "Light"
    ApplicationThemeDark => "Dark"
}

// Specifies how text in the text box portion of the
// [`AutoCompleteBox`](super::AutoCompleteBox) control is used to filter items specified by the
// `ItemsSource` property for display in the drop-down.
type AutoCompleteFilterMode = AutoCompleteFilterModeNone | AutoCompleteFilterModeStartsWith | AutoCompleteFilterModeStartsWithCaseSensitive | AutoCompleteFilterModeStartsWithOrdinal | AutoCompleteFilterModeStartsWithOrdinalCaseSensitive | AutoCompleteFilterModeContains | AutoCompleteFilterModeContainsCaseSensitive | AutoCompleteFilterModeContainsOrdinal | AutoCompleteFilterModeContainsOrdinalCaseSensitive | AutoCompleteFilterModeEquals | AutoCompleteFilterModeEqualsCaseSensitive | AutoCompleteFilterModeEqualsOrdinal | AutoCompleteFilterModeEqualsOrdinalCaseSensitive | AutoCompleteFilterModeCustom
// autoCompleteFilterModeName(value: AutoCompleteFilterMode) -> string: the name of a member, which the ABI sets by name.
fn autoCompleteFilterModeName(value) = match value {
    AutoCompleteFilterModeNone => "None"
    AutoCompleteFilterModeStartsWith => "StartsWith"
    AutoCompleteFilterModeStartsWithCaseSensitive => "StartsWithCaseSensitive"
    AutoCompleteFilterModeStartsWithOrdinal => "StartsWithOrdinal"
    AutoCompleteFilterModeStartsWithOrdinalCaseSensitive => "StartsWithOrdinalCaseSensitive"
    AutoCompleteFilterModeContains => "Contains"
    AutoCompleteFilterModeContainsCaseSensitive => "ContainsCaseSensitive"
    AutoCompleteFilterModeContainsOrdinal => "ContainsOrdinal"
    AutoCompleteFilterModeContainsOrdinalCaseSensitive => "ContainsOrdinalCaseSensitive"
    AutoCompleteFilterModeEquals => "Equals"
    AutoCompleteFilterModeEqualsCaseSensitive => "EqualsCaseSensitive"
    AutoCompleteFilterModeEqualsOrdinal => "EqualsOrdinal"
    AutoCompleteFilterModeEqualsOrdinalCaseSensitive => "EqualsOrdinalCaseSensitive"
    AutoCompleteFilterModeCustom => "Custom"
}

// The control type an automation peer reports for its element.
type AutomationControlType = AutomationControlTypeNone | AutomationControlTypeButton | AutomationControlTypeCalendar | AutomationControlTypeCheckBox | AutomationControlTypeComboBox | AutomationControlTypeComboBoxItem | AutomationControlTypeEdit | AutomationControlTypeHyperlink | AutomationControlTypeImage | AutomationControlTypeListItem | AutomationControlTypeList | AutomationControlTypeMenu | AutomationControlTypeMenuBar | AutomationControlTypeMenuItem | AutomationControlTypeProgressBar | AutomationControlTypeRadioButton | AutomationControlTypeScrollBar | AutomationControlTypeSlider | AutomationControlTypeSpinner | AutomationControlTypeStatusBar | AutomationControlTypeTab | AutomationControlTypeTabItem | AutomationControlTypeText | AutomationControlTypeToolBar | AutomationControlTypeToolTip | AutomationControlTypeTree | AutomationControlTypeTreeItem | AutomationControlTypeCustom | AutomationControlTypeGroup | AutomationControlTypeThumb | AutomationControlTypeDataGrid | AutomationControlTypeDataItem | AutomationControlTypeDocument | AutomationControlTypeSplitButton | AutomationControlTypeWindow | AutomationControlTypePane | AutomationControlTypeHeader | AutomationControlTypeHeaderItem | AutomationControlTypeTable | AutomationControlTypeTitleBar | AutomationControlTypeSeparator | AutomationControlTypeExpander | AutomationControlTypeScrollViewer
// automationControlTypeName(value: AutomationControlType) -> string: the name of a member, which the ABI sets by name.
fn automationControlTypeName(value) = match value {
    AutomationControlTypeNone => "None"
    AutomationControlTypeButton => "Button"
    AutomationControlTypeCalendar => "Calendar"
    AutomationControlTypeCheckBox => "CheckBox"
    AutomationControlTypeComboBox => "ComboBox"
    AutomationControlTypeComboBoxItem => "ComboBoxItem"
    AutomationControlTypeEdit => "Edit"
    AutomationControlTypeHyperlink => "Hyperlink"
    AutomationControlTypeImage => "Image"
    AutomationControlTypeListItem => "ListItem"
    AutomationControlTypeList => "List"
    AutomationControlTypeMenu => "Menu"
    AutomationControlTypeMenuBar => "MenuBar"
    AutomationControlTypeMenuItem => "MenuItem"
    AutomationControlTypeProgressBar => "ProgressBar"
    AutomationControlTypeRadioButton => "RadioButton"
    AutomationControlTypeScrollBar => "ScrollBar"
    AutomationControlTypeSlider => "Slider"
    AutomationControlTypeSpinner => "Spinner"
    AutomationControlTypeStatusBar => "StatusBar"
    AutomationControlTypeTab => "Tab"
    AutomationControlTypeTabItem => "TabItem"
    AutomationControlTypeText => "Text"
    AutomationControlTypeToolBar => "ToolBar"
    AutomationControlTypeToolTip => "ToolTip"
    AutomationControlTypeTree => "Tree"
    AutomationControlTypeTreeItem => "TreeItem"
    AutomationControlTypeCustom => "Custom"
    AutomationControlTypeGroup => "Group"
    AutomationControlTypeThumb => "Thumb"
    AutomationControlTypeDataGrid => "DataGrid"
    AutomationControlTypeDataItem => "DataItem"
    AutomationControlTypeDocument => "Document"
    AutomationControlTypeSplitButton => "SplitButton"
    AutomationControlTypeWindow => "Window"
    AutomationControlTypePane => "Pane"
    AutomationControlTypeHeader => "Header"
    AutomationControlTypeHeaderItem => "HeaderItem"
    AutomationControlTypeTable => "Table"
    AutomationControlTypeTitleBar => "TitleBar"

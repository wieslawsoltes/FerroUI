// Specifies the position of the tab strip within a tabbed page layout.
type TabPlacement = TabPlacementAuto | TabPlacementTop | TabPlacementBottom | TabPlacementLeft | TabPlacementRight
// tabPlacementName(value: TabPlacement) -> string: the name of a member, which the ABI sets by name.
fn tabPlacementName(value) = match value {
    TabPlacementAuto => "Auto"
    TabPlacementTop => "Top"
    TabPlacementBottom => "Bottom"
    TabPlacementLeft => "Left"
    TabPlacementRight => "Right"
}

// When the close button of a tab shows (WinUI's `TabViewCloseButtonOverlayMode`).
type TabViewCloseButtonOverlayMode = TabViewCloseButtonOverlayModeAuto | TabViewCloseButtonOverlayModeOnPointerOver | TabViewCloseButtonOverlayModeAlways
// tabViewCloseButtonOverlayModeName(value: TabViewCloseButtonOverlayMode) -> string: the name of a member, which the ABI sets by name.
fn tabViewCloseButtonOverlayModeName(value) = match value {
    TabViewCloseButtonOverlayModeAuto => "Auto"
    TabViewCloseButtonOverlayModeOnPointerOver => "OnPointerOver"
    TabViewCloseButtonOverlayModeAlways => "Always"
}

// How wide the tabs of a [`TabView`] are (WinUI's `TabViewWidthMode`).
type TabViewWidthMode = TabViewWidthModeEqual | TabViewWidthModeSizeToContent | TabViewWidthModeCompact
// tabViewWidthModeName(value: TabViewWidthMode) -> string: the name of a member, which the ABI sets by name.
fn tabViewWidthModeName(value) = match value {
    TabViewWidthModeEqual => "Equal"
    TabViewWidthModeSizeToContent => "SizeToContent"
    TabViewWidthModeCompact => "Compact"
}

// Defines how text is aligned.
type TextAlignment = TextAlignmentLeft | TextAlignmentCenter | TextAlignmentRight | TextAlignmentStart | TextAlignmentEnd | TextAlignmentDetectFromContent | TextAlignmentJustify
// textAlignmentName(value: TextAlignment) -> string: the name of a member, which the ABI sets by name.
fn textAlignmentName(value) = match value {
    TextAlignmentLeft => "Left"
    TextAlignmentCenter => "Center"
    TextAlignmentRight => "Right"
    TextAlignmentStart => "Start"
    TextAlignmentEnd => "End"
    TextAlignmentDetectFromContent => "DetectFromContent"
    TextAlignmentJustify => "Justify"
}

// Specifies the vertical position of a text decoration.
type TextDecorationLocation = TextDecorationLocationUnderline | TextDecorationLocationOverline | TextDecorationLocationStrikethrough | TextDecorationLocationBaseline
// textDecorationLocationName(value: TextDecorationLocation) -> string: the name of a member, which the ABI sets by name.
fn textDecorationLocationName(value) = match value {
    TextDecorationLocationUnderline => "Underline"
    TextDecorationLocationOverline => "Overline"
    TextDecorationLocationStrikethrough => "Strikethrough"
    TextDecorationLocationBaseline => "Baseline"
}

// Specifies the unit type of either a text decoration offset or thickness value.
type TextDecorationUnit = TextDecorationUnitFontRecommended | TextDecorationUnitFontRenderingEmSize | TextDecorationUnitPixel
// textDecorationUnitName(value: TextDecorationUnit) -> string: the name of a member, which the ABI sets by name.
fn textDecorationUnitName(value) = match value {
    TextDecorationUnitFontRecommended => "FontRecommended"
    TextDecorationUnitFontRenderingEmSize => "FontRenderingEmSize"
    TextDecorationUnitPixel => "Pixel"
}

// The kind of content a text input expects, which lets the platform show an appropriate
// (on-screen) keyboard.
type TextInputContentType = TextInputContentTypeNormal | TextInputContentTypeAlpha | TextInputContentTypeDigits | TextInputContentTypePin | TextInputContentTypeNumber | TextInputContentTypeEmail | TextInputContentTypeUrl | TextInputContentTypeName | TextInputContentTypePassword | TextInputContentTypeSocial | TextInputContentTypeSearch
// textInputContentTypeName(value: TextInputContentType) -> string: the name of a member, which the ABI sets by name.
fn textInputContentTypeName(value) = match value {
    TextInputContentTypeNormal => "Normal"
    TextInputContentTypeAlpha => "Alpha"
    TextInputContentTypeDigits => "Digits"
    TextInputContentTypePin => "Pin"
    TextInputContentTypeNumber => "Number"
    TextInputContentTypeEmail => "Email"
    TextInputContentTypeUrl => "Url"
    TextInputContentTypeName => "Name"
    TextInputContentTypePassword => "Password"
    TextInputContentTypeSocial => "Social"
    TextInputContentTypeSearch => "Search"
}

// The label of the return key of an on-screen keyboard.
type TextInputReturnKeyType = TextInputReturnKeyTypeDefault | TextInputReturnKeyTypeReturn | TextInputReturnKeyTypeDone | TextInputReturnKeyTypeGo | TextInputReturnKeyTypeSend | TextInputReturnKeyTypeSearch | TextInputReturnKeyTypeNext | TextInputReturnKeyTypePrevious
// textInputReturnKeyTypeName(value: TextInputReturnKeyType) -> string: the name of a member, which the ABI sets by name.
fn textInputReturnKeyTypeName(value) = match value {
    TextInputReturnKeyTypeDefault => "Default"
    TextInputReturnKeyTypeReturn => "Return"
    TextInputReturnKeyTypeDone => "Done"
    TextInputReturnKeyTypeGo => "Go"
    TextInputReturnKeyTypeSend => "Send"
    TextInputReturnKeyTypeSearch => "Search"
    TextInputReturnKeyTypeNext => "Next"
    TextInputReturnKeyTypePrevious => "Previous"
}

// Where a text block puts the height layout rounding adds to it: below its text (the
// reference's placement, the default) or above it (WinUI's).
type TextLayoutRoundingPlacement = TextLayoutRoundingPlacementBelow | TextLayoutRoundingPlacementAbove
// textLayoutRoundingPlacementName(value: TextLayoutRoundingPlacement) -> string: the name of a member, which the ABI sets by name.
fn textLayoutRoundingPlacementName(value) = match value {
    TextLayoutRoundingPlacementBelow => "Below"
    TextLayoutRoundingPlacementAbove => "Above"
}

// How the box of each line of text is bounded: by the ascent and the descent of its font (the
// default), or trimmed to the cap height above the baseline, to the baseline below it, or
// both.
type TextLineBounds = TextLineBoundsFull | TextLineBoundsTrimToCapHeight | TextLineBoundsTrimToBaseline | TextLineBoundsTight
// textLineBoundsName(value: TextLineBounds) -> string: the name of a member, which the ABI sets by name.
fn textLineBoundsName(value) = match value {
    TextLineBoundsFull => "Full"
    TextLineBoundsTrimToCapHeight => "TrimToCapHeight"
    TextLineBoundsTrimToBaseline => "TrimToBaseline"
    TextLineBoundsTight => "Tight"
}

// Controls the wrapping mode of text.
type TextWrapping = TextWrappingNoWrap | TextWrappingWrap | TextWrappingWrapWithOverflow
// textWrappingName(value: TextWrapping) -> string: the name of a member, which the ABI sets by name.
fn textWrappingName(value) = match value {
    TextWrappingNoWrap => "NoWrap"
    TextWrappingWrap => "Wrap"
    TextWrappingWrapWithOverflow => "WrapWithOverflow"
}

// Enum which describes how to position the [`TickBar`].
type TickBarPlacement = TickBarPlacementLeft | TickBarPlacementTop | TickBarPlacementRight | TickBarPlacementBottom
// tickBarPlacementName(value: TickBarPlacement) -> string: the name of a member, which the ABI sets by name.
fn tickBarPlacementName(value) = match value {
    TickBarPlacementLeft => "Left"
    TickBarPlacementTop => "Top"
    TickBarPlacementRight => "Right"
    TickBarPlacementBottom => "Bottom"
}

// Describes how to position the ticks in a [`Slider`].
type TickPlacement = TickPlacementNone | TickPlacementTopLeft | TickPlacementBottomRight | TickPlacementOutside
// tickPlacementName(value: TickPlacement) -> string: the name of a member, which the ABI sets by name.
fn tickPlacementName(value) = match value {
    TickPlacementNone => "None"
    TickPlacementTopLeft => "TopLeft"
    TickPlacementBottomRight => "BottomRight"
    TickPlacementOutside => "Outside"
}

// Describes how a tile brush is tiled.
type TileMode = TileModeNone | TileModeFlipX | TileModeFlipY | TileModeFlipXy | TileModeTile
// tileModeName(value: TileMode) -> string: the name of a member, which the ABI sets by name.
